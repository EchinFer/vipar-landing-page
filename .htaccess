# Redirect non-www to www and force HTTPS
# Place this file at the site root (public web root).
# Permanent 301 redirect from vipar.com.py (or http) to https://www.vipar.com.py

<IfModule mod_rewrite.c>
  RewriteEngine On

  # If host is exactly vipar.com.py (no www) OR request is not HTTPS, redirect
  RewriteCond %{HTTP_HOST} ^vipar\.com\.py$ [NC,OR]
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://www.vipar.com.py%{REQUEST_URI} [L,R=301]
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On

  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"
  ExpiresByType application/json "access plus 1 hour"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|mjs|png|jpg|jpeg|webp|avif|svg|woff|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(html)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
</IfModule>
