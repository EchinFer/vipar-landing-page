<IfModule mod_rewrite.c>
  RewriteEngine On

  RewriteRule ^admin$ /admin/ [R=301,L]

  # Si ES www -> redirigir a no-www
  RewriteCond %{HTTP_HOST} ^www\.vipar\.com\.py$ [NC]
  RewriteRule ^ https://vipar.com.py%{REQUEST_URI} [R=301,L]

  # Si Apache no detecta HTTPS pero viene por proxy (Cloudflare), no fuerces otra vez.
</IfModule>