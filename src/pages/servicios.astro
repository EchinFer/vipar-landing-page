---
import ServiciosCatalog from "@components/servicios/ServiciosCatalog.astro";
import ServiciosFilterBar from "@components/servicios/ServiciosFilterBar.astro";
import ServiciosHero from "@components/servicios/ServiciosHero.astro";
import Layout from "@layouts/Layout.astro";
import { serviciosHeroImage, staticServicioFilters, staticServicios } from "@lib/static-servicios";
import "../styles/servicios.css";
import { SITE_URL } from "src/constants";

const title = "Servicios - VIPAR S.A.";
const description =
  "Diseño, fabricación e instalación de sistemas premium en vidrio, aluminio y terminaciones avanzadas para proyectos en Paraguay.";
const canonical = `${SITE_URL}/servicios`;
---

<Layout title={title} description={description} canonical={canonical}>
  <main class="vipar-servicios-page">
    <ServiciosHero image={serviciosHeroImage} />
    <ServiciosFilterBar filters={staticServicioFilters} />
    <ServiciosCatalog servicios={staticServicios} />
  </main>

  <script is:inline>
    document.addEventListener("DOMContentLoaded", () => {
      const filterBar = document.querySelector(".vipar-servicios-filter-bar");
      const cards = Array.from(
        document.querySelectorAll(".vipar-servicios-grid .vipar-servicios-card[data-category]")
      );

      if (!filterBar || !cards.length) return;

      const apply = (filter) => {
        cards.forEach((card) => {
          card.toggleAttribute("hidden", filter !== "all" && card.dataset.category !== filter);
        });
      };

      filterBar.addEventListener("filterchange", (e) => {
        apply(e.detail.value);
      });

      apply("all");
    });
  </script>
</Layout>
