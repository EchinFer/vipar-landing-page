---
import Base from "../layouts/Base.astro";
import CabeceraPagina from "../components/CabeceraPagina.astro";
import { empresa } from "../data/empresa";
import { waUrl, mensajeLibre } from "../lib/pedido";

const wa = mensajeLibre("Quiero coordinar una visita al showroom o una medición.");
---

<Base
	title="Contacto | VIPAR S.A. Cristales y aluminio en Ñemby, Paraguay"
	description="Showroom en San Francisco 770 c/ Sexta, Bo. Salinas, Ñemby. WhatsApp +595 981 256 510. Lunes a viernes de 7:30 a 17:00."
	path="/contacto/"
	waTexto={wa}
>
	<CabeceraPagina kicker="Contacto" titulo="Vení o escribinos" h1Max="max-w-[14ch]" />
	<article class="px-4 py-12 md:px-8 md:py-16">
		<dl class="grid gap-6 text-lg md:grid-cols-2">
			<div>
				<dt class="text-sm text-muted">Showroom</dt>
				<dd class="mt-1">{empresa.direccion}<br />{empresa.ciudad}, {empresa.departamento}</dd>
				<dd class="mt-2"><a class="underline underline-offset-4" href={empresa.comoLlegar} data-mapa="contacto">Cómo llegar en Google Maps</a></dd>
			</div>
			<div>
				<dt class="text-sm text-muted">Horario</dt>
				<dd class="mt-1">{empresa.horario}</dd>
			</div>
			<div>
				<dt class="text-sm text-muted">WhatsApp</dt>
				<dd class="mt-1"><a class="underline underline-offset-4" href={waUrl(wa)}>{empresa.telefono}</a></dd>
			</div>
			<div>
				<dt class="text-sm text-muted">Correo</dt>
				<dd class="mt-1"><a class="underline underline-offset-4" href={`mailto:${empresa.email}`}>{empresa.email}</a></dd>
			</div>
		</dl>
		<p class="mt-8 max-w-lg">La página de pedido arma el mensaje con el servicio, el material, las medidas y la ciudad. Para cualquier trabajo ayudan las fotos del lugar: mandalas por WhatsApp después.</p>
		<p class="mt-6"><a href="/calculadora/" class="btn btn-primary">Armar el pedido</a></p>
	</article>
</Base>
