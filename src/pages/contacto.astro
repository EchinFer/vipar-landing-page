---
import ContactoFormPanel from "@components/contacto/ContactoFormPanel.astro";
import ContactoHero from "@components/contacto/ContactoHero.astro";
import ContactoInfoPanel from "@components/contacto/ContactoInfoPanel.astro";
import ContactoMap from "@components/contacto/ContactoMap.astro";
import ContactoMediaPanel from "@components/contacto/ContactoMediaPanel.astro";
import ContactoSocialPanel from "@components/contacto/ContactoSocialPanel.astro";
import Container from "@components/ui/Container.astro";
import Layout from "@layouts/Layout.astro";
import "../styles/contacto.css";
import {
  SITE_URL,
  SOCIAL_LINKS,
  address,
  email,
  telephone,
} from "src/constants";

const title = "Contacto | VIPAR S.A.";
const description =
  "Contacto técnico y comercial de VIPAR S.A. en Ñemby, Paraguay. Consultas, cotizaciones y coordinación de proyectos en cristales, aluminio y terminaciones.";
const canonical = `${SITE_URL}/contacto/`;
const whatsappNumber = telephone.replace(/[^\d]/g, "");
const whatsappMessage =
  "Hola, quiero solicitar un presupuesto. Me comunico desde la página de contacto.";
const googleMapsUrl =
  "https://www.google.com/maps/search/?api=1&query=" +
  encodeURIComponent(
    "San Francisco 770 c/ Sexta, Barrio Salinas, Ñemby, Paraguay",
  );

const socialItems = [
  {
    label: "Instagram",
    href: SOCIAL_LINKS.instagram || "#",
    icon: "photo_camera",
    target: "_blank",
    rel: "noopener noreferrer",
  },
  {
    label: "LinkedIn",
    href: SOCIAL_LINKS.linkedin || "#",
    icon: "work",
  },
  {
    label: "YouTube",
    href: "#",
    icon: "play_circle",
  },
  {
    label: "WhatsApp",
    href: `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`,
    icon: "chat",
    target: "_blank",
    rel: "noopener noreferrer",
  },
  {
    label: "Facebook",
    href: SOCIAL_LINKS.facebook || "#",
    icon: "thumb_up",
    target: "_blank",
    rel: "noopener noreferrer",
  },
];
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  bodyClass="vipar-contact-body"
  hideWhatsappFAB={true}
  hideConsentBanner={true}
>
  <div class="contact-page">
    <main class="contact-main">
      <ContactoHero />

      <Container class="contact-container contact-grid">
        <div class="contact-stack">
          <ContactoInfoPanel
            address={address}
            email={email}
            telephone={telephone}
          />
          <ContactoMediaPanel />
          <ContactoSocialPanel items={socialItems} />
        </div>

        <ContactoFormPanel />
      </Container>

      <ContactoMap googleMapsUrl={googleMapsUrl} />
    </main>
  </div>

  <script is:inline>
    const form = document.getElementById("vipar-contact-form");
    const status = document.getElementById("vipar-contact-form-status");
    const message = document.getElementById("vipar-contact-form-message");

    function setStatus(kind, text) {
      if (!(status instanceof HTMLElement) || !(message instanceof HTMLElement))
        return;
      status.hidden = false;
      status.dataset.state = kind;
      message.textContent = text;
    }

    function clearStatus() {
      if (!(status instanceof HTMLElement) || !(message instanceof HTMLElement))
        return;
      status.hidden = true;
      delete status.dataset.state;
      message.textContent = "";
    }

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();

      const formElement = event.currentTarget;
      if (!(formElement instanceof HTMLFormElement)) return;

      clearStatus();

      const formData = new FormData(formElement);
      const name = String(formData.get("name") || "").trim();
      const phone = String(formData.get("phone") || "").trim();
      const emailValue = String(formData.get("email") || "").trim();
      const subject = String(formData.get("city") || "").trim();
      const details = String(formData.get("message") || "").trim();

      if (!name || !phone || !details) {
        setStatus("error", "Completá nombre, teléfono y mensaje.");
        return;
      }

      const payload = new FormData();
      payload.set("name", name);
      payload.set("phone", phone);
      payload.set("email", emailValue);
      payload.set("city", subject);
      payload.set("message", details);
      payload.set("source", String(formData.get("source") || "vipar-contacto"));
      payload.set(
        "page",
        typeof window !== "undefined" ? window.location.href : "",
      );

      const attachment = formData.get("file");
      if (attachment instanceof File && attachment.size > 0) {
        payload.set("file", attachment);
      }

      const submitButton = formElement.querySelector('button[type="submit"]');
      if (submitButton instanceof HTMLButtonElement) {
        submitButton.disabled = true;
      }

      try {
        const response = await fetch("/api/leads", {
          method: "POST",
          body: payload,
        });

        const data = await response.json().catch(() => null);

        if (!response.ok) {
          setStatus(
            "error",
            data?.error ||
              "No se pudo enviar la consulta. Probá nuevamente o escribinos por WhatsApp.",
          );
          return;
        }

        if (
          typeof window !== "undefined" &&
          typeof window.gtag === "function"
        ) {
          window.gtag("event", "generate_lead", {
            method: "contact_form",
            page_location: window.location.href,
          });
        }

        formElement.reset();
        setStatus(
          "success",
          "Recibimos tu consulta. Te responderemos a la brevedad.",
        );
      } catch {
        setStatus(
          "error",
          "Error de red. Probá nuevamente o escribinos por WhatsApp.",
        );
      } finally {
        if (submitButton instanceof HTMLButtonElement) {
          submitButton.disabled = false;
        }
      }
    });
  </script>
</Layout>
