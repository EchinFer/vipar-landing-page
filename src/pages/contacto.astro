---
import ContactoFormPanel from "@components/contacto/ContactoFormPanel.astro";
import ContactoHero from "@components/contacto/ContactoHero.astro";
import ContactoInfoPanel from "@components/contacto/ContactoInfoPanel.astro";
import ContactoMap from "@components/contacto/ContactoMap.astro";
import ContactoMediaPanel from "@components/contacto/ContactoMediaPanel.astro";
import ContactoSocialPanel from "@components/contacto/ContactoSocialPanel.astro";
import Container from "@components/ui/Container.astro";
import Layout from "@layouts/Layout.astro";
import "../styles/contacto.css";
import { SITE_URL, SOCIAL_LINKS, address, email, telephone } from "src/constants";

const title = "Contacto | VIPAR S.A.";
const description =
  "Contacto técnico y comercial de VIPAR S.A. en Ñemby, Paraguay. Consultas, cotizaciones y coordinación de proyectos en cristales, aluminio y terminaciones.";
const canonical = `${SITE_URL}/contacto/`;
const whatsappNumber = telephone.replace(/[^\d]/g, "");
const whatsappMessage =
  "Hola, quiero solicitar un presupuesto. Me comunico desde la página de contacto.";
const googleMapsUrl = "https://maps.app.goo.gl/frEBGayuutx7q1hj6";

type ContactSocialItem = {
  label: string;
  href: string;
  network: "whatsapp" | "instagram" | "tiktok";
  target?: string;
  rel?: string;
};

const socialItems: ContactSocialItem[] = [
  {
    label: "WhatsApp",
    href: `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`,
    network: "whatsapp",
    target: "_blank",
    rel: "noopener noreferrer",
  },
  {
    label: "Instagram",
    href: SOCIAL_LINKS.instagram,
    network: "instagram",
    target: "_blank",
    rel: "noopener noreferrer",
  },
  {
    label: "TikTok",
    href: SOCIAL_LINKS.tiktok,
    network: "tiktok",
    target: "_blank",
    rel: "noopener noreferrer",
  },
];
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  bodyClass="vipar-contact-body"
  hideWhatsappFAB={true}
  hideConsentBanner={true}
  pageType="contact"
>
  <div class="contact-page">
    <main class="contact-main">
      <ContactoHero />

      <Container class="contact-container contact-grid">
        <div class="contact-stack">
          <ContactoInfoPanel address={address} email={email} telephone={telephone} />
          <ContactoMediaPanel />
          <ContactoSocialPanel items={socialItems} />
        </div>

        <ContactoFormPanel />
      </Container>

      <ContactoMap googleMapsUrl={googleMapsUrl} />
    </main>
  </div>

  <script define:vars={{ whatsappNumber }}>
    const form = document.getElementById("vipar-contact-form");
    const status = document.getElementById("vipar-contact-form-status");
    const message = document.getElementById("vipar-contact-form-message");
    let hasTrackedFormStart = false;

    function setStatus(kind, text) {
      if (!(status instanceof HTMLElement) || !(message instanceof HTMLElement)) return;
      status.hidden = false;
      status.dataset.state = kind;
      message.textContent = text;
    }

    function clearStatus() {
      if (!(status instanceof HTMLElement) || !(message instanceof HTMLElement)) return;
      status.hidden = true;
      delete status.dataset.state;
      message.textContent = "";
    }

    function buildWhatsappUrl(fields) {
      const lines = [
        "Hola, quiero solicitar un presupuesto.",
        `Nombre: ${fields.name}`,
        `WhatsApp: ${fields.phone}`,
        fields.email ? `Email: ${fields.email}` : "",
        fields.subject ? `Ubicación o asunto: ${fields.subject}` : "",
        "",
        "Detalle:",
        fields.details,
      ].filter(Boolean);

      return `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(lines.join("\n"))}`;
    }

    if (form instanceof HTMLFormElement) {
      const startedAtInput = form.querySelector('input[name="form_started_at"]');
      if (startedAtInput instanceof HTMLInputElement && !startedAtInput.value) {
        startedAtInput.value = String(Date.now());
      }
    }

    form?.addEventListener("input", () => {
      if (hasTrackedFormStart) return;
      hasTrackedFormStart = true;
      if (typeof window !== "undefined" && typeof window.viparTrack === "function") {
        window.viparTrack("form_start", {
          cta_location: "contact_form",
        });
      }
    });

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();

      const formElement = event.currentTarget;
      if (!(formElement instanceof HTMLFormElement)) return;

      clearStatus();

      const formData = new FormData(formElement);
      const name = String(formData.get("name") || "").trim();
      const phone = String(formData.get("phone") || "").trim();
      const emailValue = String(formData.get("email") || "").trim();
      const subject = String(formData.get("city") || "").trim();
      const details = String(formData.get("message") || "").trim();
      const website = String(formData.get("website") || "").trim();
      const formStartedAt = String(formData.get("form_started_at") || "").trim();

      if (!name || !phone || !details) {
        setStatus("error", "Completá nombre, teléfono y mensaje.");
        return;
      }

      const payload = new FormData();
      payload.set("name", name);
      payload.set("phone", phone);
      payload.set("email", emailValue);
      payload.set("city", subject);
      payload.set("message", details);
      payload.set("source", String(formData.get("source") || "vipar-contacto"));
      payload.set("page", typeof window !== "undefined" ? window.location.href : "");

      const leadContext =
        typeof window !== "undefined" && typeof window.viparLeadContext === "function"
          ? window.viparLeadContext({ cta_location: "contact_form" })
          : { cta_location: "contact_form" };

      payload.set("website", website);
      payload.set("form_started_at", formStartedAt);
      payload.set("page_path", String(leadContext.page_path || ""));
      payload.set("page_title", String(leadContext.page_title || ""));
      payload.set("page_type", String(leadContext.page_type || ""));
      payload.set("service_name", String(leadContext.service_name || ""));
      payload.set("cta_location", String(leadContext.cta_location || "contact_form"));
      payload.set("lead_source", String(leadContext.lead_source || ""));
      payload.set("lead_medium", String(leadContext.lead_medium || ""));
      payload.set("campaign", String(leadContext.campaign || ""));
      payload.set("device_type", String(leadContext.device_type || ""));

      const attachment = formData.get("file");
      if (attachment instanceof File && attachment.size > 0) {
        payload.set("file", attachment);
        if (typeof window !== "undefined" && typeof window.viparTrack === "function") {
          window.viparTrack("file_upload_attempt", {
            cta_location: "contact_form",
          });
        }
      }

      const submitButton = formElement.querySelector('button[type="submit"]');
      if (submitButton instanceof HTMLButtonElement) {
        submitButton.disabled = true;
      }

      try {
        if (typeof window !== "undefined" && typeof window.viparTrack === "function") {
          window.viparTrack("form_submit", {
            cta_location: "contact_form",
          });
        }

        if (typeof window !== "undefined" && typeof window.viparTrack === "function") {
          window.viparTrack("whatsapp_click", {
            cta_location: "contact_form",
            whatsapp_message_type: "prefilled",
          });
        }

        const whatsappUrl = buildWhatsappUrl({
          name,
          phone,
          email: emailValue,
          subject,
          details,
        });

        if (typeof window !== "undefined") {
          window.open(whatsappUrl, "_blank", "noopener,noreferrer");
        }

        setStatus("success", "Abrimos WhatsApp con tu mensaje listo para enviar.");
      } catch {
        setStatus("error", "Error de red. Probá nuevamente o escribinos por WhatsApp.");
      } finally {
        if (submitButton instanceof HTMLButtonElement) {
          submitButton.disabled = false;
        }
      }
    });
  </script>
</Layout>
