---
import ContactoFormPanel from "@components/contacto/ContactoFormPanel.astro";
import ContactoHero from "@components/contacto/ContactoHero.astro";
import ContactoInfoPanel from "@components/contacto/ContactoInfoPanel.astro";
import ContactoMap from "@components/contacto/ContactoMap.astro";
import ContactoMediaPanel from "@components/contacto/ContactoMediaPanel.astro";
import ContactoSocialPanel from "@components/contacto/ContactoSocialPanel.astro";
import Container from "@components/ui/Container.astro";
import Layout from "@layouts/Layout.astro";
import "../styles/contacto.css";
import { SITE_URL, SOCIAL_LINKS, address, email, telephone } from "src/constants";

const title = "Contacto | VIPAR S.A.";
const description =
  "Contacto técnico y comercial de VIPAR S.A. en Ñemby, Paraguay. Consultas, cotizaciones y coordinación de proyectos en cristales, aluminio y terminaciones.";
const canonical = `${SITE_URL}/contacto/`;
const whatsappNumber = telephone.replace(/[^\d]/g, "");
const whatsappMessage =
  "Hola, quiero solicitar un presupuesto. Me comunico desde la página de contacto.";
const googleMapsUrl = "https://maps.app.goo.gl/frEBGayuutx7q1hj6";

type ContactSocialItem = {
  label: string;
  href: string;
  network: "whatsapp" | "instagram" | "tiktok";
  target?: string;
  rel?: string;
};

const socialItems: ContactSocialItem[] = [
  {
    label: "WhatsApp",
    href: `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`,
    network: "whatsapp",
    target: "_blank",
    rel: "noopener noreferrer",
  },
  {
    label: "Instagram",
    href: SOCIAL_LINKS.instagram,
    network: "instagram",
    target: "_blank",
    rel: "noopener noreferrer",
  },
  {
    label: "TikTok",
    href: SOCIAL_LINKS.tiktok,
    network: "tiktok",
    target: "_blank",
    rel: "noopener noreferrer",
  },
];
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  bodyClass="vipar-contact-body"
  hideWhatsappFAB={true}
  hideConsentBanner={true}
  pageType="contact"
>
  <div class="contact-page">
    <main class="contact-main">
      <ContactoHero />

      <Container class="contact-container contact-grid">
        <div class="contact-stack">
          <ContactoInfoPanel address={address} email={email} telephone={telephone} />
          <ContactoMediaPanel />
          <ContactoSocialPanel items={socialItems} />
        </div>

        <ContactoFormPanel />
      </Container>

      <ContactoMap googleMapsUrl={googleMapsUrl} />
    </main>
  </div>
</Layout>
