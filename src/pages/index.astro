---
import Layout from "@layouts/Layout.astro";
import { SITE_URL, address, email, telephone } from "src/constants";
import "@styles/home.css";

const title = "Cristales templados, cielo raso y box de baño | VIPAR Paraguay";
const description = "VIPAR Paraguay instala cristales templados, mamparas divisorias, box de baño, cielo raso y carpintería de aluminio para hogares, oficinas y comercios. Cotizá por WhatsApp o contacto comercial.";
const keywords = "cristales templados Paraguay, box de baño, mamparas divisorias, cielo raso, carpintería de aluminio, vidrios templados, VIPAR Paraguay";
const whatsappNumber = telephone.replace(/[^\d]/g, "");
const whatsappMessage = "Hola, quiero solicitar un presupuesto. Me comunico desde la web.";
const homePath = `${SITE_URL}/`;
const contactPath = `${SITE_URL}/contacto/`;
const obrasPath = `${SITE_URL}/obras/`;
const serviceLinks = {
  residencial: "/servicios/box-de-bano/?utm_source=home&utm_medium=card&utm_campaign=redesign_home",
  comercial: "/servicios/cielo-raso/?utm_source=home&utm_medium=card&utm_campaign=redesign_home",
  corporativo: "/servicios/mampara-divisoria/?utm_source=home&utm_medium=card&utm_campaign=redesign_home",
};
const faqItems = [
  {
    question: "¿Qué servicios de VIPAR se pueden cotizar desde la web?",
    answer:
      "Desde la web podés solicitar presupuesto para cristales templados, box de baño, mamparas divisorias, cielo raso y carpintería de aluminio.",
  },
  {
    question: "¿VIPAR trabaja proyectos residenciales, comerciales y corporativos?",
    answer:
      "Sí. VIPAR ejecuta soluciones para viviendas, oficinas, comercios y proyectos corporativos con asesoría técnica e instalación profesional en Paraguay.",
  },
  {
    question: "¿Cómo conviene pedir presupuesto: WhatsApp o formulario?",
    answer:
      "Si necesitás respuesta rápida, WhatsApp es la vía más directa. Si querés dejar datos más completos, también podés ir a la página de contacto y enviar tu consulta comercial.",
  },
  {
    question: "¿Dónde está ubicada VIPAR y cómo se coordina la visita?",
    answer:
      `VIPAR está en ${address}. Podés escribir a ${email} o llamar al ${telephone} para coordinar asesoría y visita técnica.`,
  },
];
const homeStructuredData = JSON.stringify([
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: title,
    description,
    url: homePath,
    inLanguage: 'es-PY',
    primaryImageOfPage:
      'https://lh3.googleusercontent.com/aida-public/AB6AXuD_IYWL4DSO_hDUJ1n6AL5clQU7lWnPQ9lXLpd9eDKDmklcaVW90aLx-OioX-Xq5vRAPbsJh7JT3ViE0-xntBi0xE3kL3_yNWJq9Y9Z9_MdcpJPluUl4B-zjki9HFB5TlXoyVsRqpw6Ms85rpE6IxS0V4Bzsl3WQQ33vDH1Pmk-A6o0aFUtSzzWE1P0PX9fm4u5CLy3XrIOGemJktsR-NB7za5w4UdWygax9FJVuQmh659as1rqiVXcap_MHkblPedbBPBdt_ufLvKJ',
    about: [
      'Cristales templados',
      'Box de baño',
      'Mamparas divisorias',
      'Cielo raso',
      'Carpintería de aluminio',
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Servicios destacados en home VIPAR',
    itemListElement: [
      {
        '@type': 'ListItem',
        position: 1,
        name: 'Box de baño',
        url: `${SITE_URL}/servicios/box-de-bano/`,
      },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Cielo raso',
        url: `${SITE_URL}/servicios/cielo-raso/`,
      },
      {
        '@type': 'ListItem',
        position: 3,
        name: 'Mamparas divisorias',
        url: `${SITE_URL}/servicios/mampara-divisoria/`,
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqItems.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  },
]);
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  canonical={homePath}
  bodyClass="vipar-home-body"
  hideHeader={true}
  hideFooter={true}
  hideWhatsappFAB={true}
  hideConsentBanner={false}
>
  <div class="vipar-home">
    <header class="vipar-topbar">
      <nav class="vipar-topbar__nav vipar-shell" aria-label="Navegación principal de VIPAR">
        <a href="/" class="vipar-topbar__brand">VIPAR S.A.</a>
        <div class="vipar-topbar__links" aria-hidden="false">
          <a href="/" class="is-active">Inicio</a>
          <a href="/servicios/">Servicios</a>
          <a href="/obras/">Proyectos</a>
          <a href="/nosotros/">Nosotros</a>
          <a href="/contacto/">Contacto</a>
        </div>
        <a
          href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`}
          target="_blank"
          rel="noopener noreferrer"
          class="vipar-topbar__cta"
          data-track-event="whatsapp_click"
          data-track-label="Solicitar presupuesto"
          data-track-location="header"
          aria-label="Solicitar presupuesto por WhatsApp"
        >
          Solicitar presupuesto
        </a>
      </nav>
    </header>

    <main class="vipar-home__main">
      <section class="vipar-hero">
        <img
          class="vipar-hero__bg"
          src="https://lh3.googleusercontent.com/aida-public/AB6AXuD_IYWL4DSO_hDUJ1n6AL5clQU7lWnPQ9lXLpd9eDKDmklcaVW90aLx-OioX-Xq5vRAPbsJh7JT3ViE0-xntBi0xE3kL3_yNWJq9Y9Z9_MdcpJPluUl4B-zjki9HFB5TlXoyVsRqpw6Ms85rpE6IxS0V4Bzsl3WQQ33vDH1Pmk-A6o0aFUtSzzWE1P0PX9fm4u5CLy3XrIOGemJktsR-NB7za5w4UdWygax9FJVuQmh659as1rqiVXcap_MHkblPedbBPBdt_ufLvKJ"
          alt="Modern architectural building with sleek glass facade and steel structures under a clear blue sky"
          loading="eager"
          fetchpriority="high"
        />
        <div class="vipar-hero__overlay"></div>
        <div class="vipar-shell vipar-hero__content">
          <div class="vipar-hero__copy">
            <span class="vipar-eyebrow">Soluciones de Ingeniería Aplicada</span>
            <h1>
              Arquitectura de <span>alto rendimiento.</span>
            </h1>
            <p>
              Especialistas en la ejecución técnica de infraestructuras
              residenciales, comerciales y corporativas con precisión milimétrica.
            </p>
            <div class="vipar-hero__actions">
              <a href="/obras/" class="vipar-button vipar-button--light" data-track-event="cta_click" data-track-label="Explorar Proyectos" data-track-location="hero" data-track-destination={obrasPath}>Explorar Proyectos</a>
              <a href="/servicios/" class="vipar-button vipar-button--ghost" data-track-event="cta_click" data-track-label="Nuestros Servicios" data-track-location="hero" data-track-destination={`${SITE_URL}/servicios/`}>Nuestros Servicios</a>
            </div>
            <div class="vipar-hero__contact-meta">
              <a href={`tel:${whatsappNumber}`} data-track-event="phone_click" data-track-label="Telefono hero" data-track-location="hero">{telephone}</a>
              <span></span>
              <a href="/contacto/" data-track-event="cta_click" data-track-label="Contacto comercial" data-track-location="hero" data-track-destination={contactPath}>Contacto comercial</a>
            </div>
          </div>
        </div>
      </section>

      <section class="vipar-intro vipar-section">
        <div class="vipar-shell vipar-intro__grid">
          <div class="vipar-intro__copy">
            <h2>Expertos en transformar visiones estructurales en realidades tangibles.</h2>
            <p>
              En VIPAR S.A. no solo construimos; orquestamos soluciones de ingeniería
              que responden a las demandas específicas de cada entorno. Nuestra
              metodología integra el diseño funcional con la eficiencia técnica para
              garantizar resultados que trascienden lo convencional.
            </p>
            <div class="vipar-intro__stats">
              <div class="vipar-mono-stat">
                <span class="vipar-mono-stat__value">15+</span>
                <span class="vipar-mono-stat__label">Años de experiencia</span>
              </div>
              <div class="vipar-mono-stat">
                <span class="vipar-mono-stat__value">450+</span>
                <span class="vipar-mono-stat__label">Proyectos ejecutados</span>
              </div>
            </div>
          </div>
          <div class="vipar-intro__media">
            <div class="vipar-media-frame">
              <img
                src="https://lh3.googleusercontent.com/aida-public/AB6AXuAi3rhLaAsi3dmFdJfG5CmwbkGd-fIdkKbYnw6cnF_LGbZlnWVmJy4WE-HNRZDrPOCExs7Gmg0lmBPt_AdMoQVYuvQLYpePGzUicbOSQKB8xK2n7YXBWeHkxz3RboRGiZTm1iF17NKx-TcfhlpEG0EBLgc7q5NwuA5mOzlA7IGMixsARLmtfL9R-SaS8aRVZPogaTAdastyLuiWWr2I4Qi16Zme1swOCQtjQDrpR4P_CvG82hFqPdecCJmMLQv6EekkQkZNc5EkIBBX"
                alt="Interior of a modern high-end minimalist office space with concrete finishes and designer lighting"
                loading="lazy"
                decoding="async"
              />
            </div>
          </div>
        </div>
      </section>

      <section class="vipar-sector vipar-section vipar-section--muted" id="sectores-home">
        <div class="vipar-shell">
          <div class="vipar-section-heading">
            <h2>Soluciones por Entorno</h2>
            <p>Especialización técnica adaptada a los requerimientos de cada sector.</p>
          </div>

          <div class="vipar-sector__grid">
            <article class="vipar-sector-card">
              <img
                src="https://lh3.googleusercontent.com/aida-public/AB6AXuC6JXRCAaP9gCv7APOQsIvz7SY4r6ErStjwkvnaWQKsdFL_7kOa-Zv87P6ekcLRHFyyk52myWq5g6jPdJe9PQlzng9sB9e286qN08AYc9LOA3bCS2z7bjnry0PjQ7XAI45QgzUfTrr99q9TBw8JJJkxreubOcrLOrSDUGBouMr91ZI8l29YZc1gTPHHge1QVtiLBsR1fNjRv-8fROSDb3hGIE1mC6GuRJTVGP6K8PuHanJt3P6mjm3gwg6ITVwmwLUAjRhoSi8I3QVn"
                alt="Luxury modern residential house at dusk"
                class="vipar-sector-card__image"
                loading="lazy"
                decoding="async"
              />
              <div class="vipar-sector-card__shade"></div>
              <div class="vipar-sector-card__body">
                <h3>Residencial</h3>
                <p>Ejecución de viviendas de alta gama donde el detalle y el confort son la prioridad estructural.</p>
                <ul>
                  <li>Domótica Integrada</li>
                  <li>Eficiencia Energética</li>
                  <li>Acabados de Lujo</li>
                </ul>
                <a href={serviceLinks.residencial} class="vipar-sector-card__button" data-track-event="service_navigation" data-track-label="Residencial" data-track-location="service_card" data-track-service="box-de-bano">Ver Soluciones</a>
              </div>
            </article>

            <article class="vipar-sector-card">
              <img
                src="https://lh3.googleusercontent.com/aida-public/AB6AXuCKP0isqGEyF72o13yvNbtYaA8BskwcBePGllcpFlYvtXL36aMshGpz2dWSFPzkgOzo7nqpj2DZ5X-Xu6Th_xfBa-jJNVagIl52a3Iv8JSOySB0cYb8KX4m0j8nFSQOYs68j0hxxpuTYnmARHVyPHs3cswdY4Pm5L4pvxW2HBglXcRddFJKw5HmtXrKvTyzO_1xRMowhIlataGCxtfgmRQydsnC0sZKrNJYbJFXf6jUetDDvMz8TdeH_dfXYup7En30Cdd_eoy7LjY5"
                alt="Wide shot of a modern retail space"
                class="vipar-sector-card__image"
                loading="lazy"
                decoding="async"
              />
              <div class="vipar-sector-card__shade"></div>
              <div class="vipar-sector-card__body">
                <h3>Comercial</h3>
                <p>Infraestructuras diseñadas para el flujo masivo, la durabilidad y la identidad de marca.</p>
                <ul>
                  <li>Locales de Retail</li>
                  <li>Centros Comerciales</li>
                  <li>Mantenimiento Preventivo</li>
                </ul>
                <a href={serviceLinks.comercial} class="vipar-sector-card__button" data-track-event="service_navigation" data-track-label="Comercial" data-track-location="service_card" data-track-service="cielo-raso">Ver Soluciones</a>
              </div>
            </article>

            <article class="vipar-sector-card">
              <img
                src="https://lh3.googleusercontent.com/aida-public/AB6AXuA3YtH0XLhc1vWFWkeJw-g5VrGF2gAOps9OTyuxRwaHsSQjMRrtOMIHKOfw9aLQw5Xz7xVC3qiqPd-ABlH6C1AhyTTgZVS5KgtGlujMjqfYOxiAu5dX0b7gnobDmUX2PsFaYrM8l5ykgyvALJpKpTMTEHvTz2IMNuUc-0aP8Lo5z4zUUCoZPBAYerja78rc5PRzdeL5tZQv-KFbsuT_MKH4YynNNMHVDz3M4G834PBdioIg_eK-jdRy2O5Qf5dmEZ-eQsKBtOfZn1G-"
                alt="Skyscraper glass facade reflecting the sky"
                class="vipar-sector-card__image"
                loading="lazy"
                decoding="async"
              />
              <div class="vipar-sector-card__shade"></div>
              <div class="vipar-sector-card__body">
                <h3>Corporativo</h3>
                <p>Espacios de trabajo inteligentes que optimizan la productividad y reflejan solidez empresarial.</p>
                <ul>
                  <li>Oficinas Inteligentes</li>
                  <li>Auditorios y Sedes</li>
                  <li>Certificaciones LEED</li>
                </ul>
                <a href={serviceLinks.corporativo} class="vipar-sector-card__button" data-track-event="service_navigation" data-track-label="Corporativo" data-track-location="service_card" data-track-service="mampara-divisoria">Ver Soluciones</a>
              </div>
            </article>
          </div>
        </div>
      </section>

      <section class="vipar-method vipar-section">
        <div class="vipar-shell vipar-method__grid">
          <div class="vipar-method__copy">
            <h2>Nuestra Metodología de Precisión</h2>
            <div class="vipar-steps">
              <article class="vipar-step">
                <div class="vipar-step__number">01</div>
                <div>
                  <h4>Diagnóstico Técnico</h4>
                  <p>Análisis profundo de los requerimientos estructurales y viabilidad del entorno.</p>
                </div>
              </article>
              <article class="vipar-step">
                <div class="vipar-step__number">02</div>
                <div>
                  <h4>Ingeniería de Valor</h4>
                  <p>Optimización de materiales y procesos para maximizar la calidad sin exceder presupuestos.</p>
                </div>
              </article>
              <article class="vipar-step">
                <div class="vipar-step__number">03</div>
                <div>
                  <h4>Ejecución Controlada</h4>
                  <p>Supervisión en tiempo real y protocolos de seguridad de estándar internacional.</p>
                </div>
              </article>
            </div>
          </div>
          <div class="vipar-method__media">
            <div class="vipar-method__image-frame">
              <img
                src="https://lh3.googleusercontent.com/aida-public/AB6AXuDmMgGe3CMg5zfcb0-Hldz_kwJ_ltkNz61arACacw4Ev0O-qDJzjpRAJWEylsJ8cPA76b2Gj1wO0BehXgjPIuWTBpYfH9Lw-XiOe2bVzXkIKt96B4WmrWEEqfIwvhHLqmps54fCLQmq9lNYyqxWjk-MVegwvmL97ItnhF0EjLG7JzOiI4NO81CV4YKQx40duIlNErJvuTLmYQswzbSjGO2nVTOJooHxX5tj_rwT3qtN30bKYUI7jFBaRLGvd3kBGlSUPLm7PRKcwv6z"
                alt="Blueprint on a construction site with professional tools and helmet"
                loading="lazy"
                decoding="async"
              />
            </div>
            <aside class="vipar-method__quote">
              <p>"La precisión no es un objetivo, es nuestro punto de partida en cada m²."</p>
              <div>
                <span></span>
                <strong>Garantía VIPAR</strong>
              </div>
            </aside>
          </div>
        </div>
      </section>

      <section class="vipar-proof vipar-section vipar-section--soft">
        <div class="vipar-shell">
          <div class="vipar-proof__panel">
            <div class="vipar-proof__grid">
              <div class="vipar-proof__intro">
                <h3>Experiencia Aplicada</h3>
                <p>Nuestras cifras respaldan el compromiso con la excelencia técnica.</p>
              </div>
              <div class="vipar-proof__stat">
                <span>98%</span>
                <small>Cumplimiento de plazos</small>
              </div>
              <div class="vipar-proof__stat">
                <span>0</span>
                <small>Accidentes laborales</small>
              </div>
              <div class="vipar-proof__stat">
                <span>+20</span>
                <small>Sectores atendidos</small>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section class="vipar-faq vipar-section" id="faq-home" aria-label="Preguntas frecuentes">
        <div class="vipar-shell">
          <div class="vipar-section-heading vipar-section-heading--left">
            <h2>Preguntas frecuentes</h2>
          </div>
          <div class="vipar-faq__list">
            {faqItems.map((item, index) => (
              <details class="vipar-faq__item" data-faq-index={index}>
                <summary>{item.question}</summary>
                <p>{item.answer}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section class="vipar-final-cta">
        <div class="vipar-final-cta__bg">
          <img
            src="https://lh3.googleusercontent.com/aida-public/AB6AXuAjmpuZI0UHuhv8TpUkFrRCQvIsDfHBWWyhHshyTm3_rtYeeanmO6tgbVCwQ4TtgocdYRL-v57mMJzUwNmonj-l3r2fgdasz06wQlAZe7VVQDk6iDJCiBDuJshWCwYQAuBLQ2v7ZS9gdYtwl1io_sVCpMyP1ZJgoxYkbHeBYMlkOEKwIjEE76rTUuBvw4aPaQH04OzR4KOQhWqpO2HrPlGGj3YBX6XxCwf_zRtAA3TKQgsQ4avoXzOjUlKIWAmG6x0yJ2ny4hyMKsPX"
            alt="Professional construction site overview with cranes and structural framework"
            loading="lazy"
            decoding="async"
          />
        </div>
        <div class="vipar-shell vipar-final-cta__content">
          <h2>¿Listo para elevar el estándar de su próximo proyecto?</h2>
          <p>
            Contacte con nuestro equipo técnico para una consultoría preliminar y descubra cómo
            VIPAR S.A. aporta valor desde el primer trazo.
          </p>
          <div class="vipar-final-cta__actions">
            <a
              href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`}
              target="_blank"
              rel="noopener noreferrer"
              class="vipar-button vipar-button--light vipar-button--strong"
              data-track-event="whatsapp_click"
              data-track-label="Solicitar Cotizacion"
              data-track-location="final_cta"
            >
              Solicitar Cotización
            </a>
            <a href="/obras/?utm_source=home&utm_medium=cta&utm_campaign=redesign_home" class="vipar-button vipar-button--outline vipar-button--strong" data-track-event="cta_click" data-track-label="Descargar Portfolio" data-track-location="final_cta" data-track-destination={obrasPath}>Descargar Portfolio</a>
          </div>
        </div>
      </section>
    </main>

    <footer class="vipar-footer">
      <div class="vipar-shell vipar-footer__grid">
        <div class="vipar-footer__brand-block">
          <div class="vipar-footer__brand">VIPAR S.A.</div>
          <p>
            Referente en soluciones de ingeniería y arquitectura técnica con un enfoque en la precisión estructural y la innovación aplicada.
          </p>
          <div class="vipar-footer__socials">
            <a href="https://www.facebook.com/vipar.vidrios" target="_blank" rel="noopener noreferrer" aria-label="Facebook VIPAR" data-track-event="social_click" data-track-label="Facebook" data-track-location="footer"><span class="material-symbols-outlined">share</span></a>
            <a href={`mailto:${email}`} aria-label="Enviar correo" data-track-event="email_click" data-track-label="Email footer" data-track-location="footer"><span class="material-symbols-outlined">mail</span></a>
          </div>
        </div>

        <div>
          <h4>Enlaces</h4>
          <ul>
            <li><a href="/">Inicio</a></li>
            <li><a href="/servicios/" class="is-active">Servicios</a></li>
            <li><a href="/obras/">Proyectos</a></li>
            <li><a href="/nosotros/">Nosotros</a></li>
          </ul>
        </div>

        <div>
          <h4>Legal</h4>
          <ul>
            <li><a href="#">Aviso Legal</a></li>
            <li><a href="#">Privacidad</a></li>
            <li><a href="#">Cookies</a></li>
          </ul>
        </div>

        <div>
          <h4>Oficina Central</h4>
          <p>
            {address}
          </p>
          <p>
            T: <a href={`tel:${whatsappNumber}`} data-track-event="phone_click" data-track-label="Telefono footer" data-track-location="footer">{telephone}</a><br />
            E: <a href={`mailto:${email}`} data-track-event="email_click" data-track-label="Email footer" data-track-location="footer">{email}</a>
          </p>
        </div>
      </div>

      <div class="vipar-shell vipar-footer__bottom">
        <p>© 2024 VIPAR S.A. Architectural Precision.</p>
      </div>
    </footer>

    <div class="vipar-mobile-bar" aria-label="Acciones rápidas">
      <a href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`} target="_blank" rel="noopener noreferrer" data-track-event="whatsapp_click" data-track-label="WhatsApp sticky mobile" data-track-location="sticky_mobile">WhatsApp</a>
      <a href="/contacto/?utm_source=home&utm_medium=sticky&utm_campaign=redesign_home" data-track-event="cta_click" data-track-label="Contacto rapido" data-track-location="sticky_mobile" data-track-destination={contactPath}>Contacto rápido</a>
    </div>

    <script type="application/ld+json" set:html={homeStructuredData}></script>
    <script is:inline>
      function viparTrack(eventName, params) {
        if (typeof window !== 'undefined' && window.gtag) {
          window.gtag('event', eventName, params || {});
        }
      }

      document.querySelectorAll('[data-track-event]').forEach((element) => {
        element.addEventListener('click', () => {
          const eventName = element.getAttribute('data-track-event') || 'cta_click';
          viparTrack(eventName, {
            event_category: 'engagement',
            event_label: element.getAttribute('data-track-label') || '',
            cta_location: element.getAttribute('data-track-location') || '',
            destination: element.getAttribute('data-track-destination') || element.getAttribute('href') || '',
            service: element.getAttribute('data-track-service') || '',
            page_location: window.location.href,
          });
        });
      });

      document.querySelectorAll('[data-faq-index]').forEach((item) => {
        item.addEventListener('toggle', () => {
          if (item.open) {
            viparTrack('faq_open', {
              event_category: 'engagement',
              faq_index: item.getAttribute('data-faq-index') || '',
              page_location: window.location.href,
            });
          }
        });
      });
    </script>
  </div>
</Layout>
