---
import type { ImageMetadata } from "astro";
import HomeAbout from "@components/home/HomeAbout.astro";
import HomeContact from "@components/home/HomeContact.astro";
import HomeHero from "@components/home/HomeHero.astro";
import HomeProjects from "@components/home/HomeProjects.astro";
import HomeServices from "@components/home/HomeServices.astro";
import HomeSpecialties from "@components/home/HomeSpecialties.astro";
import Layout from "@layouts/Layout.astro";
import heroImage from "../assets/image/hero-nosotros.png";
import residentialImage from "../assets/image/home-residencial-entorno.png";
import commercialImage from "../assets/image/home-comercial-entorno.png";
import corporateImage from "../assets/image/home-corporativo-entorno.png";
import { SITE_URL, address, email, telephone } from "src/constants";
import { staticObras } from "@lib/static-obras";
import "@styles/home.css";

const title = "VIPAR S.A. | Cristales y Aluminio";
const description =
  "Cristales templados, aluminio y terminaciones para obras en Paraguay. Soluciones para viviendas, comercios, oficinas y obras con presupuesto según medidas y tipo de instalación.";
const keywords =
  "VIPAR S.A., cristales templados Paraguay, carpintería de aluminio, fachadas integrales, mamparas, cielos rasos, box de baño";
const homePath = `${SITE_URL}/`;
const whatsappNumber = telephone.replace(/[^\d]/g, "");
const whatsappMessage =
  "Hola, quiero solicitar un presupuesto para una obra. Me contacto desde la home.";

const serviceLinks = {
  cristalesTemplados: "/servicios/",
  carpinteriaAluminio: "/servicios/carpinteria-de-aluminio/",
  fachada: "/servicios/fachadas/",
  mamparaDivisoria: "/servicios/mamparas-divisorias/",
  cieloRaso: "/servicios/cielo-raso/",
  boxDeBano: "/servicios/box-de-bano/",
  ventana: "/servicios/ventanas/",
  puerta: "/servicios/puertas/",
  cortina: "/servicios/cortinas/",
} as const;

const featuredServices = [
  {
    title: "Cielo raso",
    description:
      "Landing prioritaria para consultas de cielo raso de yeso, PVC, Durlock y desmontable, con foco comercial en tipo de sistema, precio y mantenimiento.",
    image: residentialImage,
    alt: "Cielo raso para viviendas, comercios y oficinas",
    points: [
      "Opciones en yeso, PVC, Durlock y desmontable",
      "Presupuesto segun medidas, uso y alcance",
      "CTA directo a cotizacion por WhatsApp",
    ],
    href: serviceLinks.cieloRaso,
  },
  {
    title: "Box de bano",
    description:
      "Landing enfocada en precio, materiales, medidas y tiempos para usuarios que comparan soluciones de box de ducha y quieren una respuesta rapida.",
    image: commercialImage,
    alt: "Box de bano a medida en Paraguay",
    points: [
      "Comparativa entre acrilico, cristal y plegables",
      "Bloque visible para tomar decision comercial",
      "Paso inmediato a WhatsApp con contexto",
    ],
    href: serviceLinks.boxDeBano,
  },
  {
    title: "Mamparas divisorias",
    description:
      "Landing reforzada para oficinas, espacios corporativos y proyectos comerciales que necesitan dividir ambientes con mejor funcion e imagen.",
    image: corporateImage,
    alt: "Mamparas divisorias para oficinas y comercios",
    points: [
      "Copy orientado a oficinas, salas y areas operativas",
      "Comparacion entre cristal, Eucatex y Durlock",
      "Captacion B2B desde una landing comercial",
    ],
    href: serviceLinks.mamparaDivisoria,
  },
] satisfies Array<{
  title: string;
  description: string;
  image: ImageMetadata;
  alt: string;
  points: string[];
  href: string;
}>;

const complementaryServices = [
  {
    iconClass: "bi-columns-gap",
    title: "Cristales Templados",
    description: "Puertas, fachadas, divisiones, cerramientos y box de baño en cristal templado.",
    href: serviceLinks.cristalesTemplados,
  },
  {
    iconClass: "bi-door-closed",
    title: "Carpintería de Aluminio",
    description: "Puertas, ventanas, aberturas y cerramientos según medidas y tipo de apertura.",
    href: serviceLinks.carpinteriaAluminio,
  },
  {
    iconClass: "bi-building",
    title: "Fachadas Integrales",
    description: "Entubado, muro cortina y sistema glazing para locales, oficinas y edificios.",
    href: serviceLinks.fachada,
  },
  {
    iconClass: "bi-grid-1x2",
    title: "Mamparas",
    description: "Divisiones para oficinas y espacios comerciales.",
    href: serviceLinks.mamparaDivisoria,
  },
  {
    iconClass: "bi-grid-3x3-gap",
    title: "Cielo Raso",
    description: "Instalación de cielos rasos en PVC, Durlock y modulares.",
    href: serviceLinks.cieloRaso,
  },
  {
    iconClass: "bi-droplet-half",
    title: "Box de Baño",
    description: "Mamparas de ducha a medida con herrajes inoxidables.",
    href: serviceLinks.boxDeBano,
  },
];

const FEATURED_OBRA_SLUGS = ["sucursal-tigo-mra", "pedro-juan-caballero", "edificio-concordia"];
const projects = FEATURED_OBRA_SLUGS
  .map((slug) => staticObras.find((obra) => obra.slug === slug))
  .filter((obra): obra is NonNullable<typeof obra> => obra != null)
  .map((obra, i) => ({
  layout: i === 0 ? "hero" : "side",
  eyebrow: obra.sectorLabel,
  title: obra.titulo,
  description: obra.systemLabel,
  image: obra.imagen,
  alt: `${obra.titulo} – ${obra.ubicacion} | VIPAR`,
  href: `/obras/${obra.slug}/`,
}));

const keyData = [
  {
    iconClass: "bi-geo-alt",
    title: "Ubicación principal",
    description: address,
  },
  {
    iconClass: "bi-map",
    title: "Área de cobertura",
    description:
      "Asunción, Gran Asunción e interior del país (sujeto a envergadura del proyecto).",
  },
  {
    iconClass: "bi-building-check",
    title: "Tipos de obra",
    description:
      "Viviendas, oficinas, locales comerciales, edificios e instituciones.",
  },
];

const homeStructuredData = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: title,
    description,
    url: homePath,
    inLanguage: "es-PY",
    primaryImageOfPage: `${SITE_URL}/img/home/hero-home.webp`,
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Servicios destacados VIPAR",
    itemListElement: featuredServices.map((service, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: service.title,
    })),
  },
]);
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  canonical={homePath}
  bodyClass="vipar-home-body"
  pageType="home"
  loadAosAssets={false}
  loadLightboxAssets={false}
  loadSwiperAssets={false}
  loadIsotopeAssets={false}
  loadBootstrapJs={false}
  loadBootstrapIcons={false}
  useMaterialSymbols={false}
>
  <div class="vipar-home" id="top">
    <main class="vipar-home__main">
      <HomeHero
        whatsappNumber={whatsappNumber}
        whatsappMessage={whatsappMessage}
        image={heroImage}
      />
      <HomeSpecialties serviceLinks={serviceLinks} />
      <HomeServices
        featuredServices={featuredServices}
        complementaryServices={complementaryServices}
        viewAllHref="/servicios/"
      />
      <HomeProjects projects={projects} />
      <HomeAbout keyData={keyData} />
      <HomeContact
        whatsappNumber={whatsappNumber}
        whatsappMessage={whatsappMessage}
        telephone={telephone}
        email={email}
      />
    </main>
  </div>

  <script type="application/ld+json" set:html={homeStructuredData}></script>
</Layout>
