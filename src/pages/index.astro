---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  canonical={homePath}
  bodyClass="vipar-home-body"
  pageType="home"
>
  <div class="vipar-home" id="top">
    <main class="vipar-home__main">
      <HomeHero whatsappNumber={whatsappNumber} whatsappMessage={whatsappMessage} />
      <HomeSpecialties serviceLinks={serviceLinks} />
      <HomeServices
        featuredServices={featuredServices}
        complementaryServices={complementaryServices}
      />
      <HomeProjects projects={projects} />
      <HomeAbout keyData={keyData} />
      <HomeContact
        whatsappNumber={whatsappNumber}
        whatsappMessage={whatsappMessage}
        telephone={telephone}
        email={email}
      />
    </main>
  </div>

  <script type="application/ld+json" set:html={homeStructuredData}></script>

  <script is:inline>
    const form = document.getElementById("vipar-home-form");
    const status = document.getElementById("vipar-home-form-status");
    const message = document.getElementById("vipar-home-form-message");
    let hasTrackedFormStart = false;

    function setStatus(kind, text) {
      if (!(status instanceof HTMLElement) || !(message instanceof HTMLElement)) return;
      status.hidden = false;
      status.dataset.state = kind;
      message.textContent = text;
    }

    function clearStatus() {
      if (!(status instanceof HTMLElement) || !(message instanceof HTMLElement)) return;
      status.hidden = true;
      delete status.dataset.state;
      message.textContent = "";
    }

    if (form instanceof HTMLFormElement) {
      const startedAtInput = form.querySelector('input[name="form_started_at"]');
      if (startedAtInput instanceof HTMLInputElement && !startedAtInput.value) {
        startedAtInput.value = String(Date.now());
      }
    }

    form?.addEventListener("input", () => {
      if (hasTrackedFormStart) return;
      hasTrackedFormStart = true;
      if (typeof window !== "undefined" && typeof window.viparTrack === "function") {
        window.viparTrack("form_start", {
          cta_location: "home_contact_form",
        });
      }
    });

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();

      const formElement = event.currentTarget;
      if (!(formElement instanceof HTMLFormElement)) return;

      clearStatus();

      const formData = new FormData(formElement);
      const name = String(formData.get("name") || "").trim();
      const phone = String(formData.get("phone") || "").trim();
      const emailValue = String(formData.get("email") || "").trim();
      const service = String(formData.get("service") || "").trim();
      const city = String(formData.get("city") || "").trim();
      const details = String(formData.get("message") || "").trim();
      const website = String(formData.get("website") || "").trim();
      const formStartedAt = String(formData.get("form_started_at") || "").trim();

      if (!name || !phone || !service || !details) {
        setStatus("error", "Completa nombre, WhatsApp, servicio y detalle de la solicitud.");
        return;
      }

      const composedMessage = [
        `Tipo de servicio: ${service}`,
        city ? `Ubicacion de la obra: ${city}` : "",
        "",
        details,
      ]
        .filter(Boolean)
        .join("\n");

      const payload = new FormData();
      payload.set("name", name);
      payload.set("phone", phone);
      payload.set("email", emailValue);
      payload.set("city", city);
      payload.set("message", composedMessage);
      payload.set("source", String(formData.get("source") || "vipar-home-stitch"));
      payload.set("page", typeof window !== "undefined" ? window.location.href : "");

      const leadContext =
        typeof window !== "undefined" && typeof window.viparLeadContext === "function"
          ? window.viparLeadContext({
              cta_location: "home_contact_form",
              service_name: service,
            })
          : {
              cta_location: "home_contact_form",
              service_name: service,
            };

      payload.set("website", website);
      payload.set("form_started_at", formStartedAt);
      payload.set("page_path", String(leadContext.page_path || ""));
      payload.set("page_title", String(leadContext.page_title || ""));
      payload.set("page_type", String(leadContext.page_type || ""));
      payload.set("service_name", String(leadContext.service_name || ""));
      payload.set("cta_location", String(leadContext.cta_location || "home_contact_form"));
      payload.set("lead_source", String(leadContext.lead_source || ""));
      payload.set("lead_medium", String(leadContext.lead_medium || ""));
      payload.set("campaign", String(leadContext.campaign || ""));
      payload.set("device_type", String(leadContext.device_type || ""));

      const attachment = formData.get("file");
      if (attachment instanceof File && attachment.size > 0) {
        payload.set("file", attachment);
        if (typeof window !== "undefined" && typeof window.viparTrack === "function") {
          window.viparTrack("file_upload_attempt", {
            cta_location: "home_contact_form",
            service_name: service,
          });
        }
      }

      const submitButton = formElement.querySelector('button[type="submit"]');
      if (submitButton instanceof HTMLButtonElement) {
        submitButton.disabled = true;
      }

      try {
        if (typeof window !== "undefined" && typeof window.viparTrack === "function") {
          window.viparTrack("form_submit", {
            cta_location: "home_contact_form",
            service_name: service,
          });
        }

        const response = await fetch("/api/leads", {
          method: "POST",
          body: payload,
        });

        const data = await response.json().catch(() => null);

        if (!response.ok) {
          setStatus(
            "error",
            data?.error || "No se pudo enviar la solicitud. Proba nuevamente o escribinos por WhatsApp."
          );
          return;
        }

        if (typeof window !== "undefined" && typeof window.viparTrack === "function") {
          window.viparTrack("generate_lead", {
            method: "contact_form",
            cta_location: "home_contact_form",
            service_name: service,
          });
        }

        formElement.reset();
        const startedAtInput = formElement.querySelector('input[name="form_started_at"]');
        if (startedAtInput instanceof HTMLInputElement) {
          startedAtInput.value = String(Date.now());
        }
        setStatus("success", "Recibimos tu solicitud. Te responderemos a la brevedad.");
      } catch {
        setStatus("error", "Error de red. Proba nuevamente o escribinos por WhatsApp.");
      } finally {
        if (submitButton instanceof HTMLButtonElement) {
          submitButton.disabled = false;
        }
      }
    });
  </script>
</Layout>
