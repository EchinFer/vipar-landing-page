---
import HomeAbout from "@components/home/HomeAbout.astro";
import HomeContact from "@components/home/HomeContact.astro";
import HomeHero from "@components/home/HomeHero.astro";
import HomeProjects from "@components/home/HomeProjects.astro";
import HomeServices from "@components/home/HomeServices.astro";
import HomeSpecialties from "@components/home/HomeSpecialties.astro";
import Layout from "@layouts/Layout.astro";
import "@styles/tailwind.css";
import { SITE_URL, address, email, telephone } from "src/constants";
import { staticObras } from "@lib/static-obras";
import "@styles/home.css";

const title = "VIPAR S.A. | Cristales y Aluminio";
const description =
  "Cristales templados, aluminio y terminaciones para obras en Paraguay. Soluciones para viviendas, comercios, oficinas y obras con presupuesto según medidas y tipo de instalación.";
const keywords =
  "VIPAR S.A., cristales templados Paraguay, carpintería de aluminio, fachadas integrales, mamparas, cielos rasos, box de baño";
const homePath = `${SITE_URL}/`;
const whatsappNumber = telephone.replace(/[^\d]/g, "");
const whatsappMessage =
  "Hola, quiero solicitar un presupuesto para una obra. Me contacto desde la home.";

const serviceLinks = {
  cristalesTemplados: "/servicios/",
  carpinteriaAluminio: "/servicios/carpinteria-de-aluminio/",
  fachada: "/servicios/fachadas/",
  mamparaDivisoria: "/servicios/mamparas-divisorias/",
  cieloRaso: "/servicios/cielo-raso/",
  boxDeBano: "/servicios/box-de-bano/",
  ventana: "/servicios/ventanas/",
  puerta: "/servicios/puertas/",
  cortina: "/servicios/cortinas/",
} as const;

const featuredServices = [
  {
    title: "Residencial",
    description:
      "Soluciones para viviendas donde el detalle, la funcionalidad y la terminación visual son parte central del proyecto.",
    image: "/img/home/residencial-entorno.png",
    alt: "Soluciones residenciales VIPAR",
    points: [
      "Instalaciones según medidas y tipo de obra",
      "Terminaciones pensadas para uso diario",
      "Acabados de alta exigencia",
    ],
    href: "/servicios/",
  },
  {
    title: "Comercial",
    description:
      "Infraestructuras pensadas para alto tránsito, durabilidad operativa e identidad de marca en espacios comerciales.",
    image:
      "/img/home/comercial-entorno.png",
    alt: "Soluciones comerciales VIPAR",
    points: ["Locales de retail", "Centros comerciales", "Soluciones para espacios comerciales"],
    href: "/servicios/",
  },
  {
    title: "Corporativo",
    description:
      "Espacios de trabajo que buscan productividad, imagen institucional y soluciones técnicas alineadas al uso del edificio.",
    image:
      "/img/home/corporativo-entorno.png",
    alt: "Soluciones corporativas VIPAR",
    points: ["Oficinas y espacios corporativos", "Auditorios y sedes", "Requerimientos institucionales"],
    href: "/servicios/",
  },
];

const complementaryServices = [
  {
    icon: "splitscreen",
    title: "Cristales Templados",
    description: "Puertas, fachadas, divisiones, cerramientos y box de baño en cristal templado.",
    href: serviceLinks.cristalesTemplados,
  },
  {
    icon: "door_front",
    title: "Carpintería de Aluminio",
    description: "Puertas, ventanas, aberturas y cerramientos según medidas y tipo de apertura.",
    href: serviceLinks.carpinteriaAluminio,
  },
  {
    icon: "apartment",
    title: "Fachadas Integrales",
    description: "Entubado, muro cortina y sistema glazing para locales, oficinas y edificios.",
    href: serviceLinks.fachada,
  },
  {
    icon: "grid_view",
    title: "Mamparas",
    description: "Divisiones para oficinas y espacios comerciales.",
    href: serviceLinks.mamparaDivisoria,
  },
  {
    icon: "roofing",
    title: "Cielo Raso",
    description: "Instalación de cielos rasos en PVC, Durlock y modulares.",
    href: serviceLinks.cieloRaso,
  },
  {
    icon: "shower",
    title: "Box de Baño",
    description: "Mamparas de ducha a medida con herrajes inoxidables.",
    href: serviceLinks.boxDeBano,
  },
];

const FEATURED_OBRA_SLUGS = ["sucursal-tigo-mra", "pedro-juan-caballero", "edificio-concordia"];
const projects = FEATURED_OBRA_SLUGS
  .map((slug) => staticObras.find((obra) => obra.slug === slug))
  .filter((obra): obra is NonNullable<typeof obra> => obra != null)
  .map((obra, i) => ({
  layout: i === 0 ? "hero" : "side",
  eyebrow: obra.sectorLabel,
  title: obra.titulo,
  description: obra.systemLabel,
  image: obra.imagen,
  alt: `${obra.titulo} – ${obra.ubicacion} | VIPAR`,
  href: `/obras/${obra.slug}/`,
}));

const keyData = [
  {
    icon: "location_on",
    title: "Ubicación principal",
    description: address,
  },
  {
    icon: "map",
    title: "Área de cobertura",
    description:
      "Asunción, Gran Asunción e interior del país (sujeto a envergadura del proyecto).",
  },
  {
    icon: "domain",
    title: "Tipos de obra",
    description:
      "Viviendas, oficinas, locales comerciales, edificios e instituciones.",
  },
];

const homeStructuredData = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: title,
    description,
    url: homePath,
    inLanguage: "es-PY",
    primaryImageOfPage: `${SITE_URL}/img/home/hero-home.webp`,
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Servicios destacados VIPAR",
    itemListElement: featuredServices.map((service, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: service.title,
    })),
  },
]);
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  canonical={homePath}
  bodyClass="vipar-home-body"
  pageType="home"
>
  <div class="vipar-home" id="top">
    <main class="vipar-home__main">
      <HomeHero whatsappNumber={whatsappNumber} whatsappMessage={whatsappMessage} />
      <HomeSpecialties serviceLinks={serviceLinks} />
      <HomeServices
        featuredServices={featuredServices}
        complementaryServices={complementaryServices}
        viewAllHref="/servicios/"
      />
      <HomeProjects projects={projects} />
      <HomeAbout keyData={keyData} />
      <HomeContact
        whatsappNumber={whatsappNumber}
        whatsappMessage={whatsappMessage}
        telephone={telephone}
        email={email}
      />
    </main>
  </div>

  <script type="application/ld+json" set:html={homeStructuredData}></script>

  <script is:inline>
    const whatsappNumber = {JSON.stringify(whatsappNumber)};
    const form = document.getElementById("vipar-home-form");
    const status = document.getElementById("vipar-home-form-status");
    const message = document.getElementById("vipar-home-form-message");
    let hasTrackedFormStart = false;

    function setStatus(kind, text) {
      if (!(status instanceof HTMLElement) || !(message instanceof HTMLElement)) return;
      status.hidden = false;
      status.dataset.state = kind;
      message.textContent = text;
    }

    function clearStatus() {
      if (!(status instanceof HTMLElement) || !(message instanceof HTMLElement)) return;
      status.hidden = true;
      delete status.dataset.state;
      message.textContent = "";
    }

    function buildWhatsappUrl(fields) {
      const lines = [
        "Hola, quiero solicitar un presupuesto.",
        `Nombre: ${fields.name}`,
        `WhatsApp: ${fields.phone}`,
        fields.email ? `Email: ${fields.email}` : "",
        `Servicio: ${fields.service}`,
        fields.city ? `Ubicación: ${fields.city}` : "",
        "",
        "Detalle:",
        fields.details,
      ].filter(Boolean);

      return `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(lines.join("\n"))}`;
    }

    if (form instanceof HTMLFormElement) {
      const startedAtInput = form.querySelector('input[name="form_started_at"]');
      if (startedAtInput instanceof HTMLInputElement && !startedAtInput.value) {
        startedAtInput.value = String(Date.now());
      }
    }

    form?.addEventListener("input", () => {
      if (hasTrackedFormStart) return;
      hasTrackedFormStart = true;
      if (typeof window !== "undefined" && typeof window.viparTrack === "function") {
        window.viparTrack("form_start", {
          cta_location: "home_contact_form",
        });
      }
    });

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();

      const formElement = event.currentTarget;
      if (!(formElement instanceof HTMLFormElement)) return;

      clearStatus();

      const formData = new FormData(formElement);
      const name = String(formData.get("name") || "").trim();
      const phone = String(formData.get("phone") || "").trim();
      const emailValue = String(formData.get("email") || "").trim();
      const service = String(formData.get("service") || "").trim();
      const city = String(formData.get("city") || "").trim();
      const details = String(formData.get("message") || "").trim();
      const website = String(formData.get("website") || "").trim();
      const formStartedAt = String(formData.get("form_started_at") || "").trim();

      if (!name || !phone || !service || !details) {
        setStatus("error", "Completa nombre, WhatsApp, servicio y detalle de la solicitud.");
        return;
      }

      const composedMessage = [
        `Tipo de servicio: ${service}`,
        city ? `Ubicación de la obra: ${city}` : "",
        "",
        details,
      ]
        .filter(Boolean)
        .join("\n");

      const payload = new FormData();
      payload.set("name", name);
      payload.set("phone", phone);
      payload.set("email", emailValue);
      payload.set("city", city);
      payload.set("message", composedMessage);
      payload.set("source", String(formData.get("source") || "vipar-home-stitch"));
      payload.set("page", typeof window !== "undefined" ? window.location.href : "");

      const leadContext =
        typeof window !== "undefined" && typeof window.viparLeadContext === "function"
          ? window.viparLeadContext({
              cta_location: "home_contact_form",
              service_name: service,
            })
          : {
              cta_location: "home_contact_form",
              service_name: service,
            };

      payload.set("website", website);
      payload.set("form_started_at", formStartedAt);
      payload.set("page_path", String(leadContext.page_path || ""));
      payload.set("page_title", String(leadContext.page_title || ""));
      payload.set("page_type", String(leadContext.page_type || ""));
      payload.set("service_name", String(leadContext.service_name || ""));
      payload.set("cta_location", String(leadContext.cta_location || "home_contact_form"));
      payload.set("lead_source", String(leadContext.lead_source || ""));
      payload.set("lead_medium", String(leadContext.lead_medium || ""));
      payload.set("campaign", String(leadContext.campaign || ""));
      payload.set("device_type", String(leadContext.device_type || ""));

      const attachment = formData.get("file");
      if (attachment instanceof File && attachment.size > 0) {
        payload.set("file", attachment);
        if (typeof window !== "undefined" && typeof window.viparTrack === "function") {
          window.viparTrack("file_upload_attempt", {
            cta_location: "home_contact_form",
            service_name: service,
          });
        }
      }

      const submitButton = formElement.querySelector('button[type="submit"]');
      if (submitButton instanceof HTMLButtonElement) {
        submitButton.disabled = true;
      }

      try {
        if (typeof window !== "undefined" && typeof window.viparTrack === "function") {
          window.viparTrack("form_submit", {
            cta_location: "home_contact_form",
            service_name: service,
          });
        }

        if (typeof window !== "undefined" && typeof window.viparTrack === "function") {
          window.viparTrack("whatsapp_click", {
            cta_location: "home_contact_form",
            service_name: service,
            whatsapp_message_type: "prefilled",
          });
        }

        const whatsappUrl = buildWhatsappUrl({
          name,
          phone,
          email: emailValue,
          service,
          city,
          details,
        });

        if (typeof window !== "undefined") {
          window.open(whatsappUrl, "_blank", "noopener,noreferrer");
        }

        setStatus("success", "Abrimos WhatsApp con tu mensaje listo para enviar.");
      } catch {
        setStatus("error", "Error de red. Proba nuevamente o escribinos por WhatsApp.");
      } finally {
        if (submitButton instanceof HTMLButtonElement) {
          submitButton.disabled = false;
        }
      }
    });
  </script>
</Layout>
