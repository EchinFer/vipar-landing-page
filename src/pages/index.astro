---
import HomeAbout from "@components/home/HomeAbout.astro";
import HomeContact from "@components/home/HomeContact.astro";
import HomeHero from "@components/home/HomeHero.astro";
import HomeProjects from "@components/home/HomeProjects.astro";
import HomeServices from "@components/home/HomeServices.astro";
import HomeOtherServices from "@components/home/HomeOtherServices.astro";
import HomeSpecialties from "@components/home/HomeSpecialties.astro";
import Layout from "@layouts/Layout.astro";
import heroImage from "../assets/image/hero-nosotros.png";
import { SITE_URL, address, email, telephone } from "src/constants";
import { getStaticObraBySlug, staticObras } from "@lib/static-obras";
import "@styles/home.css";

const title = "VIPAR S.A. | Cristales y Aluminio";
const description =
  "Cristales templados, aluminio y terminaciones para obras en Paraguay. Soluciones para viviendas, comercios, oficinas y obras con presupuesto según medidas y tipo de instalación.";
const keywords =
  "VIPAR S.A., cristales templados Paraguay, carpintería de aluminio, fachadas integrales, mamparas, cielos rasos, box de baño";
const homePath = `${SITE_URL}/`;
const whatsappNumber = telephone.replace(/[^\d]/g, "");
const whatsappMessage =
  "Hola, quiero solicitar un presupuesto para una obra. Me contacto desde la home.";

const serviceLinks = {
  cristalesTemplados: "/servicios/vidrio-templado/",
  carpinteriaAluminio: "/servicios/carpinteria-de-aluminio/",
  fachada: "/servicios/fachadas/",
  mamparaDivisoria: "/servicios/mamparas-divisorias/",
  cieloRaso: "/servicios/cielo-raso/",
  boxDeBano: "/servicios/box-de-bano/",
  ventana: "/servicios/ventanas/",
  puerta: "/servicios/puertas/",
  cortina: "/servicios/cortinas/",
} as const;

const featuredServices = [
  {
    title: "Cielo raso",
    description:
      "Soluciones en cielo raso de yeso, PVC, Durlock y sistemas desmontables para viviendas, oficinas y locales que buscan mejor terminación, mantenimiento y precio según el uso del ambiente.",
    image: getStaticObraBySlug("oficina-divisorias")!.imagen,
    alt: "Cielo raso desmontable de yeso cartón en una oficina — obra VIPAR",
    caption: "Cielo raso desmontable · Oficina en Paraguay",
    points: [
      "Opciones en yeso, PVC, Durlock y desmontable",
      "Cotización según medidas, uso y complejidad de obra",
      "Ideal para hogares, oficinas y espacios comerciales",
    ],
    href: serviceLinks.cieloRaso,
  },
  {
    title: "Box de baño",
    description:
      "Box de baño a medida en acrílico, cristal templado y sistemas plegables para quienes quieren comparar materiales, medidas, limpieza y rango de inversión antes de decidir.",
    image: getStaticObraBySlug("vivienda-box-de-bano")!.imagen,
    alt: "Box de ducha en vidrio templado de 8 mm — vivienda en Paraguay",
    caption: "Box de baño de vidrio templado · Vivienda",
    points: [
      "Opciones en acrílico, cristal templado y plegables",
      "Orientación según medidas, apertura y presupuesto",
      "Pensado para remodelaciones y baños nuevos",
    ],
    href: serviceLinks.boxDeBano,
  },
  {
    title: "Mamparas divisorias",
    description:
      "Mamparas divisorias para oficinas, comercios y espacios corporativos que necesitan separar ambientes con mejor privacidad, imagen profesional y aprovechamiento de la luz.",
    image: getStaticObraBySlug("oficina-divisorias")!.imagen,
    alt: "Divisorias de oficina de vidrio templado con perfiles de aluminio — obra VIPAR",
    caption: "Divisorias de vidrio templado · Oficina en Paraguay",
    points: [
      "Soluciones en cristal templado, Eucatex y Durlock",
      "Enfoque para oficinas, salas y áreas operativas",
      "Cotización según layout, uso y nivel de privacidad",
    ],
    href: serviceLinks.mamparaDivisoria,
  },
] satisfies Array<{
  title: string;
  description: string;
  image: string;
  caption: string;
  alt: string;
  points: string[];
  href: string;
}>;

const complementaryServices = [
  {
    iconClass: "bi-columns-gap",
    title: "Vidrio templado y Blindex",
    description: "Provisión e instalación a medida para puertas, mamparas, box, barandas y fachadas.",
    href: serviceLinks.cristalesTemplados,
  },
  {
    iconClass: "bi-door-closed",
    title: "Carpintería de Aluminio",
    description: "Puertas, ventanas, aberturas y cerramientos según medidas y tipo de apertura.",
    href: serviceLinks.carpinteriaAluminio,
  },
  {
    iconClass: "bi-building",
    title: "Fachadas Integrales",
    description: "Entubado, muro cortina y sistema glazing para locales, oficinas y edificios.",
    href: serviceLinks.fachada,
  },
  {
    iconClass: "bi-grid-1x2",
    title: "Ventanas",
    description: "Aberturas de vidrio y aluminio según medidas y tipo de apertura.",
    href: serviceLinks.ventana,
  },
  {
    iconClass: "bi-door-closed",
    title: "Puertas",
    description: "Soluciones para accesos residenciales y comerciales.",
    href: serviceLinks.puerta,
  },
  {
    iconClass: "bi-view-list",
    title: "Cortinas",
    description: "Cerramientos y sistemas de apertura para tu espacio.",
    href: serviceLinks.cortina,
  },
];

const FEATURED_OBRA_SLUGS = ["sucursal-tigo-mra", "pedro-juan-caballero", "carde-apf-ypane"];
const projects = FEATURED_OBRA_SLUGS
  .map((slug) => staticObras.find((obra) => obra.slug === slug))
  .filter((obra): obra is NonNullable<typeof obra> => obra != null)
  .map((obra, i) => ({
    layout: i === 0 ? "hero" : "side",
    eyebrow: obra.sectorLabel,
    title: obra.titulo,
    description: `${obra.systemLabel} · ${obra.ubicacion}`,
    image: obra.imagen,
    imageRotation: obra.imageRotation,
    alt: `${obra.titulo} - ${obra.ubicacion} | VIPAR`,
    href: `/obras/${obra.slug}/`,
  }));

const keyData = [
  {
    iconClass: "bi-geo-alt",
    title: "Ubicación principal",
    description: address,
  },
  {
    iconClass: "bi-map",
    title: "Área de cobertura",
    description:
      "Asunción, Gran Asunción e interior del país (sujeto a la envergadura del proyecto).",
  },
  {
    iconClass: "bi-building-check",
    title: "Tipos de obra",
    description:
      "Viviendas, oficinas, locales comerciales, edificios e instituciones.",
  },
];

const homeStructuredData = JSON.stringify([
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: title,
    description,
    url: homePath,
    inLanguage: "es-PY",
    primaryImageOfPage: new URL(heroImage.src, SITE_URL).href,
  },
  {
    "@context": "https://schema.org",
    "@type": "ItemList",
    name: "Servicios destacados VIPAR",
    itemListElement: featuredServices.map((service, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: service.title,
    })),
  },
]);
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  canonical={homePath}
  bodyClass="vipar-home-body"
  pageType="home"
  loadAosAssets={false}
  loadLightboxAssets={false}
  loadSwiperAssets={false}
  loadIsotopeAssets={false}
  loadBootstrapJs={false}
  loadBootstrapIcons={false}
  useMaterialSymbols={false}
>
  <div class="vipar-home" id="top">
    <main class="vipar-home__main">
      <HomeHero
        whatsappNumber={whatsappNumber}
        whatsappMessage={whatsappMessage}
        image={heroImage}
      />
      <HomeServices
        featuredServices={featuredServices}
      />
      <HomeProjects projects={projects} totalProjects={staticObras.length} />
      <HomeOtherServices services={complementaryServices} />
      <HomeSpecialties serviceLinks={serviceLinks} />
      <HomeAbout keyData={keyData} />
      <HomeContact
        whatsappNumber={whatsappNumber}
        whatsappMessage={whatsappMessage}
        telephone={telephone}
        email={email}
      />
    </main>
  </div>

  <script type="application/ld+json" set:html={homeStructuredData}></script>
</Layout>
