            <span class="vipar-label">Metodología</span>
            <h2>Proceso de trabajo</h2>
            <p>Un enfoque estructurado para asegurar la calidad en cada entrega.</p>
          </div>

          <div class="vipar-timeline">
            <div class="vipar-timeline__line" aria-hidden="true"></div>
            {methodology.map((item, index) => (
              <article class:list={["vipar-step-card", index > 2 && "vipar-step-card--offset"]}>
                <div class:list={["vipar-step-card__index", item.step === 1 && "is-primary", item.step === 6 && "is-secondary"]}>
                  {item.step}
                </div>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="vipar-section vipar-section--plain vipar-section--bordered" id="nosotros">
        <div class="vipar-shell vipar-about-grid">
          <div class="vipar-stack-md">
            <span class="vipar-label">Sobre Nosotros</span>
            <h2>Empresa paraguaya enfocada en cristales, aluminio y terminaciones</h2>
            <div class="vipar-stack-sm vipar-prose">
              <p>
                VIPAR S.A. es una empresa paraguaya dedicada a soluciones en cristales templados, carpintería de aluminio y terminaciones para obras. Desde Ñemby, atiende proyectos residenciales, comerciales, corporativos e inmobiliarios que requieren aberturas, cerramientos, divisiones, fachadas, cielos rasos y box de baño.
              </p>
              <p>
                La atención comercial parte de datos concretos: medidas, ubicación, tipo de servicio y referencias del espacio. Eso permite orientar mejor cada consulta y preparar un presupuesto más útil para viviendas, comercios, oficinas y obras.
              </p>
            </div>
          </div>

          <aside class="vipar-key-card">
            <h3>Datos Clave</h3>
            <div class="vipar-key-card__list">
              {keyData.map((item) => (
                <div class="vipar-key-card__item">
                  <span class="material-symbols-outlined" aria-hidden="true">{item.icon}</span>
                  <div>
                    <strong>{item.title}</strong>
                    <span>{item.description}</span>
                  </div>
                </div>
              ))}
            </div>
          </aside>
        </div>
      </section>

      <section class="vipar-section vipar-section--surface" id="contacto">
        <div class="vipar-shell vipar-contact-grid">
          <div class="vipar-stack-md">
            <span class="vipar-label">Contacto</span>
            <h2>Solicite su presupuesto sin compromiso</h2>
            <p>
              Envíenos los detalles de su obra o adjunte sus planos. Nuestro equipo comercial le responderá a la brevedad con una propuesta técnico-económica.
            </p>

            <div class="vipar-contact-list">
              <div class="vipar-contact-item">
                <div class="vipar-contact-item__icon">
                  <span class="material-symbols-outlined" aria-hidden="true">call</span>
                </div>
                <div>
                  <strong>Teléfono / WhatsApp</strong>
                  <a href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`} target="_blank" rel="noopener noreferrer">{telephone}</a>
                </div>
              </div>

              <div class="vipar-contact-item">
                <div class="vipar-contact-item__icon">
                  <span class="material-symbols-outlined" aria-hidden="true">mail</span>
                </div>
                <div>
                  <strong>Correo Electrónico</strong>
                  <a href={`mailto:${email}`}>{email}</a>
                </div>
              </div>

              <div class="vipar-contact-item">
                <div class="vipar-contact-item__icon">
                  <span class="material-symbols-outlined" aria-hidden="true">schedule</span>
                </div>
                <div>
                  <strong>Horario de atención</strong>
                  <span>Lunes a Viernes: 07:30 a 17:00 hs.</span>
                </div>
              </div>
            </div>
          </div>

          <div class="vipar-form-card">
            <form class="vipar-form" id="vipar-home-form" novalidate>
              <div class="vipar-form__grid vipar-form__grid--2">
                <label class="vipar-field">
                  <span>Nombre y Apellido / Empresa *</span>
                  <input id="name" name="name" type="text" required autocomplete="name" />
                </label>

                <label class="vipar-field">
                  <span>WhatsApp de contacto *</span>
                  <input id="phone" name="phone" type="tel" required autocomplete="tel" />
                </label>
              </div>

              <label class="vipar-field">
                <span>Correo Electrónico</span>
                <input id="email" name="email" type="email" autocomplete="email" />
              </label>

              <div class="vipar-form__grid vipar-form__grid--2">
                <label class="vipar-field">
                  <span>Tipo de Servicio *</span>
                  <select id="service" name="service" required>
                    <option value="">Seleccione una opción</option>
                    <option value="Cristales Templados">Cristales Templados</option>
                    <option value="Carpintería de Aluminio">Carpintería de Aluminio</option>
                    <option value="Fachadas">Fachadas</option>
                    <option value="Mamparas / Divisiones">Mamparas / Divisiones</option>
                    <option value="Cielos Rasos">Cielos Rasos</option>
                    <option value="Box de Baño">Box de Baño</option>
                    <option value="Ventanas">Ventanas</option>
                    <option value="Puertas">Puertas</option>
                    <option value="Cortinas">Cortinas</option>
                    <option value="Múltiples servicios / Obra integral">Múltiples servicios / Obra integral</option>
                  </select>
                </label>

                <label class="vipar-field">
                  <span>Ubicación de la obra</span>
                  <input id="city" name="city" type="text" placeholder="Ej: Asunción, Luque, San Lorenzo..." />
                </label>
              </div>

              <label class="vipar-field">
                <span>Mensaje o detalle de la solicitud *</span>
                <textarea id="message" name="message" required></textarea>
              </label>

              <label class="vipar-field vipar-field--file">
                <span>
                  <span class="material-symbols-outlined" aria-hidden="true">upload_file</span>
                  Adjuntar planos o referencias (PDF, JPG, PNG)
                </span>
                <input id="file" name="file" type="file" accept=".pdf,.jpg,.jpeg,.png" />
              </label>

              <input type="hidden" name="source" value="vipar-home-stitch" />

              <div class="vipar-form__status" id="vipar-home-form-status" hidden>
                <p class="vipar-form__status-message" id="vipar-home-form-message"></p>
              </div>

              <button class="vipar-button vipar-button--primary vipar-button--block" type="submit">
                Enviar solicitud de cotización
              </button>
            </form>
          </div>
        </div>
      </section>
    </main>

    <footer class="vipar-footer">
      <div class="vipar-shell vipar-footer__grid">
        <div class="vipar-footer__brand">
          <span class="vipar-footer__logo">VIPAR S.A.</span>
          <p>
            Empresa paraguaya dedicada a cristales templados, aluminio y terminaciones para viviendas, comercios, oficinas y obras.
          </p>

          <div class="vipar-footer__socials">
            <a href="#contacto" aria-label="Compartir">
              <span class="material-symbols-outlined" aria-hidden="true">share</span>
            </a>
            <a href="/obras/" aria-label="Ver obras">
              <span class="material-symbols-outlined" aria-hidden="true">photo_camera</span>
            </a>
          </div>
        </div>

        <div class="vipar-footer__column">
          <h3>Enlaces Rápidos</h3>
          {footerQuickLinks.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
        </div>

        <div class="vipar-footer__column">
          <h3>Servicios</h3>
          {footerServiceLinks.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
        </div>

        <div class="vipar-footer__column">
          <h3>Contacto</h3>
          <p class="vipar-footer__contact">
            <span class="material-symbols-outlined" aria-hidden="true">location_on</span>
            <span>{address}</span>
          </p>
          <p class="vipar-footer__contact">
            <span class="material-symbols-outlined" aria-hidden="true">call</span>
            <span>{telephone}</span>
          </p>
          <p class="vipar-footer__contact">
            <span class="material-symbols-outlined" aria-hidden="true">mail</span>
            <span>{email}</span>
          </p>

          <a class="vipar-button vipar-button--accent vipar-footer__cta" href="#contacto">
            Solicitar Presupuesto
          </a>
        </div>
      </div>

      <div class="vipar-shell vipar-footer__bottom">
        <p>© {currentYear} VIPAR S.A. Todos los derechos reservados.</p>
        <div>
          <a href="#top">Términos y Condiciones</a>
          <a href="#top">Política de Privacidad</a>
        </div>
      </div>
    </footer>
  </div>

  <script type="application/ld+json" set:html={homeStructuredData}></script>

  <script is:inline>
    const form = document.getElementById("vipar-home-form");
    const status = document.getElementById("vipar-home-form-status");
    const message = document.getElementById("vipar-home-form-message");

    function setStatus(kind, text) {
      if (!(status instanceof HTMLElement) || !(message instanceof HTMLElement)) return;
      status.hidden = false;
      status.dataset.state = kind;
      message.textContent = text;
    }

    function clearStatus() {
      if (!(status instanceof HTMLElement) || !(message instanceof HTMLElement)) return;
      status.hidden = true;
      delete status.dataset.state;
      message.textContent = "";
    }

    form?.addEventListener("submit", async (event) => {
      event.preventDefault();

      const formElement = event.currentTarget;
      if (!(formElement instanceof HTMLFormElement)) return;

      clearStatus();

      const formData = new FormData(formElement);
      const name = String(formData.get("name") || "").trim();
      const phone = String(formData.get("phone") || "").trim();
      const emailValue = String(formData.get("email") || "").trim();
      const service = String(formData.get("service") || "").trim();
      const city = String(formData.get("city") || "").trim();
      const details = String(formData.get("message") || "").trim();

      if (!name || !phone || !service || !details) {
        setStatus("error", "Completá nombre, WhatsApp, servicio y detalle de la solicitud.");
        return;
      }

      const composedMessage = [
        `Tipo de servicio: ${service}`,
        city ? `Ubicación de la obra: ${city}` : "",
        "",
        details,
      ]
        .filter(Boolean)
        .join("\n");

      const payload = new FormData();
      payload.set("name", name);
      payload.set("phone", phone);
      payload.set("email", emailValue);
      payload.set("city", city);
      payload.set("message", composedMessage);
      payload.set("source", String(formData.get("source") || "vipar-home-stitch"));
      payload.set("page", typeof window !== "undefined" ? window.location.href : "");

      const attachment = formData.get("file");
      if (attachment instanceof File && attachment.size > 0) {
        payload.set("file", attachment);
      }

      const submitButton = formElement.querySelector('button[type="submit"]');
      if (submitButton instanceof HTMLButtonElement) {
        submitButton.disabled = true;
      }

      try {
        const response = await fetch("/api/leads", {
          method: "POST",
          body: payload,
        });

        const data = await response.json().catch(() => null);

        if (!response.ok) {
          setStatus(
            "error",
            data?.error || "No se pudo enviar la solicitud. Probá nuevamente o escribinos por WhatsApp."
          );
          return;
        }

        if (typeof window !== "undefined" && typeof window.gtag === "function") {
          window.gtag("event", "generate_lead", {
            method: "contact_form",
            page_location: window.location.href,
          });
        }

        formElement.reset();
        setStatus("success", "Recibimos tu solicitud. Te responderemos a la brevedad.");
      } catch {
        setStatus("error", "Error de red. Probá nuevamente o escribinos por WhatsApp.");
      } finally {
        if (submitButton instanceof HTMLButtonElement) {
          submitButton.disabled = false;
        }
      }
    });
  </script>
</Layout>
