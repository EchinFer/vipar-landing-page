---
import Base from "../layouts/Base.astro";
import Foto from "../components/Foto.astro";
import { empresa } from "../data/empresa";
import { fotosDe } from "../lib/fotos";

const showroom = fotosDe("showroom-vipar")[0];
---

<Base
	title="La empresa | VIPAR S.A."
	description="Empresa familiar de Ñemby, desde 2000. Vidrio templado, aluminio y terminaciones. El showroom está en Bo. Salinas."
	path="/nosotros/"
>
	<Foto src={showroom} alt="Showroom de VIPAR en Ñemby" priority class="aspect-[4/5] w-full object-cover md:aspect-[16/7]" sizes="100vw" />
	<article class="grid gap-8 px-4 py-8 md:grid-cols-2 md:px-8">
		<div>
			<h1 class="font-display text-5xl leading-none tracking-tight md:text-6xl">Desde {empresa.desde} en {empresa.ciudad}</h1>
			<p class="mt-4 text-lg">VIPAR empezó como un taller familiar de cristales templados. La segunda generación sumó carpintería de aluminio, fachadas, mamparas, cielo raso y box de baño.</p>
			<p class="mt-4 text-lg">El showroom está en la misma dirección donde se coordinan las obras. Ahí se ve el sistema antes de encargarlo.</p>
		</div>
		<div class="text-lg leading-8">
			<p>{empresa.direccion}</p>
			<p>{empresa.ciudad}, {empresa.departamento}</p>
			<p>{empresa.horario}</p>
			<p><a href={`tel:${empresa.telefono}`}>{empresa.telefono}</a></p>
			<p><a href={`mailto:${empresa.email}`}>{empresa.email}</a></p>
			<p class="mt-4 text-base text-muted">Asunción, Gran Asunción e interior. En el interior el viaje se confirma con la obra.</p>
		</div>
	</article>
</Base>
