---
import Base from "../layouts/Base.astro";
import Foto from "../components/Foto.astro";
import BandaContacto from "../components/BandaContacto.astro";
import { desdeVipar, empresa } from "../data/empresa";
import localVipar from "../assets/obras/showroom-vipar-03.webp";
---

<Base
	title="Sobre VIPAR S.A. | Más de 25 años en cristales templados y aluminio en Paraguay"
	description="Empresa familiar en Ñemby desde el año 2000. Mide en la obra e instala cristales templados, aluminio y terminaciones. En el showroom se ve el trabajo antes de encargarlo."
	path="/nosotros/"
	imagen={localVipar}
	imagenAlt="Showroom de VIPAR en Ñemby"
>
	<Foto src={localVipar} alt="Local de VIPAR en Ñemby" priority class="aspect-[4/5] w-full object-cover object-left md:aspect-[16/7]" sizes="100vw" />
	<article class="grid gap-10 px-4 py-14 md:grid-cols-2 md:px-8 md:py-20">
		<div>
			<p class="kicker text-muted">La empresa</p>
			<h1 class="mt-3 text-3xl leading-[1.05] text-brand md:text-5xl">Empresa paraguaya en cristales y aluminio desde el año {empresa.desde}</h1>
			<p class="mt-4 text-lg">Somos una familia de Ñemby. Medimos en la obra e instalamos cristales templados, aluminio y terminaciones, a la medida del lugar.</p>
			<p class="mt-4 text-lg">En el showroom ves cómo queda antes de encargarlo. Desde ahí salen las obras de Asunción, Gran Asunción y el interior. Si la obra está lejos, el viaje se confirma con el trabajo.</p>
			<p class="mt-4 text-lg">Cuando la obra termina, la limpieza la hace <a href={desdeVipar("", "texto", "nosotros")} data-evento="cleanpar_click" data-ubicacion="about_text" class="font-semibold text-brand underline underline-offset-4">CleanPar</a>.</p>
		</div>
		<div class="text-lg leading-8">
			<p>{empresa.direccion}</p>
			<p>{empresa.ciudad}, {empresa.departamento}</p>
			<p><a href={empresa.comoLlegar} data-mapa="nosotros" class="underline underline-offset-4">Cómo llegar en Google Maps</a></p>
			<p>{empresa.horario}</p>
			<p><a href={`tel:${empresa.telefono}`}>{empresa.telefono}</a></p>
			<p><a href={`mailto:${empresa.email}`}>{empresa.email}</a></p>
		</div>
	</article>
	<BandaContacto datos={false} />
</Base>
