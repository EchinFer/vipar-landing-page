---
import ServiceLandingTemplate from "@components/servicio-template/ServiceLandingTemplate.astro";
import Layout from "@layouts/Layout.astro";
import { facadesServiceContent } from "@lib/static-servicio-fachadas";
import { SITE_URL, whatsappNumber } from "src/constants";

import { buildWhatsappMessage, buildWhatsappUrl } from "@lib/whatsapp";

const serviceName = "Fachadas";
const whatsappLink = buildWhatsappUrl(
  buildWhatsappMessage({
    serviceName,
    pageLabel: serviceName,
    prompt: facadesServiceContent.whatsappMessage,
  })
);
const canonical = `${SITE_URL}${facadesServiceContent.canonicalPath}`;
---

<Layout
  title={facadesServiceContent.title}
  description={facadesServiceContent.description}
  canonical={canonical}
  keywords={facadesServiceContent.keywords}
  bodyClass="service-template-body"
  pageType="service"
  serviceName={serviceName}
  loadAosAssets={false}
  loadLightboxAssets={false}
  loadSwiperAssets={false}
  loadIsotopeAssets={false}
  loadBootstrapJs={false}
  useMaterialSymbols={false}
>
  <ServiceLandingTemplate
    content={facadesServiceContent}
    whatsappNumber={whatsappNumber}
    whatsappLink={whatsappLink}
    serviceName={serviceName}
  />
</Layout>
