---
import BoxBenefitsSection from "@components/servicio-box/BoxBenefitsSection.astro";
import BoxCompareSection from "@components/servicio-box/BoxCompareSection.astro";
import BoxEditorialSection from "@components/servicio-box/BoxEditorialSection.astro";
import BoxHero from "@components/servicio-box/BoxHero.astro";
import BoxOptionsSection from "@components/servicio-box/BoxOptionsSection.astro";
import BoxProcessSection from "@components/servicio-box/BoxProcessSection.astro";
import BoxTrustSection from "@components/servicio-box/BoxTrustSection.astro";
import RelatedWorksGallery from "@components/ui/RelatedWorksGallery.astro";
import QuoteCTA from "@components/ui/QuoteCTA.astro";
import Container from "@components/ui/Container.astro";
import Layout from "@layouts/Layout.astro";
import { getRelatedStaticObras } from "@lib/static-obras";
import { buildWhatsappMessage, buildWhatsappUrl } from "@lib/whatsapp";
import {
  boxBenefits,
  boxCompareRows,
  boxHeroImage,
  boxHeroTags,
  boxOptions,
  boxProcessSteps,
} from "@lib/static-servicio-box-de-bano";
import "../../styles/servicio-box-de-bano.css";
import { SITE_URL, whatsappNumber } from "src/constants";

const serviceName = "Box de baño";
const title = "Box de baño en Paraguay | Precio, medidas y cristal templado | VIPAR";
const description =
  "Box de baño a medida en Paraguay. Compara opciones en acrílico, cristal templado y plegables según precio, medidas, mantenimiento y tiempos de instalación.";
const canonical = `${SITE_URL}/servicios/box-de-bano/`;
const keywords =
  "box de baño paraguay, precio box de ducha, box de cristal templado, box de acrílico, mamparas para baño, box plegable";
const boxDecisionCards = [
  {
    title: "Si priorizas presupuesto",
    description:
      "El acrílico suele resolver rápido cuando el objetivo principal es cerrar la ducha con una inversión más contenida.",
  },
  {
    title: "Si priorizas limpieza e imagen",
    description:
      "El cristal templado suele ser la opción más buscada para baños principales por su terminación y mantenimiento diario.",
  },
  {
    title: "Si querés cotizar sin demoras",
    description:
      "Enviá ancho, alto, fotos del espacio y si preferís corredizo, batiente o plegable. Con eso aceleramos la orientación comercial.",
  },
];
const whatsappLink = buildWhatsappUrl(
  buildWhatsappMessage({
    serviceName,
    pageLabel: serviceName,
    prompt: "Puedo enviar medidas y fotos del baño.",
  })
);
const relatedObras = getRelatedStaticObras("box-de-bano");
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  canonical={canonical}
  loadAosAssets={false}
  loadLightboxAssets={false}
  loadSwiperAssets={false}
  loadIsotopeAssets={false}
  loadBootstrapJs={false}
  loadBootstrapIcons={false}
  useMaterialSymbols={false}
  bodyClass="box-service-body"
  pageType="service"
  serviceName={serviceName}
>
  <main class="box-service-page">
    <BoxHero image={boxHeroImage} tags={boxHeroTags} whatsappHref={whatsappLink} />
    <section class="box-service-section box-service-decision">
      <Container>
        <div class="box-service-section__head">
          <h2>Qué conviene según tu baño y tu presupuesto</h2>
          <p>
            Este bloque responde las dudas comerciales que más se repiten antes de pedir precio:
            material, mantenimiento, medidas y la información mínima para cotizar bien.
          </p>
        </div>
        <div class="box-service-decision__grid">
          {boxDecisionCards.map((card) => (
            <article class="box-service-decision__card">
              <h3>{card.title}</h3>
              <p>{card.description}</p>
            </article>
          ))}
        </div>
      </Container>
    </section>
    <BoxBenefitsSection items={boxBenefits} />
    <BoxOptionsSection items={boxOptions} />
    <BoxCompareSection rows={boxCompareRows} />
    <BoxProcessSection steps={boxProcessSteps} />
    <BoxTrustSection />
    <BoxEditorialSection />
    <RelatedWorksGallery obras={relatedObras} />

    <section class="box-service-section box-service-final">
      <Container>
        <QuoteCTA
          whatsappNumber={whatsappNumber}
          whatsappHref={whatsappLink}
          serviceName={serviceName}
          titleText="¿Necesitás cotizar un box de baño a medida?"
          bodyText="Enviá fotos, ancho, alto y el tipo de apertura que te interesa. Te orientamos sobre material, rango de inversión y siguiente paso por WhatsApp."
          buttonLabel="Pedir cotización de box de baño"
        />
      </Container>
    </section>
  </main>
</Layout>
