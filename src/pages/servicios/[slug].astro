---
import Base from "../../layouts/Base.astro";
import Foto from "../../components/Foto.astro";
import Calculadora from "../../components/Calculadora.astro";
import Pasos from "../../components/Pasos.astro";
import BandaContacto from "../../components/BandaContacto.astro";
import AvisoPrecios from "../../components/AvisoPrecios.astro";
import { servicios } from "../../data/servicios";
import { obraPorSlug, obrasDelServicio } from "../../data/obras";
import { notas } from "../../data/blog";
import { fotosDe } from "../../lib/fotos";
import { calcPorSlug, desdeM2, formatGs, mensajeLibre, preciosDe, preciosFecha, waUrl } from "../../lib/pedido";
import { empresa, migas, negocioId } from "../../data/empresa";

export function getStaticPaths() {
	return servicios.map((servicio) => ({ params: { slug: servicio.slug }, props: { servicio } }));
}

const { servicio } = Astro.props;
const [heroSlug, heroN] = servicio.hero ?? [servicio.foto, 0];
const foto = fotosDe(heroSlug)[heroN] ?? fotosDe(servicio.foto)[0];
const heroObra = obraPorSlug(heroSlug);
const heroLugar = heroObra && [heroObra.titulo, ...heroObra.ciudad.split(", ").filter((parte) => parte && !heroObra.titulo.includes(parte))].join(", ");
/** Debajo de ~1400 px la foto se pixela a pantalla completa: en computadora va enmarcada sobre un fondo desenfocado. */
const nitida = foto.width >= 1400;
const totalObras = obrasDelServicio(servicio.slug).length;
const conFoto = obrasDelServicio(servicio.slug).filter((obra) => fotosDe(obra.slug).length > 0);
const relacionadas = conFoto.slice(0, 4);
const tira = conFoto.flatMap((obra) => fotosDe(obra.slug).map((foto) => ({ obra, foto }))).slice(0, 10);
const guias = notas.filter((nota) => nota.servicio === servicio.slug);
const wa = mensajeLibre(`Quiero un presupuesto de ${servicio.nombre}.`);
const calc = calcPorSlug[servicio.slug];
const precios = calc ? preciosDe(calc) : [];
const desde = desdeM2(calc);
const url = new URL(`/servicios/${servicio.slug}/`, empresa.site).href;
const precio = (nombre: string, monto: number, unidad: "MTK" | "C62") => ({
	"@type": "Offer",
	name: nombre,
	itemOffered: { "@type": "Service", name: nombre },
	seller: { "@id": negocioId },
	priceSpecification: {
		"@type": "UnitPriceSpecification",
		price: monto,
		priceCurrency: "PYG",
		unitCode: unidad,
		unitText: unidad === "MTK" ? "m²" : "unidad",
		validFrom: preciosFecha,
	},
});
const indice = [
	{ id: "tipos", label: "Tipos" },
	precios.length > 0 && { id: "precios", label: "Precios" },
	servicio.calculadora && { id: "presupuesto", label: "Calcular" },
	relacionadas.length > 0 && { id: "obras", label: "Obras" },
	{ id: "preguntas", label: "Preguntas" },
].filter((item): item is { id: string; label: string } => Boolean(item));
const jsonLd = [
	{
		"@type": "Service",
		"@id": `${url}#servicio`,
		name: servicio.nombre,
		serviceType: servicio.nombre,
		description: servicio.description,
		url,
		provider: { "@id": negocioId },
		areaServed: { "@type": "Country", name: "Paraguay" },
		...(precios.length > 0 && {
			hasOfferCatalog: {
				"@type": "OfferCatalog",
				name: `Precios de referencia de ${servicio.nombre.toLowerCase()}`,
				itemListElement: precios.flatMap((item) => [
					precio(`${servicio.nombre}: ${item.nombre}, por m²`, item.m2, "MTK"),
					...(item.puerta ? [precio(`${servicio.nombre}: puerta de ${item.nombre}`, item.puerta, "C62")] : []),
				]),
			},
		}),
	},
	{
		"@type": "FAQPage",
		mainEntity: servicio.faq.map((item) => ({ "@type": "Question", name: item.p, acceptedAnswer: { "@type": "Answer", text: item.r } })),
	},
	migas(["Servicios", "/servicios/"], [servicio.nombre, `/servicios/${servicio.slug}/`]),
];
---

<Base title={`${servicio.title} | VIPAR S.A.`} description={servicio.description} path={`/servicios/${servicio.slug}/`} waTexto={wa} jsonLd={jsonLd}>
	<section class="relative isolate overflow-hidden bg-brand text-white">
		<div class="relative h-[50svh] min-h-[19rem] overflow-hidden md:absolute md:inset-0 md:h-auto">
			<div class="asentar size-full">
				<Foto src={foto} alt={`${servicio.nombre}${heroLugar ? ` en ${heroLugar}` : ""}, obra de VIPAR`} priority class:list={["size-full object-cover", !nitida && "md:scale-110 md:opacity-50 md:blur-2xl"]} sizes="100vw" widths={[480, 800, 1200, 1600, 1920]} />
			</div>
			<div class="absolute inset-0 bg-gradient-to-t from-brand from-5% via-brand/25 via-40% to-transparent md:bg-gradient-to-r md:from-brand md:from-5% md:via-brand/60 md:via-35% md:to-transparent md:to-75%"></div>
			{heroObra && (
				<a href={`/obras/${heroObra.slug}/`} class:list={["glass absolute top-3 right-3 max-w-[70%] px-3 py-1.5 text-xs leading-tight text-white/90 hover:text-white md:top-auto md:right-8 md:bottom-6", !nitida && "md:hidden"]}>
					<span class="kicker text-[0.65rem] text-sky">Obra de VIPAR</span> <span class="block truncate">{heroLugar}</span>
				</a>
			)}
		</div>

		<div class:list={["relative -mt-24 grid gap-10 px-4 pb-10 md:mt-0 md:min-h-[40rem] md:items-center md:px-8 md:py-16", !nitida && "md:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)]"]}>
			<div class="max-w-2xl">
				<p class="kicker text-sky"><a href="/servicios/" class="underline-offset-4 hover:underline">Servicios</a> / {servicio.nombre}</p>
				<h1 class="mt-4 max-w-[18ch] text-[2.15rem] leading-[1.02] tracking-tight text-balance md:text-6xl">{servicio.h1}</h1>
				<p class="mt-5 max-w-xl text-lg leading-snug text-white/85">{servicio.intro}</p>
				{desde && (
					<p class="glass mt-6 inline-flex flex-wrap items-baseline gap-x-2 px-4 py-2.5">
						<span class="text-sm text-white/80">Desde</span>
						<strong class="text-2xl leading-none">{formatGs(desde)}</strong>
						<span class="text-sm text-white/80">por m², precio de referencia</span>
					</p>
				)}
				<div class="mt-7 flex flex-wrap gap-3">
					<a href={waUrl(wa)} data-origen="servicio" class="btn btn-light">Pedir presupuesto</a>
					{servicio.calculadora ? <a href="#presupuesto" class="btn btn-line">Calcular mi caso</a> : relacionadas.length > 0 && <a href="#obras" class="btn btn-line">Ver obras</a>}
				</div>
				<dl class="mt-9 flex max-w-lg gap-10 border-t border-white/20 pt-5">
					{totalObras >= 4 && <div class="flex flex-col-reverse"><dt class="mt-1 text-xs leading-tight text-white/70">obras publicadas</dt><dd class="text-2xl leading-none font-bold md:text-3xl">{totalObras}</dd></div>}
					<div class="flex flex-col-reverse"><dt class="mt-1 text-xs leading-tight text-white/70">trabajando desde</dt><dd class="text-2xl leading-none font-bold md:text-3xl">{empresa.desde}</dd></div>
					<div class="flex flex-col-reverse"><dt class="mt-1 text-xs leading-tight text-white/70">showroom</dt><dd class="text-2xl leading-none font-bold md:text-3xl">{empresa.ciudad}</dd></div>
				</dl>
			</div>
			{!nitida && (
				<figure class="hidden md:block">
					<Foto src={foto} alt="" class="max-h-[34rem] w-full object-cover shadow-2xl ring-1 ring-white/25" sizes="40vw" widths={[480, 800]} />
					{heroLugar && <figcaption class="mt-3 text-sm text-white/80"><span class="kicker text-[0.65rem] text-sky">Obra de VIPAR</span> · <a href={`/obras/${heroObra?.slug}/`} class="underline-offset-4 hover:underline">{heroLugar}</a></figcaption>}
				</figure>
			)}
		</div>
	</section>

	<nav class="indice sticky top-14 z-20 border-b border-aluminum/50 bg-white/95 backdrop-blur" aria-label="En esta página">
		<ul class="flex gap-1 overflow-x-auto px-4 py-2 md:px-8">
			{indice.map((item) => (
				<li><a href={`#${item.id}`} data-indice={item.id} class="block px-3 py-2 text-sm font-semibold whitespace-nowrap text-muted transition-colors hover:text-brand">{item.label}</a></li>
			))}
		</ul>
	</nav>

	{
		tira.length > 1 && (
			<section class="pt-10 md:pt-14" aria-label="Trabajos reales">
				<div class="flex items-end justify-between gap-4 px-4 md:px-8">
					<h2 class="text-2xl leading-tight text-brand md:text-3xl">Trabajos reales de VIPAR</h2>
					{tira.length > 4 && <p class="hidden text-sm text-muted md:block">Deslizá para ver más</p>}
				</div>
				<ul class="mt-5 flex snap-x snap-mandatory gap-3 overflow-x-auto scroll-px-4 px-4 pb-3 md:scroll-px-8 md:px-8">
					{tira.map(({ obra, foto }) => (
						<li class="w-[78%] shrink-0 snap-start sm:w-[45%] md:w-[30%] lg:w-[23%]">
							<a href={`/obras/${obra.slug}/`} class="zoom group relative block aspect-[4/5] overflow-hidden bg-brand">
								<Foto src={foto} alt={`${servicio.nombre} en ${obra.titulo}${obra.ciudad ? `, ${obra.ciudad}` : ""}`} class="absolute inset-0 size-full object-cover" sizes="(min-width: 1024px) 23vw, (min-width: 768px) 30vw, 78vw" widths={[320, 480, 720]} />
								<div class="absolute inset-0 bg-gradient-to-t from-brand/85 via-transparent to-transparent"></div>
								<p class="absolute inset-x-0 bottom-0 p-4 font-bold text-white">{obra.titulo}<span class="block text-sm font-normal text-white/80">{obra.ciudad}</span></p>
							</a>
						</li>
					))}
				</ul>
			</section>
		)
	}

	<div class="px-4 py-12 md:grid md:grid-cols-[1fr_20rem] md:gap-14 md:px-8 md:py-16">
		<article>
			<div class="grid gap-4 md:grid-cols-2">
				<div class="reveal bg-wash p-6">
					<h2 class="text-xl font-bold text-brand">Incluye</h2>
					<ul class="mt-4 space-y-3">
						{servicio.incluye.map((item) => (
							<li class="flex gap-3 leading-snug"><span aria-hidden="true" class="font-bold text-brand">✓</span><span>{item}</span></li>
						))}
					</ul>
				</div>
				<div class="reveal border border-aluminum/60 p-6">
					<h2 class="text-xl font-bold text-brand">No incluye</h2>
					<ul class="mt-4 space-y-3">
						{servicio.noIncluye.map((item) => (
							<li class="flex gap-3 leading-snug"><span aria-hidden="true" class="font-bold text-muted">—</span><span>{item}</span></li>
						))}
					</ul>
				</div>
			</div>

			{
				servicio.bloques.map((bloque, orden) => (
					<section id={bloque.precios ? "precios" : orden === 0 ? "tipos" : undefined} class="reveal mt-14 max-w-3xl">
						<h2 class="text-2xl leading-tight text-brand md:text-3xl">{bloque.titulo}</h2>
						{bloque.parrafos?.map((parrafo) => <p class="mt-4 text-lg leading-relaxed">{parrafo}</p>)}
						{
							bloque.items && bloque.precios && (
								<dl class="mt-5 border-t border-aluminum/60">
									{bloque.items.map((item) => (
										<div class="flex items-baseline justify-between gap-4 border-b border-aluminum/60 py-3">
											<dt class="leading-snug">{item.titulo}</dt>
											<dd class="text-right leading-snug">{item.texto.split(" · ").map((parte, orden) => <span class:list={["block whitespace-nowrap", orden === 0 ? "font-bold text-brand" : "text-sm text-muted"]}>{parte}</span>)}</dd>
										</div>
									))}
								</dl>
							)
						}
						{
							bloque.items && !bloque.precios && (
								<div class="mt-5 grid gap-3 md:grid-cols-2">
									{bloque.items.map((item) => (
										<div class="border border-aluminum/60 p-5">
											<h3 class="font-bold text-brand">{item.titulo}</h3>
											<p class="mt-2 leading-snug">{item.texto}</p>
										</div>
									))}
								</div>
							)
						}
						{bloque.precios && <AvisoPrecios asunto={wa} calcular={servicio.calculadora} />}
					</section>
				))
			}

			<section class="reveal mt-14 max-w-3xl">
				<h2 class="text-2xl leading-tight text-brand md:text-3xl">En obra</h2>
				<ul class="mt-5 space-y-3">
					{servicio.hechos.map((hecho) => <li class="border-l-4 border-brand bg-wash py-3 pr-4 pl-4 text-lg leading-snug">{hecho}</li>)}
				</ul>
			</section>

			{
				guias.length > 0 && (
					<section class="reveal mt-14 max-w-3xl">
						<h2 class="text-2xl leading-tight text-brand md:text-3xl">Guías de {servicio.nombre.toLowerCase()}</h2>
						<ul class="mt-5 border-t border-aluminum/60">
							{guias.map((nota) => (
								<li>
									<a href={`/blog/${nota.slug}/`} class="group flex items-start justify-between gap-4 border-b border-aluminum/60 py-4">
										<span class="text-lg leading-snug font-bold text-brand group-hover:underline">{nota.title}</span>
										<span aria-hidden="true" class="mt-0.5 text-brand">→</span>
									</a>
								</li>
							))}
						</ul>
					</section>
				)
			}
		</article>

		<aside class="hidden md:block">
			<div class="top-20 border border-brand p-6 md:sticky">
				<p class="kicker text-muted">Presupuesto</p>
				<p class="mt-2 text-2xl leading-tight font-bold text-brand">{servicio.nombre}</p>
				{desde && <p class="mt-3 text-sm">Desde <strong class="text-lg text-brand">{formatGs(desde)}</strong> por m², precio de referencia.</p>}
				<p class="mt-3 text-sm leading-snug">Mandanos fotos y medidas por WhatsApp. El precio final se cierra cuando medimos en tu obra.</p>
				<a href={waUrl(wa)} data-origen="lateral" class="btn btn-primary mt-5 w-full">Pedir presupuesto</a>
				<p class="mt-4 text-xs text-muted">{empresa.horario}. {empresa.ciudad}.</p>
			</div>
		</aside>
	</div>

	{
		servicio.calculadora && (
			<div class="px-4 pb-14 md:px-8">
				<Calculadora servicio={calcPorSlug[servicio.slug]} />
			</div>
		)
	}

	<Pasos />

	<section id="preguntas" class="px-4 py-14 md:px-8 md:py-20">
		<div class="grid gap-8 md:grid-cols-[1fr_2fr] md:gap-16">
			<div>
				<p class="kicker text-muted">Dudas</p>
				<h2 class="mt-3 text-3xl leading-[1.05] text-brand md:text-4xl">Preguntas frecuentes</h2>
			</div>
			<div class="border-t border-aluminum/60">
				{
					servicio.faq.map((item) => (
						<details class="group border-b border-aluminum/60">
							<summary class="flex items-start justify-between gap-4 py-5 text-lg font-bold text-brand">
								<span>{item.p}</span>
								<span aria-hidden="true" class="mas mt-1 text-2xl leading-none transition-transform">+</span>
							</summary>
							<p class="pb-5 text-base leading-relaxed">{item.r}</p>
						</details>
					))
				}
			</div>
		</div>
	</section>

	{
		relacionadas.length > 0 && (
			<section id="obras" class="bg-wash px-4 py-14 md:px-8 md:py-20">
				<p class="kicker text-muted">Obras</p>
				<h2 class="mt-3 text-3xl leading-[1.05] text-brand md:text-4xl">Obras de esta línea</h2>
				<ul class="mt-8 grid grid-cols-2 gap-2 md:grid-cols-4 md:gap-3">
					{relacionadas.map((obra) => (
						<li>
							<a href={`/obras/${obra.slug}/`} class="zoom group relative block aspect-[4/5] overflow-hidden bg-brand">
								<Foto src={fotosDe(obra.slug)[0]} alt={obra.titulo} class="absolute inset-0 size-full object-cover" sizes="(min-width: 768px) 25vw, 50vw" widths={[320, 480, 720]} />
								<div class="absolute inset-0 bg-gradient-to-t from-brand/85 via-transparent to-transparent"></div>
								<p class="absolute inset-x-0 bottom-0 p-3 text-sm font-bold text-white md:p-4 md:text-base">{obra.titulo}</p>
							</a>
						</li>
					))}
				</ul>
			</section>
		)
	}

	<BandaContacto texto={wa} />
</Base>

<script>
	const enlaces = document.querySelectorAll<HTMLAnchorElement>("[data-indice]");
	const marcar = (id: string) => enlaces.forEach((enlace) => enlace.classList.toggle("activo", enlace.dataset.indice === id));
	const observador = new IntersectionObserver(
		(entradas) => entradas.forEach((entrada) => entrada.isIntersecting && marcar(entrada.target.id)),
		{ rootMargin: "-30% 0px -60% 0px" },
	);
	enlaces.forEach((enlace) => {
		const destino = document.getElementById(enlace.dataset.indice ?? "");
		if (destino) observador.observe(destino);
	});
</script>
