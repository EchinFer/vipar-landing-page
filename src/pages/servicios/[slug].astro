---
import Base from "../../layouts/Base.astro";
import Foto from "../../components/Foto.astro";
import Calculadora from "../../components/Calculadora.astro";
import Pasos from "../../components/Pasos.astro";
import BandaContacto from "../../components/BandaContacto.astro";
import { servicios } from "../../data/servicios";
import { obrasDelServicio } from "../../data/obras";
import { notas } from "../../data/blog";
import { fotosDe } from "../../lib/fotos";
import { calcPorSlug, mensajeLibre, waUrl } from "../../lib/pedido";
import { empresa } from "../../data/empresa";

export function getStaticPaths() {
	return servicios.map((servicio) => ({ params: { slug: servicio.slug }, props: { servicio } }));
}

const { servicio } = Astro.props;
const foto = fotosDe(servicio.foto)[0];
const relacionadas = obrasDelServicio(servicio.slug).filter((obra) => fotosDe(obra.slug).length > 0).slice(0, 4);
const guias = notas.filter((nota) => nota.servicio === servicio.slug);
const wa = mensajeLibre(`Quiero un presupuesto de ${servicio.nombre}.`);
const jsonLd = {
	"@type": "Service",
	name: servicio.nombre,
	description: servicio.description,
	url: new URL(`/servicios/${servicio.slug}/`, empresa.site).href,
	provider: { "@type": "LocalBusiness", name: empresa.nombre },
	areaServed: "Paraguay",
};
---

<Base title={`${servicio.title} | VIPAR S.A.`} description={servicio.description} path={`/servicios/${servicio.slug}/`} waTexto={wa} jsonLd={jsonLd}>
	<section class="panes bg-brand text-white">
		<div class="grid md:grid-cols-[1fr_1.05fr]">
			<div class="order-2 flex flex-col justify-center px-4 py-10 md:order-1 md:px-8 md:py-16">
				<p class="kicker text-sky"><a href="/servicios/" class="underline-offset-4 hover:underline">Servicios</a> / {servicio.nombre}</p>
				<h1 class="mt-4 max-w-[20ch] text-[2rem] leading-[1.04] md:text-5xl">{servicio.h1}</h1>
				<p class="mt-5 max-w-xl text-lg leading-snug text-white/90">{servicio.intro}</p>
				<div class="mt-7 flex flex-wrap gap-3">
					<a href={waUrl(wa)} data-origen="servicio" class="btn btn-light">Pedir presupuesto</a>
					{servicio.calculadora ? <a href="#presupuesto" class="btn btn-line">Armar el pedido</a> : relacionadas.length > 0 && <a href="#obras" class="btn btn-line">Ver obras</a>}
				</div>
			</div>
			<div class="order-1 md:order-2">
				<Foto src={foto} alt={servicio.nombre} priority class="aspect-[4/3] size-full object-cover md:aspect-auto md:min-h-[32rem]" sizes="(min-width: 768px) 52vw, 100vw" />
			</div>
		</div>
	</section>

	<div class="px-4 py-12 md:grid md:grid-cols-[1fr_20rem] md:gap-14 md:px-8 md:py-16">
		<article>
			<div class="grid gap-4 md:grid-cols-2">
				<div class="reveal bg-wash p-6">
					<h2 class="text-xl font-bold text-brand">Incluye</h2>
					<ul class="mt-4 space-y-3">
						{servicio.incluye.map((item) => (
							<li class="flex gap-3 leading-snug"><span aria-hidden="true" class="font-bold text-brand">✓</span><span>{item}</span></li>
						))}
					</ul>
				</div>
				<div class="reveal border border-aluminum/60 p-6">
					<h2 class="text-xl font-bold text-brand">No incluye</h2>
					<ul class="mt-4 space-y-3">
						{servicio.noIncluye.map((item) => (
							<li class="flex gap-3 leading-snug"><span aria-hidden="true" class="font-bold text-muted">—</span><span>{item}</span></li>
						))}
					</ul>
				</div>
			</div>

			{
				servicio.bloques.map((bloque) => (
					<section class="reveal mt-14 max-w-3xl">
						<h2 class="text-2xl leading-tight text-brand md:text-3xl">{bloque.titulo}</h2>
						{bloque.parrafos?.map((parrafo) => <p class="mt-4 text-lg leading-relaxed">{parrafo}</p>)}
						{
							bloque.items && (
								<div class="mt-5 grid gap-3 md:grid-cols-2">
									{bloque.items.map((item) => (
										<div class="border border-aluminum/60 p-5">
											<h3 class="font-bold text-brand">{item.titulo}</h3>
											<p class="mt-2 leading-snug">{item.texto}</p>
										</div>
									))}
								</div>
							)
						}
					</section>
				))
			}

			<section class="reveal mt-14 max-w-3xl">
				<h2 class="text-2xl leading-tight text-brand md:text-3xl">En obra</h2>
				<ul class="mt-5 space-y-3">
					{servicio.hechos.map((hecho) => <li class="border-l-4 border-brand bg-wash py-3 pr-4 pl-4 text-lg leading-snug">{hecho}</li>)}
				</ul>
			</section>

			{
				guias.length > 0 && (
					<section class="reveal mt-14 max-w-3xl">
						<h2 class="text-2xl leading-tight text-brand md:text-3xl">Guías de {servicio.nombre.toLowerCase()}</h2>
						<ul class="mt-5 border-t border-aluminum/60">
							{guias.map((nota) => (
								<li>
									<a href={`/blog/${nota.slug}/`} class="group flex items-start justify-between gap-4 border-b border-aluminum/60 py-4">
										<span class="text-lg leading-snug font-bold text-brand group-hover:underline">{nota.title}</span>
										<span aria-hidden="true" class="mt-0.5 text-brand">→</span>
									</a>
								</li>
							))}
						</ul>
					</section>
				)
			}
		</article>

		<aside class="hidden md:block">
			<div class="top-20 border border-brand p-6 md:sticky">
				<p class="kicker text-muted">Presupuesto</p>
				<p class="mt-2 text-2xl leading-tight font-bold text-brand">{servicio.nombre}</p>
				<p class="mt-3 text-sm leading-snug">Mandanos fotos y medidas por WhatsApp. El precio final se cierra cuando medimos en tu obra.</p>
				<a href={waUrl(wa)} data-origen="lateral" class="btn btn-primary mt-5 w-full">Pedir presupuesto</a>
				<p class="mt-4 text-xs text-muted">{empresa.horario}. {empresa.ciudad}.</p>
			</div>
		</aside>
	</div>

	{
		servicio.calculadora && (
			<div class="px-4 pb-14 md:px-8">
				<Calculadora servicio={calcPorSlug[servicio.slug]} />
			</div>
		)
	}

	<Pasos />

	<section class="px-4 py-14 md:px-8 md:py-20">
		<div class="grid gap-8 md:grid-cols-[1fr_2fr] md:gap-16">
			<div>
				<p class="kicker text-muted">Dudas</p>
				<h2 class="mt-3 text-3xl leading-[1.05] text-brand md:text-4xl">Preguntas frecuentes</h2>
			</div>
			<div class="border-t border-aluminum/60">
				{
					servicio.faq.map((item) => (
						<details class="group border-b border-aluminum/60">
							<summary class="flex items-start justify-between gap-4 py-5 text-lg font-bold text-brand">
								<span>{item.p}</span>
								<span aria-hidden="true" class="mas mt-1 text-2xl leading-none transition-transform">+</span>
							</summary>
							<p class="pb-5 text-base leading-relaxed">{item.r}</p>
						</details>
					))
				}
			</div>
		</div>
	</section>

	{
		relacionadas.length > 0 && (
			<section id="obras" class="bg-wash px-4 py-14 md:px-8 md:py-20">
				<p class="kicker text-muted">Obras</p>
				<h2 class="mt-3 text-3xl leading-[1.05] text-brand md:text-4xl">Obras de esta línea</h2>
				<ul class="mt-8 grid grid-cols-2 gap-2 md:grid-cols-4 md:gap-3">
					{relacionadas.map((obra) => (
						<li>
							<a href={`/obras/${obra.slug}/`} class="zoom group relative block aspect-[4/5] overflow-hidden bg-brand">
								<Foto src={fotosDe(obra.slug)[0]} alt={obra.titulo} class="absolute inset-0 size-full object-cover" sizes="(min-width: 768px) 25vw, 50vw" widths={[320, 480, 720]} />
								<div class="absolute inset-0 bg-gradient-to-t from-brand/85 via-transparent to-transparent"></div>
								<p class="absolute inset-x-0 bottom-0 p-3 text-sm font-bold text-white md:p-4 md:text-base">{obra.titulo}</p>
							</a>
						</li>
					))}
				</ul>
			</section>
		)
	}

	<BandaContacto asunto={wa} />
</Base>
