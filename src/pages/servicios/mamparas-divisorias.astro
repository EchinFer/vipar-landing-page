---
import MamparaComparisonSection from "@components/servicio-mampara/MamparaComparisonSection.astro";
import MamparaEditorialSection from "@components/servicio-mampara/MamparaEditorialSection.astro";
import MamparaFactorsSection from "@components/servicio-mampara/MamparaFactorsSection.astro";
import MamparaHero from "@components/servicio-mampara/MamparaHero.astro";
import MamparaProblemSection from "@components/servicio-mampara/MamparaProblemSection.astro";
import MamparaProcessSection from "@components/servicio-mampara/MamparaProcessSection.astro";
import MamparaSectorsSection from "@components/servicio-mampara/MamparaSectorsSection.astro";
import MamparaSymptomsSection from "@components/servicio-mampara/MamparaSymptomsSection.astro";
import MamparaTrustSection from "@components/servicio-mampara/MamparaTrustSection.astro";
import MamparaTypesSection from "@components/servicio-mampara/MamparaTypesSection.astro";
import FaqAccordion from "@components/ui/FaqAccordion.astro";
import Container from "@components/ui/Container.astro";
import RelatedWorksGallery from "@components/ui/RelatedWorksGallery.astro";
import QuoteCTA from "@components/ui/QuoteCTA.astro";
import Layout from "@layouts/Layout.astro";
import { getRelatedStaticObras } from "@lib/static-obras";
import { buildWhatsappMessage, buildWhatsappUrl } from "@lib/whatsapp";
import {
  mamparaComparisonRows,
  mamparaEditorialTags,
  mamparaFaqs,
  mamparaFactors,
  mamparaHeroImage,
  mamparaHeroTags,
  mamparaProblemCases,
  mamparaProcessSteps,
  mamparaSectorItems,
  mamparaSymptoms,
  mamparaTrustStats,
  mamparaTypeCards,
} from "@lib/static-servicio-mampara-divisoria";
import "../../styles/servicio-mampara-divisoria.css";
import { SITE_URL, whatsappNumber } from "src/constants";

const serviceName = "Mamparas divisorias";
const title = "Mamparas divisorias para oficinas en Paraguay | Cristal, Durlock y Eucatex | VIPAR";
const description =
  "Mamparas divisorias para oficinas, comercios y espacios corporativos. Cotizá opciones en cristal templado, Durlock o Eucatex según privacidad, imagen, plazos y uso del ambiente.";
const canonical = `${SITE_URL}/servicios/mamparas-divisorias/`;
const keywords =
  "mamparas divisorias paraguay, mamparas para oficinas, divisiones para oficinas, mamparas de cristal templado, tabiques de durlock, mamparas corporativas";
const ogImageAlt = "Mamparas divisorias para oficinas y espacios corporativos en Paraguay";
const serviceStructuredDataId = `${canonical}#service`;
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": canonical,
    url: canonical,
    name: title,
    description,
    inLanguage: "es-PY",
    primaryImageOfPage: {
      "@type": "ImageObject",
      url: mamparaHeroImage,
    },
    mainEntity: {
      "@id": serviceStructuredDataId,
    },
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": serviceStructuredDataId,
    name: serviceName,
    description,
    serviceType: [
      "Mamparas divisorias para oficinas",
      "Mamparas de cristal templado",
      "Tabiques de Durlock",
      "Mamparas Eucatex",
    ],
    areaServed: {
      "@type": "Country",
      name: "Paraguay",
    },
    provider: {
      "@type": "Organization",
      name: "VIPAR S.A.",
      url: SITE_URL,
    },
    image: [
      {
        "@type": "ImageObject",
        url: mamparaHeroImage,
      },
    ],
    mainEntityOfPage: {
      "@id": canonical,
    },
  },
];
const whatsappLink = buildWhatsappUrl(
  buildWhatsappMessage({
    serviceName,
    pageLabel: serviceName,
    prompt: "Puedo enviar fotos, medidas o plano del espacio.",
  })
);
const relatedObras = getRelatedStaticObras("mampara-divisoria");
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  keywords={keywords}
  ogImage={mamparaHeroImage}
  ogImageAlt={ogImageAlt}
  structuredData={structuredData}
  loadAosAssets={false}
  loadLightboxAssets={false}
  loadSwiperAssets={false}
  loadIsotopeAssets={false}
  loadBootstrapJs={false}
  loadBootstrapIcons={false}
  useMaterialSymbols={false}
  bodyClass="mampara-service-body"
  pageType="service"
  serviceName={serviceName}
>
  <main class="mampara-service-page">
    <MamparaHero image={mamparaHeroImage} tags={mamparaHeroTags} whatsappHref={whatsappLink} />
    <MamparaProblemSection cases={mamparaProblemCases} />
    <MamparaFactorsSection items={mamparaFactors} />
    <MamparaTypesSection items={mamparaTypeCards} />
    <MamparaComparisonSection rows={mamparaComparisonRows} />
    <MamparaSectorsSection items={mamparaSectorItems} />
    <MamparaSymptomsSection image={mamparaHeroImage} items={mamparaSymptoms} />
    <MamparaProcessSection steps={mamparaProcessSteps} />
    <MamparaTrustSection stats={mamparaTrustStats} />
    <MamparaEditorialSection tags={mamparaEditorialTags} />
    <FaqAccordion items={mamparaFaqs} />
    <RelatedWorksGallery obras={relatedObras} />

    <section class="mampara-service-section mampara-service-final">
      <Container>
        <QuoteCTA
          whatsappNumber={whatsappNumber}
          whatsappHref={whatsappLink}
          serviceName={serviceName}
          titleText="¿Necesitás dividir oficinas o áreas operativas?"
          bodyText="Enviá medidas, plano o fotos del espacio y contanos si priorizás privacidad, paso de luz o velocidad de obra. Te orientamos sobre cristal, Durlock o Eucatex."
          buttonLabel="Pedir cotización de mamparas"
        />
      </Container>
    </section>
  </main>
</Layout>
