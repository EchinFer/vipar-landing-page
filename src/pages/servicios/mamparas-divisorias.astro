      <img src="/img/logo-simple.png" alt="VIPAR S.A." class="block md:hidden h-9 w-9" />
    </a>
    <div class="hidden md:flex items-center space-x-10">
      <a class="text-[#002046] border-b-2 border-[#1B365D] pb-1 font-bold font-headline tracking-tight" href="/servicios/">Servicios</a>
      <a class="text-slate-500 font-medium hover:text-[#1B365D] transition-all duration-300 ease-in-out font-headline tracking-tight" href="/obras/">Proyectos</a>
      <a class="text-slate-500 font-medium hover:text-[#1B365D] transition-all duration-300 ease-in-out font-headline tracking-tight" href="/nosotros/">Empresa</a>
      <a class="text-slate-500 font-medium hover:text-[#1B365D] transition-all duration-300 ease-in-out font-headline tracking-tight" href="/contacto/">Contacto</a>
    </div>
    <a href="/contacto/" class="bg-primary text-on-primary px-6 py-3 rounded-xl font-bold font-headline tracking-tight hover:opacity-80 transition-all active:scale-95 duration-150">
      Cotizar Proyecto
    </a>
  </div>
</nav>

<main class="pt-20">
  <!-- Hero Section: Editorial Focus -->
  <section class="relative h-[921px] flex items-center overflow-hidden">
    <div class="absolute inset-0 z-0">
      <img class="w-full h-full object-cover" alt="Lobby corporativo minimalista con mamparas de cristal templado" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAWL1SdapClxacZbU-BDsOxCm6FeDmKTi4AzWqCwGR5aVqNtlszxC7VxVKys4XN994M17_TqoXF0hMQsX890kJgA7wRPTKU-qdJccKZL2_1eTrPYok8nppN9PfZh6KlD2RmO_4Ff9gVgB2O1llszJiqBKhExzcP9OHfkcwKlgqwV7EAbdYYkWQ7hbLeIUPq-lemrX7JD-4ph5U9lWZ9K0n6Mng4uGgMc1nt9U29bY-LXY8dRfCt9S1TQYRO_oOyCG1vSY2h7IboOrAK" />
      <div class="absolute inset-0 bg-gradient-to-r from-background via-background/40 to-transparent"></div>
    </div>
    <div class="container mx-auto px-12 relative z-10 grid grid-cols-12 gap-8">
      <div class="col-span-12 lg:col-span-7">
        <span class="label-md font-medium tracking-[0.2em] uppercase text-primary mb-6 block">Arquitectura Corporativa</span>
        <h1 class="text-display-lg text-[4.5rem] leading-[1.1] font-headline font-extrabold text-primary mb-8 tracking-tighter">
