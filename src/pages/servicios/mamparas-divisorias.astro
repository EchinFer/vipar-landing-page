---
// Mamparas Divisorias - static page based on Stitch design (Architectural Impact)
const title = "Mamparas Divisorias | VIPAR S.A.";
const description = "Mamparas divisorias en Paraguay: cristal templado, tabiquería Durlock y sistemas Eucatex. Instalación profesional para oficinas y espacios corporativos.";
const canonical = "https://vipar.com.py/servicios/mamparas-divisorias";
---
<!DOCTYPE html>
<html class="light" lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href={canonical} />

  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600&family=Manrope:wght@700;800&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
  <script is:inline src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <script is:inline id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "surface-dim": "#dadada",
            "surface-tint": "#465f88",
            "on-primary-fixed": "#001b3d",
            "surface-container-low": "#f3f3f3",
            "tertiary-fixed-dim": "#f1bd81",
            "secondary-container": "#e2e2e6",
            "primary-fixed-dim": "#aec7f7",
            "on-secondary-fixed-variant": "#45474a",
            "surface": "#f9f9f9",
            "on-tertiary-fixed-variant": "#623f0f",
            "on-tertiary-container": "#c6965e",
            "secondary": "#5d5e62",
            "tertiary-fixed": "#ffddb9",
            "surface-container-lowest": "#ffffff",
            "primary": "#002046",
            "background": "#f9f9f9",
            "on-secondary-fixed": "#191c1e",
            "error": "#ba1a1a",
            "on-primary-fixed-variant": "#2e476f",
            "on-primary-container": "#87a0cd",
            "surface-bright": "#f9f9f9",
            "secondary-fixed-dim": "#c5c6ca",
            "outline-variant": "#c4c6cf",
            "on-surface-variant": "#44474e",
            "error-container": "#ffdad6",
            "outline": "#74777f",
            "on-error-container": "#93000a",
            "surface-container-highest": "#e2e2e2",
            "tertiary": "#321c00",
            "surface-variant": "#e2e2e2",
            "on-error": "#ffffff",
            "on-tertiary": "#ffffff",
            "on-primary": "#ffffff",
            "primary-container": "#1b365d",
            "on-tertiary-fixed": "#2b1700",
            "on-secondary-container": "#636468",
            "secondary-fixed": "#e2e2e6",
            "primary-fixed": "#d6e3ff",
            "tertiary-container": "#4f2f00",
            "surface-container": "#eeeeee",
            "on-background": "#1a1c1c",
            "surface-container-high": "#e8e8e8",
            "inverse-primary": "#aec7f7",
            "on-secondary": "#ffffff",
            "inverse-surface": "#2f3131",
            "inverse-on-surface": "#f1f1f1",
            "on-surface": "#1a1c1c"
          },
          borderRadius: {
            "DEFAULT": "0.125rem",
            "lg": "0.25rem",
            "xl": "0.5rem",
            "full": "0.75rem"
          },
          fontFamily: {
            "headline": ["Manrope"],
            "body": ["Inter"],
            "label": ["Inter"]
          }
        }
      }
    }
  </script>
  <style is:inline>
    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
      display: inline-block;
      vertical-align: middle;
    }
    .bg-machined {
      background: linear-gradient(45deg, #002046 0%, #1B365D 100%);
    }
    .editorial-shadow {
      box-shadow: 0 32px 64px -12px rgba(26, 28, 28, 0.04);
    }
  </style>
</head>
<body class="bg-background text-on-background font-body selection:bg-primary-fixed selection:text-on-primary-fixed">

<!-- Top Navigation -->
<nav class="fixed top-0 w-full z-50 bg-white/85 dark:bg-slate-900/85 backdrop-blur-md border-b border-slate-200/20 shadow-sm transition-all duration-300 ease-in-out">
  <div class="flex justify-between items-center px-12 h-20 max-w-[1920px] mx-auto">
    <a href="/" aria-label="VIPAR S.A. — Inicio">
