  </div>
  <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
    <div class="text-center group cursor-pointer">
      <div class="aspect-square bg-surface-container rounded-full mb-4 flex items-center justify-center border border-vipar-border group-hover:border-vipar-accent transition-colors overflow-hidden relative">
