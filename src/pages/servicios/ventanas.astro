---
// Ventanas de Aluminio - static page based on Stitch design
const title = "Ventanas de Aluminio | VIPAR S.A.";
const description = "Ventanas de aluminio y cristal templado en Paraguay. Fabricación e instalación a medida para proyectos residenciales y corporativos.";
const canonical = "https://vipar.com.py/servicios/ventanas";
const whatsappNumber = "595981256510";
const whatsappMessage = "Hola, quiero cotizar ventanas de aluminio. Me comunico desde su página web.";
const whatsappLink = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href={canonical} />

  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />

  <script is:inline src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
  <script is:inline id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "error": "#ba1a1a",
            "tertiary": "#08141b",
            "surface": "#f3faff",
            "surface-dim": "#c5deeb",
            "primary-fixed-dim": "#b0c9e2",
            "primary-container": "#0f2a3d",
            "tertiary-container": "#1d2930",
            "background": "#f3faff",
            "secondary-container": "#89d2fe",
            "outline": "#73777d",
            "inverse-surface": "#1c333d",
            "on-primary-container": "#7992a9",
            "on-primary": "#ffffff",
            "surface-container-high": "#d3ecf9",
            "surface-bright": "#f3faff",
            "surface-tint": "#486176",
            "surface-container-highest": "#cee6f3",
            "inverse-primary": "#b0c9e2",
            "surface-variant": "#cee6f3",
            "surface-container-low": "#e6f6ff",
            "on-error": "#ffffff",
            "on-tertiary-fixed-variant": "#3c4950",
            "on-surface-variant": "#43474c",
            "on-secondary-container": "#005b7d",
            "primary": "#001524",
            "surface-container-lowest": "#ffffff",
            "on-primary-fixed": "#011e30",
            "primary-fixed": "#cce6ff",
            "on-tertiary-fixed": "#111d24",
            "on-secondary-fixed-variant": "#004c6a",
            "error-container": "#ffdad6",
            "inverse-on-surface": "#dff4ff",
            "secondary-fixed": "#c5e7ff",
            "on-surface": "#051e28",
            "on-primary-fixed-variant": "#30495e",
            "on-background": "#051e28",
            "secondary-fixed-dim": "#86cffb",
            "tertiary-fixed": "#d7e4ee",
            "secondary": "#00658b",
            "on-tertiary": "#ffffff",
            "on-error-container": "#93000a",
            "surface-container": "#d9f2ff",
            "on-secondary": "#ffffff",
            "tertiary-fixed-dim": "#bbc8d1",
            "outline-variant": "#c3c7cd",
            "on-tertiary-container": "#839099",
            "on-secondary-fixed": "#001e2d",
            "vipar-accent": "#2F80A8",
            "vipar-muted": "#EEF2F4",
            "vipar-base": "#FFFFFF",
            "vipar-border": "#D9DEE2"
          },
          borderRadius: {
            "DEFAULT": "0.25rem",
            "lg": "0.5rem",
            "xl": "0.75rem",
            "full": "9999px"
          },
          spacing: {
            "stack-md": "24px",
            "gutter": "24px",
            "base": "8px",
            "stack-lg": "48px",
            "section-padding": "80px",
            "container-max": "1280px",
            "stack-sm": "12px"
          },
          fontFamily: {
            "body-lg": ["Inter"],
            "h1": ["Inter"],
            "display": ["Inter"],
            "body-md": ["Inter"],
            "label-caps": ["Inter"],
            "h2": ["Inter"]
          },
          fontSize: {
            "body-lg": ["18px", { "lineHeight": "1.6", "fontWeight": "400" }],
            "h1": ["42px", { "lineHeight": "1.2", "letterSpacing": "-0.01em", "fontWeight": "700" }],
            "display": ["56px", { "lineHeight": "1.1", "letterSpacing": "-0.02em", "fontWeight": "700" }],
            "body-md": ["16px", { "lineHeight": "1.5", "fontWeight": "400" }],
            "label-caps": ["12px", { "lineHeight": "1.0", "letterSpacing": "0.05em", "fontWeight": "600" }],
            "h2": ["28px", { "lineHeight": "1.3", "fontWeight": "600" }]
          }
        }
      }
    }
  </script>
  <style is:inline>
    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }
    body { background-color: #EEF2F4; }
    .vipar-btn-primary {
      background-color: #2F80A8;
      color: #ffffff;
      border-radius: 6px;
      font-family: 'Inter', sans-serif;
      font-weight: 700;
      padding: 12px 24px;
      transition: all 0.2s ease;
      display: inline-block;
    }
    .vipar-btn-primary:hover {
      opacity: 0.9;
      transform: translateY(-1px);
    }
    .vipar-btn-secondary {
      background-color: transparent;
      color: #2F80A8;
      border: 1px solid #2F80A8;
      border-radius: 6px;
      font-family: 'Inter', sans-serif;
      font-weight: 600;
      padding: 12px 24px;
      transition: all 0.2s ease;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }
    .vipar-btn-secondary:hover {
      background-color: rgba(47, 128, 168, 0.05);
    }
  </style>
</head>
<body class="font-body-md text-on-surface antialiased bg-background">

<!-- TopNavBar -->
<nav class="bg-surface-container-lowest/95 backdrop-blur-md font-label-caps text-label-caps uppercase top-0 sticky z-50 border-b border-vipar-border w-full">
  <div class="max-w-[1280px] w-full mx-auto flex justify-between items-center h-20 px-8">
    <a href="/" aria-label="VIPAR S.A. — Inicio">
      <img src="/img/logo.png" alt="VIPAR S.A." class="hidden md:block h-9 w-auto" />
      <img src="/img/logo-simple.png" alt="VIPAR S.A." class="block md:hidden h-9 w-9" />
    </a>
    <div class="hidden md:flex gap-8">
      <a class="text-on-surface-variant hover:text-vipar-accent transition-colors" href="/">Inicio</a>
      <a class="text-vipar-accent border-b-2 border-vipar-accent pb-1" href="/servicios/">Servicios</a>
      <a class="text-on-surface-variant hover:text-vipar-accent transition-colors" href="/obras/">Obras</a>
      <a class="text-on-surface-variant hover:text-vipar-accent transition-colors" href="/nosotros/">Nosotros</a>
      <a class="text-on-surface-variant hover:text-vipar-accent transition-colors" href="/contacto/">Contacto</a>
    </div>
    <a class="vipar-btn-primary text-sm uppercase tracking-wider" href="/contacto/">Solicitar presupuesto</a>
  </div>
</nav>

<!-- Hero Section -->
<section class="max-w-container-max mx-auto px-gutter py-section-padding grid md:grid-cols-2 gap-stack-lg items-center min-h-[680px]">
  <div class="space-y-stack-md">
    <span class="font-label-caps text-label-caps text-vipar-accent block">Ventanas en Paraguay</span>
    <h1 class="font-h1 text-h1 text-primary-container">Ventanas de aluminio y cristal templado en Paraguay</h1>
    <p class="font-body-lg text-body-lg text-on-surface-variant">Soluciones arquitectónicas de alta precisión para proyectos residenciales y corporativos. Fabricación e instalación garantizada bajo estrictos estándares técnicos.</p>
    <div class="flex flex-wrap gap-4 pt-4">
      <a class="vipar-btn-primary" href="/contacto/">Cotizar ventana</a>
      <a class="vipar-btn-secondary" href={whatsappLink} target="_blank" rel="noopener noreferrer">
        <span class="material-symbols-outlined text-xl">chat</span> WhatsApp
      </a>
    </div>
    <div class="flex flex-wrap gap-2 pt-8 border-t border-vipar-border">
      <span class="px-3 py-1 bg-surface-container text-xs font-semibold text-primary-container rounded border border-vipar-border">Basculantes</span>
      <span class="px-3 py-1 bg-surface-container text-xs font-semibold text-primary-container rounded border border-vipar-border">Corredizas</span>
      <span class="px-3 py-1 bg-surface-container text-xs font-semibold text-primary-container rounded border border-vipar-border">Cristal templado</span>
      <span class="px-3 py-1 bg-surface-container text-xs font-semibold text-primary-container rounded border border-vipar-border">A medida</span>
    </div>
  </div>
  <div class="h-full min-h-[500px] bg-vipar-border rounded-xl overflow-hidden relative border border-vipar-border">
    <img alt="Instalación de ventana de aluminio arquitectónica" class="absolute inset-0 w-full h-full object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuD-2XOymuc61Lhid1fIDjX1Gcz3dK6EhJH7wtDYoMTkKMC6Pq8tmCmqYoyd44ta6tFX5045eCPaZE1WilmHAft7h600VpJzXBQ02QWJu8UXp9gs1RVcyrNiRBo4lqzYh4GpFIz3pX5MfstV41YNt-b6ytbHzcNlZxD3M-F9RHwanL_b78Wugm4t1V_2qSEuP5iQ1RQcDbItSbEhv53-G4VWGwEWdJc8mgq3RWNfi304A6SoXlVLJJ3qCBCDlHHyvP3pu0CbhNpNKf-j" />
  </div>
</section>

<!-- Problem Block -->
<section class="bg-surface-container-lowest py-section-padding border-y border-vipar-border">
  <div class="max-w-container-max mx-auto px-gutter grid md:grid-cols-2 gap-stack-lg items-center">
    <div class="space-y-stack-md">
      <h2 class="font-h2 text-h2 text-primary-container">¿Necesitás cambiar, instalar o cotizar ventanas para tu obra?</h2>
      <p class="font-body-md text-on-surface-variant">Resolver problemas de cerramientos requiere precisión. Te ayudamos a identificar la solución correcta para tus necesidades específicas.</p>
    </div>
    <div class="bg-surface rounded-xl p-8 border border-vipar-border space-y-4">
      <div class="flex items-start gap-4">
        <span class="material-symbols-outlined text-error mt-1">warning</span>
        <div>
          <h3 class="font-bold text-on-surface">Poca ventilación</h3>
          <p class="text-sm text-on-surface-variant">Espacios cerrados o húmedos que requieren flujo constante.</p>
        </div>
      </div>
      <div class="flex items-start gap-4">
        <span class="material-symbols-outlined text-error mt-1">warning</span>
        <div>
          <h3 class="font-bold text-on-surface">Mala entrada de luz</h3>
          <p class="text-sm text-on-surface-variant">Ambientes oscuros que necesitan maximizar la luz natural.</p>
        </div>
      </div>
      <div class="flex items-start gap-4">
        <span class="material-symbols-outlined text-error mt-1">warning</span>
        <div>
          <h3 class="font-bold text-on-surface">Filtraciones</h3>
          <p class="text-sm text-on-surface-variant">Problemas con lluvia o polvo debido a aberturas defectuosas.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Soluciones en Aberturas -->
<section class="max-w-container-max mx-auto px-gutter py-section-padding">
  <div class="mb-stack-lg text-center">
    <h2 class="font-h2 text-h2 text-primary-container mb-4">Soluciones en Aberturas</h2>
    <p class="font-body-md text-on-surface-variant max-w-2xl mx-auto">Fabricamos e instalamos ventanas a medida, utilizando perfilería de aluminio de alta resistencia y cristal templado de seguridad.</p>
  </div>
  <div class="grid md:grid-cols-3 gap-8">
    <!-- Card 1 -->
    <div class="bg-surface-container-lowest border border-vipar-border rounded-xl overflow-hidden flex flex-col h-full hover:shadow-lg transition-shadow">
      <div class="h-48 bg-vipar-muted relative">
        <img alt="Ventana Basculante de aluminio" class="absolute inset-0 w-full h-full object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAFrYCkpK_Jtq9rDtp4GQl_tYm9FnppbhqKQBytEULWxtjZCKNw-wSWrVIpUfZ-dbPCpJCFu4sxdMXsBJbU1RjUKNyCtPtLV4xa2cWhk9WtYhm41LIFbIfLO8Flv4qwno1_WZ_B5w9LZgXJM96TU38xeFaaxBhih9q9ZYzE0S-xMYxbqMCukRmtzq8J0tZ5Ei-kPdRQoQa72qXCa-HIKRSlM61X9B1aemyRUtaH_Px7WRQjC5hJ7xhDILLFBmBr_LO6DAAcLhUumuJc" />
      </div>
      <div class="p-6 flex-1 flex flex-col">
        <h3 class="font-bold text-xl text-on-surface mb-2">Ventana Basculante</h3>
        <p class="text-on-surface-variant text-sm mb-4">Abertura de eje horizontal que permite ventilación constante y segura. Ideal para espacios donde se requiere privacidad y flujo de aire continuo.</p>
        <div class="mb-4">
          <h4 class="font-semibold text-xs text-on-surface uppercase tracking-wide mb-2">Ideal para:</h4>
          <ul class="text-sm text-on-surface-variant space-y-1 list-disc list-inside">
            <li>Baños y toilettes</li>
            <li>Cocinas</li>
            <li>Áreas de servicio</li>
          </ul>
        </div>
        <div class="mt-auto pt-4 border-t border-vipar-border">
          <a class="text-vipar-accent font-semibold text-sm hover:underline flex items-center gap-1" href="/contacto/">
            Solicitar cotización <span class="material-symbols-outlined text-sm">arrow_forward</span>
          </a>
        </div>
      </div>
    </div>
    <!-- Card 2 -->
    <div class="bg-surface-container-lowest border border-vipar-border rounded-xl overflow-hidden flex flex-col h-full hover:shadow-lg transition-shadow">
      <div class="h-48 bg-vipar-muted relative">
        <img alt="Ventana Corrediza de aluminio" class="absolute inset-0 w-full h-full object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDs2va21_6Uejboo8d_-DrT4feT09fanU04K0VqpViyeZUfWCqa595a_tJ5PddzEtnrmCy5QrA8pxVt914Qxg-7Y_NuAKXaUGuzweoejejR_BrMBxE7cBQ-wzeIWVCOZ4yDCBg_5TEjI4obHBCFdixYqW69gPHvZ3snP-64cqBeJcSI1lHVjCN3DWiHgRXu5MtihabG5I0FhAYzQFasUyPeBGKRW2MgskLGQbhwBP9Z-R8ZSu4voROIgVF4vmvKG0aiUpfbHAhi9dUu" />
      </div>
      <div class="p-6 flex-1 flex flex-col">
        <h3 class="font-bold text-xl text-on-surface mb-2">Ventana Corrediza</h3>
        <p class="text-on-surface-variant text-sm mb-4">Sistema de hojas deslizantes que optimiza el espacio interior. Ofrece gran superficie acristalada para máxima iluminación y vistas amplias.</p>
        <div class="mb-4">
          <h4 class="font-semibold text-xs text-on-surface uppercase tracking-wide mb-2">Ideal para:</h4>
          <ul class="text-sm text-on-surface-variant space-y-1 list-disc list-inside">
            <li>Dormitorios</li>
            <li>Salas de estar</li>
            <li>Balcones</li>
          </ul>
        </div>
        <div class="mt-auto pt-4 border-t border-vipar-border">
          <a class="text-vipar-accent font-semibold text-sm hover:underline flex items-center gap-1" href="/contacto/">
            Solicitar cotización <span class="material-symbols-outlined text-sm">arrow_forward</span>
          </a>
        </div>
      </div>
    </div>
    <!-- Card 3 -->
    <div class="bg-surface-container-lowest border border-vipar-border rounded-xl overflow-hidden flex flex-col h-full hover:shadow-lg transition-shadow">
      <div class="h-48 bg-vipar-muted relative">
        <img alt="Ventana con Cristal Templado" class="absolute inset-0 w-full h-full object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuC_AZXM1JTcYOaVXmvGw_Vze_hQmvNEAP7Zo4vt3xOhfE5BMcURTbfz5IBX6MZjzmCdyPiFH5AhiEcIDyf-6LKuIsTU6aGr8bdO_Aj-h3ztE6Xfjxg5Rhxw2PqcP0mlVVXD9bVR-OgNctN3iREvcS9-pBCWmFX-znQ1pp8tCNBVTqm_Mr9HyTM3e13VKT8J-4aOXKFRhKsM0qVnOxoB21qyLu-w2vrxqssp-ZlQj94-PR27YMLOi4VTs7wSfPC-AemqrbTdHRXveIBe" />
      </div>
      <div class="p-6 flex-1 flex flex-col">
        <h3 class="font-bold text-xl text-on-surface mb-2">Ventana con Cristal Templado</h3>
        <p class="text-on-surface-variant text-sm mb-4">Cerramientos de máxima seguridad y estética minimalista. El vidrio templado ofrece resistencia superior a impactos y cambios térmicos.</p>
        <div class="mb-4">
          <h4 class="font-semibold text-xs text-on-surface uppercase tracking-wide mb-2">Ideal para:</h4>
          <ul class="text-sm text-on-surface-variant space-y-1 list-disc list-inside">
            <li>Frentes comerciales</li>
            <li>Oficinas corporativas</li>
            <li>Cerramientos de quinchos</li>
          </ul>
        </div>
        <div class="mt-auto pt-4 border-t border-vipar-border">
          <a class="text-vipar-accent font-semibold text-sm hover:underline flex items-center gap-1" href="/contacto/">
            Solicitar cotización <span class="material-symbols-outlined text-sm">arrow_forward</span>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Selection Guide -->
<section class="bg-surface py-section-padding border-y border-vipar-border">
  <div class="max-w-container-max mx-auto px-gutter">
    <div class="mb-stack-lg text-center">
      <h2 class="font-h2 text-h2 text-primary-container mb-4">Guía de Selección</h2>
      <p class="font-body-md text-on-surface-variant max-w-2xl mx-auto">Encontrá el tipo de ventana adecuado según el ambiente y los requerimientos técnicos de tu obra.</p>
    </div>
    <div class="grid md:grid-cols-4 gap-4">
      <div class="col-span-1 bg-surface-container-lowest p-6 rounded-xl border border-vipar-border">
        <h3 class="font-bold text-on-surface mb-4 border-b border-vipar-border pb-2">Ambiente</h3>
        <div class="space-y-4">
