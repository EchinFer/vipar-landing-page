---
import ServiceLandingTemplate from "@components/servicio-template/ServiceLandingTemplate.astro";
import Layout from "@layouts/Layout.astro";
import { windowServiceContent } from "@lib/static-servicio-ventana";
import { SITE_URL, whatsappNumber } from "src/constants";

const serviceName = "Ventanas";
const whatsappLink = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(windowServiceContent.whatsappMessage)}`;
const canonical = `${SITE_URL}${windowServiceContent.canonicalPath}`;
---

<Layout
  title={windowServiceContent.title}
  description={windowServiceContent.description}
  canonical={canonical}
  keywords={windowServiceContent.keywords}
  hideWhatsappFAB={true}
  bodyClass="service-template-body"
  pageType="service"
  serviceName={serviceName}
>
  <ServiceLandingTemplate
    content={windowServiceContent}
    whatsappNumber={whatsappNumber}
    whatsappLink={whatsappLink}
    serviceName={serviceName}
  />
</Layout>
