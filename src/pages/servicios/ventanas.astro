            <span class="text-sm font-medium text-on-surface">Baños</span>
            <span class="material-symbols-outlined text-vipar-accent">arrow_forward</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-sm font-medium text-on-surface">Dormitorios</span>
            <span class="material-symbols-outlined text-vipar-accent">arrow_forward</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-sm font-medium text-on-surface">Salas</span>
            <span class="material-symbols-outlined text-vipar-accent">arrow_forward</span>
          </div>
          <div class="flex items-center justify-between">
            <span class="text-sm font-medium text-on-surface">Fachadas</span>
            <span class="material-symbols-outlined text-vipar-accent">arrow_forward</span>
          </div>
        </div>
      </div>
      <div class="col-span-3 grid md:grid-cols-3 gap-4">
        <div class="bg-surface-container-lowest p-6 rounded-xl border border-vipar-border flex flex-col justify-center items-center text-center">
          <span class="material-symbols-outlined text-4xl text-vipar-accent mb-2">air</span>
          <h4 class="font-bold text-on-surface mb-1">Basculante</h4>
          <p class="text-xs text-on-surface-variant">Alta ventilación, privacidad.</p>
        </div>
        <div class="bg-surface-container-lowest p-6 rounded-xl border border-vipar-border flex flex-col justify-center items-center text-center">
          <span class="material-symbols-outlined text-4xl text-vipar-accent mb-2">view_compact</span>
          <h4 class="font-bold text-on-surface mb-1">Corrediza</h4>
          <p class="text-xs text-on-surface-variant">Luz natural, optimización de espacio.</p>
        </div>
        <div class="bg-surface-container-lowest p-6 rounded-xl border border-vipar-border flex flex-col justify-center items-center text-center">
          <span class="material-symbols-outlined text-4xl text-vipar-accent mb-2">architecture</span>
          <h4 class="font-bold text-on-surface mb-1">Paño Fijo / Templado</h4>
          <p class="text-xs text-on-surface-variant">Seguridad, diseño, vistas amplias.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Aplicaciones por Proyecto -->
