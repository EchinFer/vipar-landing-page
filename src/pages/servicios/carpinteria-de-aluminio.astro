---
import AluminumChallengesSection from "@components/servicio-aluminio/AluminumChallengesSection.astro";
import AluminumHero from "@components/servicio-aluminio/AluminumHero.astro";
import AluminumSystemsSection from "@components/servicio-aluminio/AluminumSystemsSection.astro";
import RelatedWorksGallery from "@components/ui/RelatedWorksGallery.astro";
import QuoteCTA from "@components/ui/QuoteCTA.astro";
import Container from "@components/ui/Container.astro";
import Layout from "@layouts/Layout.astro";
import { getRelatedStaticObras } from "@lib/static-obras";
import { buildWhatsappMessage, buildWhatsappUrl } from "@lib/whatsapp";
import {
  aluminumChallengeItems,
  aluminumHeroImage,
  aluminumHeroSpecs,
  aluminumSystems,
} from "@lib/static-servicio-carpinteria-de-aluminio";
import "../../styles/servicio-carpinteria-de-aluminio.css";
import { SITE_URL, whatsappNumber } from "src/constants";

const serviceName = "Carpintería de aluminio";
const title = "Carpintería de aluminio en Paraguay | Puertas, ventanas y cerramientos | VIPAR";
const description =
  "Carpintería de aluminio para viviendas, comercios y obras. Consultá opciones para puertas, ventanas, aberturas y cerramientos según medidas, tipo de apertura y condiciones de instalación.";
const canonical = `${SITE_URL}/servicios/carpinteria-de-aluminio/`;
const keywords =
  "carpintería de aluminio paraguay, aberturas de aluminio, puertas y ventanas, cerramientos, aluminio a medida";
const whatsappLink = buildWhatsappUrl(
  buildWhatsappMessage({ serviceName, pageLabel: serviceName, prompt: "Hola, quiero cotizar carpintería de aluminio. Me comunico desde su página web." })
);
const relatedObras = getRelatedStaticObras("carpinteria-de-aluminio");
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  canonical={canonical}
  loadAosAssets={false}
  loadLightboxAssets={false}
  loadSwiperAssets={false}
  loadIsotopeAssets={false}
  loadBootstrapJs={false}
  useMaterialSymbols={false}
  bodyClass="aluminum-service-body"
  pageType="service"
  serviceName={serviceName}
>
  <main class="aluminum-service-page">
    <AluminumHero image={aluminumHeroImage} specs={aluminumHeroSpecs} whatsappHref={whatsappLink} />
    <AluminumChallengesSection items={aluminumChallengeItems} />
    <AluminumSystemsSection items={aluminumSystems} />
    <RelatedWorksGallery obras={relatedObras} />

    <section class="aluminum-service-section aluminum-service-final">
      <Container>
        <QuoteCTA
          whatsappNumber={whatsappNumber}
          whatsappHref={whatsappLink}
          serviceName={serviceName}
        />
      </Container>
    </section>
  </main>
</Layout>
