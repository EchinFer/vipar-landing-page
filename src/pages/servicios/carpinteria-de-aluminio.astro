---
// Carpintería de Aluminio - static page based on Stitch design (Corporate Full-Page Hub)
const title = "Carpintería de Aluminio | VIPAR S.A.";
const description = "Carpintería de aluminio en Paraguay: puertas batientes y corredizas a medida para viviendas, comercios y obras. Fabricación e instalación profesional.";
const canonical = "https://vipar.com.py/servicios/carpinteria-de-aluminio";
---
<!DOCTYPE html>
<html class="light" lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow" />
  <link rel="canonical" href={canonical} />

  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonical} />

  <script is:inline src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700&display=swap" rel="stylesheet" />
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
  <script is:inline id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "primary": "#001524",
            "on-error": "#ffffff",
            "surface-container": "#d9f2ff",
            "secondary-fixed-dim": "#86cffb",
            "on-surface-variant": "#43474c",
            "surface": "#f3faff",
            "on-background": "#051e28",
            "surface-container-highest": "#cee6f3",
            "tertiary-container": "#1d2930",
            "secondary-container": "#89d2fe",
            "primary-container": "#0f2a3d",
            "on-tertiary": "#ffffff",
            "tertiary-fixed-dim": "#bbc8d1",
            "on-tertiary-container": "#839099",
            "on-secondary-container": "#005b7d",
            "on-primary-container": "#7992a9",
            "surface-container-low": "#e6f6ff",
            "surface-variant": "#cee6f3",
            "secondary": "#00658b",
            "on-secondary": "#ffffff",
            "on-primary": "#ffffff",
            "tertiary-fixed": "#d7e4ee",
            "tertiary": "#08141b",
            "error": "#ba1a1a",
            "surface-container-lowest": "#ffffff",
            "inverse-on-surface": "#dff4ff",
            "outline": "#73777d",
            "secondary-fixed": "#c5e7ff",
            "on-error-container": "#93000a",
            "on-secondary-fixed-variant": "#004c6a",
            "on-secondary-fixed": "#001e2d",
            "surface-bright": "#f3faff",
            "outline-variant": "#c3c7cd",
            "on-tertiary-fixed-variant": "#3c4950",
            "background": "#f3faff",
            "surface-dim": "#c5deeb",
            "surface-container-high": "#d3ecf9",
            "on-surface": "#051e28",
            "inverse-primary": "#b0c9e2",
            "primary-fixed": "#cce6ff",
            "on-tertiary-fixed": "#111d24",
            "inverse-surface": "#1c333d",
            "surface-tint": "#486176",
            "primary-fixed-dim": "#b0c9e2",
            "on-primary-fixed": "#011e30",
            "on-primary-fixed-variant": "#30495e",
            "error-container": "#ffdad6"
          },
          borderRadius: {
            "DEFAULT": "0.25rem",
            "lg": "0.5rem",
            "xl": "0.75rem",
            "full": "9999px"
          },
          spacing: {
            "stack-lg": "48px",
            "stack-md": "24px",
            "stack-sm": "12px",
            "gutter": "24px",
            "container-max": "1280px",
            "section-padding": "100px",
            "base": "8px"
          },
          fontFamily: {
            "label-caps": ["Inter"],
            "h2": ["Inter"],
            "body-lg": ["Inter"],
            "display": ["Inter"],
            "body-md": ["Inter"],
            "h1": ["Inter"]
          },
          fontSize: {
            "label-caps": ["12px", { "lineHeight": "1.0", "letterSpacing": "0.05em", "fontWeight": "600" }],
            "h2": ["28px", { "lineHeight": "1.3", "fontWeight": "600" }],
            "body-lg": ["18px", { "lineHeight": "1.6", "fontWeight": "400" }],
            "display": ["56px", { "lineHeight": "1.1", "letterSpacing": "-0.02em", "fontWeight": "700" }],
            "body-md": ["16px", { "lineHeight": "1.5", "fontWeight": "400" }],
            "h1": ["42px", { "lineHeight": "1.2", "letterSpacing": "-0.01em", "fontWeight": "700" }]
          }
        }
      }
    }
  </script>
  <style is:inline>
    .material-symbols-outlined {
      font-variation-settings: 'FILL' 0, 'wght' 400, 'GRAD' 0, 'opsz' 24;
    }
    .material-symbols-outlined[data-weight="fill"] {
      font-variation-settings: 'FILL' 1;
    }
    body {
      background-color: #f3faff;
      color: #051e28;
    }
  </style>
</head>
<body class="antialiased font-body-md text-body-md bg-surface text-on-surface">

<!-- Navbar -->
<nav class="bg-surface font-inter tracking-tight antialiased full-width top-0 border-b border-outline-variant sticky z-50 py-4">
  <div class="max-w-container-max mx-auto px-8 flex justify-between items-center h-16 w-full">
    <a href="/" class="text-xl font-bold tracking-widest text-on-surface uppercase flex items-center">
      VIPAR S.A.
    </a>
    <div class="hidden md:flex items-center space-x-8">
      <a class="text-on-surface-variant hover:text-secondary font-label-caps text-label-caps transition-colors duration-200 uppercase" href="/">Inicio</a>
      <a class="text-secondary border-b-2 border-secondary pb-1 font-bold font-label-caps text-label-caps transition-colors duration-200 uppercase" href="/servicios/">Servicios</a>
      <a class="text-on-surface-variant hover:text-secondary font-label-caps text-label-caps transition-colors duration-200 uppercase" href="/obras/">Obras</a>
      <a class="text-on-surface-variant hover:text-secondary font-label-caps text-label-caps transition-colors duration-200 uppercase" href="/nosotros/">Nosotros</a>
      <a class="text-on-surface-variant hover:text-secondary font-label-caps text-label-caps transition-colors duration-200 uppercase" href="/contacto/">Contacto</a>
    </div>
    <a href="/contacto/" class="bg-primary text-on-primary px-6 py-3 rounded font-label-caps text-label-caps font-bold hover:bg-opacity-90 transition-colors uppercase">
      Solicitar presupuesto
    </a>
  </div>
</nav>

<!-- Hero Section -->
<section class="max-w-container-max mx-auto px-8 py-section-padding min-h-[800px] flex items-center relative bg-surface border-b border-outline-variant">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter w-full">
    <div class="lg:col-span-5 flex flex-col justify-center z-10 pr-8">
      <span class="font-label-caps text-label-caps text-secondary mb-stack-sm tracking-widest uppercase">Carpintería de aluminio en Paraguay</span>
      <h1 class="font-display text-display text-on-surface mb-stack-md">Puertas de aluminio a medida para viviendas, comercios y obras.</h1>
      <p class="font-body-lg text-body-lg text-on-surface-variant mb-stack-lg max-w-lg">
        Sistemas de cerramiento de alta precisión. Diseñamos, fabricamos e instalamos soluciones en aluminio que combinan estética contemporánea, aislamiento técnico y durabilidad estructural superior.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 mb-stack-md">
        <a href="/contacto/" class="bg-primary text-on-primary px-8 py-4 rounded font-body-lg text-body-lg font-bold hover:bg-opacity-90 transition-colors flex justify-center items-center">
          Cotizar puerta de aluminio
        </a>
        <a href="#tipos" class="bg-transparent border border-outline text-on-surface px-8 py-4 rounded font-body-lg text-body-lg font-semibold hover:bg-surface-variant transition-colors flex justify-center items-center">
          Ver tipos de puertas
        </a>
      </div>
      <div class="flex flex-wrap gap-4 mt-4">
        <div class="flex items-center gap-2 text-on-surface-variant font-label-caps text-label-caps bg-surface-container px-3 py-2 rounded border border-outline-variant uppercase">
          <span class="material-symbols-outlined text-sm">check_circle</span> Batiente
        </div>
        <div class="flex items-center gap-2 text-on-surface-variant font-label-caps text-label-caps bg-surface-container px-3 py-2 rounded border border-outline-variant uppercase">
          <span class="material-symbols-outlined text-sm">check_circle</span> Corrediza
        </div>
        <div class="flex items-center gap-2 text-on-surface-variant font-label-caps text-label-caps bg-surface-container px-3 py-2 rounded border border-outline-variant uppercase">
          <span class="material-symbols-outlined text-sm">check_circle</span> A Medida
        </div>
      </div>
    </div>
    <div class="lg:col-span-7 relative h-[600px] lg:h-full min-h-[600px] rounded-lg overflow-hidden border border-outline-variant bg-surface-container">
      <img alt="Instalación de puerta de aluminio" class="absolute inset-0 w-full h-full object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBzBy-5zjDXmXv4IGeZo9dwkWwvA8U-JVxNkqkwGd7K8dSoNtRkK8lQxhf_hMqtOTz78ErPCEAcqR3riFuMThijhFGT865URpyXwlUuLMJdrs6RmwLsR4VslpUaA57sD6Sbpr5Zd7GPXwnKVRXtZ08un-oeMfsHlU2W2FEse9AkkLq5oloe2vIPIV5e9k0UAOvl16itbdB5WxovEUJBgQupxQC0I1TQxdTUbxDnAYBfdbxJsLc-1mULCLNYElfxUeHL1dYtwOQ07dzj" />
      <div class="absolute bottom-8 left-8 right-8 bg-surface/95 backdrop-blur-md border border-outline-variant p-6 rounded flex justify-between items-center shadow-lg">
        <div>
          <div class="font-label-caps text-label-caps text-on-surface-variant uppercase mb-1">Perfilería</div>
          <div class="font-body-md text-body-md font-bold text-on-surface">Línea Herrero / Alta Prestación</div>
        </div>
        <div class="h-8 w-px bg-outline-variant"></div>
        <div>
          <div class="font-label-caps text-label-caps text-on-surface-variant uppercase mb-1">Vidriado</div>
          <div class="font-body-md text-body-md font-bold text-on-surface">Templado 10mm / DVH</div>
        </div>
        <div class="h-8 w-px bg-outline-variant"></div>
        <div>
          <div class="font-label-caps text-label-caps text-on-surface-variant uppercase mb-1">Cierre</div>
          <div class="font-body-md text-body-md font-bold text-on-surface">Multipunto Seguridad</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Problem Block -->
<section class="max-w-container-max mx-auto px-8 py-section-padding border-b border-outline-variant">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-gutter">
    <div class="lg:col-span-8 pr-12">
      <h2 class="font-h1 text-h1 text-on-surface mb-stack-md">Desafíos Arquitectónicos Resueltos con Precisión</h2>
      <p class="font-body-lg text-body-lg text-on-surface-variant mb-6">La elección de aberturas no es un tema menor. Las puertas tradicionales suelen sufrir problemas de deformación, filtraciones o pérdida térmica con el paso del tiempo. Nuestro enfoque en aluminio estructural elimina estas fricciones.</p>
      <p class="font-body-lg text-body-lg text-on-surface-variant mb-6">Al utilizar aleaciones de primera calidad y sistemas de herrajes diseñados para alto tránsito, garantizamos un cerramiento hermético, de suave operación y sin necesidad de mantenimiento complejo, resistiendo el exigente clima paraguayo.</p>
    </div>
    <div class="lg:col-span-4">
      <div class="bg-surface-container p-8 rounded-lg border border-outline-variant">
        <h3 class="font-h2 text-h2 text-on-surface mb-6">Casos Frecuentes</h3>
        <ul class="space-y-4">
          <li class="flex items-start gap-3">
            <span class="material-symbols-outlined text-secondary mt-1">water_drop</span>
            <div>
              <strong class="block text-on-surface">Filtraciones de agua y aire</strong>
              <span class="text-on-surface-variant text-sm">Resuelto con doble burlete perimetral y felpas densas.</span>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <span class="material-symbols-outlined text-secondary mt-1">compress</span>
            <div>
              <strong class="block text-on-surface">Deformación por calor</strong>
              <span class="text-on-surface-variant text-sm">El aluminio mantiene su rigidez estructural independientemente de la temperatura.</span>
            </div>
          </li>
          <li class="flex items-start gap-3">
            <span class="material-symbols-outlined text-secondary mt-1">lock</span>
            <div>
              <strong class="block text-on-surface">Vulnerabilidad de seguridad</strong>
              <span class="text-on-surface-variant text-sm">Integración de cerraduras multipunto en perfilerías robustas.</span>
            </div>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- Tipos de Puertas -->
<section id="tipos" class="bg-surface-container-lowest py-section-padding border-b border-outline-variant">
  <div class="max-w-container-max mx-auto px-8">
    <div class="text-center mb-16">
      <h2 class="font-h1 text-h1 text-on-surface">Sistemas de Apertura</h2>
      <p class="font-body-lg text-body-lg text-on-surface-variant mt-4 max-w-2xl mx-auto">Configuraciones técnicas adaptadas a la planimetría y requerimientos de circulación de su proyecto.</p>
    </div>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 mb-24">
      <!-- Batiente -->
      <div class="flex flex-col border border-outline-variant rounded-lg overflow-hidden bg-surface">
        <div class="h-80 relative">
          <img alt="Puerta Batiente de aluminio" class="w-full h-full object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAmaxrsGImcIX8kmQzBUrkxyJH9EVhvCEc3yGMizUZDp53uVGg7Rwtd9fdGUPVs0mt23UF_2hTPomv0Unomt7kx0NRZXjmst-jpcwo-Spm_LSIvUzqsDLWksoxtnBtcYGEluUClIDcr5IO-35rqEb1tmQNZofC90NOzTPB51KTwqdMC2-moGbfGLVoV5FJ60a_nvYoC9kk4LSyg7tcCwNLuAkRZHjUg8gXDH4ODEY9mveHA67q4Wco_dmY7MJjmHFlhD9QhnvrLAXyj" />
        </div>
        <div class="p-10 flex-grow flex flex-col">
          <h3 class="font-display text-h2 text-on-surface mb-4">Puertas Batientes de Aluminio</h3>
          <p class="text-on-surface-variant mb-8 flex-grow">Sistema de apertura pivotante tradicional optimizado para máxima estanqueidad. Ideal para accesos principales e interiores donde el espacio de barrido no es una limitante.</p>
          <div class="mb-8">
            <h4 class="font-label-caps text-label-caps text-on-surface mb-3 uppercase tracking-widest">Ideal para:</h4>
            <ul class="text-sm text-on-surface-variant list-disc pl-5 space-y-1">
              <li>Accesos principales a viviendas.</li>
              <li>Puertas interiores de alto tránsito comercial.</li>
              <li>Salidas de emergencia.</li>
            </ul>
          </div>
          <div class="mb-8">
            <h4 class="font-label-caps text-label-caps text-on-surface mb-3 uppercase tracking-widest">Problemas Resueltos:</h4>
            <ul class="text-sm text-on-surface-variant list-disc pl-5 space-y-1">
              <li>Máxima hermeticidad acústica y térmica.</li>
              <li>Integración sencilla de cerraduras electromagnéticas.</li>
            </ul>
          </div>
          <div class="flex flex-wrap gap-2 mb-8">
            <span class="bg-surface-container-high px-3 py-1 rounded-full text-xs text-on-surface">Bisagras reforzadas</span>
            <span class="bg-surface-container-high px-3 py-1 rounded-full text-xs text-on-surface">Doble Contacto</span>
          </div>
          <a href="/contacto/" class="w-full border border-primary text-primary py-3 rounded font-bold hover:bg-primary hover:text-white transition-colors text-center block">Cotizar Batiente</a>
        </div>
      </div>
      <!-- Corrediza -->
      <div class="flex flex-col border border-outline-variant rounded-lg overflow-hidden bg-surface">
        <div class="h-80 relative">
          <img alt="Puerta Corrediza de aluminio" class="w-full h-full object-cover" src="https://lh3.googleusercontent.com/aida-public/AB6AXuAgUPSovzoXWYbZs0PrcdjMlwX1piiO2BZdJkK_HfqcWNcmoU448Be-h-3urpeSTgmWeT8z9aVyudKvTfi9OjRkH763ozCl5vnmwY9lM9blMR-p0GBh0bVOULiHICJ7l8DFHjIUguP7qAn1EQRSGDUOG3U4V8drC-x7MVLBSjVOsLsEp1GlK-GWXoPG9vjxymzwhJainhCVq8T7nd1NHd5ZVtG9Yy7dfr3OG6isHLoJ3sF_GCgGGuSAk6Ym3I9yMI9fWC7coC7tUQnQ" />
        </div>
        <div class="p-10 flex-grow flex flex-col">
          <h3 class="font-display text-h2 text-on-surface mb-4">Puertas Corredizas de Aluminio</h3>
          <p class="text-on-surface-variant mb-8 flex-grow">Sistemas de desplazamiento sobre rieles que maximizan la amplitud visual y el aprovechamiento espacial. Perfectas para integrar ambientes interiores con exteriores.</p>
          <div class="mb-8">
            <h4 class="font-label-caps text-label-caps text-on-surface mb-3 uppercase tracking-widest">Ideal para:</h4>
            <ul class="text-sm text-on-surface-variant list-disc pl-5 space-y-1">
              <li>Salidas a galerías y patios.</li>
              <li>Balcones en departamentos.</li>
              <li>Divisiones de ambientes amplios.</li>
            </ul>
          </div>
          <div class="mb-8">
            <h4 class="font-label-caps text-label-caps text-on-surface mb-3 uppercase tracking-widest">Problemas Resueltos:</h4>
            <ul class="text-sm text-on-surface-variant list-disc pl-5 space-y-1">
              <li>Ahorro total de espacio de barrido.</li>
              <li>Grandes luces de acristalamiento.</li>
            </ul>
          </div>
          <div class="flex flex-wrap gap-2 mb-8">
            <span class="bg-surface-container-high px-3 py-1 rounded-full text-xs text-on-surface">Rodamientos regulables</span>
            <span class="bg-surface-container-high px-3 py-1 rounded-full text-xs text-on-surface">Felpa perimetral</span>
          </div>
          <a href="/contacto/" class="w-full border border-primary text-primary py-3 rounded font-bold hover:bg-primary hover:text-white transition-colors text-center block">Cotizar Corrediza</a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Final CTA -->
<section class="bg-primary text-on-primary py-section-padding">
  <div class="max-w-container-max mx-auto px-8 grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
    <div>
      <h2 class="font-h1 text-h1 mb-6">Inicie su proyecto con precisión.</h2>
      <p class="font-body-lg text-inverse-primary mb-8">Póngase en contacto con nuestro departamento técnico para recibir asesoramiento sobre perfilerías, presupuestos y plazos de ejecución.</p>
    </div>
    <div class="bg-surface p-8 rounded-lg">
      <form class="flex flex-col gap-4" action="/contacto/" method="GET">
        <input class="border border-outline-variant rounded p-3 bg-surface-container text-on-surface" placeholder="Nombre completo" type="text" name="nombre" />
        <input class="border border-outline-variant rounded p-3 bg-surface-container text-on-surface" placeholder="Correo electrónico" type="email" name="email" />
        <textarea class="border border-outline-variant rounded p-3 bg-surface-container text-on-surface h-32" placeholder="Detalles del proyecto" name="mensaje"></textarea>
        <a href="/contacto/" class="bg-secondary text-white py-4 rounded font-bold uppercase tracking-widest hover:bg-opacity-90 text-center">Enviar Consulta Técnica</a>
      </form>
    </div>
  </div>
</section>

<footer class="bg-[#001524] font-inter text-xs tracking-widest uppercase py-16 border-t border-slate-800 text-white">
  <div class="max-w-[1280px] mx-auto px-8 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">
    <div class="flex flex-col gap-6">
      <a href="/" class="text-lg font-black text-white">VIPAR S.A.</a>
      <p class="text-slate-400 normal-case tracking-normal">
        Ingeniería en cerramientos de aluminio y vidrio para proyectos arquitectónicos exigentes en Paraguay.
      </p>
    </div>
    <div class="flex flex-col gap-4">
      <span class="text-sky-400 font-bold border-b border-slate-800 pb-2 w-fit">Soluciones</span>
      <a class="text-slate-400 hover:text-white transition-all duration-300 ease-in-out" href="/servicios/mamparas-divisorias">Mamparas Divisorias</a>
      <a class="text-sky-400 hover:text-white transition-all duration-300 ease-in-out" href="/servicios/carpinteria-de-aluminio">Carpintería de Aluminio</a>
      <a class="text-slate-400 hover:text-white transition-all duration-300 ease-in-out" href="/servicios/box-de-bano">Box de Baño</a>
      <a class="text-slate-400 hover:text-white transition-all duration-300 ease-in-out" href="/servicios/ventanas">Ventanas</a>
    </div>
    <div class="flex flex-col gap-4">
      <span class="text-sky-400 font-bold border-b border-slate-800 pb-2 w-fit">Empresa</span>
      <a class="text-slate-400 hover:text-white transition-all duration-300 ease-in-out" href="/nosotros/">Nosotros</a>
      <a class="text-slate-400 hover:text-white transition-all duration-300 ease-in-out" href="/obras/">Proyectos</a>
    </div>
    <div class="flex flex-col gap-4">
      <span class="text-sky-400 font-bold border-b border-slate-800 pb-2 w-fit">Contacto Técnico</span>
      <span class="text-slate-400 flex items-center gap-2 normal-case tracking-normal"><span class="material-symbols-outlined">location_on</span> Planta Industrial, Ñemby, PY</span>
      <span class="text-slate-400 flex items-center gap-2 normal-case tracking-normal"><span class="material-symbols-outlined">mail</span> info@vipar.com.py</span>
    </div>
  </div>
  <div class="max-w-[1280px] mx-auto px-8 mt-16 pt-8 border-t border-slate-800 text-slate-500 text-center">
    © 2025 VIPAR S.A. Todos los derechos reservados.
  </div>
</footer>

</body>
</html>
