---
import AluminumChallengesSection from "@components/servicio-aluminio/AluminumChallengesSection.astro";
import AluminumHero from "@components/servicio-aluminio/AluminumHero.astro";
import AluminumSystemsSection from "@components/servicio-aluminio/AluminumSystemsSection.astro";
import RelatedWorksGallery from "@components/ui/RelatedWorksGallery.astro";
import QuoteCTA from "@components/ui/QuoteCTA.astro";
import Container from "@components/ui/Container.astro";
import Layout from "@layouts/Layout.astro";
import { getRelatedStaticObras } from "@lib/static-obras";
import {
  aluminumChallengeItems,
  aluminumHeroImage,
  aluminumHeroSpecs,
  aluminumSystems,
} from "@lib/static-servicio-carpinteria-de-aluminio";
import "../../styles/servicio-carpinteria-de-aluminio.css";
import { SITE_URL, telephone } from "src/constants";

const title = "Carpintería de Aluminio | VIPAR S.A.";
const description =
  "Carpintería de aluminio en Paraguay: puertas batientes y corredizas a medida para viviendas, comercios y obras. Fabricación e instalación profesional.";
const canonical = `${SITE_URL}/servicios/carpinteria-de-aluminio`;
const keywords =
  "carpintería de aluminio paraguay, puertas de aluminio, puertas corredizas de aluminio, puertas batientes, aberturas de aluminio";
const whatsappNumber = telephone.replace(/[^\d]/g, "");
const relatedObras = getRelatedStaticObras("carpinteria-de-aluminio");
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  canonical={canonical}
  hideWhatsappFAB={true}
  bodyClass="aluminum-service-body"
>
  <main class="aluminum-service-page">
    <AluminumHero image={aluminumHeroImage} specs={aluminumHeroSpecs} />
    <AluminumChallengesSection items={aluminumChallengeItems} />
    <AluminumSystemsSection items={aluminumSystems} />
    <RelatedWorksGallery obras={relatedObras} />

    <section class="aluminum-service-section aluminum-service-final">
      <Container>
        <QuoteCTA whatsappNumber={whatsappNumber} />
      </Container>
    </section>
  </main>
</Layout>
