---
import CeilingDetailsSection from "@components/servicio-cielo/CeilingDetailsSection.astro";
import CeilingEnvironmentsSection from "@components/servicio-cielo/CeilingEnvironmentsSection.astro";
import CeilingFaqSection from "@components/servicio-cielo/CeilingFaqSection.astro";
import CeilingHero from "@components/servicio-cielo/CeilingHero.astro";
import CeilingSystemsSection from "@components/servicio-cielo/CeilingSystemsSection.astro";
import Container from "@components/ui/Container.astro";
import RelatedWorksGallery from "@components/ui/RelatedWorksGallery.astro";
import QuoteCTA from "@components/ui/QuoteCTA.astro";
import Layout from "@layouts/Layout.astro";
import { getRelatedStaticObras } from "@lib/static-obras";
import { buildWhatsappMessage, buildWhatsappUrl } from "@lib/whatsapp";
import {
  ceilingDetailImage,
  ceilingDetails,
  ceilingEnvironments,
  ceilingFaqs,
  ceilingHeroImage,
  ceilingMetrics,
  ceilingSystems,
} from "@lib/static-servicio-cielo-raso";
import "../../styles/servicio-cielo-raso.css";
import { SITE_URL, whatsappNumber } from "src/constants";

const serviceName = "Cielo raso";
const title = "Cielo raso en Paraguay | PVC, Durlock y sistemas desmontables | VIPAR";
const description =
  "Cielo raso para viviendas, oficinas, comercios y obras. Consultá opciones en PVC, Durlock, desmontable y Eucatex en Paraguay.";
const canonical = `${SITE_URL}/servicios/cielo-raso/`;
const keywords =
  "cielo raso paraguay, cielorraso pvc, desmontable, eucatex, durlock, techos, instalación";
const whatsappLink = buildWhatsappUrl(
  buildWhatsappMessage({
    serviceName,
    pageLabel: serviceName,
    prompt: "Puedo enviar fotos, medidas o referencias del espacio.",
  })
);
const relatedObras = getRelatedStaticObras("cielo-raso");
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  keywords={keywords}
  loadAosAssets={false}
  loadLightboxAssets={false}
  loadSwiperAssets={false}
  loadIsotopeAssets={false}
  loadBootstrapJs={false}
  loadBootstrapIcons={false}
  useMaterialSymbols={false}
  bodyClass="ceiling-service-body"
  pageType="service"
  serviceName={serviceName}
>
  <main class="ceiling-service-page">
    <CeilingHero image={ceilingHeroImage} whatsappHref={whatsappLink} />
    <CeilingEnvironmentsSection environments={ceilingEnvironments} metrics={ceilingMetrics} />
    <CeilingSystemsSection items={ceilingSystems} />
    <CeilingDetailsSection image={ceilingDetailImage} items={ceilingDetails} />
    <CeilingFaqSection items={ceilingFaqs} />
    <RelatedWorksGallery obras={relatedObras} />

    <section class="ceiling-service-section ceiling-service-final">
      <Container>
        <QuoteCTA
          whatsappNumber={whatsappNumber}
          whatsappHref={whatsappLink}
          serviceName={serviceName}
        />
      </Container>
    </section>
  </main>
</Layout>
