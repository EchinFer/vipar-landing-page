---
import Base from "../../layouts/Base.astro";
import CabeceraPagina from "../../components/CabeceraPagina.astro";
import ServicioCard from "../../components/ServicioCard.astro";
import Pasos from "../../components/Pasos.astro";
import BandaContacto from "../../components/BandaContacto.astro";
import { servicios } from "../../data/servicios";
---

<Base
	title="Servicios de cristales templados, aluminio y terminaciones | VIPAR S.A."
	description="Cristales templados, carpintería de aluminio, ventanas, puertas, mamparas, fachadas, cortinas de vidrio, cielo raso y box de baño en Paraguay."
	path="/servicios/"
>
	<CabeceraPagina
		kicker="Servicios"
		titulo="Cristales templados, aluminio y terminaciones para obras en Paraguay"
		texto="Nueve líneas de trabajo, todas a medida y con instalación. Elegí una para ver qué incluye, qué no incluye y qué obras hicimos. En cada una podés armar el pedido y mandarlo por WhatsApp con las medidas."
	/>
	<section class="px-4 py-14 md:px-8 md:py-20">
		<ul class="grid gap-3 md:grid-cols-3 md:gap-5">
			{
				servicios.map((servicio) => (
					<li class="reveal">
						<ServicioCard servicio={servicio} />
					</li>
				))
			}
		</ul>
	</section>
	<Pasos titulo="Cómo se pide un trabajo" />
	<BandaContacto />
</Base>
