---
import ObrasConfidence from "@components/obras/ObrasConfidence.astro";
import ObrasFeatured from "@components/obras/ObrasFeatured.astro";
import ObrasFilterBar from "@components/obras/ObrasFilterBar.astro";
import ObrasFinalCTA from "@components/obras/ObrasFinalCTA.astro";
import ObrasGrid from "@components/obras/ObrasGrid.astro";
import ObrasHero from "@components/obras/ObrasHero.astro";
import ObrasIntro from "@components/obras/ObrasIntro.astro";
import Layout from "@layouts/Layout.astro";
import { obraFilters, obrasHeroImage, staticObras } from "@lib/static-obras";
import "../styles/obras.css";
import { SITE_URL, telephone } from "src/constants";

const title = "Obras y Proyectos Realizados - Cristales Templados | VIPAR";
const description =
  "Portafolio de obras realizadas con cristales templados, carpintería de aluminio, fachadas vidrio y mamparas. Proyectos de construcción en Paraguay para viviendas, comercios, oficinas y obras.";
const keywords =
  "obras cristales templados, proyectos construcción Paraguay, fachadas vidrio, instalaciones cristal, obras carpintería aluminio, portfolio construcción, proyectos realizados";
const canonical = `${SITE_URL}/obras/`;
const whatsappNumber = telephone.replace(/[^\d]/g, "");
const featuredObra = staticObras[0];
const remainingObras = staticObras.slice(1);
const featuredTagline = featuredObra ? `${featuredObra.sectorLabel} / ${featuredObra.cliente}` : "";
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  canonical={canonical}
  bodyClass="vipar-obras-body"
>
  <main class="vipar-obras-main">
    <ObrasHero image={obrasHeroImage} />
    <ObrasIntro />
    {featuredObra && <ObrasFeatured obra={featuredObra} tagline={featuredTagline} />}
    <ObrasFilterBar filters={obraFilters} />
    <ObrasGrid obras={remainingObras} />
    <ObrasConfidence />
    <ObrasFinalCTA whatsappNumber={whatsappNumber} />
  </main>
</Layout>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const filterBar = document.querySelector(".vipar-obras-filter-bar");
    const cards = Array.from(document.querySelectorAll(".vipar-obras-card"));

    const applyFilter = (filter) => {
      cards.forEach((card) => {
        const tagList = card.getAttribute("data-tags") || "";
        const tags = tagList.split(",").map((tag) => tag.trim()).filter(Boolean);
        card.toggleAttribute("hidden", filter !== "all" && !tags.includes(filter));
      });
    };

    filterBar?.addEventListener("filterchange", (e) => {
      applyFilter(e.detail.value);
      window.posthog?.capture('obra_filter_applied', {
        filter_value: e.detail.value,
        page_path: window.location.pathname,
      });
    });

    applyFilter("all");
  });
</script>


