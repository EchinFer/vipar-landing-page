---
import Base from "../../layouts/Base.astro";
import Galeria from "../../components/Galeria.astro";
import { obras } from "../../data/obras";
---

<Base
	title="Obras | VIPAR S.A."
	description="Fachadas, viviendas, hospitales y locales hechos por VIPAR en Paraguay. Filtrá por residencial, comercial o institucional."
	path="/obras/"
>
	<header class="px-4 pt-8 md:px-8">
		<h1 class="max-w-[16ch] font-display text-5xl leading-none tracking-tight md:text-7xl">Obras hechas</h1>
		<p class="mt-4 max-w-lg text-muted">Cada ficha dice qué se instaló y en qué ciudad. Si la foto del sitio anterior no era de esa obra, no está.</p>
	</header>
	<Galeria obras={obras} activa="todas" />
</Base>
