---
import Base from "../../layouts/Base.astro";
import Galeria from "../../components/Galeria.astro";
import CabeceraPagina from "../../components/CabeceraPagina.astro";
import { obrasPublicadas } from "../../data/obras";
---

<Base
	title="Obras y proyectos realizados en Paraguay | VIPAR S.A."
	description="Fachadas, viviendas, hospitales y locales hechos por VIPAR en Paraguay. Filtrá por residencial, comercial o institucional."
	path="/obras/"
>
	<CabeceraPagina kicker="Obras" titulo="Obras y proyectos realizados por VIPAR" texto="Cada ficha dice qué se instaló y en qué ciudad. Si la foto del sitio anterior no era de esa obra, no está." h1Max="max-w-[18ch]" />
	<Galeria obras={obrasPublicadas} activa="todas" />
</Base>
