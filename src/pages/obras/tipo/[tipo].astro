---
import Base from "../../../layouts/Base.astro";
import Galeria from "../../../components/Galeria.astro";
import CabeceraPagina from "../../../components/CabeceraPagina.astro";
import { obrasDe, type TipoObra } from "../../../data/obras";

export function getStaticPaths() {
	return (["residencial", "comercial", "institucional"] as const).map((tipo) => ({
		params: { tipo },
		props: { tipo },
	}));
}

interface Props {
	tipo: TipoObra;
}
const { tipo } = Astro.props;
const lista = obrasDe(tipo);
const nombre = tipo.charAt(0).toUpperCase() + tipo.slice(1);
---

<Base
	title={`Obras ${nombre.toLowerCase()} | VIPAR S.A.`}
	description={`Obras ${nombre.toLowerCase()} de vidrio y aluminio hechas por VIPAR.`}
	path={`/obras/tipo/${tipo}/`}
>
	<CabeceraPagina kicker="Obras" titulo={`Obras ${nombre.toLowerCase()}s`} texto={`${lista.length} obras en esta lista.`} />
	<Galeria obras={lista} activa={tipo} />
</Base>
