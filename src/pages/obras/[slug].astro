---
import ObraCTA from "@components/obra-detail/ObraCTA.astro";
import ObraEditorial from "@components/obra-detail/ObraEditorial.astro";
import ObraFichaTecnica from "@components/obra-detail/ObraFichaTecnica.astro";
import ObraGallery from "@components/obra-detail/ObraGallery.astro";
import ObraHero from "@components/obra-detail/ObraHero.astro";
import ObraServiciosAplicados from "@components/obra-detail/ObraServiciosAplicados.astro";
import { staticObras } from "@lib/static-obras";
import Layout from "@layouts/Layout.astro";
import "@styles/obra-detail.css";
import { SITE_URL, telephone } from "src/constants";

export async function getStaticPaths() {
  return staticObras.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;

const title = `${project.titulo} - Obra Realizada | VIPAR Paraguay`;
const description = project.descripcion
  ? `${project.descripcion.replace(/<[^>]*>/g, "").substring(0, 150)}... Proyecto de ${project.category.map((c) => c.name).join(", ")} realizado por VIPAR.`
  : `Obra de ${project.category.map((c) => c.name).join(", ")}: ${project.titulo}. Instalación profesional en Paraguay.`;
const keywords = `${project.titulo}, ${project.category.map((c) => c.name).join(", ")}, obras cristales templados, proyectos construcción, instalación profesional Paraguay`;
const canonical = `${SITE_URL}/obras/${project.slug}`;
const whatsappNumber = telephone.replace(/[^\d]/g, "");
---

<Layout
  title={title}
  description={description}
  keywords={keywords}
  canonical={canonical}
  ogImage={project.imagen || `${SITE_URL}/img/vipar-og.webp`}
  hideWhatsappFAB={true}
>
  <ObraHero titulo={project.titulo} ubicacion={project.ubicacion} imagen={project.imagen} />

  <ObraFichaTecnica
    sectorLabel={project.sectorLabel}
    ubicacion={project.ubicacion}
    displayTags={project.displayTags}
  />

  <ObraEditorial descripcion={project.descripcion} />

  <ObraGallery titulo={project.titulo} systemLabel={project.systemLabel} imagen={project.imagen} imagenes={project.imagenes} />

  <ObraServiciosAplicados tags={project.displayTags} />

  <ObraCTA whatsappNumber={whatsappNumber} />

  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "CreativeWork",
      name: project.titulo,
      description: project.descripcion?.replace(/<[^>]*>/g, "") || `Obra: ${project.titulo}`,
      image: project.imagen || project.imagenes?.[0],
      creator: { "@type": "Organization", name: "Vipar", url: SITE_URL },
      datePublished: project.fecha,
      keywords: project.category.map((c) => c.name).join(", "),
      about: { "@type": "Thing", name: project.category[0]?.name || "Construcción" },
    })}
  />
</Layout>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    if (typeof GLightbox !== "undefined") {
      GLightbox({ selector: ".glightbox" });
    }
  });
</script>
