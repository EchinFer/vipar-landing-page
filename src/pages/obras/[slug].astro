---
import Base from "../../layouts/Base.astro";
import Foto from "../../components/Foto.astro";
import { nombreCompleto, obras } from "../../data/obras";
import { servicioPorSlug } from "../../data/servicios";
import { fotosDe } from "../../lib/fotos";
import BandaContacto from "../../components/BandaContacto.astro";
import NoMolesta from "../../components/NoMolesta.astro";
import { mensajeLibre, waUrl } from "../../lib/pedido";

export function getStaticPaths() {
	return obras.map((obra) => ({ params: { slug: obra.slug }, props: { obra } }));
}

const { obra } = Astro.props;
const fotos = fotosDe(obra.slug);
const nombre = nombreCompleto(obra);
const descripcion = `${obra.hecho} ${obra.ciudad ? `Obra de VIPAR en ${obra.ciudad}, Paraguay.` : "Obra realizada por VIPAR en Paraguay."}`;
const otras = obras
	.filter((otra) => otra.slug !== obra.slug && fotosDe(otra.slug).length > 0)
	.map((otra) => ({ otra, comunes: otra.servicios.filter((slug) => obra.servicios.includes(slug)).length }))
	.sort((a, b) => b.comunes - a.comunes)
	.slice(0, 4)
	.map(({ otra }) => otra);
const wa = mensajeLibre(`Quiero un presupuesto parecido a esta obra: ${obra.titulo}${obra.ciudad ? `, ${obra.ciudad}` : ""}. ${obra.hecho}`);
---

<Base title={`${nombre} - Obra realizada | VIPAR Paraguay`} description={descripcion} path={`/obras/${obra.slug}/`} waTexto={wa} imagen={fotos[0]} imagenAlt={nombre}>
	{
		fotos[0] ? (
			<Foto src={fotos[0]} alt={`${nombre}. ${obra.hecho}`} priority class="aspect-[4/5] w-full object-cover md:aspect-[16/8]" sizes="100vw" />
		) : (
			<div class="bg-brand px-4 py-16 text-white md:px-8">
				<p class="max-w-xl text-lg">{obra.sinFoto}</p>
			</div>
		)
	}
	<article class="grid gap-8 px-4 py-8 md:grid-cols-[1.4fr_0.8fr] md:px-8">
		<div>
			<p class="kicker text-muted"><a href="/obras/" class="underline-offset-4 hover:underline">Obras</a> / <a href={`/obras/tipo/${obra.tipo}/`} class="capitalize underline-offset-4 hover:underline">{obra.tipo}</a></p>
			<h1 class="mt-3 text-4xl leading-[1.04] text-brand md:text-6xl">{nombre}</h1>
			{obra.ciudad && <p class="mt-4 text-lg">{obra.ciudad}</p>}
			<p class="mt-4 max-w-xl text-xl leading-snug">{obra.hecho}</p>
			{
				obra.sinFoto && fotos.length === 0 && (
					<p class="mt-4 max-w-xl text-sm text-muted">{obra.sinFoto}</p>
				)
			}
		</div>
		<div>
			<p class="kicker text-muted">En esta obra</p>
			<ul class="mt-3 flex flex-wrap gap-2 text-sm">
			{
				obra.servicios.map((slug) => {
					const servicio = servicioPorSlug(slug);
					if (!servicio) return null;
					return (
						<li>
							<a href={`/servicios/${servicio.slug}/`} class="block border border-brand px-3 py-2 text-brand transition-colors hover:bg-brand hover:text-white">{servicio.nombre}</a>
						</li>
					);
				})
			}
			</ul>
			<a href={waUrl(wa)} data-origen="obra" class="btn btn-primary mt-6 w-full md:w-auto">Pedir algo parecido</a>
			<NoMolesta texto="No tiene que quedar igual. Contanos tu espacio." />
		</div>
	</article>
	{
		fotos.length > 1 && (
			<ul class="grid gap-2 px-4 pb-14 md:grid-cols-2 md:gap-3 md:px-8">
				{fotos.slice(1).map((foto) => (
					<li>
						<Foto src={foto} alt={`${nombre}, otra vista`} class="aspect-[4/3] w-full object-cover" sizes="(min-width: 768px) 50vw, 100vw" />
					</li>
				))}
			</ul>
		)
	}
	{
		otras.length > 0 && (
			<section class="bg-wash px-4 py-12 md:px-8 md:py-16">
				<div class="flex flex-wrap items-end justify-between gap-4">
					<h2 class="text-2xl leading-tight text-brand md:text-3xl">Otras obras parecidas</h2>
					<a href="/obras/" class="text-sm font-semibold text-brand underline underline-offset-4">Ver las {obras.length} obras →</a>
				</div>
				<ul class="mt-6 grid grid-cols-2 gap-2 md:grid-cols-4 md:gap-3">
					{otras.map((otra) => (
						<li>
							<a href={`/obras/${otra.slug}/`} class="zoom group relative block aspect-[4/5] overflow-hidden bg-brand">
								<Foto src={fotosDe(otra.slug)[0]} alt={otra.titulo} class="absolute inset-0 size-full object-cover" sizes="(min-width: 768px) 25vw, 50vw" widths={[480, 720, 1100, 1400]} />
								<div class="absolute inset-0 bg-gradient-to-t from-brand/85 via-transparent to-transparent"></div>
								<p class="absolute inset-x-0 bottom-0 p-3 text-sm font-bold text-white md:p-4 md:text-base">{otra.titulo}<span class="block text-xs font-normal text-white/80">{otra.ciudad}</span></p>
							</a>
						</li>
					))}
				</ul>
			</section>
		)
	}
	<BandaContacto texto={wa} />
</Base>
