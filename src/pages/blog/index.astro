---
import Base from "../../layouts/Base.astro";
import { notas } from "../../data/blog";
---

<Base
	title="Notas | VIPAR S.A."
	description="Notas de VIPAR sobre box de baño, cielo raso y mamparas: aperturas, sistemas, vidrio o panel y qué define el precio de cada trabajo."
	path="/blog/"
>
	<article class="px-4 py-10 md:px-8">
		<h1 class="font-display text-5xl leading-none tracking-tight md:text-7xl">Notas</h1>
		<p class="mt-4 max-w-lg text-muted">Textos con datos concretos de obras de VIPAR. Las notas de precio explican qué mueve el costo de cada trabajo, sin inventar un monto.</p>
		<ul class="mt-8 divide-y divide-aluminum border-y border-aluminum">
			{
				notas.map((nota) => (
					<li>
						<a href={`/blog/${nota.slug}/`} class="block py-5">
							<p class="font-display text-3xl leading-none">{nota.title}</p>
							<p class="mt-2 max-w-xl text-muted">{nota.description}</p>
						</a>
					</li>
				))
			}
		</ul>
	</article>
</Base>
