---
import Base from "../../layouts/Base.astro";
import Foto from "../../components/Foto.astro";
import Calculadora from "../../components/Calculadora.astro";
import AvisoPrecios from "../../components/AvisoPrecios.astro";
import { notas } from "../../data/blog";
import { servicioPorSlug } from "../../data/servicios";
import { obrasDelServicio } from "../../data/obras";
import { fotosDe } from "../../lib/fotos";
import { avisoCorto, calcPorSlug, desdeM2, formatGs, mensajeLibre, preciosVigencia, waUrl } from "../../lib/pedido";
import { canonical, empresa, migas, negocioId } from "../../data/empresa";

export function getStaticPaths() {
	return notas.map((nota) => ({ params: { slug: nota.slug }, props: { nota } }));
}

const { nota } = Astro.props;
const servicio = servicioPorSlug(nota.servicio);
const relacionadas = notas.filter((otra) => otra.servicio === nota.servicio && otra.slug !== nota.slug);
const titulo = nota.h1 ?? nota.title;
const wa = mensajeLibre(`Leí la guía «${titulo}» y quiero un presupuesto.`);
const calc = servicio ? calcPorSlug[servicio.slug] : undefined;
const desde = desdeM2(calc);
const conPrecios = nota.sections.some((seccion) => seccion.precios);
const guiaPrecios = notas.find((otra) => otra.servicio === nota.servicio && otra.actualizado && otra.slug !== nota.slug);
const ruta = `/blog/${nota.slug}/`;
const portada = servicio ? fotosDe(servicio.foto)[0] : undefined;
const obrasConFoto = servicio ? obrasDelServicio(servicio.slug).filter((obra) => fotosDe(obra.slug).length > 0).slice(0, 6) : [];

const palabras = [nota.description, ...nota.resumen, ...nota.sections.flatMap((seccion) => [seccion.titulo, ...seccion.parrafos])].join(" ").split(/\s+/).length;
const minutos = Math.max(1, Math.round(palabras / 200));
const ancla = (texto: string) =>
	texto
		.toLowerCase()
		.normalize("NFD")
		.replace(/[\u0300-\u036f]/g, "")
		.replace(/[^a-z0-9]+/g, "-")
		.replace(/^-|-$/g, "");
const secciones = nota.sections.map((seccion) => ({ ...seccion, id: ancla(seccion.titulo) }));

const jsonLd = [
	{
		"@type": "Article",
		headline: titulo,
		description: nota.description,
		url: canonical(ruta),
		mainEntityOfPage: canonical(ruta),
		inLanguage: "es-PY",
		image: new URL("/og.webp", empresa.site).href,
		author: { "@id": negocioId },
		publisher: { "@id": negocioId },
		...(nota.actualizado && { dateModified: nota.actualizado }),
		...(servicio && { about: { "@id": `${canonical(`/servicios/${servicio.slug}/`)}#servicio` } }),
	},
	migas(["Guías", "/blog/"], [titulo, ruta]),
];
---

<Base title={`${nota.title} | VIPAR S.A.`} description={nota.description} path={ruta} waTexto={wa} jsonLd={jsonLd}>
	<header class="panes bg-brand text-white">
		<div class="grid md:grid-cols-[1.25fr_1fr]">
			<div class="px-4 py-10 md:px-8 md:py-16">
				<p class="kicker text-sky"><a href="/blog/" class="underline-offset-4 hover:underline">Guías</a>{servicio && <> / <a href={`/servicios/${servicio.slug}/`} class="underline-offset-4 hover:underline">{servicio.nombre}</a></>}</p>
				<h1 class="mt-4 max-w-[24ch] text-[1.9rem] leading-[1.06] md:text-5xl">{titulo}</h1>
				<p class="mt-5 max-w-2xl text-lg leading-snug text-white/90">{nota.description}</p>
				<ul class="mt-6 flex flex-wrap gap-x-4 gap-y-1 border-t border-white/20 pt-4 text-sm text-white/90">
					<li><span aria-hidden="true" class="mr-1 text-sky">✓</span>Escrita por VIPAR, desde {empresa.desde} en {empresa.ciudad}</li>
					<li><span aria-hidden="true" class="mr-1 text-sky">✓</span>{minutos} min de lectura</li>
					{nota.actualizado && <li><span aria-hidden="true" class="mr-1 text-sky">✓</span>Precios de <time datetime={nota.actualizado}>{preciosVigencia}</time></li>}
				</ul>
			</div>
			{portada && servicio && (
				<div class="hidden md:block">
					<Foto src={portada} alt={servicio.nombre} priority class="size-full min-h-[24rem] object-cover" sizes="44vw" />
				</div>
			)}
		</div>
	</header>

	<div class="px-4 py-10 md:grid md:grid-cols-[1fr_20rem] md:gap-14 md:px-8 md:py-16">
		<article class="max-w-2xl">
			<section class="border border-brand p-5 md:p-7" aria-label="En pocas palabras">
				<p class="kicker text-muted">En pocas palabras</p>
				<ul class="mt-4 space-y-3">
					{nota.resumen.map((punto) => (
						<li class="flex gap-3 text-lg leading-snug"><span aria-hidden="true" class="font-bold text-brand">✓</span><span>{punto}</span></li>
					))}
				</ul>
				{conPrecios && <p class="mt-4 text-sm text-muted">{avisoCorto}</p>}
				<div class="mt-5 flex flex-wrap gap-3">
					<a href={waUrl(wa)} data-origen="resumen" class="btn btn-primary">Pedir presupuesto</a>
					{calc && <a href="#presupuesto" class="btn btn-line text-brand">Calcular mi caso</a>}
				</div>
				<details class="group mt-6 border-t border-aluminum/60 pt-4">
					<summary class="flex items-center justify-between gap-4 font-semibold text-brand">
						<span>En esta guía</span>
						<span aria-hidden="true" class="mas text-xl leading-none transition-transform">+</span>
					</summary>
					<ol class="mt-3 space-y-2">
						{secciones.map((seccion, orden) => (
							<li><a href={`#${seccion.id}`} class="flex gap-3 text-ink underline-offset-4 hover:underline"><span class="text-muted">{orden + 1}.</span>{seccion.titulo}</a></li>
						))}
					</ol>
				</details>
			</section>

			{
				secciones.map((seccion, orden) => (
					<>
						<section id={seccion.id} class="mt-12">
							<h2 class="text-2xl leading-tight text-brand md:text-3xl">{seccion.titulo}</h2>
							{seccion.parrafos.map((parrafo) => <p class="mt-4 text-lg leading-relaxed">{parrafo}</p>)}
							{seccion.tabla && (
								<table class="mt-6 w-full border-collapse text-left">
									<caption class="mb-2 text-left text-sm text-muted">{seccion.tabla.titulo}</caption>
									<thead>
										<tr>{seccion.tabla.columnas.map((columna) => <th scope="col" class="border-b-2 border-brand py-2 pr-4 text-sm font-semibold text-muted">{columna}</th>)}</tr>
									</thead>
									<tbody>
										{seccion.tabla.filas.map(([nombre, ...montos]) => (
											<tr class="border-b border-aluminum/60">
												<th scope="row" class="py-3 pr-4 text-lg font-normal">{nombre}</th>
												{montos.map((monto) => <td class="py-3 pr-4 text-lg font-bold whitespace-nowrap text-brand">{monto}</td>)}
											</tr>
										))}
									</tbody>
								</table>
							)}
							{seccion.precios && <AvisoPrecios asunto={wa} calcular={Boolean(calc)} />}
						</section>

						{orden === 1 && obrasConFoto.length > 1 && servicio && (
							<figure class="mt-12">
								<figcaption class="flex items-end justify-between gap-4">
									<span class="text-xl font-bold text-brand">Así quedan en obra</span>
									<a href={`/servicios/${servicio.slug}/#obras`} class="text-sm font-semibold text-brand underline underline-offset-4">Ver más</a>
								</figcaption>
								<ul class="-mx-4 mt-4 flex snap-x snap-mandatory gap-3 overflow-x-auto scroll-px-4 px-4 pb-2 md:mx-0 md:grid md:grid-cols-3 md:overflow-visible md:px-0">
									{obrasConFoto.slice(0, 3).map((obra) => (
										<li class="w-[70%] shrink-0 snap-start md:w-auto">
											<a href={`/obras/${obra.slug}/`} class="zoom group relative block aspect-[4/5] overflow-hidden bg-brand">
												<Foto src={fotosDe(obra.slug)[0]} alt={`${servicio.nombre} en ${obra.titulo}`} class="absolute inset-0 size-full object-cover" sizes="(min-width: 768px) 14rem, 70vw" widths={[320, 480, 720]} />
												<div class="absolute inset-0 bg-gradient-to-t from-brand/85 via-transparent to-transparent"></div>
												<p class="absolute inset-x-0 bottom-0 p-3 text-sm font-bold text-white">{obra.titulo}<span class="block text-xs font-normal text-white/80">{obra.ciudad}</span></p>
											</a>
										</li>
									))}
								</ul>
							</figure>
						)}

						{orden === 2 && !conPrecios && secciones.length > 3 && (
							<aside class="mt-12 bg-brand p-6 text-white md:p-8" aria-label="Pedir presupuesto">
								<p class="text-2xl leading-tight font-bold">¿Ya tenés una idea de lo que necesitás?</p>
								<p class="mt-3 text-white/90">Mandanos fotos y medidas aproximadas por WhatsApp. Te respondemos con el sistema que conviene y el presupuesto.</p>
								<div class="mt-5 flex flex-wrap gap-3">
									<a href={waUrl(wa)} data-origen="nota-medio" class="btn btn-light">Pedir presupuesto</a>
									{calc && <a href="#presupuesto" class="btn btn-line">Calcular mi caso</a>}
								</div>
							</aside>
						)}
					</>
				))
			}
		</article>
		{
			servicio && (
				<aside class="mt-12 md:mt-0">
					<div class="top-20 border border-brand p-6 md:sticky">
						<p class="kicker text-muted">Servicio</p>
						<p class="mt-2 text-2xl leading-tight font-bold text-brand">{servicio.nombre}</p>
						<p class="mt-3 text-sm leading-snug">{servicio.resumen}</p>
						{desde && (
							<p class="mt-3 text-sm">
								Desde <strong class="text-lg text-brand">{formatGs(desde)}</strong> por m², precio de referencia.
								{guiaPrecios && <a href={`/blog/${guiaPrecios.slug}/`} class="mt-1 block font-semibold text-brand underline underline-offset-4">Ver todos los precios</a>}
							</p>
						)}
						<a href={`/servicios/${servicio.slug}/`} class="mt-4 block font-semibold text-brand underline underline-offset-4">Ver el servicio y las obras →</a>
						<a href={waUrl(wa)} data-origen="nota" class="btn btn-primary mt-5 w-full">Pedir presupuesto</a>
					</div>
				</aside>
			)
		}
	</div>

	{
		calc && (
			<div class="px-4 pb-14 md:px-8">
				<Calculadora servicio={calc} />
			</div>
		)
	}

	{
		relacionadas.length > 0 && (
			<section class="bg-wash px-4 py-12 md:px-8 md:py-16">
				<p class="kicker text-muted">Seguí leyendo</p>
				<h2 class="mt-2 text-2xl leading-tight text-brand md:text-3xl">Más guías de {servicio?.nombre.toLowerCase()}</h2>
				<ul class="mt-6 grid gap-3 md:grid-cols-3">
					{relacionadas.map((otra) => (
						<li>
							<a href={`/blog/${otra.slug}/`} class="group flex h-full flex-col border border-aluminum/60 bg-white p-5 transition-shadow hover:shadow-lg">
								{otra.actualizado && <span class="mb-2 self-start bg-sky px-2 py-0.5 text-xs font-semibold text-brand">Con precios</span>}
								<p class="font-bold leading-snug text-brand">{otra.h1 ?? otra.title}</p>
								<p class="mt-2 text-sm text-muted">{otra.resumen[0]}</p>
								<p class="mt-auto pt-3 text-sm font-semibold text-brand">Leer <span aria-hidden="true" class="inline-block transition-transform group-hover:translate-x-1">→</span></p>
							</a>
						</li>
					))}
				</ul>
			</section>
		)
	}
</Base>
