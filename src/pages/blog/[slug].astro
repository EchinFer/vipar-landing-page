---
import Base from "../../layouts/Base.astro";
import Calculadora from "../../components/Calculadora.astro";
import AvisoPrecios from "../../components/AvisoPrecios.astro";
import NoMolesta from "../../components/NoMolesta.astro";
import { notas } from "../../data/blog";
import { servicioPorSlug } from "../../data/servicios";
import { calcPorSlug, desdeM2, formatGs, mensajeLibre, preciosVigencia, waUrl } from "../../lib/pedido";
import { canonical, migas, negocioId } from "../../data/empresa";
import { fotoDeServicio } from "../../lib/fotos";
import { imagenSocial } from "../../lib/social";

export function getStaticPaths() {
	return notas.map((nota) => ({ params: { slug: nota.slug }, props: { nota } }));
}

const { nota } = Astro.props;
const servicio = servicioPorSlug(nota.servicio);
const relacionadas = notas.filter((otra) => otra.servicio === nota.servicio && otra.slug !== nota.slug);
const wa = mensajeLibre(`Leí la nota «${nota.h1 ?? nota.title}» y quiero un presupuesto.`);
const calc = servicio ? calcPorSlug[servicio.slug] : undefined;
const desde = nota.actualizado ? desdeM2(calc) : null;
const ruta = `/blog/${nota.slug}/`;
const foto = servicio && fotoDeServicio(servicio);
const social = await imagenSocial(foto);
const jsonLd = [
	{
		"@type": "Article",
		headline: nota.h1 ?? nota.title,
		description: nota.description,
		url: canonical(ruta),
		mainEntityOfPage: canonical(ruta),
		inLanguage: "es-PY",
		image: social.url,
		author: { "@id": negocioId },
		publisher: { "@id": negocioId },
		...(nota.actualizado && { dateModified: nota.actualizado }),
		...(servicio && { about: { "@id": `${canonical(`/servicios/${servicio.slug}/`)}#servicio` } }),
	},
	migas(["Guías", "/blog/"], [nota.h1 ?? nota.title, ruta]),
];
---

<Base title={`${nota.title} | VIPAR S.A.`} description={nota.description} path={ruta} waTexto={wa} jsonLd={jsonLd} imagen={foto} imagenAlt={servicio?.nombre}>
	<header class="panes bg-brand px-4 py-12 text-white md:px-8 md:py-16">
		<p class="kicker text-sky"><a href="/blog/" class="underline-offset-4 hover:underline">Guías</a>{servicio && <> / <a href={`/servicios/${servicio.slug}/`} class="underline-offset-4 hover:underline">{servicio.nombre}</a></>}</p>
		<h1 class="mt-4 max-w-[26ch] text-[1.9rem] leading-[1.06] md:text-5xl">{nota.h1 ?? nota.title}</h1>
		<p class="mt-5 max-w-2xl text-lg leading-snug text-white/90">{nota.description}</p>
		{nota.actualizado && <p class="mt-4 text-sm text-sky">Precios actualizados en <time datetime={nota.actualizado}>{preciosVigencia}</time>.</p>}
	</header>

	<div class="px-4 py-12 md:grid md:grid-cols-[1fr_20rem] md:gap-14 md:px-8 md:py-16">
		<article class="max-w-2xl">
			{
				nota.sections.map((seccion) => (
					<section class="mt-10 first:mt-0">
						<h2 class="text-2xl leading-tight text-brand md:text-3xl">{seccion.titulo}</h2>
						{seccion.parrafos.map((parrafo) => <p class="mt-4 text-lg leading-relaxed">{parrafo}</p>)}
						{seccion.tabla && (
							<table class="mt-6 w-full border-collapse text-left">
								<caption class="mb-2 text-left text-sm text-muted">{seccion.tabla.titulo}</caption>
								<thead>
									<tr>{seccion.tabla.columnas.map((columna) => <th scope="col" class="border-b-2 border-brand py-2 pr-4 text-sm font-semibold text-muted">{columna}</th>)}</tr>
								</thead>
								<tbody>
									{seccion.tabla.filas.map(([nombre, ...montos]) => (
										<tr class="border-b border-aluminum/60">
											<th scope="row" class="py-3 pr-4 text-lg font-normal">{nombre}</th>
											{montos.map((monto) => <td class="py-3 pr-4 text-lg font-bold whitespace-nowrap text-brand">{monto}</td>)}
										</tr>
									))}
								</tbody>
							</table>
						)}
						{seccion.precios && <AvisoPrecios asunto={wa} calcular={Boolean(calc)} />}
					</section>
				))
			}
		</article>
		{
			servicio && (
				<aside class="mt-12 md:mt-0">
					<div class="top-20 border border-brand p-6 md:sticky">
						<p class="kicker text-muted">Servicio</p>
						<p class="mt-2 text-2xl leading-tight font-bold text-brand">{servicio.nombre}</p>
						<p class="mt-3 text-sm leading-snug">{servicio.resumen}</p>
						{desde && <p class="mt-3 text-sm">Desde <strong class="text-lg text-brand">{formatGs(desde)}</strong> por m², precio de referencia.</p>}
						<a href={`/servicios/${servicio.slug}/`} class="mt-4 block font-semibold text-brand underline underline-offset-4">Ver el servicio y las obras →</a>
						<a href={waUrl(wa)} data-origen="nota" class="btn btn-primary mt-5 w-full">Pedir presupuesto</a>
						<NoMolesta texto="Si algo no quedó claro, escribinos." />
					</div>
				</aside>
			)
		}
	</div>

	{
		servicio && calcPorSlug[servicio.slug] && (
			<div class="px-4 pb-14 md:px-8">
				<Calculadora servicio={calcPorSlug[servicio.slug]} />
			</div>
		)
	}

	{
		relacionadas.length > 0 && (
			<section class="bg-wash px-4 py-12 md:px-8 md:py-16">
				<p class="kicker text-muted">Del mismo tema</p>
				<ul class="mt-5 grid gap-3 md:grid-cols-3">
					{relacionadas.map((otra) => (
						<li>
							<a href={`/blog/${otra.slug}/`} class="group block h-full border border-aluminum/60 bg-white p-5 transition-shadow hover:shadow-lg">
								<p class="font-bold leading-snug text-brand">{otra.title}</p>
								<p class="mt-2 text-sm text-muted">{otra.description}</p>
							</a>
						</li>
					))}
				</ul>
			</section>
		)
	}
</Base>
