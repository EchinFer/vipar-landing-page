---
import Header from "@components/Header.astro";
import "@styles/design-system.css";
import "@styles/bootstrap.scss";

import "@assets/vendor/aos/aos.css";
import "@assets/vendor/glightbox/css/glightbox.min.css";
import "@assets/vendor/glightbox/css/plyr.min.css";
import "@assets/vendor/swiper/swiper-bundle.min.css";
import "@assets/vendor/bootstrap-icons/bootstrap-icons.css";
import ClientProvider from "./ClientProvider.astro";
import Footer from "@components/Footer.astro";
import WhatsappFAB from "@components/WhatsappFAB.astro";
import {
  MEASUREMENT_ID,
  SITE_URL,
  SOCIAL_LINKS,
  companyAddress,
  email,
  telephone,
} from "src/constants";
interface Props {
  title: string;
  description?: string;
  keywords?: string;
  canonical?: string;
  ogImage?: string;
  bodyClass?: string;
  pageType?: string;
  serviceName?: string;
  hideHeader?: boolean;
  hideFooter?: boolean;
  hideWhatsappFAB?: boolean;
  hideConsentBanner?: boolean;
}

const defaultDescription =
  "Empresa paraguaya especializada en cristales templados, carpintería de aluminio y soluciones para obras comerciales, corporativas y residenciales.";

const defaultKeywords =
  "cristales templados, vidrios templados Paraguay, carpintería de aluminio, box de baño, fachadas de vidrio, mamparas divisorias, ventanas de aluminio, construcción Paraguay";

const { 
  title, 
  description = defaultDescription, 
  keywords = defaultKeywords,
  canonical = SITE_URL,
  ogImage = `${SITE_URL}/img/vipar-og.webp`,
  bodyClass = "",
  pageType = "generic",
  serviceName,
  hideHeader = false,
  hideFooter = false,
  hideWhatsappFAB = false,
  hideConsentBanner = false
} = Astro.props;

const localBusinessStructuredData = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: "VIPAR S.A.",
  description: defaultDescription,
  url: SITE_URL,
  logo: `${SITE_URL}/img/logo.png`,
  image: ogImage,
  email,
  telephone,
  address: {
    "@type": "PostalAddress",
    streetAddress: companyAddress.streetAddress,
    addressLocality: companyAddress.addressLocality,
    addressRegion: companyAddress.addressRegion,
    addressCountry: companyAddress.addressCountry,
  },
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      opens: "07:00",
      closes: "17:00",
    },
  ],
  areaServed: "PY",
  sameAs: [SOCIAL_LINKS.instagram, SOCIAL_LINKS.facebook].filter(Boolean),
  makesOffer: [
    {
      "@type": "Offer",
      itemOffered: {
        "@type": "Service",
        name: "Box de baño",
        description: "Instalación de box de baño en cristal templado y otros cerramientos a medida.",
      },
    },
    {
      "@type": "Offer",
      itemOffered: {
        "@type": "Service",
        name: "Cielo raso",
        description: "Soluciones en cielorrasos de PVC, yeso junta tomada, Durlock y sistemas desmontables.",
      },
    },
    {
      "@type": "Offer",
      itemOffered: {
        "@type": "Service",
        name: "Cortinas",
        description: "Cortinas verticales y horizontales personalizadas para interiores y oficinas.",
      },
    },
    {
      "@type": "Offer",
      itemOffered: {
        "@type": "Service",
        name: "Fachadas",
        description: "Diseño e instalación de fachadas de vidrio y aluminio para locales, oficinas y edificios.",
      },
    },
    {
      "@type": "Offer",
      itemOffered: {
        "@type": "Service",
        name: "Mamparas divisorias",
        description: "Mamparas en eucatex, cristal templado y tabique de Durlock para ambientes interiores.",
      },
    },
    {
      "@type": "Offer",
      itemOffered: {
        "@type": "Service",
        name: "Puertas",
        description: "Puertas corredizas, batientes y plegables en cristal templado o aluminio para hogares y oficinas.",
      },
    },
    {
      "@type": "Offer",
      itemOffered: {
        "@type": "Service",
        name: "Ventanas",
        description: "Ventanas de aluminio y cristal templado en sistemas basculantes y corredizos.",
      },
    },
    {
      "@type": "Offer",
      itemOffered: {
        "@type": "Service",
        name: "Carpintería de aluminio",
        description: "Fabricación e instalación de puertas, ventanas y cerramientos de aluminio a medida.",
      },
    },
  ],
});
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content="index, follow" />
    <meta name="generator" content={Astro.generator} />

    <link rel="canonical" href={canonical} />
    <link rel="preconnect" href="https://lh3.googleusercontent.com" crossorigin />

    <!-- SEO Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicon -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- Fonts for redesign (Manrope + Inter) -->
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
  </head>
  <body class={bodyClass} data-page-type={pageType} data-service-name={serviceName}>
    {!hideHeader && <Header />}
      {
        MEASUREMENT_ID && MEASUREMENT_ID !== "G-XXXXXXX" && (
          <>
            <!-- Google Consent Mode: default deny until user gives consent -->
            <script is:inline>
              window.dataLayer = window.dataLayer || [];
              function gtag(){dataLayer.push(arguments);} 
              // set default consent to denied so gtag won't set analytics/ad cookies
              gtag('consent', 'default', {
                'ad_storage': 'denied',
                'analytics_storage': 'denied',
                'wait_for_update': 500
              });
            </script>
            <!-- Load gtag.js (it will respect consent state above) -->
            <script async src={`https://www.googletagmanager.com/gtag/js?id=${MEASUREMENT_ID}`}></script>
            <script is:inline define:vars={{ MEASUREMENT_ID }}>
              gtag('js', new Date());
              // basic config; cookies still blocked until consent update
              gtag('config', `${MEASUREMENT_ID}`, { 'anonymize_ip': true });
            </script>
            <script is:inline>
              (function () {
                function getReferrerHost() {
                  try {
                    return document.referrer ? new URL(document.referrer).hostname : "";
                  } catch (error) {
                    return "";
                  }
                }

                function inferMedium(referrerHost, utmMedium) {
                  if (utmMedium) return utmMedium;
                  if (!referrerHost) return "direct";
                  if (/google\./i.test(referrerHost)) return "organic";
                  return "referral";
                }

                function buildLeadContext(extra) {
                  var params = new URLSearchParams(window.location.search);
                  var referrerHost = getReferrerHost();
                  return Object.assign(
                    {
                      page_path: window.location.pathname,
                      page_title: document.title,
                      page_type: document.body?.dataset.pageType || undefined,
                      service_name: document.body?.dataset.serviceName || undefined,
                      lead_source: params.get("utm_source") || referrerHost || "direct",
                      lead_medium: inferMedium(referrerHost, params.get("utm_medium")),
                      campaign: params.get("utm_campaign") || undefined,
                      device_type: window.innerWidth < 768 ? "mobile" : "desktop",
                    },
                    extra || {}
                  );
                }

                window.viparLeadContext = function (extra) {
                  return buildLeadContext(extra);
                };

                window.viparTrack = function (eventName, extra) {
                  if (typeof window.gtag !== "function") return;

                  var payload = buildLeadContext(extra);

                  Object.keys(payload).forEach(function (key) {
                    if (payload[key] === undefined || payload[key] === null || payload[key] === "") {
                      delete payload[key];
                    }
                  });

                  window.gtag("event", eventName, payload);
                };

                document.addEventListener("click", function (event) {
                  var target = event.target;
                  if (!(target instanceof Element)) return;

                  var anchor = target.closest("a");
                  if (!(anchor instanceof HTMLAnchorElement)) return;

                  var href = anchor.getAttribute("href") || "";
                  var eventName = "";

                  if (href.startsWith("tel:")) eventName = "phone_click";
                  if (href.startsWith("mailto:")) eventName = "email_click";
                  if (href.includes("wa.me/")) {
                    eventName = anchor.dataset.trackEvent || "whatsapp_click";
                  }

                  if (!eventName) return;

                  var ctaLocation =
                    anchor.dataset.ctaLocation ||
                    anchor.closest("[data-cta-location]")?.dataset.ctaLocation ||
                    "unknown";

                  window.viparTrack(eventName, {
                    cta_location: ctaLocation,
                    service_name:
                      anchor.dataset.serviceName || document.body?.dataset.serviceName || undefined,
                    whatsapp_message_type: href.includes("wa.me/")
                      ? anchor.dataset.whatsappMessageType ||
                        (href.includes("?text=") ? "prefilled" : "generic")
                      : undefined,
                  });
                });
              })();
            </script>
          </>
        )
      }

    <script>
      import "bootstrap/js/dist/toast";
      import "bootstrap/js/dist/tooltip";
      import "bootstrap/js/dist/collapse";
      import AOS from "aos";

      window.addEventListener("load", () => {
        AOS.init();
      });
    </script>

    <main id="main">
      <slot />
    </main>

    {!hideFooter && <Footer />}
    <!-- Cookie / Consent banner (improved, fixed to footer) -->
    {!hideConsentBanner && <div id="consent-banner" class="consent-banner" aria-hidden="true" role="dialog" aria-live="polite">
      <div class="consent-inner container d-flex align-items-center justify-content-between">
        <div class="d-flex gap-3 align-items-center">
          <div class="consent-logo" aria-hidden="true">VIPAR</div>
          <div class="consent-text">
            <strong>Usamos cookies</strong>
            <div class="small">Usamos cookies propias y de terceros para mejorar la experiencia, analizar tráfico y ofrecer servicios. Podés aceptar todas o configurar tus preferencias.</div>
          </div>
        </div>
        <div class="consent-actions d-flex gap-2 align-items-center">
          <button id="consent-preferences" class="btn btn-outline-secondary">Preferencias</button>
          <button id="consent-reject" class="btn btn-light">Rechazar</button>
          <button id="consent-accept" class="btn btn-primary w-100">Aceptar todas</button>
        </div>
      </div>
    </div>}

    <!-- Preferences modal (simple) -->
    {!hideConsentBanner && <div id="consent-modal" class="consent-modal" aria-hidden="true" role="dialog">
      <div class="consent-modal__backdrop" aria-hidden="true"></div>
      <div class="consent-modal__inner">
        <h4>Preferencias de cookies</h4>
        <p class="small text-muted">Seleccioná qué tipos de cookies autorizás:</p>
        <div class="form-check">
          <input class="form-check-input" type="checkbox" value="" id="pref-necessary" disabled checked>
          <label class="form-check-label" for="pref-necessary">Necesarias (siempre permitidas)</label>
        </div>
        <div class="form-check mt-2">
          <input class="form-check-input" type="checkbox" id="pref-analytics">
          <label class="form-check-label" for="pref-analytics">Analíticas (Analytics)</label>
        </div>
        <div class="form-check mt-2">
          <input class="form-check-input" type="checkbox" id="pref-marketing">
          <label class="form-check-label" for="pref-marketing">Marketing y anuncios</label>
        </div>
        <div class="d-flex justify-content-end gap-2 mt-3">
          <button id="pref-cancel" class="btn btn-light">Cancelar</button>
          <button id="pref-save" class="btn btn-primary">Guardar preferencias</button>
        </div>
      </div>
    </div>}
    {!hideWhatsappFAB && <WhatsappFAB />}
    <ClientProvider />
    <script type='application/ld+json' set:html={localBusinessStructuredData}></script>
    <script is:inline>
      document.addEventListener('DOMContentLoaded', function(){
        (function(){
          var banner = document.getElementById('consent-banner');
          var modal = document.getElementById('consent-modal');
          var acceptBtn = document.getElementById('consent-accept');
          var rejectBtn = document.getElementById('consent-reject');
          var prefBtn = document.getElementById('consent-preferences');
          var prefSave = document.getElementById('pref-save');
          var prefCancel = document.getElementById('pref-cancel');
          var prefAnalytics = document.getElementById('pref-analytics');
          var prefMarketing = document.getElementById('pref-marketing');
          var CONSENT_KEY = 'vipar_consent_v1';

          function hideBanner(){ if(banner) banner.style.display='none'; }
          function showBanner(){ if(banner) banner.style.display='block'; }
          function showModal(){
            if(modal){
              modal.setAttribute('aria-hidden','false');
              modal.style.display='flex';
              if(banner) banner.style.display = 'none';
              setTimeout(function(){ var f = document.getElementById('pref-analytics'); if(f) f.focus(); }, 150);
            }
          }

          function hideModal(){
            if(modal){
              modal.setAttribute('aria-hidden','true');
              modal.style.display='none';
              try{ var s = readStored(); if(!s) showBanner(); }catch(e){ showBanner(); }
            }
          }

          function readStored(){
            try{ var s = localStorage.getItem(CONSENT_KEY); return s ? JSON.parse(s) : null; }catch(e){ return null; }
          }

          function saveStored(obj){ try{ localStorage.setItem(CONSENT_KEY, JSON.stringify(obj)); }catch(e){} }

          function applyConsent(obj){
            if(window.gtag){
              var analyticsState = obj.analytics ? 'granted' : 'denied';
              var adState = obj.marketing ? 'granted' : 'denied';
              gtag('consent','update',{
                'analytics_storage': analyticsState,
                'ad_storage': adState,
                'ad_user_data': adState,
                'ad_personalization': adState
              });
              gtag('event','consent_update',{analytics: obj.analytics, marketing: obj.marketing});
              if(obj.analytics){
                gtag('event','consent_accept',{method: 'banner', analytics: true, marketing: !!obj.marketing});
                try{ gtag('set', {'user_properties': { consent_analytics: 'granted' }}); }catch(e){}
              } else {
                gtag('event','consent_reject',{method: 'banner', analytics: false, marketing: !!obj.marketing});
                try{ gtag('set', {'user_properties': { consent_analytics: 'denied' }}); }catch(e){}
              }
            }
          }

          var stored = readStored();
          if(!stored){ showBanner(); } else { applyConsent(stored); }

          if(acceptBtn) acceptBtn.addEventListener('click', function(){
            var obj = { analytics: true, marketing: true };
            saveStored(obj); applyConsent(obj); hideBanner();
          });

          if(rejectBtn) rejectBtn.addEventListener('click', function(){
            var obj = { analytics: false, marketing: false };
            saveStored(obj); applyConsent(obj); hideBanner();
          });

          if(prefBtn) prefBtn.addEventListener('click', function(){
            var s = readStored() || { analytics: false, marketing: false };
            if(prefAnalytics) prefAnalytics.checked = !!s.analytics;
            if(prefMarketing) prefMarketing.checked = !!s.marketing;
            showModal();
          });

          if(prefSave) prefSave.addEventListener('click', function(){
            var obj = { analytics: !!(prefAnalytics && prefAnalytics.checked), marketing: !!(prefMarketing && prefMarketing.checked) };
            saveStored(obj); applyConsent(obj); hideModal(); hideBanner();
          });

          if(prefCancel) prefCancel.addEventListener('click', function(){ hideModal(); });
        })();
      });
    </script>
  </body>
</html>
<style is:global>
.consent-banner{
  position:fixed;
  left:0;
  right:0;
  bottom:0px;
  z-index:99999;
  display:none;
  background:#ffffff;
  box-shadow:0 -8px 30px rgba(7,12,20,0.06);
}
.consent-inner{
  max-width:1200px;
  margin:0 auto;
  padding:16px 20px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:18px;
  background:#fff;
  border-radius:10px;
  box-shadow:0 8px 30px rgba(0,0,0,0.08);
  font-family:var(--font-default);
}
.consent-logo{font-weight:700;color:var(--color-primary);padding-left:4px}
.consent-text{max-width:75%}
.consent-text strong{display:block;font-size:15px;color:var(--color-dark)}
.consent-text .small{color:#6c757d}
.consent-actions .btn{min-width:110px;border-radius:8px}
.consent-actions .btn{white-space:nowrap;word-break:normal}
.consent-actions .btn-primary{background:var(--color-primary);border-color:var(--color-primary);color:#fff}
.consent-actions .btn-primary:hover{background:var(--color-primary-hover);border-color:var(--color-primary-hover)}
.consent-actions .btn-outline-secondary{color:var(--color-primary);border-color:var(--color-primary);background:transparent}
.consent-actions .btn-light{background:#f7f7f8;border:1px solid #e9eaec}
.consent-actions button{margin-left:8px}

/* modal */
.consent-modal{display:none;position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);z-index:100002;justify-content:center;padding:20px;width:100%;max-width:100vw}
.consent-modal__backdrop{position:fixed;inset:0;z-index:100001}
.consent-modal__inner{width:420px;max-width:92vw;background:#fff;border-radius:12px;padding:20px;box-shadow:0 20px 50px rgba(7,12,20,0.18);border:1px solid rgba(20,24,40,0.04);z-index:100002}
.consent-modal__inner h4{margin:0 0 8px;color:var(--color-secondary);font-family:var(--font-primary)}
.consent-modal__inner .form-check-label{color:var(--color-default)}
.consent-modal__inner .btn-primary{background:var(--color-primary);border-color:var(--color-primary);color:#fff}
.consent-modal__inner .btn-primary:hover{background:var(--color-primary-hover);border-color:var(--color-primary-hover)}

/* Responsive adjustments */
@media (max-width: 768px) {
  .consent-inner{flex-direction:column;gap:10px;text-align:center;padding:12px 14px;align-items:center}
  .consent-text{max-width:100%}
  .consent-actions{width:100%;display:flex;flex-direction:column;gap:10px;align-items:stretch}
  .consent-actions .btn{width:100%;min-width:0;margin-left:0;padding:0.65rem 0}
  .consent-logo{display:none}
  .consent-text strong{font-size:1rem}
  .consent-text .small{font-size:0.95rem}
}

/* mobile: modal as bottom sheet */
@media (max-width: 576px) {
  .consent-banner{bottom:0}
  .consent-inner{border-radius:12px 12px 0 0;padding:14px}
  .consent-modal{top:auto;left:0;right:0;bottom:0;transform:none;padding:0}
  .consent-modal__backdrop{display:block}
  .consent-modal__inner{width:100%;border-radius:12px 12px 0 0;max-height:80vh;overflow:auto}
  .consent-modal__inner .d-flex.justify-content-end{flex-direction:column;align-items:stretch}
  .consent-modal__inner .btn{width:100%}
}
</style>



