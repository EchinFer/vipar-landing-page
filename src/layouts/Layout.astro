.consent-note{color:#6c757d}
.consent-actions{
  display:flex;
  flex-wrap:wrap;
  gap:10px;
  align-items:center;
  justify-content:flex-end;
}
.consent-actions .ds-btn,
.consent-modal__actions .ds-btn{
  white-space:nowrap;
