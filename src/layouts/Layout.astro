---
import PostHog from "@components/posthog.astro";
import Header from "@components/Header.astro";
import bootstrapIconsHref from "@assets/vendor/bootstrap-icons/bootstrap-icons.css?url";
import "@styles/design-system-core.css";
import ClientProvider from "./ClientProvider.astro";
import Footer from "@components/Footer.astro";
import WhatsappFAB from "@components/WhatsappFAB.astro";
import {
  MEASUREMENT_ID,
  SITE_URL,
  SOCIAL_LINKS,
  companyAddress,
  email,
  telephone,
} from "src/constants";
interface Props {
  title: string;
  description?: string;
  keywords?: string;
  canonical?: string;
  ogImage?: string;
  ogImageAlt?: string;
  bodyClass?: string;
  pageType?: string;
  serviceName?: string;
  ogType?: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown> | Array<Record<string, unknown>>;
  loadAosAssets?: boolean;
  loadLightboxAssets?: boolean;
  loadSwiperAssets?: boolean;
  loadIsotopeAssets?: boolean;
  loadBootstrapJs?: boolean;
  loadBootstrapIcons?: boolean;
  useMaterialSymbols?: boolean;
  preconnectOrigins?: string[];
  hideHeader?: boolean;
  hideFooter?: boolean;
  hideWhatsappFAB?: boolean;
  hideConsentBanner?: boolean;
}

const defaultDescription =
  "Empresa paraguaya especializada en cristales templados, carpintería de aluminio y soluciones para obras comerciales, corporativas y residenciales.";

const defaultKeywords =
  "cristales templados, vidrios templados Paraguay, carpintería de aluminio, box de baño, fachadas de vidrio, mamparas divisorias, ventanas de aluminio, construcción Paraguay";

const { 
  title, 
  description = defaultDescription, 
  keywords = defaultKeywords,
  canonical = SITE_URL,
  ogImage = `${SITE_URL}/img/vipar-og.webp`,
  ogImageAlt = title,
  bodyClass = "",
  pageType = "generic",
  serviceName,
  ogType = "website",
  noindex = false,
  structuredData = [],
  loadAosAssets = true,
  loadLightboxAssets = true,
  loadSwiperAssets = true,
  loadIsotopeAssets = true,
  loadBootstrapJs = true,
  loadBootstrapIcons = true,
  useMaterialSymbols = true,
  preconnectOrigins = [],
  hideHeader = false,
  hideFooter = false,
  hideWhatsappFAB = false,
  hideConsentBanner = false
} = Astro.props;

const localBusinessStructuredData = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  name: "VIPAR S.A.",
  description: defaultDescription,
  url: SITE_URL,
  logo: `${SITE_URL}/img/logo.png`,
  image: ogImage,
  email,
  telephone,
  address: {
    "@type": "PostalAddress",
    streetAddress: companyAddress.streetAddress,
    addressLocality: companyAddress.addressLocality,
    addressRegion: companyAddress.addressRegion,
    addressCountry: companyAddress.addressCountry,
  },
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      opens: "07:00",
      closes: "17:00",
    },
  ],
  areaServed: "PY",
  sameAs: [SOCIAL_LINKS.instagram, SOCIAL_LINKS.facebook].filter(Boolean),
  makesOffer: [
    {
      "@type": "Offer",
      itemOffered: {
        "@type": "Service",
        name: "Box de baño",
        description: "Instalación de box de baño en cristal templado y otros cerramientos a medida.",
      },
    },
    {
      "@type": "Offer",
      itemOffered: {
        "@type": "Service",
        name: "Cielo raso",
        description: "Soluciones en cielorrasos de PVC, yeso junta tomada, Durlock y sistemas desmontables.",
      },
    },
    {
      "@type": "Offer",
      itemOffered: {
        "@type": "Service",
        name: "Cortinas",
        description: "Cortinas de vidrio corredizas para balcones, quinchos, galerías y frentes, según medidas y condiciones de instalación.",
      },
    },
    {
      "@type": "Offer",
      itemOffered: {
        "@type": "Service",
        name: "Fachadas",
        description: "Fachadas de vidrio y aluminio para locales, oficinas y edificios según medidas, sistema y condiciones del proyecto.",
      },
    },
    {
      "@type": "Offer",
      itemOffered: {
        "@type": "Service",
        name: "Mamparas divisorias",
        description: "Mamparas en eucatex, cristal templado y tabique de Durlock para ambientes interiores.",
      },
    },
    {
      "@type": "Offer",
      itemOffered: {
        "@type": "Service",
        name: "Puertas",
        description: "Puertas corredizas, batientes y plegables en cristal templado o aluminio para hogares y oficinas.",
      },
    },
    {
      "@type": "Offer",
      itemOffered: {
        "@type": "Service",
        name: "Ventanas",
        description: "Ventanas de aluminio y cristal templado en sistemas basculantes y corredizos.",
      },
    },
    {
      "@type": "Offer",
      itemOffered: {
        "@type": "Service",
        name: "Carpintería de aluminio",
        description: "Carpintería de aluminio para puertas, ventanas, aberturas y cerramientos según medidas, tipo de apertura y condiciones de instalación.",
      },
    },
  ],
};

const structuredDataItems = [
  localBusinessStructuredData,
  ...(Array.isArray(structuredData)
    ? structuredData
    : structuredData
      ? [structuredData]
      : []),
].map((item) => JSON.stringify(item));
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="VIPAR S.A." />
    <meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0f2a3d" />

    <link rel="canonical" href={canonical} />
    <!-- SEO Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="VIPAR S.A." />
    <meta property="og:locale" content="es_PY" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Favicon -->
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <PostHog />
    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- Fonts for redesign (Manrope + Inter) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    {preconnectOrigins.map((origin) => (
      <link rel="preconnect" href={origin} crossorigin />
    ))}
    <!-- Non-blocking Google Fonts (avoids render-blocking) -->
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;700;800&family=Inter:wght@400;500;600&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;700;800&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    </noscript>
    {loadBootstrapIcons && <link rel="stylesheet" href={bootstrapIconsHref} />}
    {useMaterialSymbols && (
      <link
        rel="preload"
        as="style"
        href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
        onload="this.onload=null;this.rel='stylesheet'"
      />
    )}
    {loadAosAssets && <link rel="stylesheet" href="/vendor/aos/aos.css" />}
    {loadLightboxAssets && (
      <>
        <link rel="stylesheet" href="/vendor/glightbox/css/glightbox.min.css" />
        <link rel="stylesheet" href="/vendor/glightbox/css/plyr.min.css" />
      </>
    )}
    {loadSwiperAssets && (
      <link rel="stylesheet" href="/vendor/swiper/swiper-bundle.min.css" />
    )}
  </head>
  <body class={bodyClass} data-page-type={pageType} data-service-name={serviceName}>
    {!hideHeader && <Header />}
      {
        MEASUREMENT_ID && MEASUREMENT_ID !== "G-XXXXXXX" && (
          <>
            <!-- Google Consent Mode: default deny until user gives consent -->
            <script is:inline>
              window.dataLayer = window.dataLayer || [];
              function gtag(){dataLayer.push(arguments);} 
              // set default consent to denied so gtag won't set analytics/ad cookies
              gtag('consent', 'default', {
                'ad_storage': 'denied',
                'analytics_storage': 'denied',
                'wait_for_update': 500
              });
            </script>
            <!-- Load gtag.js (it will respect consent state above) -->
            <script async src={`https://www.googletagmanager.com/gtag/js?id=${MEASUREMENT_ID}`}></script>
            <script is:inline define:vars={{ MEASUREMENT_ID }}>
              gtag('js', new Date());
              // basic config; cookies still blocked until consent update
              gtag('config', `${MEASUREMENT_ID}`, { 'anonymize_ip': true });
            </script>
            <script is:inline>
              (function () {
                function getReferrerHost() {
                  try {
                    return document.referrer ? new URL(document.referrer).hostname : "";
                  } catch (error) {
                    return "";
                  }
                }

                function inferMedium(referrerHost, utmMedium) {
                  if (utmMedium) return utmMedium;
                  if (!referrerHost) return "direct";
                  if (/google\./i.test(referrerHost)) return "organic";
                  return "referral";
                }

                var LEGACY_EVENT_NAME_MAP = {
                  whatsapp_fab_click: "whatsapp_click",
                  whatsapp_service_click: "whatsapp_click",
                  whatsapp_service_hub_click: "whatsapp_click",
                };

                var CTA_LOCATION_MAP = {
                  footer: "footer_cta",
                  header_primary: "header_cta",
                  legacy_home_hero_primary: "hero_cta",
                  legacy_home_hero_secondary: "hero_cta",
                  home_hero_primary: "hero_cta",
                  home_hero_secondary: "hero_cta",
                  obra_hero_primary: "hero_cta",
                  about_primary: "hero_cta",
                  about_secondary: "final_cta",
                  home_contact_info: "final_cta",
                  contact_form_alt: "contact_form",
                  carpinteria_aluminio_hero: "service_cta",
                  box_bano_hero: "service_cta",
                  cielo_raso_hero: "service_cta",
                  mamparas_divisorias_hero: "service_cta",
                  hero: "service_cta",
                  aluminum_systems_card: "service_cta",
                  services_hub_quoting: "services_hub_cta",
                };

                function normalizeEventName(eventName, href) {
                  if (href.includes("wa.me/")) return "whatsapp_click";
                  return LEGACY_EVENT_NAME_MAP[eventName] || eventName;
                }

                function normalizeCtaLocation(rawValue, eventName, pageType) {
                  if (rawValue && CTA_LOCATION_MAP[rawValue]) {
                    return CTA_LOCATION_MAP[rawValue];
                  }

                  if (rawValue) return rawValue;

                  if (eventName === "whatsapp_click") {
                    if (pageType === "service") return "service_cta";
                    if (pageType === "services_hub") return "services_hub_cta";
                    if (pageType === "contact") return "contact_form";
                    if (pageType === "home") return "hero_cta";
                  }

                  return "unknown";
                }

                function appendLabeledLine(message, label, value) {
                  if (!value) return message;

                  var normalizedMessage = String(message || "");
                  var prefix = `${label.toLowerCase()}:`;

                  if (normalizedMessage.toLowerCase().includes(prefix)) {
                    return normalizedMessage;
                  }

                  return normalizedMessage
                    ? `${normalizedMessage}\n${label}: ${value}`
                    : `${label}: ${value}`;
                }

                function buildLeadContext(extra) {
                  var params = new URLSearchParams(window.location.search);
                  var referrerHost = getReferrerHost();
                  return Object.assign(
                    {
                      page_path: window.location.pathname,
                      page_title: document.title,
                      page_type: document.body?.dataset.pageType || undefined,
                      service_name: document.body?.dataset.serviceName || undefined,
                      lead_source: params.get("utm_source") || referrerHost || "direct",
                      lead_medium: inferMedium(referrerHost, params.get("utm_medium")),
                      campaign: params.get("utm_campaign") || undefined,
                      device_type: window.innerWidth < 768 ? "mobile" : "desktop",
                    },
                    extra || {}
                  );
                }

                window.viparLeadContext = function (extra) {
                  return buildLeadContext(extra);
                };

                window.viparBuildWhatsappUrl = function (rawHref, extra) {
                  try {
                    var url = new URL(rawHref, window.location.origin);
                    if (!/wa\.me$/i.test(url.hostname) && !/api\.whatsapp\.com$/i.test(url.hostname)) {
                      return rawHref;
                    }

                    var payload = buildLeadContext(extra);
                    var message = url.searchParams.get("text") || "";

                    message = appendLabeledLine(message, "Servicio", payload.service_name);
                    message = appendLabeledLine(message, "Landing", payload.page_path);
                    message = appendLabeledLine(message, "Origen", payload.lead_source);
                    message = appendLabeledLine(message, "Medio", payload.lead_medium);
                    message = appendLabeledLine(message, "Campaña", payload.campaign);
                    message = appendLabeledLine(message, "CTA", payload.cta_location);
                    message = appendLabeledLine(message, "Formulario", payload.form_id);
                    message = appendLabeledLine(message, "Email", payload.email);
                    message = appendLabeledLine(
                      message,
                      "Tipo de consulta",
                      payload.consultation_type
                    );

                    if (message) {
                      url.searchParams.set("text", message);
                    }

                    return url.toString();
                  } catch (error) {
                    return rawHref;
                  }
                };

                window.viparTrack = function (eventName, extra) {
                  var payload = buildLeadContext(extra);

                  Object.keys(payload).forEach(function (key) {
                    if (payload[key] === undefined || payload[key] === null || payload[key] === "") {
                      delete payload[key];
                    }
                  });

                  if (typeof window.gtag === "function") {
                    window.gtag("event", eventName, payload);
                  }

                  if (
                    typeof window.posthog === "object" &&
                    typeof window.posthog.capture === "function"
                  ) {
                    window.posthog.capture(eventName, payload);
                  }
                };

                function trackServicePageView() {
                  if (document.body?.dataset.pageType !== "service") return;
                  if (window.__viparServicePageViewed) return;

                  window.__viparServicePageViewed = true;
                  window.viparTrack("service_page_viewed", {
                    service_name: document.body?.dataset.serviceName || undefined,
                  });
                }

                if (document.readyState === "loading") {
                  document.addEventListener("DOMContentLoaded", trackServicePageView, {
                    once: true,
                  });
                } else {
                  trackServicePageView();
                }

                document.addEventListener("click", function (event) {
                  var target = event.target;
                  if (!(target instanceof Element)) return;

                  var anchor = target.closest("a");
                  if (!(anchor instanceof HTMLAnchorElement)) return;

                  var href = anchor.getAttribute("href") || "";
                  var legacyEventName = anchor.dataset.trackEvent || "";
                  var eventName = legacyEventName;

                  if (!eventName && href.startsWith("tel:")) eventName = "phone_click";
                  if (!eventName && href.startsWith("mailto:")) eventName = "email_click";
                  if (!eventName && href.includes("wa.me/")) {
                    eventName = "whatsapp_click";
                  }

                  if (!eventName) return;

                  eventName = normalizeEventName(eventName, href);

                  var rawCtaLocation =
                    anchor.dataset.ctaLocation ||
                    anchor.closest("[data-cta-location]")?.dataset.ctaLocation ||
                    "";
                  var ctaLocation = normalizeCtaLocation(
                    rawCtaLocation,
                    eventName,
                    document.body?.dataset.pageType || ""
                  );

                  if (eventName === "whatsapp_click" && href.includes("wa.me/")) {
                    anchor.href = window.viparBuildWhatsappUrl(anchor.href, {
                      cta_location: ctaLocation,
                      service_name:
                        anchor.dataset.serviceName || document.body?.dataset.serviceName || undefined,
                    });
                  }

                  window.viparTrack(eventName, {
                    cta_location: ctaLocation,
                    service_name:
                      anchor.dataset.serviceName || document.body?.dataset.serviceName || undefined,
                    legacy_event_name:
                      legacyEventName && legacyEventName !== eventName ? legacyEventName : undefined,
                    whatsapp_message_type: href.includes("wa.me/")
                      ? anchor.dataset.whatsappMessageType ||
                        (href.includes("?text=") ? "prefilled" : "generic")
                      : undefined,
                  });
                });
              })();
            </script>
          </>
        )
      }

    <script is:inline>
      (function () {
        if (typeof window.viparTrack === "function") return;

        function getReferrerHost() {
          try {
            return document.referrer ? new URL(document.referrer).hostname : "";
          } catch (error) {
            return "";
          }
        }

        function inferMedium(referrerHost, utmMedium) {
          if (utmMedium) return utmMedium;
          if (!referrerHost) return "direct";
          if (/google\./i.test(referrerHost)) return "organic";
          return "referral";
        }

        var LEGACY_EVENT_NAME_MAP = {
          whatsapp_fab_click: "whatsapp_click",
          whatsapp_service_click: "whatsapp_click",
          whatsapp_service_hub_click: "whatsapp_click",
        };

        var CTA_LOCATION_MAP = {
          footer: "footer_cta",
          header_primary: "header_cta",
          legacy_home_hero_primary: "hero_cta",
          legacy_home_hero_secondary: "hero_cta",
          home_hero_primary: "hero_cta",
          home_hero_secondary: "hero_cta",
          obra_hero_primary: "hero_cta",
          about_primary: "hero_cta",
          about_secondary: "final_cta",
          home_contact_info: "final_cta",
          contact_form_alt: "contact_form",
          carpinteria_aluminio_hero: "service_cta",
          box_bano_hero: "service_cta",
          cielo_raso_hero: "service_cta",
          mamparas_divisorias_hero: "service_cta",
          hero: "service_cta",
          aluminum_systems_card: "service_cta",
          services_hub_quoting: "services_hub_cta",
        };

        function normalizeEventName(eventName, href) {
          if (href.includes("wa.me/")) return "whatsapp_click";
          return LEGACY_EVENT_NAME_MAP[eventName] || eventName;
        }

        function normalizeCtaLocation(rawValue, eventName, pageType) {
          if (rawValue && CTA_LOCATION_MAP[rawValue]) {
            return CTA_LOCATION_MAP[rawValue];
          }

          if (rawValue) return rawValue;

          if (eventName === "whatsapp_click") {
            if (pageType === "service") return "service_cta";
            if (pageType === "services_hub") return "services_hub_cta";
            if (pageType === "contact") return "contact_form";
            if (pageType === "home") return "hero_cta";
          }

          return "unknown";
        }

        function appendLabeledLine(message, label, value) {
          if (!value) return message;

          var normalizedMessage = String(message || "");
          var prefix = `${label.toLowerCase()}:`;

          if (normalizedMessage.toLowerCase().includes(prefix)) {
            return normalizedMessage;
          }

          return normalizedMessage
            ? `${normalizedMessage}\n${label}: ${value}`
            : `${label}: ${value}`;
        }

        function buildLeadContext(extra) {
          var params = new URLSearchParams(window.location.search);
          var referrerHost = getReferrerHost();
          return Object.assign(
            {
              page_path: window.location.pathname,
              page_title: document.title,
              page_type: document.body?.dataset.pageType || undefined,
              service_name: document.body?.dataset.serviceName || undefined,
              lead_source: params.get("utm_source") || referrerHost || "direct",
              lead_medium: inferMedium(referrerHost, params.get("utm_medium")),
              campaign: params.get("utm_campaign") || undefined,
              device_type: window.innerWidth < 768 ? "mobile" : "desktop",
            },
            extra || {}
          );
        }

        window.viparLeadContext = function (extra) {
          return buildLeadContext(extra);
        };

        window.viparBuildWhatsappUrl = function (rawHref, extra) {
          try {
            var url = new URL(rawHref, window.location.origin);
            if (!/wa\.me$/i.test(url.hostname) && !/api\.whatsapp\.com$/i.test(url.hostname)) {
              return rawHref;
            }

            var payload = buildLeadContext(extra);
            var message = url.searchParams.get("text") || "";

            message = appendLabeledLine(message, "Servicio", payload.service_name);
            message = appendLabeledLine(message, "Landing", payload.page_path);
            message = appendLabeledLine(message, "Origen", payload.lead_source);
            message = appendLabeledLine(message, "Medio", payload.lead_medium);
            message = appendLabeledLine(message, "Campaña", payload.campaign);
            message = appendLabeledLine(message, "CTA", payload.cta_location);
            message = appendLabeledLine(message, "Formulario", payload.form_id);
            message = appendLabeledLine(message, "Email", payload.email);
            message = appendLabeledLine(message, "Tipo de consulta", payload.consultation_type);

            if (message) {
              url.searchParams.set("text", message);
            }

            return url.toString();
          } catch (error) {
            return rawHref;
          }
        };

        window.viparTrack = function (eventName, extra) {
          var payload = buildLeadContext(extra);

          Object.keys(payload).forEach(function (key) {
            if (payload[key] === undefined || payload[key] === null || payload[key] === "") {
              delete payload[key];
            }
          });

          if (
            typeof window.posthog === "object" &&
            typeof window.posthog.capture === "function"
          ) {
            window.posthog.capture(eventName, payload);
          }
        };

        function trackServicePageView() {
          if (document.body?.dataset.pageType !== "service") return;
          if (window.__viparServicePageViewed) return;

          window.__viparServicePageViewed = true;
          window.viparTrack("service_page_viewed", {
            service_name: document.body?.dataset.serviceName || undefined,
          });
        }

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", trackServicePageView, {
            once: true,
          });
        } else {
          trackServicePageView();
        }

        document.addEventListener("click", function (event) {
          var target = event.target;
          if (!(target instanceof Element)) return;

          var anchor = target.closest("a");
          if (!(anchor instanceof HTMLAnchorElement)) return;

          var href = anchor.getAttribute("href") || "";
          var legacyEventName = anchor.dataset.trackEvent || "";
          var eventName = legacyEventName;

          if (!eventName && href.startsWith("tel:")) eventName = "phone_click";
          if (!eventName && href.startsWith("mailto:")) eventName = "email_click";
          if (!eventName && href.includes("wa.me/")) {
            eventName = "whatsapp_click";
          }

          if (!eventName) return;

          eventName = normalizeEventName(eventName, href);

          var rawCtaLocation =
            anchor.dataset.ctaLocation ||
            anchor.closest("[data-cta-location]")?.dataset.ctaLocation ||
            "";
          var ctaLocation = normalizeCtaLocation(
            rawCtaLocation,
            eventName,
            document.body?.dataset.pageType || ""
          );

          if (eventName === "whatsapp_click" && href.includes("wa.me/")) {
            anchor.href = window.viparBuildWhatsappUrl(anchor.href, {
              cta_location: ctaLocation,
              service_name:
                anchor.dataset.serviceName || document.body?.dataset.serviceName || undefined,
            });
          }

          window.viparTrack(eventName, {
            cta_location: ctaLocation,
            service_name:
              anchor.dataset.serviceName || document.body?.dataset.serviceName || undefined,
            legacy_event_name:
              legacyEventName && legacyEventName !== eventName ? legacyEventName : undefined,
            whatsapp_message_type: href.includes("wa.me/")
              ? anchor.dataset.whatsappMessageType ||
                (href.includes("?text=") ? "prefilled" : "generic")
              : undefined,
          });
        });
      })();
    </script>

    {(loadBootstrapJs || loadAosAssets) && (
      <script define:vars={{ loadBootstrapJs, loadAosAssets }}>
        (async () => {
          if (loadBootstrapJs) {
            await import("bootstrap/js/dist/toast");
            await import("bootstrap/js/dist/tooltip");
            await import("bootstrap/js/dist/collapse");
          }

          if (loadAosAssets) {
            const AOS = await import("aos");
            window.addEventListener("load", () => {
              AOS.default.init();
            });
          }
        })();
      </script>
    )}

    <main id="main">
      <slot />
    </main>

    {!hideFooter && <Footer />}
    <!-- Cookie / Consent banner (improved, fixed to footer) -->
    {!hideConsentBanner && <div id="consent-banner" class="consent-banner" aria-hidden="true" role="dialog" aria-live="polite">
      <div class="consent-inner ds-container">
        <div class="consent-copy">
          <div class="consent-logo" aria-hidden="true">VIPAR</div>
          <div class="consent-text">
            <strong>Usamos cookies</strong>
            <div class="consent-note">Usamos cookies propias y de terceros para mejorar la experiencia, analizar tráfico y ofrecer servicios. Podés aceptar todas o configurar tus preferencias.</div>
          </div>
        </div>
        <div class="consent-actions">
          <button id="consent-preferences" class="ds-btn ds-btn--outlined ds-btn--primary ds-btn--md">Preferencias</button>
          <button id="consent-reject" class="ds-btn ds-btn--outlined ds-btn--primary ds-btn--md consent-btn-muted">Rechazar</button>
          <button id="consent-accept" class="ds-btn ds-btn--contained ds-btn--primary ds-btn--md">Aceptar todas</button>
        </div>
      </div>
    </div>}

    <!-- Preferences modal (simple) -->
    {!hideConsentBanner && <div id="consent-modal" class="consent-modal" aria-hidden="true" role="dialog">
      <div class="consent-modal__backdrop" aria-hidden="true"></div>
      <div class="consent-modal__inner">
        <h4>Preferencias de cookies</h4>
        <p class="consent-note">Seleccioná qué tipos de cookies autorizás:</p>
        <label class="consent-option consent-option--disabled" for="pref-necessary">
          <input class="consent-option__input" type="checkbox" value="" id="pref-necessary" disabled checked>
          <span class="consent-option__label">Necesarias (siempre permitidas)</span>
        </label>
        <label class="consent-option" for="pref-analytics">
          <input class="consent-option__input" type="checkbox" id="pref-analytics">
          <span class="consent-option__label">Analíticas (Analytics)</span>
        </label>
        <label class="consent-option" for="pref-marketing">
          <input class="consent-option__input" type="checkbox" id="pref-marketing">
          <span class="consent-option__label">Marketing y anuncios</span>
        </label>
        <div class="consent-modal__actions">
          <button id="pref-cancel" class="ds-btn ds-btn--outlined ds-btn--primary ds-btn--md consent-btn-muted">Cancelar</button>
          <button id="pref-save" class="ds-btn ds-btn--contained ds-btn--primary ds-btn--md">Guardar preferencias</button>
        </div>
      </div>
    </div>}
    {!hideWhatsappFAB && <WhatsappFAB />}
    <ClientProvider
      loadLightboxAssets={loadLightboxAssets}
      loadIsotopeAssets={loadIsotopeAssets}
      loadSwiperAssets={loadSwiperAssets}
    />
    {structuredDataItems.map((item) => (
      <script type="application/ld+json" set:html={item}></script>
    ))}
    <script is:inline>
      document.addEventListener('DOMContentLoaded', function(){
        (function(){
          var banner = document.getElementById('consent-banner');
          var modal = document.getElementById('consent-modal');
          var acceptBtn = document.getElementById('consent-accept');
          var rejectBtn = document.getElementById('consent-reject');
          var prefBtn = document.getElementById('consent-preferences');
          var prefSave = document.getElementById('pref-save');
          var prefCancel = document.getElementById('pref-cancel');
          var prefAnalytics = document.getElementById('pref-analytics');
          var prefMarketing = document.getElementById('pref-marketing');
          var CONSENT_KEY = 'vipar_consent_v1';

          function hideBanner(){ if(banner) banner.style.display='none'; }
          function showBanner(){ if(banner) banner.style.display='block'; }
          function showModal(){
            if(modal){
              modal.setAttribute('aria-hidden','false');
              modal.style.display='flex';
              if(banner) banner.style.display = 'none';
              setTimeout(function(){ var f = document.getElementById('pref-analytics'); if(f) f.focus(); }, 150);
            }
          }

          function hideModal(){
            if(modal){
              modal.setAttribute('aria-hidden','true');
              modal.style.display='none';
              try{ var s = readStored(); if(!s) showBanner(); }catch(e){ showBanner(); }
            }
          }

          function readStored(){
            try{ var s = localStorage.getItem(CONSENT_KEY); return s ? JSON.parse(s) : null; }catch(e){ return null; }
          }

          function saveStored(obj){ try{ localStorage.setItem(CONSENT_KEY, JSON.stringify(obj)); }catch(e){} }

          function applyConsent(obj){
            if(window.gtag){
              var analyticsState = obj.analytics ? 'granted' : 'denied';
              var adState = obj.marketing ? 'granted' : 'denied';
              gtag('consent','update',{
                'analytics_storage': analyticsState,
                'ad_storage': adState,
                'ad_user_data': adState,
                'ad_personalization': adState
              });
              gtag('event','consent_update',{analytics: obj.analytics, marketing: obj.marketing});
              if(obj.analytics){
                gtag('event','consent_accept',{method: 'banner', analytics: true, marketing: !!obj.marketing});
                try{ gtag('set', {'user_properties': { consent_analytics: 'granted' }}); }catch(e){}
              } else {
                gtag('event','consent_reject',{method: 'banner', analytics: false, marketing: !!obj.marketing});
                try{ gtag('set', {'user_properties': { consent_analytics: 'denied' }}); }catch(e){}
              }
            }

            if (window.posthog && typeof window.posthog === 'object') {
              if (obj.analytics && typeof window.posthog.opt_in_capturing === 'function') {
                window.posthog.opt_in_capturing();
              }

              if (!obj.analytics && typeof window.posthog.opt_out_capturing === 'function') {
                window.posthog.opt_out_capturing();
              }
            }
          }

          var stored = readStored();
          if(!stored){ showBanner(); } else { applyConsent(stored); }

          if(acceptBtn) acceptBtn.addEventListener('click', function(){
            var obj = { analytics: true, marketing: true };
            saveStored(obj); applyConsent(obj); hideBanner();
          });

          if(rejectBtn) rejectBtn.addEventListener('click', function(){
            var obj = { analytics: false, marketing: false };
            saveStored(obj); applyConsent(obj); hideBanner();
          });

          if(prefBtn) prefBtn.addEventListener('click', function(){
            var s = readStored() || { analytics: false, marketing: false };
            if(prefAnalytics) prefAnalytics.checked = !!s.analytics;
            if(prefMarketing) prefMarketing.checked = !!s.marketing;
            showModal();
          });

          if(prefSave) prefSave.addEventListener('click', function(){
            var obj = { analytics: !!(prefAnalytics && prefAnalytics.checked), marketing: !!(prefMarketing && prefMarketing.checked) };
            saveStored(obj); applyConsent(obj); hideModal(); hideBanner();
          });

          if(prefCancel) prefCancel.addEventListener('click', function(){ hideModal(); });
        })();
      });
    </script>
  </body>
</html>
<style is:global>
.consent-banner{
  position:fixed;
  left:0;
  right:0;
  bottom:0px;
  z-index:99999;
