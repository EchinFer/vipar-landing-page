---
import Heading from "../ui/Heading.astro";
import Text from "../ui/Text.astro";

interface Props {
  image: string;
}

const { image } = Astro.props;
---

<section class="vipar-servicios-hero">
  <div class="vipar-servicios-hero__copy">
    <Heading level={1} variant="display">Cristales templados, aluminio y terminaciones para obras en Paraguay.</Heading>
    <Text size="lg">
      Diseño, provisión e instalación de sistemas en vidrio templado, carpintería de aluminio
      y terminaciones técnicas para proyectos residenciales, comerciales y corporativos.
    </Text>
  </div>
  <div class="vipar-servicios-hero__media">
    <img src={image} alt="Fachada arquitectónica" />
  </div>
</section>
