---
import { Image } from "astro:assets";
import Button from "../ui/Button.astro";
import Card from "../ui/Card.astro";
import Heading from "../ui/Heading.astro";
import Text from "../ui/Text.astro";
import type { ServicioListItem } from "@types";

interface Props {
  servicio: ServicioListItem;
}

const { servicio } = Astro.props;
---

<Card as="article" variant="catalog" class="vipar-servicios-card" data-category={servicio.key}>
  <Image
    src={servicio.image}
    alt={servicio.alt ?? servicio.title}
    inferSize={true}
    widths={[360, 540, 720]}
    sizes="(max-width: 700px) 50vw, (max-width: 1024px) 50vw, 33vw"
    loading="lazy"
    decoding="async"
    format="webp"
    quality={66}
  />
  <div class="vipar-servicios-card__body">
    <Heading level={3} variant="sm">{servicio.title}</Heading>
    <Text size="sm">{servicio.description}</Text>
    <Button href={servicio.href} class="details-btn" variant="contained" tone="neutral" size="sm">
      Ver servicio
    </Button>
  </div>
</Card>
