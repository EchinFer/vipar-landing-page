---
import { Image } from "astro:assets";
import Button from "@components/ui/Button.astro";
import Container from "@components/ui/Container.astro";
import Heading from "@components/ui/Heading.astro";
import Text from "@components/ui/Text.astro";

interface HeroSpec {
  label: string;
  value: string;
}

interface Props {
  image: string;
  specs: HeroSpec[];
  whatsappHref: string;
}

const { image, specs, whatsappHref } = Astro.props;
---

<section class="aluminum-service-hero">
  <Container class="aluminum-service-hero__inner">
    <div class="aluminum-service-hero__copy">
      <Text as="div" variant="label-sm" tone="accent" class="aluminum-service-hero__eyebrow">
        Carpintería de aluminio en Paraguay
      </Text>
      <Heading level={1} variant="display">
        Carpintería de aluminio para puertas, ventanas y cerramientos
      </Heading>
      <Text variant="body-lg">
        Consultá opciones según medidas, uso del espacio, tipo de apertura y condiciones de
        instalación. Trabajamos con sistemas diversos adaptados a cada proyecto.
      </Text>
      <div class="aluminum-service-hero__actions">
        <Button
          href={whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          variant="contained"
          tone="primary"
          size="lg"
          data-track-event="whatsapp_click"
          data-cta-location="service_cta"
          data-service-name="Carpintería de aluminio"
          data-whatsapp-message-type="service_hero"
        >
          Cotizar por WhatsApp
        </Button>
        <Button href="#tipos" variant="outlined" tone="primary" size="lg">
          Ver tipos de aberturas
        </Button>
      </div>
      <div class="aluminum-service-hero__tags" aria-label="Soluciones disponibles">
        <span class="ds-tag">Batiente</span>
        <span class="ds-tag">Corrediza</span>
        <span class="ds-tag">A medida</span>
      </div>
    </div>

    <div class="aluminum-service-hero__media">
      <Image
        src={image}
        alt="Instalacion de puerta de aluminio"
        inferSize={true}
        widths={[768, 1024, 1280, 1600]}
        sizes="(max-width: 1100px) 100vw, 58vw"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        format="webp"
        quality={72}
      />
      <div class="aluminum-service-hero__specs">
        {specs.map((spec, index) => (
          <>
            {index > 0 && <div class="aluminum-service-hero__divider" aria-hidden="true"></div>}
            <div class="aluminum-service-hero__spec">
              <Text as="div" variant="label-sm" tone="muted">{spec.label}</Text>
              <Text as="div" variant="body-md">{spec.value}</Text>
            </div>
          </>
        ))}
      </div>
    </div>
  </Container>
</section>
