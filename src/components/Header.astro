---
import { Image } from "astro:assets";
import Button from "./ui/Button.astro";
import Container from "./ui/Container.astro";
import logoFull from "../assets/image/logo-full-public.png";
import logoSimple from "../assets/image/logo-simple-public.png";
import { LOGO_TEXT, MENU_ITEMS } from "src/constants";

const currentPathname = new URL(Astro.request.url).pathname;
---

<header class="vipar-site-header" aria-label="Menu principal">
  <Container as="nav" class="vipar-site-header__nav" aria-label="Navegacion principal">
    <a class="vipar-site-header__brand" href="/" aria-label="VIPAR S.A. — Inicio">
        <Image
          src={logoFull}
          alt="VIPAR S.A."
          widths={[254]}
          sizes="254px"
          format="webp"
          quality={70}
          loading="eager"
          decoding="async"
          fetchpriority="low"
          class="vipar-site-header__logo-full"
        />
        <Image
          src={logoSimple}
          alt="VIPAR S.A."
          widths={[63]}
          sizes="63px"
          format="webp"
          quality={70}
          loading="eager"
          decoding="async"
          fetchpriority="low"
          class="vipar-site-header__logo-icon"
        />
    </a>

    <button
      class="vipar-site-header__toggle"
      type="button"
      aria-expanded="false"
      aria-controls="vipar-site-nav"
      aria-label="Abrir menu"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <div class="vipar-site-header__links" id="vipar-site-nav">
      {
        MENU_ITEMS.map((menuItem) => {
          const itemUrl = menuItem.url.endsWith("/") ? menuItem.url : `${menuItem.url}/`;
          const isActive =
            currentPathname === itemUrl ||
            (itemUrl !== "/" && currentPathname.startsWith(itemUrl));

          return (
            <a
              href={menuItem.url}
              aria-current={isActive ? "page" : undefined}
              class:list={[isActive && "is-active"]}
            >
              {menuItem.title}
            </a>
          );
        })
      }
    </div>

    <Button
      href="/contacto/"
      variant="contained"
      tone="primary"
      size="md"
      class="vipar-site-header__cta"
      data-track-event="contact_cta_click"
      data-cta-location="header_cta"
    >
      Solicitar presupuesto
    </Button>
  </Container>
</header>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const header = document.querySelector(".vipar-site-header");
    const toggle = document.querySelector(".vipar-site-header__toggle");

    if (!(header instanceof HTMLElement) || !(toggle instanceof HTMLButtonElement)) {
      return;
    }

    toggle.addEventListener("click", () => {
      const isOpen = header.classList.toggle("is-open");
      toggle.setAttribute("aria-expanded", String(isOpen));
    });

    header.querySelectorAll(".vipar-site-header__links a").forEach((link) => {
      link.addEventListener("click", () => {
        header.classList.remove("is-open");
        toggle.setAttribute("aria-expanded", "false");
      });
    });
  });
</script>
