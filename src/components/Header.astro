---
import { Image } from "astro:assets";
import logo from "../assets/marca/logo-full.webp";
import { waUrl, mensajeLibre } from "../lib/pedido";
import { servicios } from "../data/servicios";

const presupuesto = waUrl(mensajeLibre("Vi la web y quiero coordinar una medición."));
const ruta = Astro.url.pathname;
---

<header class="sticky top-0 z-30 flex h-14 items-center justify-between bg-brand px-4 text-white md:px-8">
	<a href="/" aria-label="VIPAR S.A. - Terminaciones y obras, inicio">
		<Image src={logo} alt="VIPAR S.A. Terminaciones y obras" width={146} height={36} class="h-9 w-auto" loading="eager" />
	</a>
	<nav class="flex items-center gap-5 text-sm">
		<a href="/obras/" class:list={["hidden sm:inline", ruta.startsWith("/obras") && "underline underline-offset-4"]}>Obras</a>
		<a href="/servicios/" class:list={["hidden sm:inline", ruta.startsWith("/servicios") && "underline underline-offset-4"]}>Servicios</a>
		<a href="/contacto/" class:list={["hidden md:inline", ruta.startsWith("/contacto") && "underline underline-offset-4"]}>Contacto</a>
		<a href={presupuesto} data-origen="cabecera" class="hidden bg-white px-3 py-2 font-semibold text-brand md:inline">Pedir presupuesto</a>
		<details class="menu sm:hidden">
			<summary class="flex h-10 items-center gap-2 border border-white/40 px-3 font-semibold">Menú</summary>
			<div class="absolute inset-x-0 top-14 max-h-[calc(100svh-7rem)] overflow-y-auto bg-brand px-4 pt-2 pb-6 shadow-xl">
				<p class="kicker pt-3 text-sky">Servicios</p>
				<ul class="mt-2 grid grid-cols-2 gap-x-4">
					{servicios.map((servicio) => (
						<li><a href={`/servicios/${servicio.slug}/`} class="block py-2.5">{servicio.nombre}</a></li>
					))}
				</ul>
				<ul class="mt-3 border-t border-white/20 pt-3">
					<li><a href="/calculadora/" class="block py-2.5 font-semibold">Armar el pedido</a></li>
					<li><a href="/obras/" class="block py-2.5">Obras</a></li>
					<li><a href="/blog/" class="block py-2.5">Notas</a></li>
					<li><a href="/nosotros/" class="block py-2.5">La empresa</a></li>
					<li><a href="/contacto/" class="block py-2.5">Contacto</a></li>
				</ul>
			</div>
		</details>
	</nav>
</header>
