---
import Card from "@components/ui/Card.astro";
import Container from "@components/ui/Container.astro";
import Heading from "@components/ui/Heading.astro";
import Text from "@components/ui/Text.astro";
import type { MamparaFactorItem } from "@lib/static-servicio-mampara-divisoria";

interface Props {
  items: MamparaFactorItem[];
}

const { items } = Astro.props;
---

<section class="mampara-service-section mampara-service-factors">
  <Container>
    <div class="mampara-service-section__head">
      <Text as="div" variant="label-sm" tone="accent">Factores críticos</Text>
      <Heading level={2} variant="lg">Una mampara mal elegida puede arruinar el espacio</Heading>
      <Text variant="body-lg">
        Antes de solicitar una cotización, evaluamos las condiciones técnicas que definen el
        desempeño real del sistema.
      </Text>
    </div>
    <div class="mampara-service-factors__grid">
      {items.map((item) => (
        <Card as="article" class="mampara-service-factor">
          <Heading level={3} variant="sm">{item.title}</Heading>
          <Text>{item.description}</Text>
        </Card>
      ))}
    </div>
  </Container>
</section>
