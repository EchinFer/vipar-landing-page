---
import { Image } from "astro:assets";
import Container from "@components/ui/Container.astro";
import Heading from "@components/ui/Heading.astro";
import Text from "@components/ui/Text.astro";
import type { MamparaSymptomItem } from "@lib/static-servicio-mampara-divisoria";

interface Props {
  image: string;
  items: MamparaSymptomItem[];
}

const { image, items } = Astro.props;
---

<section class="mampara-service-section mampara-service-symptoms">
  <Container class="mampara-service-symptoms__grid">
    <div>
      <Heading level={2} variant="lg">Señales de que necesitás renovar tus divisiones</Heading>
      <div class="mampara-service-symptoms__list">
        {items.map((item) => (
          <article>
            <strong>{item.title}</strong>
            <Text variant="body-sm">{item.description}</Text>
          </article>
        ))}
      </div>
    </div>
    <div class="mampara-service-symptoms__media">
      <Image
        src={image}
        alt="Mamparas divisorias instaladas en espacio corporativo"
        inferSize={true}
        widths={[540, 720, 960]}
        sizes="(max-width: 1100px) 100vw, 50vw"
        loading="lazy"
        decoding="async"
        format="webp"
        quality={68}
      />
    </div>
  </Container>
</section>
