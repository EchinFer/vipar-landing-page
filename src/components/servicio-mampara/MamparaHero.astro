---
import Button from "@components/ui/Button.astro";
import Container from "@components/ui/Container.astro";
import Heading from "@components/ui/Heading.astro";
import Text from "@components/ui/Text.astro";

interface Props {
  image: string;
  tags: string[];
  whatsappHref: string;
}

const { image, tags, whatsappHref } = Astro.props;
---

<section class="mampara-service-hero">
  <Container class="mampara-service-hero__inner">
    <div class="mampara-service-hero__copy">
      <Text as="div" variant="label-sm" tone="accent" class="mampara-service-hero__eyebrow">
        Mamparas divisorias en Paraguay
      </Text>
      <Heading level={1} variant="display">
        Mamparas divisorias para oficinas, comercios y espacios interiores
      </Heading>
      <Text variant="body-lg">
        Mamparas divisorias para oficinas, comercios y espacios interiores en Paraguay. Consultá opciones en cristal templado, Durlock o Eucatex según medidas, uso del ambiente y condiciones de instalación.
      </Text>
      <div class="mampara-service-hero__actions">
        <Button
          href={whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          variant="contained"
          tone="primary"
          size="lg"
          data-track-event="whatsapp_service_click"
          data-cta-location="mamparas_divisorias_hero"
          data-service-name="Mamparas divisorias"
          data-whatsapp-message-type="service_hero"
        >
          Cotizar por WhatsApp
        </Button>
        <Button href="#tipos" variant="outlined" tone="primary" size="lg">
          Ver tipos de mamparas
        </Button>
      </div>
      <div class="mampara-service-hero__tags">
        {tags.map((tag) => <span class="ds-tag">{tag}</span>)}
      </div>
    </div>
    <div class="mampara-service-hero__media">
      <img src={image} alt="Mamparas divisorias para oficinas y comercios" />
    </div>
  </Container>
</section>
