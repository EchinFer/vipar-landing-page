---
import Button from "@components/ui/Button.astro";
import Container from "@components/ui/Container.astro";
import Heading from "@components/ui/Heading.astro";
import Text from "@components/ui/Text.astro";

interface Props {
  image: string;
  tags: string[];
}

const { image, tags } = Astro.props;
---

<section class="mampara-service-hero">
  <Container class="mampara-service-hero__inner">
    <div class="mampara-service-hero__copy">
      <Text as="div" variant="label-sm" tone="accent" class="mampara-service-hero__eyebrow">
        Mamparas divisorias en Paraguay
      </Text>
      <Heading level={1} variant="display">
        Mamparas divisorias para oficinas, comercios y obras
      </Heading>
      <Text variant="body-lg">
        Soluciones arquitectónicas en cristal templado, eucatex y durlock para optimizar
        espacios profesionales con precisión y diseño.
      </Text>
      <div class="mampara-service-hero__actions">
        <Button href="/contacto/" variant="contained" tone="primary" size="lg">
          Cotizar mamparas divisorias
        </Button>
        <Button href="#tipos" variant="outlined" tone="primary" size="lg">
          Ver tipos de mamparas
        </Button>
      </div>
      <div class="mampara-service-hero__tags">
        {tags.map((tag) => <span class="ds-tag">{tag}</span>)}
      </div>
    </div>
    <div class="mampara-service-hero__media">
      <img src={image} alt="Mamparas divisorias para oficinas y comercios" />
    </div>
  </Container>
</section>
