---
import Button from "@components/ui/Button.astro";
import Container from "@components/ui/Container.astro";
import Heading from "@components/ui/Heading.astro";
import Text from "@components/ui/Text.astro";

interface Props {
  image: string;
  tags: string[];
  whatsappHref: string;
}

const { image, tags, whatsappHref } = Astro.props;
---

<section class="mampara-service-hero">
  <Container class="mampara-service-hero__inner">
    <div class="mampara-service-hero__copy">
      <Text as="div" variant="label-sm" tone="accent" class="mampara-service-hero__eyebrow">
        Mamparas divisorias en Paraguay
      </Text>
      <Heading level={1} variant="display">
        Mamparas divisorias para oficinas, comercios y espacios corporativos
      </Heading>
      <Text variant="body-lg">
        Cotizá mamparas divisorias para salas, puestos de trabajo, recepciones y áreas operativas.
        Te orientamos entre cristal templado, Durlock o Eucatex según privacidad, imagen,
        mantenimiento y velocidad de obra.
      </Text>
      <div class="mampara-service-hero__actions">
        <Button
          href={whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          variant="contained"
          tone="primary"
          size="lg"
          data-track-event="whatsapp_click"
          data-cta-location="service_cta"
          data-service-name="Mamparas divisorias"
          data-whatsapp-message-type="service_hero"
        >
          Cotizar por WhatsApp
        </Button>
        <Button href="#tipos" variant="outlined" tone="primary" size="lg">
          Ver tipos de mamparas
        </Button>
      </div>
      <div class="mampara-service-hero__tags">
        {tags.map((tag) => <span class="ds-tag">{tag}</span>)}
      </div>
    </div>
    <figure class="mampara-service-hero__media" style="margin:0">
      <img
        src={image}
        alt="Oficina dividida con mamparas de vidrio templado y perfiles de aluminio — obra VIPAR"
        width={550}
        height={367}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <figcaption class="service-hero-caption">Obra VIPAR · Divisorias de vidrio templado · Oficina en Paraguay</figcaption>
    </figure>
  </Container>
</section>
