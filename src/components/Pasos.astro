---
import { pasos } from "../data/servicios";

interface Props {
	titulo?: string;
}

const { titulo = "De la consulta a la instalación" } = Astro.props;
---

<section class="panes bg-brand px-4 py-14 text-white md:px-8 md:py-20" aria-label="Cómo trabajamos">
	<p class="kicker text-sky">Cómo trabajamos</p>
	<h2 class="reveal mt-3 max-w-[22ch] text-3xl leading-[1.05] md:text-5xl">{titulo}</h2>
	<ol class="mt-10 grid gap-8 md:grid-cols-5 md:gap-6">
		{
			pasos.map((paso, indice) => (
				<li class="reveal border-t border-white/30 pt-4" style={`transition-delay:${indice * 80}ms`}>
					<p class="text-4xl font-bold tabular-nums text-sky/90">0{indice + 1}</p>
					<h3 class="mt-3 text-lg font-bold">{paso.titulo}</h3>
					<p class="mt-2 text-sm leading-snug text-white/85">{paso.texto}</p>
				</li>
			))
		}
	</ol>
</section>
