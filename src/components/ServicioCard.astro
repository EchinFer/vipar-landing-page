---
import Foto from "./Foto.astro";
import type { Servicio } from "../data/servicios";
import { fotosDe } from "../lib/fotos";
import { calcPorSlug, desdeM2, formatGs } from "../lib/pedido";

interface Props {
	servicio: Servicio;
	compacto?: boolean;
}

const { servicio, compacto = false } = Astro.props;
const foto = fotosDe(servicio.foto)[0];
const desde = desdeM2(calcPorSlug[servicio.slug]);
---

<a href={`/servicios/${servicio.slug}/`} class:list={["zoom group flex h-full gap-4 border border-aluminum/60 bg-white p-3 transition-shadow hover:shadow-lg", !compacto && "md:block md:p-0"]}>
	<div class:list={["size-24 shrink-0 overflow-hidden", !compacto && "md:aspect-[4/3] md:size-auto md:w-full"]}>
		<Foto src={foto} alt={servicio.nombre} class="size-full object-cover" sizes="(min-width: 768px) 33vw, 100px" widths={[200, 480, 720]} />
	</div>
	<div class:list={["min-w-0", !compacto && "md:p-5"]}>
		<h3 class="text-lg font-bold leading-tight text-brand md:text-xl">{servicio.nombre}</h3>
		<p class="mt-1 text-sm leading-snug text-ink">{servicio.description}</p>
		{desde && <p class="mt-2 text-sm text-ink">Desde <strong class="text-brand">{formatGs(desde)}</strong> por m² <span class="text-muted">(referencia)</span></p>}
		<p class:list={["mt-2 hidden text-sm font-semibold text-brand", !compacto && "md:block"]}>Ver el servicio <span aria-hidden="true" class="inline-block transition-transform group-hover:translate-x-1">→</span></p>
	</div>
</a>
