---
import Foto from "./Foto.astro";
import type { Servicio } from "../data/servicios";
import { fotosDe } from "../lib/fotos";

interface Props {
	servicio: Servicio;
}

const { servicio } = Astro.props;
const foto = fotosDe(servicio.foto)[0];
---

<a href={`/servicios/${servicio.slug}/`} class="zoom group flex gap-4 border border-aluminum/60 bg-white p-3 transition-shadow hover:shadow-lg md:block md:p-0">
	<div class="size-24 shrink-0 overflow-hidden md:aspect-[4/3] md:size-auto md:w-full">
		<Foto src={foto} alt={servicio.nombre} class="size-full object-cover" sizes="(min-width: 768px) 33vw, 100px" widths={[200, 480, 720]} />
	</div>
	<div class="min-w-0 md:p-5">
		<h3 class="text-lg font-bold leading-tight text-brand md:text-xl">{servicio.nombre}</h3>
		<p class="mt-1 text-sm leading-snug text-ink">{servicio.description}</p>
		<p class="mt-2 hidden text-sm font-semibold text-brand md:block">Ver el servicio <span aria-hidden="true" class="inline-block transition-transform group-hover:translate-x-1">→</span></p>
	</div>
</a>
