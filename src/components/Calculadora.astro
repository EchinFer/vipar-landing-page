---
import { ids, mensajePedido, opciones, waUrl, type ServicioCalc } from "../lib/pedido";

interface Props {
	servicio?: ServicioCalc;
}

const fijo = Astro.props.servicio;
const inicial: ServicioCalc = fijo ?? "box";
const base = opciones[inicial];
const pedidoInicial = {
	servicio: inicial,
	material: base.materiales[base.materialInicial].id,
	apertura: base.aperturas[0]?.id ?? "",
	ancho: base.ancho,
	alto: base.alto,
};
const hrefInicial = waUrl(mensajePedido(pedidoInicial).texto);
const paneles = fijo ? [fijo] : ids;
---

<section class="border border-brand bg-white p-4 md:p-8" id="presupuesto" data-calculadora data-fijo={fijo ?? ""}>
	<p class="kicker text-muted">Pedido</p>
	<h2 class="mt-2 text-3xl leading-[1.05] text-brand md:text-5xl">Armá lo que querés instalar</h2>
	<p class="mt-4 max-w-xl text-muted">Elegí el tipo, el material y una medida aproximada. El mensaje de WhatsApp sale con esos datos.</p>

	<form class="mt-8 grid gap-6">
		{
			!fijo && (
				<fieldset>
					<legend class="mb-2 text-sm font-semibold">Qué querés instalar</legend>
					<div class="grid grid-cols-2 gap-2 md:grid-cols-3">
						{ids.map((id) => (
							<label class="choice relative cursor-pointer [&:last-child:nth-child(odd)]:col-span-2 md:[&:last-child:nth-child(odd)]:col-span-1">
								<input type="radio" name="servicio" value={id} checked={id === inicial} />
								<span>{opciones[id].etiqueta}</span>
							</label>
						))}
					</div>
				</fieldset>
			)
		}

		{
			paneles.map((servicio) => {
				const config = opciones[servicio];
				return (
					<div data-panel={servicio} hidden={servicio !== inicial}>
						<fieldset>
							<legend class="mb-2 text-sm font-semibold">{config.grupoMaterial}</legend>
							<div class="grid gap-2 sm:grid-cols-2 md:grid-cols-3">
								{config.materiales.map((item, indice) => (
									<label class="choice relative cursor-pointer">
										<input type="radio" name={`material-${servicio}`} value={item.id} checked={servicio === inicial && indice === config.materialInicial} />
										<span>{item.label}</span>
									</label>
								))}
							</div>
						</fieldset>
						{config.aperturas.length > 0 && (
							<fieldset class="mt-6">
								<legend class="mb-2 text-sm font-semibold">{config.grupoApertura}</legend>
								<div class="grid grid-cols-1 gap-2 md:grid-cols-3">
									{config.aperturas.map((item, indice) => (
										<label class="choice relative cursor-pointer">
											<input type="radio" name={`apertura-${servicio}`} value={item.id} checked={servicio === inicial && indice === 0} />
											<span>{item.label}</span>
										</label>
									))}
								</div>
							</fieldset>
						)}
					</div>
				);
			})
		}

		<div class="grid grid-cols-2 gap-3">
			<label class="block text-sm font-semibold">
				<span data-medida="a">{base.medidaA}</span> (m)
				<input class="mt-2 w-full border border-aluminum bg-white px-3 py-3 text-lg font-normal" name="ancho" type="number" inputmode="decimal" min="0.4" max={base.max} step="0.05" value={base.ancho} />
			</label>
			<label class="block text-sm font-semibold">
				<span data-medida="b">{base.medidaB}</span> (m)
				<input class="mt-2 w-full border border-aluminum bg-white px-3 py-3 text-lg font-normal" name="alto" type="number" inputmode="decimal" min="0.4" max={base.max} step="0.05" value={base.alto} />
			</label>
		</div>
		<label class="block text-sm font-semibold">
			Ciudad o zona de la obra <span class="font-normal text-muted">(opcional)</span>
			<input class="mt-2 w-full border border-aluminum bg-white px-3 py-3 text-lg font-normal" name="ciudad" type="text" autocomplete="address-level2" placeholder="Ñemby, Asunción, Luque…" maxlength="60" />
		</label>
	</form>

	<p class="resultado mt-8 text-3xl leading-[1.05] font-bold text-brand md:text-4xl" data-resultado>El rango te lo pasamos por WhatsApp.</p>
	<p class="mt-3 max-w-xl text-sm text-muted" data-aclaracion>El precio se cierra cuando medimos en la obra.</p>
	<a class="btn btn-primary mt-6 w-full" data-pedir data-origen="calculadora" href={hrefInicial}>Pedir presupuesto</a>
</section>

<script>
	import { ids, mensajePedido, opciones, waUrl, type ServicioCalc } from "../lib/pedido";

	function leerNumero(valor: string) {
		const n = Number(valor.replace(",", "."));
		return Number.isFinite(n) ? n : 0;
	}

	document.querySelectorAll<HTMLElement>("[data-calculadora]").forEach((raiz) => {
		const fijo = raiz.dataset.fijo as ServicioCalc | "";
		const form = raiz.querySelector("form");
		const resultado = raiz.querySelector("[data-resultado]");
		const aclaracion = raiz.querySelector("[data-aclaracion]");
		const pedir = raiz.querySelector<HTMLAnchorElement>("[data-pedir]");
		if (!form || !resultado || !aclaracion || !pedir) return;

		const paneles = raiz.querySelectorAll<HTMLElement>("[data-panel]");
		let servicioPrevio = servicioActual();

		function servicioActual(): ServicioCalc {
			if (fijo && ids.includes(fijo)) return fijo;
			const marcado = form!.querySelector<HTMLInputElement>('input[name="servicio"]:checked');
			const valor = marcado?.value as ServicioCalc | undefined;
			return valor && ids.includes(valor) ? valor : "box";
		}

		function valorMarcado(nombre: string, fallback: string, indice = 0) {
			let marcado = form!.querySelector<HTMLInputElement>(`input[name="${nombre}"]:checked`);
			if (!marcado) {
				marcado = form!.querySelectorAll<HTMLInputElement>(`input[name="${nombre}"]`)[indice] ?? null;
				if (marcado) marcado.checked = true;
			}
			return marcado?.value ?? fallback;
		}

		function pintar() {
			const servicio = servicioActual();
			const config = opciones[servicio];
			paneles.forEach((panel) => {
				panel.hidden = panel.dataset.panel !== servicio;
			});
			const anchoInput = form!.querySelector<HTMLInputElement>('input[name="ancho"]');
			const altoInput = form!.querySelector<HTMLInputElement>('input[name="alto"]');
			if (servicio !== servicioPrevio) {
				const antes = opciones[servicioPrevio];
				if (anchoInput && altoInput) {
					const anchoActual = leerNumero(anchoInput.value);
					const altoActual = leerNumero(altoInput.value);
					const seguiaElDefecto = Math.abs(anchoActual - antes.ancho) < 0.001 && Math.abs(altoActual - antes.alto) < 0.001;
					if (seguiaElDefecto) {
						anchoInput.value = String(config.ancho);
						altoInput.value = String(config.alto);
					}
				}
				servicioPrevio = servicio;
			}
			if (anchoInput) anchoInput.max = String(config.max);
			if (altoInput) altoInput.max = String(config.max);
			const a = raiz.querySelector("[data-medida='a']");
			const b = raiz.querySelector("[data-medida='b']");
			if (a) a.textContent = config.medidaA;
			if (b) b.textContent = config.medidaB;

			const material = valorMarcado(`material-${servicio}`, config.materiales[0].id, config.materialInicial);
			const apertura = config.aperturas.length > 0 ? valorMarcado(`apertura-${servicio}`, config.aperturas[0].id) : "";
			const ancho = leerNumero(anchoInput?.value ?? "");
			const alto = leerNumero(altoInput?.value ?? "");
			const ciudad = form!.querySelector<HTMLInputElement>('input[name="ciudad"]')?.value ?? "";
			const { texto, calculo } = mensajePedido({ servicio, material, apertura, ancho, alto, ciudad });
			if (!calculo) {
				resultado!.textContent = "El rango te lo pasamos por WhatsApp.";
				aclaracion!.textContent = "El precio se cierra cuando medimos en la obra.";
			} else {
				const marca = calculo.ejemplo ? " PRECIO DE EJEMPLO" : "";
				resultado!.textContent = `${calculo.min.toLocaleString("es-PY")} a ${calculo.max.toLocaleString("es-PY")}${marca}`;
				aclaracion!.textContent = calculo.ejemplo
					? "Este número es de ejemplo. No es un presupuesto de VIPAR. El precio se cierra en la medición."
					: calculo.fuera
						? "La medida se sale de la referencia. Tomá el rango como orientación. El precio se cierra en la medición."
						: "El precio se cierra cuando medimos en la obra.";
			}
			const destino = waUrl(texto);
			pedir!.href = destino;
			document.querySelectorAll<HTMLAnchorElement>("[data-wa-bar]").forEach((barra) => {
				barra.href = destino;
			});
		}

		form.addEventListener("change", pintar);
		form.addEventListener("input", pintar);
		pintar();
	});
</script>
