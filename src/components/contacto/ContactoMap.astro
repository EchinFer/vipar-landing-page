---
import Button from "@components/ui/Button.astro";
import Card from "@components/ui/Card.astro";
import Container from "@components/ui/Container.astro";
import Heading from "@components/ui/Heading.astro";
import Text from "@components/ui/Text.astro";

interface Props {
  googleMapsUrl: string;
}

const { googleMapsUrl } = Astro.props;
---

<Container class="contact-container">
  <Card as="section" class="contact-map">
    <div class="contact-map__head">
      <div>
        <Heading level={2} variant="md" class="contact-map__title">Ubicación Estratégica</Heading>
        <Text class="contact-map__copy">Nuestra planta y oficinas técnicas en Ñemby, Paraguay</Text>
      </div>

      <Button
        href={googleMapsUrl}
        target="_blank"
        rel="noopener noreferrer"
        variant="link"
        tone="primary"
        class="contact-map__action"
      >
        Abrir en Google Maps
        <span class="material-symbols-outlined" aria-hidden="true">open_in_new</span>
      </Button>
    </div>

    <div class="contact-map__visual">
      <iframe
        src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d450.52744847537275!2d-57.5541118547404!3d-25.397459231338143!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x945dab8784646b99%3A0xa108aa4012e395af!2sVIPAR%20S.A!5e0!3m2!1ses-419!2spy!4v1777936587196!5m2!1ses-419!2spy"
        title="Mapa con ubicación de VIPAR S.A. en Ñemby, Paraguay"
        style="border:0;"
        allowfullscreen
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
  </Card>
</Container>
