---
import ContactFormGeneric from "@components/ContactFormGeneric.astro";
import { telephone } from "src/constants";

const whatsappNumber = telephone.replace(/[^\d]/g, "");
---

<ContactFormGeneric
  formId="vipar-contact-form"
  source="vipar-contacto"
  variant="contact"
  title="Consulta Técnica"
  intro="Su consulta no molesta. Estamos aquí para responder a sus consultas técnicas y ayudarlo a encontrar la mejor solución para su proyecto u obra."
  showServiceSelect={false}
  showAsuntoSelect={true}
  showFileUpload={true}
  cardClass="contact-form-panel"
  formClass="contact-form"
  whatsappNumber={whatsappNumber}
/>
