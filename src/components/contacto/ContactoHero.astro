---
import Container from "@components/ui/Container.astro";
import Heading from "@components/ui/Heading.astro";
import Text from "@components/ui/Text.astro";
---

<section class="contact-hero">
  <Container class="contact-container">
    <Heading level={1} variant="display" class="contact-hero__title"
      >Contacto</Heading
    >
    <Text class="contact-hero__body">
      Estamos aquí para responder a sus consultas técnicas y proyectos de
      ingeniería. Contáctenos para iniciar su próxima obra con precisión y
      calidad.
    </Text>
  </Container>
</section>
