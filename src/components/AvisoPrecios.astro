---
import { avisoPrecios, preciosFecha, preciosVigencia, waUrl } from "../lib/pedido";
import NoMolesta from "./NoMolesta.astro";

interface Props {
	/** Texto del WhatsApp que arma el botón. */
	asunto: string;
	/** Hay un armador en la misma página. */
	calcular?: boolean;
}

const { asunto, calcular = false } = Astro.props;
---

<aside class="mt-6 border-l-4 border-brand bg-wash p-5 md:p-6" aria-label="Sobre estos precios">
	<p class="kicker text-muted">Precios de referencia · <time datetime={preciosFecha}>{preciosVigencia}</time></p>
	<p class="mt-3 leading-relaxed">{avisoPrecios}</p>
	<div class="mt-5 flex flex-wrap gap-3">
		<a href={waUrl(asunto)} data-origen="aviso-precios" class="btn btn-primary">Pedir presupuesto exacto</a>
		{calcular && <a href="#presupuesto" class="btn btn-line text-brand">Calcular mi caso</a>}
	</div>
	<NoMolesta texto="Preguntar el precio no te ata a nada." />
</aside>
