---
import Heading from "@components/ui/Heading.astro";

interface Props {
  titulo: string;
  systemLabel: string;
  imagen: string;
  imagenes?: string[];
}

const { titulo, systemLabel, imagen, imagenes = [] } = Astro.props;

const allImages = [...(imagen ? [imagen] : []), ...imagenes];
---

{allImages.length > 0 && (
  <section class="od-gallery">
    <Heading level={3} variant="md" class="od-gallery__title">Galería del Proyecto</Heading>

    <div class="od-gallery__grid">
      {allImages.map((img, i) => (
        <a
          href={img}
          class="od-gallery__item glightbox"
          data-gallery="obra-detail-gallery"
          data-title={titulo}
        >
          <img
            src={img}
            alt={`${systemLabel} – ${titulo}, foto ${i + 1}`}
            loading={i === 0 ? "eager" : "lazy"}
            decoding="async"
          />
        </a>
      ))}
    </div>
  </section>
)}
