---
import ActionLink from "@components/ui/ActionLink.astro";
import Card from "@components/ui/Card.astro";
import Heading from "@components/ui/Heading.astro";
import Text from "@components/ui/Text.astro";

interface ServiceInfo {
  icon: string;
  label: string;
  description: string;
  href: string;
}

interface Props {
  tags: string[];
}

const { tags } = Astro.props;

const SERVICE_MAP: Record<string, Omit<ServiceInfo, "label">> = {
  Fachadas: {
    icon: "bi-building",
    description: "Sistemas de fachada en cristal y aluminio según el tipo de proyecto y la lectura visual buscada.",
    href: "/servicios/",
  },
  "Cristal templado": {
    icon: "bi-gem",
    description: "Vidrio templado de alta resistencia para fachadas, tabiques y cerramientos.",
    href: "/servicios/",
  },
  Cristal: {
    icon: "bi-gem",
    description: "Soluciones en cristal templado y laminado para construcción residencial y comercial.",
    href: "/servicios/",
  },
  Aluminio: {
    icon: "bi-columns-gap",
    description: "Perfiles de aluminio con terminaciones acordes al uso, las medidas y el lenguaje del proyecto.",
    href: "/servicios/",
  },
  Mamparas: {
    icon: "bi-layout-sidebar-inset",
    description: "Divisiones interiores en cristal con opciones acústicas y de privacidad.",
    href: "/servicios/",
  },
  "Mamparas de Cristal": {
    icon: "bi-layout-sidebar-inset",
    description: "Tabiquería interior de vidrio templado, configurable y de montaje limpio.",
    href: "/servicios/",
  },
  "Cielos rasos": {
    icon: "bi-grid-3x3-gap",
    description: "Sistemas de cielorraso en aluminio y materiales compuestos para interiores modernos.",
    href: "/servicios/",
  },
  Ventanas: {
    icon: "bi-border-all",
    description: "Ventanas de aluminio y PVC con opciones de control solar y tratamiento acústico según sistema.",
    href: "/servicios/",
  },
  Puertas: {
    icon: "bi-door-open",
    description: "Puertas en aluminio y cristal para accesos residenciales, comerciales e institucionales.",
    href: "/servicios/",
  },
  Terminaciones: {
    icon: "bi-stars",
    description: "Detalles y terminaciones en aluminio y vidrio para una obra impecable.",
    href: "/servicios/",
  },
};

const DEFAULT_SERVICE: Omit<ServiceInfo, "label"> = {
  icon: "bi-tools",
  description: "Servicio especializado en carpintería de aluminio y cristal templado.",
  href: "/servicios/",
};

const services: ServiceInfo[] = tags.map((tag) => ({
  label: tag,
  ...(SERVICE_MAP[tag] ?? DEFAULT_SERVICE),
}));
---

{services.length > 0 && (
  <section class="od-servicios">
    <div class="od-servicios__inner">
      <Heading level={3} variant="md" class="od-servicios__title">Servicios Aplicados</Heading>

      <div class="od-servicios__grid">
        {services.map((service) => (
          <Card as="article" variant="info">
            <i class={`bi ${service.icon} ds-card__icon`} aria-hidden="true"></i>
            <Heading level={4} variant="sm" class="ds-card__title">{service.label}</Heading>
            <Text class="ds-card__description">{service.description}</Text>
            <ActionLink href={service.href}>
              Ver servicios <i class="bi bi-arrow-right" aria-hidden="true"></i>
            </ActionLink>
          </Card>
        ))}
      </div>
    </div>
  </section>
)}
