---
interface Props {
  titulo: string;
  ubicacion: string;
  imagen: string;
  slug?: string;
}

const { titulo, ubicacion, imagen, slug } = Astro.props;
---

<!-- Breadcrumb -->
<nav class="od-breadcrumb" aria-label="Breadcrumb">
  <a href="/obras">Proyectos</a>
  <i class="bi bi-chevron-right od-breadcrumb__sep"></i>
  <span class="od-breadcrumb__current">{titulo}</span>
</nav>

<!-- Hero image -->
<div class="od-hero-wrap">
  <div class="od-hero">
    <img
      class="od-hero__img"
      src={imagen}
      alt={titulo}
      loading="eager"
      decoding="async"
    />
    <div class="od-hero__overlay"></div>

    <div class="od-hero__meta">
      <div>
        <h1 class="od-hero__title">{titulo}</h1>
        <div class="od-hero__location">
          <i class="bi bi-geo-alt-fill"></i>
          <span>{ubicacion}</span>
        </div>
      </div>
      <a href="/contacto/" class="od-hero__cta">Cotizar algo similar</a>
    </div>
  </div>
</div>
