---
import Button from "@components/ui/Button.astro";
import Heading from "@components/ui/Heading.astro";

interface Props {
  titulo: string;
  ubicacion: string;
  imagen: string;
}

const { titulo, ubicacion, imagen } = Astro.props;
---

<nav class="od-breadcrumb" aria-label="Breadcrumb">
  <a href="/obras/">Proyectos</a>
  <i class="bi bi-chevron-right od-breadcrumb__sep"></i>
  <span class="od-breadcrumb__current">{titulo}</span>
</nav>

<div class="od-hero-wrap">
  <div class="od-hero">
    <img class="od-hero__img" src={imagen} alt={`${titulo} – ${ubicacion} | VIPAR`} loading="eager" decoding="async" />
    <div class="od-hero__overlay"></div>

    <div class="od-hero__meta">
      <div>
        <Heading level={1} variant="display" tone="inverse" class="od-hero__title">{titulo}</Heading>
        <div class="od-hero__location">
          <i class="bi bi-geo-alt-fill"></i>
          <span>{ubicacion}</span>
        </div>
      </div>
      <Button
        href="/contacto/"
        variant="contained"
        tone="secondary"
        size="md"
        class="od-hero__cta"
        data-track-event="contact_cta_click"
        data-cta-location="obra_hero_primary"
      >
        Cotizar algo similar
      </Button>
    </div>
  </div>
</div>
