---
import Card from "@components/ui/Card.astro";
import Text from "@components/ui/Text.astro";

interface Props {
  sectorLabel: string;
  ubicacion: string;
  displayTags: string[];
}

const { sectorLabel, ubicacion, displayTags } = Astro.props;
---

<div class="od-ficha-wrap">
  <div class="od-ficha-grid">
    <Card as="div" class="od-ficha-card">
      <Text as="div" variant="label-sm" tone="muted" class="od-ficha-card__label">Tipo de obra</Text>
      <div class="od-ficha-card__value">{sectorLabel}</div>
    </Card>

    <Card as="div" class="od-ficha-card">
      <Text as="div" variant="label-sm" tone="muted" class="od-ficha-card__label">Ubicación</Text>
      <div class="od-ficha-card__value">{ubicacion}</div>
    </Card>

    <Card as="div" class="od-ficha-card">
      <Text as="div" variant="label-sm" tone="muted" class="od-ficha-card__label">Servicios aplicados</Text>
      <div class="od-ficha-card__tags">
        {displayTags.map((tag) => (
          <span class="od-ficha-tag">{tag}</span>
        ))}
      </div>
    </Card>
  </div>
</div>
