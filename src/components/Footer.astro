---
import { empresa } from "../data/empresa";
---

<footer class="border-t border-aluminum px-4 py-10 md:px-8">
	<div class="grid gap-8 md:grid-cols-3">
		<div>
			<p class="font-display text-3xl leading-none">VIPAR</p>
			<p class="mt-3 max-w-xs text-sm text-muted">Vidrio templado y aluminio desde {empresa.desde}, en {empresa.ciudad}.</p>
		</div>
		<div class="text-sm leading-6">
			<p>{empresa.direccion}</p>
			<p>{empresa.ciudad}, {empresa.departamento}</p>
			<p class="mt-2">{empresa.horario}</p>
		</div>
		<div class="text-sm leading-6">
			<p><a href={`tel:${empresa.telefono}`}>{empresa.telefono}</a></p>
			<p><a href={`mailto:${empresa.email}`}>{empresa.email}</a></p>
			<p class="mt-3"><a href="/obras/" class="underline underline-offset-4">Ver las obras</a></p>
		</div>
	</div>
</footer>
