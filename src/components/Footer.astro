---
import Button from "./ui/Button.astro";
import Container from "./ui/Container.astro";
import {
  LOGO_TEXT,
  MENU_ITEMS,
  SOCIAL_LINKS,
  address,
  email,
  telephone,
} from "src/constants";

const currentYear = new Date().getFullYear();
const serviceLinks = [
  { label: "Cristales Templados", href: "/servicios/" },
  { label: "Carpinteria de Aluminio", href: "/servicios/carpinteria-de-aluminio/" },
  { label: "Fachadas", href: "/servicios/fachadas/" },
  { label: "Mamparas y Divisiones", href: "/servicios/mampara-divisoria/" },
  { label: "Cielos Rasos", href: "/servicios/cielo-raso/" },
];
const whatsappNumber = telephone.replace(/[^\d]/g, "");
---

<footer class="vipar-site-footer">
  <Container class="vipar-site-footer__grid">
    <div class="vipar-site-footer__brand">
      <a href="/" aria-label="VIPAR S.A. — Inicio" class="vipar-site-footer__logo">
        <img src="/img/logo.png" alt="VIPAR S.A." />
      </a>
      <p>
        Empresa paraguaya dedicada a cristales templados, aluminio y terminaciones para
        viviendas, comercios, oficinas y obras.
      </p>

      <div class="vipar-site-footer__socials">
        {SOCIAL_LINKS.instagram && (
          <a
            href={SOCIAL_LINKS.instagram}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram VIPAR"
          >
            <span class="material-symbols-outlined" aria-hidden="true">photo_camera</span>
          </a>
        )}
        {SOCIAL_LINKS.facebook && (
          <a
            href={SOCIAL_LINKS.facebook}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook VIPAR"
          >
            <span class="material-symbols-outlined" aria-hidden="true">groups</span>
          </a>
        )}
      </div>
    </div>

    <div class="vipar-site-footer__column">
      <h3>Enlaces Rapidos</h3>
      {MENU_ITEMS.map((menuItem) => (
        <a href={menuItem.url}>{menuItem.title}</a>
      ))}
    </div>

    <div class="vipar-site-footer__column">
      <h3>Servicios</h3>
      {serviceLinks.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </div>

    <div class="vipar-site-footer__column">
      <h3>Contacto</h3>
      <p class="vipar-site-footer__contact">
        <span class="material-symbols-outlined" aria-hidden="true">location_on</span>
        <span>{address}</span>
      </p>
      <p class="vipar-site-footer__contact">
        <span class="material-symbols-outlined" aria-hidden="true">call</span>
        <a href={`tel:${telephone}`}>{telephone}</a>
      </p>
      <p class="vipar-site-footer__contact">
        <span class="material-symbols-outlined" aria-hidden="true">mail</span>
        <a href={`mailto:${email}`}>{email}</a>
      </p>

      <Button
        href={`https://wa.me/${whatsappNumber}`}
        target="_blank"
        rel="noopener noreferrer"
        variant="contained"
        tone="secondary"
        size="md"
        class="vipar-site-footer__cta"
      >
        Solicitar Presupuesto
      </Button>
    </div>
  </Container>

  <Container class="vipar-site-footer__bottom">
    <p>&copy; {currentYear} {LOGO_TEXT}. Todos los derechos reservados.</p>
    <div>
      <a href="/contacto/">Contacto</a>
      <a href="/obras/">Obras</a>
    </div>
  </Container>
</footer>
