---
import { Image } from "astro:assets";
import Button from "./ui/Button.astro";
import Container from "./ui/Container.astro";
import logoFull from "../assets/image/logo-full-public.png";
import {
  LOGO_TEXT,
  MENU_ITEMS,
  SOCIAL_LINKS,
  address,
  email,
  telephone,
  whatsappNumber,
} from "src/constants";
import { buildWhatsappMessage, buildWhatsappUrl } from "@lib/whatsapp";

const currentYear = new Date().getFullYear();
const serviceLinks = [
  { label: "Cristales Templados", href: "/servicios/" },
  { label: "Carpinteria de Aluminio", href: "/servicios/carpinteria-de-aluminio/" },
  { label: "Fachadas", href: "/servicios/fachadas/" },
  { label: "Mamparas y Divisiones", href: "/servicios/mamparas-divisorias/" },
  { label: "Cielos Rasos", href: "/servicios/cielo-raso/" },
];
const footerWhatsappHref = buildWhatsappUrl(
  buildWhatsappMessage({ pageLabel: "footer", prompt: "Quiero recibir orientacion comercial." })
);
---

<footer class="vipar-site-footer">
  <Container class="vipar-site-footer__grid">
    <div class="vipar-site-footer__brand">
      <a href="/" aria-label="VIPAR S.A. — Inicio" class="vipar-site-footer__logo">
        <Image
          src={logoFull}
          alt="VIPAR S.A."
          widths={[254]}
          sizes="254px"
          format="webp"
          quality={70}
        />
      </a>
      <p>
        Empresa paraguaya dedicada a cristales templados, aluminio y terminaciones para
        viviendas, comercios, oficinas y obras.
      </p>

      <div class="vipar-site-footer__socials">
        {SOCIAL_LINKS.instagram && (
          <a
            href={SOCIAL_LINKS.instagram}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Instagram VIPAR"
          >
            <i class="bi bi-instagram" aria-hidden="true"></i>
          </a>
        )}
        {SOCIAL_LINKS.facebook && (
          <a
            href={SOCIAL_LINKS.facebook}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Facebook VIPAR"
          >
            <i class="bi bi-facebook" aria-hidden="true"></i>
          </a>
        )}
      </div>
    </div>

    <div class="vipar-site-footer__column">
      <h3>Enlaces Rapidos</h3>
      {MENU_ITEMS.map((menuItem) => (
        <a href={menuItem.url}>{menuItem.title}</a>
      ))}
    </div>

    <div class="vipar-site-footer__column">
      <h3>Servicios</h3>
      {serviceLinks.map((item) => (
        <a href={item.href}>{item.label}</a>
      ))}
    </div>

    <div class="vipar-site-footer__column">
      <h3>Contacto</h3>
      <p class="vipar-site-footer__contact">
        <i class="bi bi-geo-alt" aria-hidden="true"></i>
        <span>{address}</span>
      </p>
      <p class="vipar-site-footer__contact">
        <i class="bi bi-telephone" aria-hidden="true"></i>
        <a href={`tel:${telephone}`}>{telephone}</a>
      </p>
      <p class="vipar-site-footer__contact">
        <i class="bi bi-envelope" aria-hidden="true"></i>
        <a href={`mailto:${email}`}>{email}</a>
      </p>

      <Button
        href={footerWhatsappHref}
        target="_blank"
        rel="noopener noreferrer"
        variant="contained"
        tone="secondary"
        size="md"
        class="vipar-site-footer__cta"
        data-track-event="whatsapp_click"
        data-cta-location="footer"
        data-whatsapp-message-type="footer"
      >
        Solicitar Presupuesto
      </Button>
    </div>
  </Container>

  <Container class="vipar-site-footer__bottom">
    <p>&copy; {currentYear} {LOGO_TEXT}. Todos los derechos reservados.</p>
    <div>
      <a href="/contacto/">Contacto</a>
      <a href="/obras/">Obras</a>
    </div>
  </Container>
</footer>
