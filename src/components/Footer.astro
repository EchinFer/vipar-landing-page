---
import { Image } from "astro:assets";
import logo from "../assets/marca/logo-full.webp";
import { empresa } from "../data/empresa";
---

<footer class="bg-brand px-4 py-10 text-white md:px-8">
	<div class="grid gap-8 md:grid-cols-3">
		<div>
			<Image src={logo} alt="VIPAR S.A. Terminaciones y obras" width={220} height={55} class="h-14 w-auto" />
			<p class="mt-3 max-w-xs text-sm text-sky">Cristales templados y aluminio desde {empresa.desde}, en {empresa.ciudad}.</p>
		</div>
		<div class="text-sm leading-6">
			<p>{empresa.direccion}</p>
			<p>{empresa.ciudad}, {empresa.departamento}</p>
			<p class="mt-2">{empresa.horario}</p>
		</div>
		<div class="text-sm leading-6">
			<p><a href={`tel:${empresa.telefono}`}>{empresa.telefono}</a></p>
			<p><a href={`mailto:${empresa.email}`}>{empresa.email}</a></p>
			<ul class="mt-3 flex flex-wrap gap-x-4">
				<li><a href="/servicios/" class="underline underline-offset-4">Servicios</a></li>
				<li><a href="/obras/" class="underline underline-offset-4">Obras</a></li>
				<li><a href="/blog/" class="underline underline-offset-4">Guías</a></li>
				<li><a href="/nosotros/" class="underline underline-offset-4">La empresa</a></li>
			</ul>
		</div>
	</div>
</footer>
