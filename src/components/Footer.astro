---
import { LOGO_TEXT, MENU_ITEMS, SOCIAL_LINKS, address } from "src/constants";
import EmailLink from "./EmailLink.astro";
import FacebookIcon from "./icons/FacebookIcon.astro";
import InstagramIcon from "./icons/InstagramIcon.astro";
import LastProject from "./LastProject.astro";
import TelephoneLink from "./TelephoneLink.astro";
---

<footer id="footer" class="footer">
  <div class="footer-content position-relative">
    <div class="container">
      <div class="row">
        <div class="col-lg-4 col-md-6">
          <div class="footer-info">
            <h3>{LOGO_TEXT}</h3>
            <div>
              <strong>Dirección:</strong>
              <a
                href="https://maps.app.goo.gl/QGPCNXD9RqXEyDDN8"
                target="_blank"
                class="text-decoration-none"
              >
                {address}
              </a>
              <br />
              <strong>Teléfono:</strong>
              <TelephoneLink /><br />
              <strong>Correo electrónico:</strong>
              <EmailLink /><br />
            </div>
            <div class="social-links d-flex mt-3">
              {SOCIAL_LINKS.facebook && (
                <a
                  href={SOCIAL_LINKS.facebook}
                  target="_blank"
                  rel="noopener"
                  class="d-flex align-items-center justify-content-center"
                  aria-label="Facebook VIPAR"
                >
                  <FacebookIcon />
                </a>
              )}
              {SOCIAL_LINKS.instagram && (
                <a
                  href={SOCIAL_LINKS.instagram}
                  target="_blank"
                  rel="noopener"
                  class="d-flex align-items-center justify-content-center"
                  aria-label="Instagram VIPAR"
                >
                  <InstagramIcon />
                </a>
              )}
            </div>
          </div>
        </div>

        <div class="col-lg-2 col-md-3 footer-links">
          <h4>Menú</h4>
          <ul>
            {
              MENU_ITEMS.map((menuItem) => (
                <li>
                  <a href={menuItem.url}>{menuItem.title}</a>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="col-lg-3 col-md-4 footer-links">
          <h4>Nuestros Servicios</h4>
          <ul>
            <li><a href="/servicios/">Ver todos los servicios</a></li>
            <li><a href="/contacto/">Solicitar presupuesto</a></li>
          </ul>
        </div>
        <div class="col-lg-3 col-md-4 footer-links">
          <h4>Última obra</h4>
          <LastProject />
        </div>
      </div>
    </div>
  </div>

  <div class="footer-legal text-center position-relative">
    <div class="container">
      <div class="copyright">
        &copy; Copyright <strong><span>Moochsoft</span></strong>. All Rights
        Reserved
      </div>
    </div>
  </div>
</footer>
