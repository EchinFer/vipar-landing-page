---
import { email, whatsappNumber } from "src/constants";
import { buildWhatsappMessage, buildWhatsappUrl } from "@lib/whatsapp";

const whatsappHref = buildWhatsappUrl(
  buildWhatsappMessage({
    pageLabel: "formulario de contacto",
    prompt: "Quiero solicitar un presupuesto.",
  })
);
---

<form role="form" class="php-email-form" id="contact-form">
  <div class="row gy-4">
    <div class="col-lg-6 form-group">
      <input
        type="text"
        name="name"
        class="form-control"
        id="name"
        placeholder="Tu nombre"
        required
        autocomplete="name"
      />
    </div>
    <div class="col-lg-6 form-group">
      <input
        type="email"
        class="form-control"
        name="email"
        id="email"
        placeholder="Tu correo"
        required
        autocomplete="email"
      />
    </div>
    <div class="col-lg-6 form-group">
      <input
        type="tel"
        class="form-control"
        name="phone"
        id="phone"
        placeholder="Tu telefono (opcional)"
        autocomplete="tel"
      />
    </div>
    <div class="col-lg-6 form-group">
      <input
        type="text"
        class="form-control"
        name="city"
        id="city"
        placeholder="Ciudad / zona"
      />
    </div>
    <div class="col-12 form-group">
      <textarea
        class="form-control"
        name="message"
        id="message"
        rows="5"
        placeholder="Contanos que necesitas (medidas aproximadas, tipo de ambiente, etc.)"
        required
      ></textarea>
    </div>

    <input type="hidden" name="form_started_at" value="" />

    <div
      style="position:absolute;left:-9999px;opacity:0;pointer-events:none;"
      aria-hidden="true"
    >
      <label>
        Website
        <input type="text" name="website" tabindex="-1" autocomplete="off" />
      </label>
    </div>

    <div class="col-12">
      <div class="p-3 bg-light">
        <label for="captcha_answer" class="form-label mb-2">
          Verificacion rapida: cuanto es <strong
            ><span id="captcha_a">?</span> + <span id="captcha_b">?</span></strong
          >?
        </label>
        <input type="hidden" name="captcha_a" id="captcha_a_input" />
        <input type="hidden" name="captcha_b" id="captcha_b_input" />
        <input
          type="number"
          class="form-control"
          name="captcha_answer"
          id="captcha_answer"
          inputmode="numeric"
          placeholder="Respuesta"
          required
        />
        <small class="text-muted">Esto ayuda a filtrar envios automaticos.</small>
      </div>
    </div>
  </div>

  <div class="my-3" id="form-status" style="display:none;">
    <div class="alert alert-success mb-0" id="form-success" style="display:none;">
      Listo. Recibimos tu consulta. Te contactaremos en horario laboral.
    </div>
    <div class="alert alert-danger mb-0" id="form-error" style="display:none;"></div>
  </div>

  <div class="d-flex flex-column flex-sm-row gap-2">
    <button type="submit" class="btn btn-primary">
      <i class="bi bi-send me-2"></i>Enviar consulta
    </button>
    <a
      class="btn btn-success"
      target="_blank"
      rel="noopener"
      href={whatsappHref}
      data-cta-location="contact_form_alt"
      data-whatsapp-message-type="contact_form"
    >
      <i class="bi bi-whatsapp me-2"></i>WhatsApp
    </a>
    <a
      class="btn btn-outline-secondary"
      href={`mailto:${email}?subject=${encodeURIComponent("Solicitud de presupuesto")}`}
    >
      <i class="bi bi-envelope me-2"></i>Enviar por correo
    </a>
  </div>

  <noscript>
    <p class="mt-3">
      Si no podes usar el formulario, escribinos a <a href={`mailto:${email}`}>{email}</a> o
      por WhatsApp.
    </p>
  </noscript>
</form>

<script is:inline>
  const whatsappNumber = {JSON.stringify(whatsappNumber)};
  const form = document.getElementById("contact-form");
  const status = document.getElementById("form-status");
  const success = document.getElementById("form-success");
  const error = document.getElementById("form-error");

  const aEl = document.getElementById("captcha_a");
  const bEl = document.getElementById("captcha_b");
  const aInput = document.getElementById("captcha_a_input");
  const bInput = document.getElementById("captcha_b_input");
  let hasTrackedFormStart = false;

  function seedCaptcha() {
    const a = Math.floor(Math.random() * 9) + 1;
    const b = Math.floor(Math.random() * 9) + 1;
    if (aEl) aEl.textContent = String(a);
    if (bEl) bEl.textContent = String(b);
    if (aInput) aInput.value = String(a);
    if (bInput) bInput.value = String(b);
  }

  function resetStartedAt(formElement) {
    const startedAtInput = formElement?.querySelector('input[name="form_started_at"]');
    if (startedAtInput instanceof HTMLInputElement) {
      startedAtInput.value = String(Date.now());
    }
  }

  seedCaptcha();
  if (form instanceof HTMLFormElement) resetStartedAt(form);

  form?.addEventListener("input", () => {
    if (hasTrackedFormStart) return;
    hasTrackedFormStart = true;
    if (typeof window !== "undefined" && typeof window.viparTrack === "function") {
      window.viparTrack("form_start", {
        cta_location: "contact_form",
      });
    }
  });

  function showSuccess() {
    status.style.display = "block";
    error.style.display = "none";
    success.style.display = "block";
  }

  function showError(message) {
    status.style.display = "block";
    success.style.display = "none";
    error.style.display = "block";
    error.textContent = message;
  }

  function buildWhatsappUrl(fields) {
    const lines = [
      "Hola, quiero solicitar un presupuesto.",
      `Nombre: ${fields.name}`,
      fields.phone ? `Telefono: ${fields.phone}` : "",
      fields.email ? `Email: ${fields.email}` : "",
      fields.city ? `Ciudad o zona: ${fields.city}` : "",
      "",
      "Detalle:",
      fields.message,
    ].filter(Boolean);

    return `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(lines.join("\n"))}`;
  }

  form?.addEventListener("submit", (event) => {
    event.preventDefault();

    const formElement = event.currentTarget;
    if (!(formElement instanceof HTMLFormElement)) return;

    const formData = new FormData(formElement);
    const name = String(formData.get("name") || "").trim();
    const email = String(formData.get("email") || "").trim();
    const phone = String(formData.get("phone") || "").trim();
    const city = String(formData.get("city") || "").trim();
    const message = String(formData.get("message") || "").trim();
    const website = String(formData.get("website") || "").trim();
    const captchaA = String(formData.get("captcha_a") || "").trim();
    const captchaB = String(formData.get("captcha_b") || "").trim();
    const captchaAnswer = String(formData.get("captcha_answer") || "").trim();

    if (!name || !email || !message) {
      showError("Completa nombre, correo y mensaje.");
      return;
    }

    if (!captchaA || !captchaB || !captchaAnswer) {
      showError("Completa la verificacion rapida.");
      return;
    }

    if (website) {
      showError("No se pudo enviar. Proba de nuevo.");
      return;
    }

    if (Number(captchaA) + Number(captchaB) !== Number(captchaAnswer)) {
      showError("La verificacion rapida no coincide.");
      seedCaptcha();
      return;
    }

    try {
      if (typeof window !== "undefined" && typeof window.viparTrack === "function") {
        window.viparTrack("form_submit", {
          cta_location: "contact_form",
        });
      }

      if (typeof window !== "undefined" && typeof window.viparTrack === "function") {
        window.viparTrack("whatsapp_click", {
          cta_location: "contact_form",
          whatsapp_message_type: "prefilled",
        });
      }

      const whatsappUrl = buildWhatsappUrl({
        name,
        email,
        phone,
        city,
        message,
      });

      if (typeof window !== "undefined") {
        window.open(whatsappUrl, "_blank", "noopener,noreferrer");
      }

      success.textContent = "Abrimos WhatsApp con tu mensaje listo para enviar.";
      showSuccess();
      formElement.reset();
      seedCaptcha();
      resetStartedAt(formElement);
    } catch (submissionError) {
      showError("No se pudo abrir WhatsApp. Proba de nuevo.");
    }
  });
</script>
