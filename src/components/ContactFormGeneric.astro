---
import Button from "@components/ui/Button.astro";
import Card from "@components/ui/Card.astro";
import Heading from "@components/ui/Heading.astro";
import Text from "@components/ui/Text.astro";
import Input from "@components/ui/Input.astro";

export interface Props {
  formId: string;
  source: string;
  variant?: "home" | "contact";
  title?: string;
  intro?: string;
  cardClass?: string;
  formClass?: string;
  showServiceSelect?: boolean;
  showAsuntoSelect?: boolean;
  showFileUpload?: boolean;
  whatsappNumber?: string;
}

const {
  formId,
  source,
  variant = "contact",
  title = "¿Cómo podemos ayudarte?",
  intro = "Elegí una opción y dejá tu correo para que te contactemos.",
  cardClass = "",
  formClass = "",
  showServiceSelect = true,
  showAsuntoSelect = true,
  whatsappNumber = "+595981256510",
} = Astro.props;

const serviceOptions = [
  { label: "Mamparas divisorias", value: "Mamparas divisorias" },
  { label: "Ventanas", value: "Ventanas" },
  { label: "Box de Baño", value: "Box de Baño" },
  { label: "Cielo raso", value: "Cielo raso" },
  { label: "Carpintería de Aluminio", value: "Carpintería de Aluminio" },
  { label: "Cristales Templados", value: "Cristales Templados" },
  { label: "Otro", value: "Otro" },
];

const consultationTypes = [
  { label: "Presupuesto", value: "Presupuesto" },
  { label: "Consulta Técnica", value: "Consulta Técnica" },
  { label: "Otro", value: "Otro" },
];

const visibleSections = [
  showServiceSelect ? "service_selection" : null,
  showAsuntoSelect ? "consultation_selection" : null,
  "email_capture",
].filter(Boolean) as string[];
---

<Card as="article" class:list={["smart-form-panel", cardClass]}>
  <div class="smart-form-container">
    <div class="smart-form-header">
      {title && <Heading level={2} variant="md">{title}</Heading>}
      {intro && <Text class="form-intro">{intro}</Text>}
    </div>

    <form class:list={["contact-form", "contact-form--smart", formClass]} id={formId} novalidate>
      {showServiceSelect && (
        <section class="smart-form-step smart-form-step--visible" data-step-name="service_selection">
          <div class="step-header">
            <span class="step-number">1</span>
            <Heading level={3} variant="sm">¿Qué servicio te interesa?</Heading>
          </div>
          <div class="options-grid">
            {serviceOptions.map((option) => (
              <button
                type="button"
                class="option-btn"
                data-group="service"
                data-option={option.value}
                aria-label={`Seleccionar ${option.label}`}
              >
                <span class="option-btn__copy">
                  <span class="option-btn__label">{option.label}</span>
                  <span class="option-btn__hint">Seleccionar servicio</span>
                </span>
                <span class="option-btn__icon" aria-hidden="true">→</span>
              </button>
            ))}
          </div>
        </section>
      )}

      {showAsuntoSelect && (
        <section class="smart-form-step smart-form-step--visible" data-step-name="consultation_selection">
          <div class="step-header">
            <span class="step-number">{showServiceSelect ? 2 : 1}</span>
            <Heading level={3} variant="sm">¿Qué necesitas?</Heading>
          </div>
          <div class="options-grid vertical">
            {consultationTypes.map((option) => (
              <button
                type="button"
                class="option-btn"
                data-group="consultation"
                data-option={option.value}
                aria-label={`Seleccionar ${option.label}`}
              >
                <span class="option-btn__copy">
                  <span class="option-btn__label">{option.label}</span>
                  <span class="option-btn__hint">Seleccionar tipo de consulta</span>
                </span>
                <span class="option-btn__icon" aria-hidden="true">→</span>
              </button>
            ))}
          </div>
        </section>
      )}

      <section class="smart-form-step smart-form-step--visible" data-step-name="email_capture">
        <div class="step-header">
          <span class="step-number">
            {showServiceSelect && showAsuntoSelect ? 3 : showServiceSelect || showAsuntoSelect ? 2 : 1}
          </span>
          <Heading level={3} variant="sm">Tu correo</Heading>
        </div>
        <div class="form-group">
          <label for={`${formId}-email`}>Email *</label>
          <Input
            id={`${formId}-email`}
            name="email"
            type="email"
            autocomplete="email"
            placeholder="tu@email.com"
            required
          />
          <Text class="smart-form-helper">
            Te respondemos con una orientación inicial y abrimos WhatsApp con el contexto cargado.
          </Text>
        </div>
      </section>

      <input type="hidden" name="service" />
      <input type="hidden" name="consultation_type" />
      <input type="hidden" name="source" value={source} />
      <input type="hidden" name="form_started_at" value="" />
      <div
        style="position:absolute;left:-9999px;opacity:0;pointer-events:none;"
        aria-hidden="true"
      >
        <label>
          Website
          <input type="text" name="website" tabindex="-1" autocomplete="off" />
        </label>
      </div>

      <div class="smart-form-summary">
        <Text as="span" variant="label-sm" tone="muted">Resumen de tu consulta</Text>
        <div class="smart-form-summary__chips">
          {showServiceSelect && <span class="summary-chip" data-summary-chip="service">Servicio pendiente</span>}
          {showAsuntoSelect && (
            <span class="summary-chip" data-summary-chip="consultation">
              Tipo de consulta pendiente
            </span>
          )}
          <span class="summary-chip summary-chip--accent">Respuesta por WhatsApp</span>
        </div>
      </div>

      <div class="form-actions form-actions--sticky-mobile">
        <Button
          type="submit"
          variant="contained"
          tone="primary"
          size="md"
          fullWidth
          class="btn-submit"
        >
          Continuar por WhatsApp
        </Button>
      </div>
    </form>

    <div class="form-status" hidden id={`${formId}-status`}>
      <p id={`${formId}-message`}></p>
    </div>
  </div>
</Card>

<script define:vars={{ formId, source, variant, whatsappNumber, showServiceSelect, showAsuntoSelect, visibleSections }}>
  const form = document.getElementById(formId);
  const statusEl = document.getElementById(`${formId}-status`);
  const messageEl = document.getElementById(`${formId}-message`);
  let hasTrackedFormStart = false;
  let formData = {
    service: "",
    consultation_type: "",
    email: "",
  };

  function getCtaLocation() {
    return formId === "vipar-home-form" ? "home_contact_form" : "contact_form";
  }

  function setStatus(type, text) {
    if (!statusEl || !messageEl) return;
    statusEl.hidden = false;
    statusEl.dataset.state = type;
    messageEl.textContent = text;
  }

  function clearStatus() {
    if (statusEl) statusEl.hidden = true;
  }

  function markOptionSelection(group, value) {
    document
      .querySelectorAll(`.option-btn[data-group="${group}"]`)
      .forEach((button) => {
        const isSelected = button.dataset.option === value;
        button.classList.toggle("is-selected", isSelected);
        button.setAttribute("aria-pressed", isSelected ? "true" : "false");
      });
  }

  function updateSummaryChip(key, value, fallback) {
    const chip = document.querySelector(`[data-summary-chip="${key}"]`);
    if (!chip) return;
    chip.textContent = value || fallback;
    chip.classList.toggle("is-filled", Boolean(value));
  }

  function identifyLead(emailValue) {
    if (!emailValue) return;
    if (
      typeof window !== "undefined" &&
      typeof window.posthog === "object" &&
      typeof window.posthog.identify === "function"
    ) {
      window.posthog.identify(emailValue, {
        email: emailValue,
        source,
        form_id: formId,
        variant,
        service_interest: formData.service || undefined,
        consultation_type: formData.consultation_type || undefined,
      });
    }
  }

  function buildTrackingPayload(props = {}) {
    return {
      ...props,
      cta_location: getCtaLocation(),
      form_id: formId,
      source,
      variant,
      service_name: formData.service || undefined,
      consultation_type: formData.consultation_type || undefined,
    };
  }

  function buildWhatsappUrl() {
    const lines = [
      "Hola, quiero hacer una consulta.",
      formData.service ? `Servicio: ${formData.service}` : "",
      formData.consultation_type ? `Tipo de consulta: ${formData.consultation_type}` : "",
      `Email: ${formData.email}`,
    ].filter(Boolean);

    const rawHref = `https://wa.me/${String(whatsappNumber || "").replace(/\D/g, "")}?text=${encodeURIComponent(lines.join("\n"))}`;

    if (typeof window !== "undefined" && typeof window.viparBuildWhatsappUrl === "function") {
      return window.viparBuildWhatsappUrl(rawHref, {
        cta_location: getCtaLocation(),
        form_id: formId,
        email: formData.email,
        service_name: formData.service || undefined,
        consultation_type: formData.consultation_type || undefined,
      });
    }

    return rawHref;
  }

  function trackEvent(name, props = {}) {
    if (typeof window !== "undefined" && typeof window.viparTrack === "function") {
      window.viparTrack(name, buildTrackingPayload(props));
    }
  }

  function ensureFormStart(extra = {}) {
    if (hasTrackedFormStart) return;
    hasTrackedFormStart = true;
    trackEvent("form_start", extra);
  }

  document.querySelectorAll('.option-btn[data-group="service"]').forEach((btn) => {
    btn.addEventListener("click", () => {
      ensureFormStart({ entry_step: "service_selection" });
      formData.service = btn.dataset.option || "";
      const hiddenService = form?.querySelector('input[name="service"]');
      if (hiddenService) hiddenService.value = formData.service;
      markOptionSelection("service", formData.service);
      updateSummaryChip("service", formData.service, "Servicio pendiente");
      trackEvent("form_service_selected", {
        selected_step: "service_selection",
      });
    });
  });

  document.querySelectorAll('.option-btn[data-group="consultation"]').forEach((btn) => {
    btn.addEventListener("click", () => {
      ensureFormStart({ entry_step: "consultation_selection" });
      formData.consultation_type = btn.dataset.option || "";
      const hiddenConsultation = form?.querySelector('input[name="consultation_type"]');
      if (hiddenConsultation) hiddenConsultation.value = formData.consultation_type;
      markOptionSelection("consultation", formData.consultation_type);
      updateSummaryChip(
        "consultation",
        formData.consultation_type,
        "Tipo de consulta pendiente"
      );
      trackEvent("form_consultation_selected", {
        selected_step: "consultation_selection",
      });
    });
  });

  if (form) {
    form.addEventListener("input", () => {
      ensureFormStart({ entry_step: "email_input" });
      const emailInput = form.querySelector('input[name="email"]');
      if (emailInput) formData.email = emailInput.value;
    });

    form.addEventListener("submit", (event) => {
      event.preventDefault();
      clearStatus();

      const emailInput = form.querySelector('input[name="email"]');
      formData.email = String(emailInput?.value || "").trim();

      if (showServiceSelect && !formData.service) {
        trackEvent("form_error", {
          field_name: "service",
          error_type: "missing_required_selection",
          step_name: "service_selection",
        });
        setStatus("error", "Elegí primero el servicio que te interesa.");
        return;
      }

      if (showAsuntoSelect && !formData.consultation_type) {
        trackEvent("form_error", {
          field_name: "consultation_type",
          error_type: "missing_required_selection",
          step_name: "consultation_selection",
        });
        setStatus("error", "Seleccioná qué tipo de consulta necesitás.");
        return;
      }

      if (typeof form.reportValidity === "function" && !form.reportValidity()) {
        trackEvent("form_error", {
          field_name: "email",
          error_type: "invalid_or_missing_email",
          step_name: "email_capture",
        });
        return;
      }

      if (!formData.email) {
        trackEvent("form_error", {
          field_name: "email",
          error_type: "missing_required_value",
          step_name: "email_capture",
        });
        setStatus("error", "Completá tu correo.");
        return;
      }

      identifyLead(formData.email);

      trackEvent("lead_email_captured", {
        email: formData.email,
        email_domain: formData.email.includes("@") ? formData.email.split("@")[1] : "",
      });

      trackEvent("form_submit", {
        email_only: true,
        email: formData.email,
        email_domain: formData.email.includes("@") ? formData.email.split("@")[1] : "",
      });

      trackEvent("whatsapp_click", {
        interaction_source: "smart_form",
        email: formData.email,
        whatsapp_message_type: "smart_form_prefilled",
      });

      if (typeof window !== "undefined") {
        window.open(buildWhatsappUrl(), "_blank", "noopener,noreferrer");
      }

      setStatus("success", "Abrimos WhatsApp y registramos tu correo en GA y PostHog.");
      form.reset();
      formData.service = "";
      formData.consultation_type = "";
      formData.email = "";
      markOptionSelection("service", "");
      markOptionSelection("consultation", "");
      updateSummaryChip("service", "", "Servicio pendiente");
      updateSummaryChip("consultation", "", "Tipo de consulta pendiente");
    });
  }

  if (form) {
    const startedAtInput = form.querySelector('input[name="form_started_at"]');
    if (startedAtInput && !startedAtInput.value) {
      startedAtInput.value = String(Date.now());
    }
  }

  updateSummaryChip("service", "", "Servicio pendiente");
  updateSummaryChip("consultation", "", "Tipo de consulta pendiente");

  trackEvent("form_view", { visible_sections: visibleSections.join(",") });
  visibleSections.forEach(function (stepName) {
    trackEvent("form_step_viewed", { step_name: stepName });
  });
</script>

<style>
  .smart-form-container {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .smart-form-header {
    text-align: center;
  }

  .form-intro {
    color: var(--color-text-secondary);
    font-size: 0.95rem;
  }

  .contact-form--smart {
    display: grid;
    gap: 1.5rem;
  }

  .smart-form-step {
    padding: 1.25rem;
    border: 1px solid rgba(0, 21, 36, 0.08);
    border-radius: 1.25rem;
    background: rgba(255, 255, 255, 0.86);
    box-shadow: 0 10px 24px rgba(5, 30, 40, 0.05);
  }

  .smart-form-step--visible {
    animation: none;
  }

  .step-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .step-number {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    background: var(--color-primary);
    color: white;
    font-weight: 600;
    font-size: 1.1rem;
  }

  .options-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 0.9rem;
  }

  .options-grid.vertical {
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
  }

  .option-btn {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    min-height: 84px;
    padding: 1rem 1rem 1rem 1.2rem;
    border: 1px solid rgba(0, 21, 36, 0.14);
    border-radius: 1rem;
    background: rgba(255, 255, 255, 0.96);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.4);
    cursor: pointer;
    font: inherit;
    text-align: left;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
    touch-action: manipulation;
  }

  .option-btn::before {
    content: "";
    position: absolute;
    left: 0;
    top: 12px;
    bottom: 12px;
    width: 4px;
    border-radius: 999px;
    background: rgba(0, 101, 139, 0.16);
  }

  .option-btn__copy {
    display: flex;
    flex-direction: column;
    gap: 0.32rem;
    min-width: 0;
  }

  .option-btn__label {
    color: var(--color-text-primary);
    font-size: 1rem;
    font-weight: 800;
    line-height: 1.25;
  }

  .option-btn__hint {
    color: var(--color-text-secondary);
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }

  .option-btn__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: 2.65rem;
    height: 2.65rem;
    border-radius: 0.8rem;
    border: 1px solid rgba(0, 101, 139, 0.14);
    background: rgba(0, 101, 139, 0.06);
    color: var(--color-primary);
    font-size: 1rem;
    font-weight: 700;
  }

  .option-btn:focus-visible::before {
    background: var(--color-primary);
  }

  .option-btn:focus-visible .option-btn__icon {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: white;
  }

  .option-btn:focus-visible {
    outline: none;
    border-color: var(--color-primary);
    box-shadow:
      0 0 0 4px rgba(0, 101, 139, 0.14),
      0 12px 28px rgba(5, 30, 40, 0.08);
  }

  .option-btn.is-selected {
    border-color: rgba(0, 101, 139, 0.6);
    background: rgba(230, 246, 255, 0.95);
    box-shadow:
      0 0 0 3px rgba(0, 101, 139, 0.12),
      0 12px 28px rgba(5, 30, 40, 0.08);
  }

  .option-btn.is-selected::before {
    background: var(--color-primary);
  }

  .option-btn.is-selected .option-btn__icon {
    background: var(--color-primary);
    border-color: var(--color-primary);
    color: white;
  }

  .contact-form,
  .details-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .form-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .form-group label {
    font-weight: 500;
    color: var(--color-text-primary);
    font-size: 0.95rem;
  }

  .smart-form-helper {
    display: block;
    margin-top: 0.5rem;
    color: var(--color-text-secondary);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .form-group input,
  .form-group textarea {
    padding: 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: 0.375rem;
    font-size: 1rem;
    font-family: inherit;
  }

  .form-group textarea {
    resize: vertical;
    min-height: 80px;
  }

  .form-group input:focus,
  .form-group textarea:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px var(--color-primary-light);
  }

  .smart-form-summary {
    display: grid;
    gap: 0.75rem;
    padding: 1rem 1.1rem;
    border: 1px dashed rgba(0, 21, 36, 0.18);
    border-radius: 1rem;
    background: rgba(243, 250, 255, 0.92);
  }

  .smart-form-summary__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .summary-chip {
    display: inline-flex;
    align-items: center;
    min-height: 36px;
    padding: 0.35rem 0.85rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.88);
    border: 1px solid rgba(0, 21, 36, 0.12);
    color: var(--color-text-secondary);
    font-size: 0.85rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .summary-chip.is-filled,
  .summary-chip--accent {
    color: var(--color-primary);
    border-color: rgba(0, 101, 139, 0.25);
    background: rgba(223, 244, 255, 0.92);
  }

  .form-actions {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
  }

  .form-actions--sticky-mobile {
    position: sticky;
    bottom: 0;
    z-index: 2;
    padding-top: 0.25rem;
    background: linear-gradient(180deg, rgba(243, 250, 255, 0) 0%, rgba(243, 250, 255, 0.96) 22%, rgba(243, 250, 255, 1) 100%);
  }

  .form-status {
    padding: 1rem;
    border-radius: 0.5rem;
    font-weight: 500;
    text-align: center;
  }

  .form-status[data-state="success"] {
    background-color: #d4edda;
    color: #155724;
    border: 1px solid #c3e6cb;
  }

  .form-status[data-state="error"] {
    background-color: #f8d7da;
    color: #721c24;
    border: 1px solid #f5c6cb;
  }

  @media (max-width: 720px) {
    .options-grid,
    .options-grid.vertical {
      grid-template-columns: 1fr;
      gap: 0.75rem;
    }

    .smart-form-step {
      padding: 1rem;
      border-radius: 1rem;
    }

    .step-header {
      align-items: flex-start;
      margin-bottom: 0.85rem;
    }

    .option-btn {
      min-height: 80px;
      padding: 0.95rem 1rem;
      border-radius: 0.9rem;
    }

    .option-btn__label {
      font-size: 0.98rem;
    }

    .option-btn__hint {
      font-size: 0.78rem;
    }

    .option-btn__icon {
      width: 2.25rem;
      height: 2.25rem;
    }

    .smart-form-summary {
      padding: 0.9rem 1rem;
    }

    .form-actions--sticky-mobile {
      margin: 0 -0.25rem;
      padding: 0.5rem 0.25rem 0;
    }
  }
</style>
