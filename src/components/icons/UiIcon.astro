---
interface Props {
  name: string;
  class?: string;
  title?: string;
}

const { name, class: className = "", title } = Astro.props;
const normalizedName = name.replace(/^bi-/, "");
const iconAliases: Record<string, string> = {
  apartment: "building",
  chat: "whatsapp",
  grid_view: "grid-1x2",
  roofing: "layers",
  shower: "droplet-half",
};
const iconName = iconAliases[normalizedName] ?? normalizedName;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width="1em"
  height="1em"
  fill="none"
  stroke="currentColor"
  stroke-width="1.9"
  stroke-linecap="round"
  stroke-linejoin="round"
  class:list={["bi", `bi-${iconName}`, className]}
  aria-hidden={title ? undefined : "true"}
  role={title ? "img" : undefined}
  focusable="false"
>
  {title && <title>{title}</title>}
  {iconName === "arrow-right" && (
    <>
      <path d="M5 12h14"></path>
      <path d="m12 5 7 7-7 7"></path>
    </>
  )}
  {iconName === "check-circle-fill" && (
    <>
      <circle cx="12" cy="12" r="9"></circle>
      <path d="m9.5 12 1.8 1.8 3.8-4"></path>
    </>
  )}
  {iconName === "grid-3x3-gap" && (
    <>
      <rect x="4" y="4" width="4" height="4"></rect>
      <rect x="10" y="4" width="4" height="4"></rect>
      <rect x="16" y="4" width="4" height="4"></rect>
      <rect x="4" y="10" width="4" height="4"></rect>
      <rect x="10" y="10" width="4" height="4"></rect>
      <rect x="16" y="10" width="4" height="4"></rect>
      <rect x="4" y="16" width="4" height="4"></rect>
      <rect x="10" y="16" width="4" height="4"></rect>
      <rect x="16" y="16" width="4" height="4"></rect>
    </>
  )}
  {iconName === "columns-gap" && (
    <>
      <rect x="4" y="5" width="6" height="14"></rect>
      <rect x="14" y="5" width="6" height="14"></rect>
      <path d="M12 5v14"></path>
    </>
  )}
  {iconName === "door-closed" && (
    <>
      <path d="M6 21V4.8a1 1 0 0 1 .7-1L16 1v20"></path>
      <path d="M16 21H6"></path>
      <path d="M13 11h.01"></path>
    </>
  )}
  {iconName === "building" && (
    <>
      <path d="M4 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v16"></path>
      <path d="M2 21h20"></path>
      <path d="M9 7h1"></path>
      <path d="M13 7h1"></path>
      <path d="M9 11h1"></path>
      <path d="M13 11h1"></path>
      <path d="M9 15h1"></path>
      <path d="M13 15h1"></path>
    </>
  )}
  {iconName === "grid-1x2" && (
    <>
      <rect x="4" y="4" width="16" height="6"></rect>
      <rect x="4" y="14" width="16" height="6"></rect>
    </>
  )}
  {iconName === "droplet-half" && (
    <>
      <path d="M12 3s6 5.4 6 10a6 6 0 1 1-12 0c0-4.6 6-10 6-10Z"></path>
      <path d="M12 3v16"></path>
    </>
  )}
  {iconName === "map" && (
    <>
      <path d="m3 6 6-3 6 3 6-3v15l-6 3-6-3-6 3Z"></path>
      <path d="M9 3v15"></path>
      <path d="M15 6v15"></path>
    </>
  )}
  {iconName === "building-check" && (
    <>
      <path d="M4 21V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v5"></path>
      <path d="M2 21h10"></path>
      <path d="M9 7h1"></path>
      <path d="M13 7h1"></path>
      <path d="M9 11h1"></path>
      <path d="M13 11h1"></path>
      <path d="m14 18 2 2 4-4"></path>
    </>
  )}
  {iconName === "clock" && (
    <>
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M12 7v5l3 3"></path>
    </>
  )}
  {iconName === "upload" && (
    <>
      <path d="M12 16V4"></path>
      <path d="m7 9 5-5 5 5"></path>
      <path d="M20 16v3a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-3"></path>
    </>
  )}
  {iconName === "whatsapp" && (
    <>
      <path d="M7.5 19 5 20l1-3.8A8.5 8.5 0 1 1 20 12a8.5 8.5 0 0 1-12.5 7Z"></path>
      <path d="M9.6 8.8c.2-.5.4-.6.7-.6h.6c.2 0 .5 0 .6.4l.7 1.8c.1.2 0 .5-.1.7l-.5.7c.7 1.2 1.7 2.1 2.9 2.8l.7-.5c.2-.1.5-.2.7-.1l1.7.7c.4.1.5.4.5.6v.6c0 .3-.2.6-.6.7-.6.2-1.3.3-1.9.2A8.1 8.1 0 0 1 8.2 10c-.1-.6 0-1.3.2-1.9Z"></path>
    </>
  )}
  {iconName === "exclamation-triangle" && (
    <>
      <path d="m12 4 8 14H4L12 4Z"></path>
      <path d="M12 9v4"></path>
      <path d="M12 16h.01"></path>
    </>
  )}
  {iconName === "geo-alt" && (
    <>
      <path d="M12 20s6-5.4 6-10a6 6 0 1 0-12 0c0 4.6 6 10 6 10Z"></path>
      <circle cx="12" cy="10" r="2.5"></circle>
    </>
  )}
  {iconName === "arrows-fullscreen" && (
    <>
      <path d="M8 4H4v4"></path>
      <path d="M4 4 9 9"></path>
      <path d="M16 4h4v4"></path>
      <path d="m20 4-5 5"></path>
      <path d="M8 20H4v-4"></path>
      <path d="m4 20 5-5"></path>
      <path d="M16 20h4v-4"></path>
      <path d="m20 20-5-5"></path>
    </>
  )}
  {iconName === "shield-check" && (
    <>
      <path d="M12 3 6 5.5v5.6c0 3.9 2.4 6.7 6 8.9 3.6-2.2 6-5 6-8.9V5.5L12 3Z"></path>
      <path d="m9.6 11.8 1.7 1.7 3.4-3.7"></path>
    </>
  )}
  {iconName === "eye" && (
    <>
      <path d="M2.5 12s3.5-5.5 9.5-5.5S21.5 12 21.5 12 18 17.5 12 17.5 2.5 12 2.5 12Z"></path>
      <circle cx="12" cy="12" r="2.7"></circle>
    </>
  )}
  {iconName === "shop" && (
    <>
      <path d="M4 9h16"></path>
      <path d="M5 9V6.5A1.5 1.5 0 0 1 6.5 5h11A1.5 1.5 0 0 1 19 6.5V9"></path>
      <path d="M6 9v10"></path>
      <path d="M18 9v10"></path>
      <path d="M4 19h16"></path>
      <path d="M10 19v-5h4v5"></path>
    </>
  )}
  {iconName === "window" && (
    <>
      <rect x="4" y="5" width="16" height="14"></rect>
      <path d="M12 5v14"></path>
      <path d="M4 12h16"></path>
    </>
  )}
  {iconName === "tools" && (
    <>
      <path d="m4 20 6.5-6.5"></path>
      <path d="m14 6 4 4"></path>
      <path d="m13 7 4-4 2 2-4 4"></path>
      <path d="M9 11 4 6l2-2 5 5"></path>
      <path d="m8 12 4 4"></path>
    </>
  )}
  {iconName === "door-open" && (
    <>
      <path d="M6 21V4.8a1 1 0 0 1 .7-1L16 1v20"></path>
      <path d="M16 21H6"></path>
      <path d="M13 11h.01"></path>
      <path d="M18 7h2v10h-2"></path>
    </>
  )}
  {iconName === "wind" && (
    <>
      <path d="M3 9h10a2 2 0 1 0-2-2"></path>
      <path d="M3 13h14a2 2 0 1 1-2 2"></path>
      <path d="M3 17h9a2 2 0 1 0-2 2"></path>
    </>
  )}
  {iconName === "square" && <rect x="5" y="5" width="14" height="14"></rect>}
  {iconName === "chevron-down" && <path d="m6 9 6 6 6-6"></path>}
  {iconName === "check-circle" && (
    <>
      <circle cx="12" cy="12" r="9"></circle>
      <path d="m8.8 12.1 2.1 2.1 4.3-4.5"></path>
    </>
  )}
  {iconName === "layers" && (
    <>
      <path d="m12 4 8 4-8 4-8-4 8-4Z"></path>
      <path d="m4 12 8 4 8-4"></path>
      <path d="m4 16 8 4 8-4"></path>
    </>
  )}
  {iconName === "aspect-ratio" && (
    <>
      <rect x="4" y="7" width="16" height="10" rx="1.5"></rect>
      <path d="M8 10H6v2"></path>
      <path d="M16 14h2v-2"></path>
    </>
  )}
  {iconName === "view-list" && (
    <>
      <path d="M8 7h12"></path>
      <path d="M8 12h12"></path>
      <path d="M8 17h12"></path>
      <path d="M4 7h.01"></path>
      <path d="M4 12h.01"></path>
      <path d="M4 17h.01"></path>
    </>
  )}
  {iconName === "house" && (
    <>
      <path d="m4 11 8-6 8 6"></path>
      <path d="M6 10.5V20h12v-9.5"></path>
      <path d="M10 20v-5h4v5"></path>
    </>
  )}
</svg>
