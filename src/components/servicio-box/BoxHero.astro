---
import Button from "@components/ui/Button.astro";
import Container from "@components/ui/Container.astro";
import Heading from "@components/ui/Heading.astro";
import Text from "@components/ui/Text.astro";

interface Props {
  image: string;
  tags: string[];
  whatsappHref: string;
}

const { image, tags, whatsappHref } = Astro.props;
---

<section class="box-service-hero">
  <Container class="box-service-hero__inner">
    <div class="box-service-hero__copy">
      <Text as="div" variant="label-sm" tone="accent" class="box-service-hero__eyebrow">
        Box de baño en Paraguay
      </Text>
      <Heading level={1} variant="display">
        Box de baño y mamparas de ducha a medida
      </Heading>
      <Text variant="body-lg">
        Cotizá tu box de baño en acrílico, cristal templado o sistema plegable según medidas,
        tipo de apertura, mantenimiento esperado y presupuesto disponible.
      </Text>
      <div class="box-service-hero__actions">
        <Button
          href={whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          variant="contained"
          tone="primary"
          size="lg"
          data-track-event="whatsapp_click"
          data-cta-location="service_cta"
          data-service-name="Box de baño"
          data-whatsapp-message-type="service_hero"
        >
          Cotizar por WhatsApp
        </Button>
        <Button href="#opciones" variant="outlined" tone="primary" size="lg">
          Ver opciones
        </Button>
      </div>
      <div class="box-service-hero__tags" aria-label="Materiales y soluciones disponibles">
        {tags.map((tag) => (
          <span>{tag}</span>
        ))}
      </div>
    </div>

    <figure class="box-service-hero__media" style="margin:0">
      <img
        src={image}
        alt="Box de ducha residencial en vidrio templado de 8 mm con perfiles de aluminio — obra VIPAR"
        width={550}
        height={825}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
      <figcaption class="service-hero-caption">Obra VIPAR · Box de baño en vidrio templado · Vivienda en Paraguay</figcaption>
    </figure>
  </Container>
</section>
