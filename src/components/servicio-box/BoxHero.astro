---
import { Image } from "astro:assets";
import Button from "@components/ui/Button.astro";
import Container from "@components/ui/Container.astro";
import Heading from "@components/ui/Heading.astro";
import Text from "@components/ui/Text.astro";

interface Props {
  image: string;
  tags: string[];
  whatsappHref: string;
}

const { image, tags, whatsappHref } = Astro.props;
---

<section class="box-service-hero">
  <Container class="box-service-hero__inner">
    <div class="box-service-hero__copy">
      <Text as="div" variant="label-sm" tone="accent" class="box-service-hero__eyebrow">
        Box de baño en Paraguay
      </Text>
      <Heading level={1} variant="display">
        Box de baño a medida para duchas más cómodas, limpias y mejor terminadas
      </Heading>
      <Text variant="body-lg">
        Soluciones precisas en acrílico, cristal templado y sistemas safonados para optimizar el
        espacio y mantener la higiene de tu baño.
      </Text>
      <div class="box-service-hero__actions">
        <Button
          href={whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          variant="contained"
          tone="primary"
          size="lg"
          data-track-event="whatsapp_service_click"
          data-cta-location="box_bano_hero"
          data-service-name="Box de baño"
          data-whatsapp-message-type="service_hero"
        >
          Cotizar por WhatsApp
        </Button>
        <Button href="#opciones" variant="outlined" tone="primary" size="lg">
          Ver opciones
        </Button>
      </div>
      <div class="box-service-hero__tags" aria-label="Materiales y soluciones disponibles">
        {tags.map((tag) => (
          <span>{tag}</span>
        ))}
      </div>
    </div>

    <div class="box-service-hero__media">
      <Image
        src={image}
        alt="Box de bano en cristal templado instalado"
        inferSize={true}
        widths={[768, 1024, 1280, 1600]}
        sizes="(max-width: 1100px) 100vw, 58vw"
        loading="eager"
        fetchpriority="high"
        decoding="async"
        format="webp"
        quality={72}
      />
    </div>
  </Container>
</section>
