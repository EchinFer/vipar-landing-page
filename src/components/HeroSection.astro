---
import { Image } from "astro:assets";
import { telephone } from "src/constants";

const whatsappNumber = telephone.replace(/[^\d]/g, "");
const whatsappMessage = "Hola, quiero solicitar un presupuesto. Me comunico desde la web.";
---

<section id="hero" class="hero" aria-label="Introducción al sitio">
  <div id="contenedor-divisiones">
    <div id="division-1" class="division hero-wrapper position-relative">
      <Image
        src="/img/home/hero-home.webp"
        alt="Cristal templado decorativo"
        class="hero-bg-img"
        width="1920"
        height="800"
        loading="eager"
        fetchpriority="high"
      />
      <div class="overlay"></div>
      <div class="container">
        <div class="row justify-content-center">
          <div
            class="col-lg-11 text-center text-white d-flex flex-column align-items-center gap-2"
          >
            <h1 class="vipar-display-lg">
              Perfeccionamos tus espacios con cristales templados de alta
              calidad
            </h1>
            <p class="vipar-body-lg">
              Más de dos generaciones brindando soluciones en vidrio templado
              para desarrollos inmobiliarios, viviendas y la industria de la
              construcción en Paraguay.
            </p>
            <ul class="list-unstyled d-flex flex-column flex-md-row gap-2 gap-md-4 mb-3" style="max-width: 920px;">
              <li class="d-flex align-items-center gap-2">
                <i class="bi bi-shield-check"></i>
                <span>Instalación profesional</span>
              </li>
              <li class="d-flex align-items-center gap-2">
                <i class="bi bi-award"></i>
                <span>Dos generaciones de experiencia</span>
              </li>
              <li class="d-flex align-items-center gap-2">
                <i class="bi bi-chat-dots"></i>
                <span>Asesoría y presupuesto claro</span>
              </li>
            </ul>
            <div>
              <a
                href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`}
                target="_blank"
                rel="noopener"
                class="vipar-btn-primary me-2"
                aria-label="Solicitar presupuesto por WhatsApp"
                data-track-event="whatsapp_click"
                data-cta-location="hero_cta"
                data-whatsapp-message-type="hero_prefilled"
                >Solicitar presupuesto</a
              >
              <a
                href="#nuestras-obras"
                class="btn btn-outline-light"
                aria-label="Ver nuestras obras de cristales templados"
                data-track-event="hero_portfolio_click"
                data-cta-location="hero_cta"
                >Ver obras</a
              >
              <div class="mt-3 small opacity-75">
                Respondemos en horario laboral. Cobertura en Paraguay.
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
