---
// GA4 diferido + aviso de cookies con Consent Mode. Un solo lugar para toda la medición.
---

<div
	id="aviso-cookies"
	hidden
	role="dialog"
	aria-label="Aviso de cookies"
	class="fixed inset-x-0 bottom-14 z-40 border-t border-aluminum bg-white p-3 text-sm shadow-lg md:inset-x-auto md:bottom-4 md:left-4 md:max-w-md md:border"
>
	<p>Usamos cookies para medir las visitas al sitio.</p>
	<div class="mt-2 flex gap-2">
		<button type="button" data-cookies="granted" class="bg-brand px-4 py-2 text-white">Aceptar</button>
		<button type="button" data-cookies="denied" class="border border-aluminum px-4 py-2">Rechazar</button>
	</div>
</div>

<script>
	const ID = "G-TZ2CL571FZ";
	const CLAVE = "vipar-cookies";

	declare global {
		interface Window {
			dataLayer: unknown[];
			gtag: (...args: unknown[]) => void;
		}
	}

	window.dataLayer = window.dataLayer || [];
	window.gtag = function gtag() {
		// gtag.js espera el objeto `arguments`, no un array.
		// eslint-disable-next-line prefer-rest-params
		window.dataLayer.push(arguments);
	};

	const local = ["localhost", "127.0.0.1"].includes(location.hostname);
	const forzar = new URLSearchParams(location.search).has("medir");

	let guardado: string | null = null;
	try {
		guardado = localStorage.getItem(CLAVE);
	} catch {
		guardado = null;
	}

	window.gtag("consent", "default", {
		ad_storage: "denied",
		ad_user_data: "denied",
		ad_personalization: "denied",
		analytics_storage: guardado === "granted" ? "granted" : "denied",
	});
	window.gtag("js", new Date());
	// En local solo se prueba el peso de gtag.js: sin hits a la propiedad real.
	window.gtag("config", ID, local ? { send_page_view: false } : {});

	if (!local || forzar) {
		window.addEventListener("load", () => {
			setTimeout(() => {
				const script = document.createElement("script");
				script.async = true;
				script.src = `https://www.googletagmanager.com/gtag/js?id=${ID}`;
				document.head.appendChild(script);
			}, 800);
		});
	}

	const aviso = document.getElementById("aviso-cookies");
	if (aviso && guardado === null) aviso.hidden = false;

	aviso?.addEventListener("click", (evento) => {
		const boton = (evento.target as HTMLElement).closest<HTMLElement>("[data-cookies]");
		if (!boton) return;
		const valor = boton.dataset.cookies === "granted" ? "granted" : "denied";
		try {
			localStorage.setItem(CLAVE, valor);
		} catch {
			/* sin almacenamiento: el aviso vuelve en la próxima visita */
		}
		window.gtag("consent", "update", { analytics_storage: valor });
		aviso.hidden = true;
	});

	// `page_type` con los valores del sitio anterior: las obras y el armador quedaban como "generic".
	const ruta = location.pathname;
	const page_type =
		ruta === "/"
			? "home"
			: ruta === "/servicios/"
				? "services_hub"
				: ruta.startsWith("/servicios/")
					? "service"
					: ruta.startsWith("/blog/")
						? "blog"
						: ruta === "/nosotros/"
							? "about"
							: ruta === "/contacto/"
								? "contact"
								: "generic";
	const servicioDeLaRuta = ruta.match(/^\/servicios\/([^/]+)\//)?.[1];

	const ficha = document.querySelector<HTMLElement>("[data-ficha-servicio]");
	if (ficha) {
		window.gtag("event", "service_page_viewed", {
			page_type,
			pagina: ruta,
			service_name: ficha.dataset.fichaServicio,
			service_slug: servicioDeLaRuta,
		});
	}

	// Clics de navegación del sitio anterior (`contact_cta_click`, `services_nav_click`, `blog_article_open`…).
	// Solo en los enlaces que los tenían, para que las cantidades se puedan comparar.
	document.addEventListener("click", (evento) => {
		const enlace = (evento.target as HTMLElement).closest<HTMLAnchorElement>("a[data-evento]");
		if (!enlace) return;
		const destino = new URL(enlace.href, location.href).pathname.match(/^\/servicios\/([^/]+)\//)?.[1];
		const slug = destino ?? servicioDeLaRuta;
		window.gtag("event", enlace.dataset.evento, {
			cta_location: enlace.dataset.ubicacion,
			page_type,
			pagina: ruta,
			...(enlace.dataset.servicio && { service_name: enlace.dataset.servicio }),
			...(slug && { service_slug: slug }),
		});
	});

	// `whatsapp_click` es el evento clave que ya tiene la propiedad GA4: mantiene la serie histórica de contactos.
	// Quien pide cómo llegar al showroom es un contacto, aunque no sea por WhatsApp.
	document.addEventListener("click", (evento) => {
		const enlace = (evento.target as HTMLElement).closest<HTMLAnchorElement>("a[data-mapa]");
		if (!enlace) return;
		window.gtag("event", "mapa_click", { origen: enlace.dataset.mapa, page_type, pagina: ruta });
	});

	// Mismos nombres que el sitio anterior, para no cortar la serie de llamadas y correos.
	document.addEventListener("click", (evento) => {
		const enlace = (evento.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="tel:"], a[href^="mailto:"]');
		if (!enlace) return;
		window.gtag("event", enlace.href.startsWith("tel:") ? "phone_click" : "email_click", { page_type, pagina: ruta });
	});

	// Valores de `cta_location` del sitio anterior. El FAB viejo se veía también en el celular: la barra cuenta como él.
	const UBICACION_ANTERIOR: Record<string, string> = {
		fab: "floating_fab",
		barra: "floating_fab",
		cabecera: "header_cta",
		inicio: "hero_cta",
		obra: "hero_cta",
		servicio: "service_cta",
		lateral: "service_cta",
		banda: "final_cta",
		nota: "blog_sidebar_whatsapp",
		"aviso-precios": "service_price_guide",
		calculadora: "contact_form",
	};

	document.addEventListener("click", (evento) => {
		const enlace = (evento.target as HTMLElement).closest<HTMLAnchorElement>('a[href^="https://wa.me/"]');
		if (!enlace) return;
		let texto = "";
		try {
			texto = decodeURIComponent(enlace.href.split("?text=")[1] ?? "");
		} catch {
			texto = "";
		}
		const delTexto = texto.match(/Servicio:\s*(.+)/i)?.[1]?.trim();
		const valor = Number(enlace.dataset.valor);
		const servicio = delTexto ?? servicioDeLaRuta ?? "sin_servicio";
		const origen = enlace.dataset.origen ?? ("waBar" in enlace.dataset ? "barra" : "contenido");
		window.gtag("event", "whatsapp_click", {
			servicio,
			origen,
			pagina: ruta,
			page_type,
			// Nombres del sitio anterior: si la propiedad tiene dimensiones personalizadas con ellos, siguen llenándose.
			...(delTexto && { service_name: delTexto }),
			...(servicioDeLaRuta && { service_slug: servicioDeLaRuta }),
			cta_location: UBICACION_ANTERIOR[origen] ?? origen,
			// Monto de referencia que vio la persona en el armador: el valor estimado del pedido, no una venta.
			...(valor > 0 ? { value: valor, currency: "PYG" } : {}),
		});
	});
</script>
