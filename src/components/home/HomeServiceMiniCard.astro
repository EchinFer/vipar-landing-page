---
import Card from "@components/ui/Card.astro";
import Heading from "@components/ui/Heading.astro";
import Text from "@components/ui/Text.astro";

interface ComplementaryService {
  icon: string;
  title: string;
  description: string;
  href: string;
}

interface Props {
  service: ComplementaryService;
}

const { service } = Astro.props;
---

<Card as="a" variant="soft" href={service.href} class="vipar-mini-card">
  <div class="vipar-mini-card__icon">
    <span class="material-symbols-outlined" aria-hidden="true">{service.icon}</span>
  </div>
  <div class="vipar-mini-card__body">
    <Heading level={3}>{service.title}</Heading>
    <Text variant="body-sm" tone="muted">{service.description}</Text>
  </div>
  <span class="material-symbols-outlined vipar-mini-card__arrow" aria-hidden="true">arrow_forward</span>
</Card>
