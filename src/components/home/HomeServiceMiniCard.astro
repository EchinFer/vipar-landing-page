---
import Card from "@components/ui/Card.astro";
import Heading from "@components/ui/Heading.astro";
import UiIcon from "@components/icons/UiIcon.astro";
import Text from "@components/ui/Text.astro";

interface ComplementaryService {
  iconClass: string;
  title: string;
  description: string;
  href: string;
}

interface Props {
  service: ComplementaryService;
}

const { service } = Astro.props;
---

<Card as="a" variant="soft" href={service.href} class="vipar-mini-card">
  <div class="vipar-mini-card__icon">
    <UiIcon name={service.iconClass} />
  </div>
  <div class="vipar-mini-card__body">
    <Heading level={3}>{service.title}</Heading>
    <Text variant="body-sm" tone="muted">{service.description}</Text>
  </div>
  <UiIcon name="arrow-right" class="vipar-mini-card__arrow" />
</Card>
