---
import Container from "@components/ui/Container.astro";
import Heading from "@components/ui/Heading.astro";
import Stack from "@components/ui/Stack.astro";
import Text from "@components/ui/Text.astro";
import HomeServiceEnvironmentCard from "./HomeServiceEnvironmentCard.astro";

interface FeaturedService {
  title: string;
  description: string;
  image: string;
  caption: string;
  alt: string;
  points: string[];
  href: string;
}

interface Props {
  featuredServices: FeaturedService[];
}

const { featuredServices } = Astro.props;
---

<section class="vipar-section vipar-section--surface" id="servicios">
  <Container class="vipar-shell vipar-stack-lg">
    <Stack class="vipar-section-heading vipar-section-heading--center" gap="sm">
      <Text as="span" variant="label-sm" tone="accent" class="vipar-label">Servicios Destacados</Text>
      <Heading level={2}>Cielo raso, box de baño y mamparas divisorias en Paraguay</Heading>
      <Text variant="body-lg" tone="muted">
        Descubre soluciones en cielo raso, box de baño y mamparas divisorias para viviendas,
        oficinas y locales comerciales. Compara materiales, usos y opciones de instalación para
        pedir tu cotización según medidas, necesidad y tipo de obra.
      </Text>
    </Stack>

    <div class="vipar-featured-grid">
      {featuredServices.map((service) => (
        <HomeServiceEnvironmentCard service={service} />
      ))}
    </div>

  </Container>
</section>
