---
import type { ImageMetadata } from "astro";
import Container from "@components/ui/Container.astro";
import Heading from "@components/ui/Heading.astro";
import Stack from "@components/ui/Stack.astro";
import Text from "@components/ui/Text.astro";
import HomeServiceEnvironmentCard from "./HomeServiceEnvironmentCard.astro";
import HomeServiceMiniCard from "./HomeServiceMiniCard.astro";

interface FeaturedService {
  title: string;
  description: string;
  image: ImageMetadata;
  alt: string;
  points: string[];
  href: string;
}

interface ComplementaryService {
  iconClass: string;
  title: string;
  description: string;
  href: string;
}

interface Props {
  featuredServices: FeaturedService[];
  complementaryServices: ComplementaryService[];
  viewAllHref?: string;
}

const { featuredServices, complementaryServices, viewAllHref } = Astro.props;
---

<section class="vipar-section vipar-section--surface" id="servicios">
  <Container class="vipar-shell vipar-stack-lg">
    <Stack class="vipar-section-heading vipar-section-heading--center" gap="sm">
      <Text as="span" variant="label-sm" tone="accent" class="vipar-label">Servicios Destacados</Text>
      <Heading level={2}>Cielo raso, box de bano y mamparas divisorias en Paraguay</Heading>
      <Text variant="body-lg" tone="muted">
        Conoce soluciones en cielo raso, box de bano y mamparas divisorias para viviendas,
        oficinas y espacios comerciales. Revisa materiales, tipos de instalacion y opciones para
        solicitar tu presupuesto segun medidas y tipo de proyecto.
      </Text>
    </Stack>

    <div class="vipar-featured-grid">
      {featuredServices.map((service) => (
        <HomeServiceEnvironmentCard service={service} />
      ))}
    </div>

    <div class="vipar-mini-grid">
      {complementaryServices.map((service) => (
        <HomeServiceMiniCard service={service} />
      ))}
    </div>
    {viewAllHref && (
      <div class="vipar-services-view-all">
        <a
          href={viewAllHref}
          class="ds-btn ds-btn--outlined ds-btn--primary"
          data-track-event="services_nav_click"
          data-cta-location="services_hub_cta"
        >
          Ver todos los servicios
        </a>
      </div>
    )}
  </Container>
</section>
