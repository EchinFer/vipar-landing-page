---
import Button from "../ui/Button.astro";
import Container from "../ui/Container.astro";
import Heading from "../ui/Heading.astro";
import UiIcon from "../icons/UiIcon.astro";
import Stack from "../ui/Stack.astro";
import Text from "../ui/Text.astro";
import HomeProjectCard from "./HomeProjectCard.astro";

interface Project {
  layout: string;
  eyebrow: string;
  title: string;
  description: string;
  image: string;
  alt: string;
  imageRotation?: 90;
}

interface Props {
  projects: Project[];
  totalProjects?: number;
}

const { projects, totalProjects } = Astro.props;
---

<section class="vipar-section vipar-section--projects-architectural" id="obras">
  <Container class="vipar-shell">
    <Stack size="lg">
      <Stack size="sm" class="vipar-projects-heading">
        <Text as="span" variant="label-md" tone="accent" class="vipar-label">Nuestras Obras</Text>
        <Heading level={2}>Obras reales ejecutadas por VIPAR</Heading>
        <Text>
          Vidrio, aluminio y cielos rasos en proyectos comerciales, educativos e institucionales.
        </Text>
      </Stack>

      <div class="vipar-project-grid">
        {projects.map((project) => (
          <HomeProjectCard project={project} />
        ))}
      </div>

      <div class="vipar-projects-footer-action">
        <Button href="/obras/" variant="outlined" tone="primary" size="lg">
          {totalProjects ? `Ver ${totalProjects} obras del catálogo` : "Explorar catálogo completo"}
          <UiIcon name="grid-3x3-gap" />
        </Button>
      </div>
    </Stack>
  </Container>
</section>
