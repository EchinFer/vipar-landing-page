---
import ContactFormGeneric from "@components/ContactFormGeneric.astro";
import { telephone } from "src/constants";

const whatsappNumber = telephone.replace(/[^\d]/g, "");
---

<ContactFormGeneric
  formId="vipar-home-form"
  source="vipar-home-stitch"
  variant="home"
  title={undefined}
  intro={undefined}
  showServiceSelect={true}
  showAsuntoSelect={false}
  showFileUpload={true}
  cardClass="vipar-form-card"
  formClass="vipar-form"
  whatsappNumber={whatsappNumber}
/>

<style>
  :global(.vipar-form-card) {
    --form-padding: 1.5rem;
  }

  :global(.vipar-form) {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  :global(.vipar-form__grid) {
    display: grid;
    gap: 1.5rem;
  }

  :global(.vipar-form__grid--2) {
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  }

  :global(.vipar-field) {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  :global(.vipar-field--file span) {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
</style>
