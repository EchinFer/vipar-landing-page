---
import ContactFormGeneric from "@components/ContactFormGeneric.astro";
import { telephone } from "src/constants";

const whatsappNumber = telephone.replace(/[^\d]/g, "");
---

<ContactFormGeneric
  formId="vipar-home-form"
  source="vipar-home-stitch"
  variant="home"
  title="Solicitá presupuesto sin salir de esta pantalla"
  intro="Elegí el servicio, dejá tu correo y seguí por WhatsApp con el contexto precargado."
  showServiceSelect={true}
  showAsuntoSelect={false}
  showFileUpload={true}
  cardClass="vipar-form-card"
  formClass="vipar-form"
  whatsappNumber={whatsappNumber}
/>

<style>
  :global(.vipar-form-card) {
    --form-padding: 1.5rem;
    scroll-margin-top: 120px;
  }

  :global(.vipar-form) {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }
</style>
