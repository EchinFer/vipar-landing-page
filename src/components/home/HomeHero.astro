---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Button from "@components/ui/Button.astro";
import Container from "@components/ui/Container.astro";
import Heading from "@components/ui/Heading.astro";
import Stack from "@components/ui/Stack.astro";
import Text from "@components/ui/Text.astro";

interface Props {
  whatsappNumber: string;
  whatsappMessage: string;
  image: ImageMetadata;
}

const { whatsappNumber, whatsappMessage, image } = Astro.props;
void whatsappNumber;
void whatsappMessage;
---

<section class="vipar-hero">
  <div class="vipar-hero__backdrop">
    <Image
      src={image}
      alt="Lobby corporativo con superficies vidriadas y terminaciones arquitect&oacute;nicas"
      widths={[640, 768, 960, 1280, 1600]}
      sizes="100vw"
      quality={64}
      format="webp"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="vipar-hero__backdrop-overlay"></div>
  </div>

  <Container class="vipar-shell vipar-hero__grid">
    <Stack class="vipar-hero__copy" gap="md">
      <Stack class="vipar-hero__meta" gap="sm">
        <Text as="span" variant="label-sm" tone="accent" class="vipar-hero__eyebrow">Ubicados en &Ntilde;emby, Central</Text>
        <Text as="span" variant="body-md" tone="muted" class="vipar-hero__support">Atenci&oacute;n para obras residenciales y comerciales</Text>
      </Stack>

      <Heading level={1} variant="display">Cristales templados, aluminio y terminaciones para obras en Paraguay</Heading>
      <Text variant="body-lg" tone="muted">
        Soluciones en cristal templado, aluminio, fachadas, mamparas, cielos rasos y box de ba&ntilde;o para viviendas, comercios, oficinas y obras. Cotizamos seg&uacute;n medidas, tipo de proyecto y condiciones de instalaci&oacute;n.
      </Text>

      <div class="vipar-actions">
        <Button
          href="#contacto"
          variant="contained"
          tone="primary"
          size="lg"
          data-track-event="contact_cta_click"
          data-cta-location="hero_cta"
        >
          Solicitar presupuesto
        </Button>
        <Button
          href="#servicios"
          variant="link"
          tone="primary"
          size="md"
          data-track-event="services_nav_click"
          data-cta-location="hero_cta"
        >
          Ver servicios
        </Button>
      </div>
    </Stack>
  </Container>
</section>
