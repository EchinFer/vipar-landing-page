---
import Button from "@components/ui/Button.astro";
import Card from "@components/ui/Card.astro";
import Heading from "@components/ui/Heading.astro";
import UiIcon from "@components/icons/UiIcon.astro";
import Text from "@components/ui/Text.astro";

interface FeaturedService {
  title: string;
  description: string;
  image: string;
  caption: string;
  alt: string;
  points: string[];
  href: string;
}

interface Props {
  service: FeaturedService;
}

const { service } = Astro.props;
---

<Card variant="media">
  <div class="vipar-service-card__image">
    <img
      src={service.image}
      alt={service.alt}
      width="550"
      height="367"
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="vipar-service-card__body">
    <Heading level={3}>{service.title}</Heading>
    <Text variant="body-sm" tone="inverse">{service.caption}</Text>
    <ul class="vipar-service-card__list">
      {service.points.map((point) => (
        <li>
          <UiIcon name="check-circle-fill" />
          <span>{point}</span>
        </li>
      ))}
    </ul>
    <details class="vipar-service-card__details"><summary>Más sobre esta solución</summary><Text variant="body-md" tone="inverse">{service.description}</Text></details>
    <Button
      href={service.href}
      variant="contained"
      tone="inverse"
      size="md"
      fullWidth
      data-track-event="services_nav_click"
      data-cta-location="services_hub_cta"
    >
      Ver soluciones
      <UiIcon name="arrow-right" />
    </Button>
  </div>
</Card>
<style>
  summary { cursor: pointer; padding: .5rem 0; font-size: .9rem; }
  details { margin-bottom: 1rem; }
</style>
