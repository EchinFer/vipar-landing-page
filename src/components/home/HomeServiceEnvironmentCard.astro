---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Button from "@components/ui/Button.astro";
import Card from "@components/ui/Card.astro";
import Heading from "@components/ui/Heading.astro";
import Text from "@components/ui/Text.astro";

interface FeaturedService {
  title: string;
  description: string;
  image: ImageMetadata;
  alt: string;
  points: string[];
  href: string;
}

interface Props {
  service: FeaturedService;
}

const { service } = Astro.props;
---

<Card variant="media">
  <div class="vipar-service-card__image">
    <Image
      src={service.image}
      alt={service.alt}
      widths={[480, 640, 968]}
      sizes="(max-width: 768px) 85vw, (max-width: 1180px) 50vw, 33vw"
      quality={68}
      format="webp"
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="vipar-service-card__body">
    <Heading level={3}>{service.title}</Heading>
    <Text variant="body-md" tone="inverse">{service.description}</Text>
    <ul class="vipar-service-card__list">
      {service.points.map((point) => (
        <li>
          <i class="bi bi-check-circle-fill" aria-hidden="true"></i>
          <span>{point}</span>
        </li>
      ))}
    </ul>
    <Button href={service.href} variant="contained" tone="inverse" size="md" fullWidth>
      Ver soluciones
      <i class="bi bi-arrow-right" aria-hidden="true"></i>
    </Button>
  </div>
</Card>
