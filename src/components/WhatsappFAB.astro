---
import { SOCIAL_LINKS } from "src/constants";
import { buildWhatsappMessage, buildWhatsappUrl } from "@lib/whatsapp";
import InstagramIcon from "./icons/InstagramIcon.astro";
import TiktokIcon from "./icons/TiktokIcon.astro";
import WhatsappIcon from "./icons/WhatsappIcon.astro";

const whatsappHref = buildWhatsappUrl(
  buildWhatsappMessage({ pageLabel: "sitio web", prompt: "Quiero recibir mas informacion." })
);
---

<style>
  .fab-stack {
    position: fixed;
    bottom: 20px;
    right: 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    z-index: 1000;
  }

  .fab-btn {
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border-radius: 999px;
    box-shadow: 0 10px 24px rgba(0, 0, 0, 0.16);
  }

  .fab-btn--label {
    font-weight: 700;
    font-size: 12px;
    letter-spacing: 0.1px;
  }

  .fab-btn--instagram {
    border: 0;
    color: #fff;
    background: radial-gradient(
        circle at 30% 110%,
        #fdf497 0%,
        #fdf497 5%,
        #fd5949 45%,
        #d6249f 60%,
        #285aeb 90%
      );
  }

  .fab-btn--instagram:hover {
    color: #fff;
    filter: brightness(0.95);
  }

  .fab-btn--whatsapp {
    color: #fff;
    background: #25d366;
  }

  .fab-btn--whatsapp:hover {
    color: #fff;
    filter: brightness(0.96);
  }

  .fab-btn--tiktok {
    border: 0;
    color: #fff;
    background: #000;
    box-shadow:
      0 6px 16px rgba(0, 0, 0, 0.25),
      -2px 0 0 #25f4ee,
      2px 0 0 #fe2c55;
  }

  .fab-btn--tiktok:hover {
    color: #fff;
    filter: brightness(0.95);
  }
</style>

<div class="fab-stack" aria-label="Accesos directos">
  <a
    href={whatsappHref}
    target="_blank"
    class="fab-btn fab-btn--whatsapp"
    aria-label="WhatsApp VIPAR"
    rel="noopener"
    data-track-event="whatsapp_click"
    data-cta-location="floating_fab"
    data-whatsapp-message-type="floating_fab"
  >
    <WhatsappIcon />
  </a>

  {
    SOCIAL_LINKS.instagram && (
      <a
        href={SOCIAL_LINKS.instagram}
        target="_blank"
        class="fab-btn fab-btn--instagram"
        aria-label="Instagram VIPAR"
        rel="noopener"
      >
        <InstagramIcon />
      </a>
    )
  }

  {
    SOCIAL_LINKS.tiktok && (
      <a
        href={SOCIAL_LINKS.tiktok}
        target="_blank"
        class="fab-btn fab-btn--label fab-btn--tiktok"
        aria-label="TikTok VIPAR"
        rel="noopener"
      >
        <TiktokIcon />
      </a>
    )
  }
</div>
