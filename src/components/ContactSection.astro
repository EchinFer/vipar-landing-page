---
import { address, email, telephone } from "src/constants";
import EmailLink from "./EmailLink.astro";
import GoogleMapLocation from "./GoogleMapLocation.astro";
import SectionContainer from "./SectionContainer.astro";
import TelephoneLink from "./TelephoneLink.astro";
import ContactForm from "./ContactForm.astro";
import EnvelopeIcon from "./icons/EnvelopeIcon.astro";
import GeoAltIcon from "./icons/GeoAltIcon.astro";
import TelephoneIcon from "./icons/TelephoneIcon.astro";

const seccion1 = {
  direccion_titulo: "Nuestra Dirección",
  direccion_informacion: address,
  correo_titulo: "Correo Electrónico",
  correo_informacion: email,
  telefono_titulo: "Teléfono",
  telefono_informacion: telephone,
};
---

<SectionContainer id="contact" class="contact" ariaLabelledby="contact">
  <div class="section-header">
    <h2>Contáctanos</h2>
  </div>
  <div class="row gy-4">
    <div class="col-lg-6">
      <address
        class="info-item d-flex flex-column justify-content-center align-items-center"
      >
        <GeoAltIcon aria-label="Ubicación" title="Ubicación" />
        <h3>{seccion1.direccion_titulo}</h3>
        <p>{seccion1.direccion_informacion}</p>
      </address>
    </div>

    <div class="col-lg-3 col-md-6">
      <div
        class="info-item d-flex flex-column justify-content-center align-items-center"
      >
        <EnvelopeIcon />
        <h3>{seccion1.correo_titulo}</h3>
        <EmailLink />
      </div>
    </div>

    <div class="col-lg-3 col-md-6">
      <div
        class="info-item d-flex flex-column justify-content-center align-items-center"
      >
        <TelephoneIcon />
        <h3>{seccion1.telefono_titulo}</h3>
        <TelephoneLink />
      </div>
    </div>
  </div>

  <div class="row gy-4 mt-4">
    <div class="col-lg-5">
      <div class="p-3 p-md-4 bg-light h-100">
        <h3 class="h5 mb-3">Pedí presupuesto con confianza</h3>
        <ul class="list-unstyled mb-3">
          <li class="mb-2"><i class="bi bi-check2-circle me-2"></i>Respondemos en horario laboral</li>
          <li class="mb-2"><i class="bi bi-check2-circle me-2"></i>Presupuesto claro y asesoría</li>
          <li class="mb-2"><i class="bi bi-check2-circle me-2"></i>Instalación profesional</li>
        </ul>
        <p class="text-muted mb-0" style="font-size: 14px;">
          Tip: si podés, adjuntá medidas aproximadas y una foto en WhatsApp.
        </p>
      </div>
    </div>
    <div class="col-lg-7">
      <ContactForm />
    </div>
  </div>
</SectionContainer>
<SectionContainer id="contact-map" class="contact-map" fullWidth ariaLabelledby="contact">
  <div class="row gy-4 mt-1">
    <div class="col-lg-12">
      <div class="map-container"><GoogleMapLocation /></div>
    </div>
  </div>
</SectionContainer>

<style>
  .map-container {
    min-height: 400px;
    height: 100%;
  }
</style>
