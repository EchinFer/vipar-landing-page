---
import { Image } from "astro:assets";
import Container from "@components/ui/Container.astro";
import Card from "@components/ui/Card.astro";
import Heading from "@components/ui/Heading.astro";
import Text from "@components/ui/Text.astro";
import Button from "@components/ui/Button.astro";
import FaqAccordion from "@components/ui/FaqAccordion.astro";
import QuoteCTA from "@components/ui/QuoteCTA.astro";
import RelatedWorksGallery from "@components/ui/RelatedWorksGallery.astro";
import UiIcon from "@components/icons/UiIcon.astro";
import type { ServiceTemplateContent } from "@lib/service-template";
import { getRelatedStaticObras } from "@lib/static-obras";
import "../../styles/servicio-template.css";

interface Props {
  content: ServiceTemplateContent;
  whatsappNumber: string;
  whatsappLink: string;
  serviceName?: string;
}

const { content, whatsappNumber, whatsappLink, serviceName } = Astro.props;
const relatedObras = getRelatedStaticObras(content.relatedWorksKey);

const serviceTemplateIconMap: Record<string, string> = {
  open_in_full: "arrows-fullscreen",
  shield: "shield-check",
  visibility: "eye",
  storefront: "shop",
  business: "building",
  window: "window",
  precision_manufacturing: "tools",
  sensor_door: "door-open",
  view_compact: "columns-gap",
  air: "wind",
  architecture: "building",
};

const resolveTemplateIcon = (icon: string) => serviceTemplateIconMap[icon] ?? "square";
---

<main class="service-template-page">
  <section class="service-template-hero">
    <Container class="service-template-hero__inner">
      <div class="service-template-hero__copy">
        <Text as="div" variant="label-sm" tone="accent" class="service-template-hero__eyebrow">
          {content.hero.eyebrow}
        </Text>
        <Heading level={1} variant="display">{content.hero.title}</Heading>
        <Text variant="body-lg">{content.hero.description}</Text>

        <div class="service-template-hero__actions">
          <Button href="/contacto/" variant="contained" tone="primary" size="lg">
            {content.hero.primaryCtaLabel}
          </Button>
          <Button
            href={whatsappLink}
            target="_blank"
            rel="noopener noreferrer"
            variant="outlined"
            tone="primary"
            size="lg"
            data-track-event="whatsapp_service_click"
            data-cta-location="hero"
            data-service-name={serviceName}
            data-whatsapp-message-type="service_hero"
          >
            <UiIcon name="whatsapp" />
            {content.hero.secondaryCtaLabel ?? "WhatsApp"}
          </Button>
        </div>

        <div class="service-template-hero__tags">
          {content.hero.tags.map((tag) => (
            <span class="ds-tag">{tag}</span>
          ))}
        </div>
      </div>

      <div class="service-template-hero__media">
        <Image
          src={content.hero.image}
          alt={content.hero.title}
          inferSize={true}
          widths={[768, 1024, 1280, 1600]}
          sizes="(max-width: 1100px) 100vw, 58vw"
          loading="eager"
          fetchpriority="high"
          decoding="async"
          format="webp"
          quality={72}
        />
      </div>
    </Container>
  </section>

  <section class="service-template-section service-template-problem">
    <Container class="service-template-problem__grid">
      <div class="service-template-problem__copy">
        <Heading level={2} variant="lg">{content.problem.title}</Heading>
        <Text>{content.problem.description}</Text>
      </div>

      <Card as="aside" class="service-template-problem__aside">
        <Heading level={3} variant="sm">Casos frecuentes</Heading>
        <div class="service-template-problem__list">
          {content.problem.cases.map((item) => (
            <article class="service-template-problem__item">
              <UiIcon name="exclamation-triangle" />
              <div>
                <strong>{item.title}</strong>
                <Text variant="body-sm">{item.description}</Text>
              </div>
            </article>
          ))}
        </div>
      </Card>
    </Container>
  </section>

  <section class="service-template-section service-template-solutions">
    <Container>
      <div class="service-template-section__head">
        <Heading level={2} variant="lg">{content.solutions.title}</Heading>
        <Text>{content.solutions.description}</Text>
      </div>

      <div class="service-template-solutions__grid">
        {content.solutions.items.map((item) => (
          <Card class="service-template-solution">
            <div class="service-template-solution__media">
              <Image
                src={item.image}
                alt={item.title}
                inferSize={true}
                widths={[360, 540, 720]}
                sizes="(max-width: 760px) 100vw, (max-width: 1100px) 50vw, 33vw"
                loading="lazy"
                decoding="async"
                format="webp"
                quality={68}
              />
            </div>
            <div class="service-template-solution__body">
              <Heading level={3} variant="sm">{item.title}</Heading>
              <Text variant="body-sm">{item.description}</Text>

              <div class="service-template-solution__block">
                <Text as="div" variant="label-sm" tone="accent">Ideal para</Text>
                <ul>
                  {item.idealFor.map((target) => (
                    <li>{target}</li>
                  ))}
                </ul>
              </div>
            </div>
          </Card>
        ))}
      </div>
    </Container>
  </section>

  <section class="service-template-section service-template-selection">
    <Container>
      <div class="service-template-section__head">
        <Heading level={2} variant="lg">{content.selection.title}</Heading>
        <Text>{content.selection.description}</Text>
      </div>

      <div class="service-template-selection__grid">
        {content.selection.items.map((item) => (
          <Card class="service-template-selection__card">
            <UiIcon name={resolveTemplateIcon(item.icon)} />
            <Heading level={3} variant="sm">{item.title}</Heading>
            <Text variant="body-sm">{item.description}</Text>
          </Card>
        ))}
      </div>
    </Container>
  </section>

  <section class="service-template-section service-template-applications">
    <Container>
      <div class="service-template-section__head">
        <Heading level={2} variant="lg">{content.applications.title}</Heading>
        <Text>{content.applications.description}</Text>
      </div>

      <div class="service-template-applications__grid">
        {content.applications.items.map((item) => (
          <article class="service-template-application">
            <div class="service-template-application__media">
              <Image
                src={item.image}
                alt={item.title}
                inferSize={true}
                widths={[240, 320, 480]}
                sizes="(max-width: 760px) 50vw, (max-width: 1100px) 50vw, 25vw"
                loading="lazy"
                decoding="async"
                format="webp"
                quality={68}
              />
            </div>
            <Heading level={3} variant="sm">{item.title}</Heading>
          </article>
        ))}
      </div>
    </Container>
  </section>

  <section class="service-template-section service-template-process">
    <Container>
      <div class="service-template-section__head">
        <Heading level={2} variant="lg">{content.process.title}</Heading>
        <Text>{content.process.description}</Text>
      </div>

      <div class="service-template-process__grid">
        {content.process.steps.map((step, index) => (
          <article class="service-template-process__step">
            <div class="service-template-process__badge">{index + 1}</div>
            <Heading level={3} variant="sm">{step.label}</Heading>
          </article>
        ))}
      </div>
    </Container>
  </section>

  <section class="service-template-section service-template-trust">
    <Container>
      <div class="service-template-trust__inner">
        <div class="service-template-trust__copy">
          <Heading level={2} variant="lg">{content.trust.title}</Heading>
          <Text variant="body-lg">{content.trust.description}</Text>
          <div class="service-template-trust__location">
            <UiIcon name="geo-alt" />
            <span>{content.trust.locationLabel}</span>
          </div>
        </div>

        <div class="service-template-trust__media">
          <Image
            src={content.trust.image}
            alt={content.trust.title}
            inferSize={true}
            widths={[240, 320, 480]}
            sizes="240px"
            loading="lazy"
            decoding="async"
            format="webp"
            quality={70}
          />
        </div>
      </div>
    </Container>
  </section>

  <FaqAccordion items={content.faqs} class="service-template-faq" />
  <RelatedWorksGallery obras={relatedObras} />

  <section class="service-template-section service-template-final">
    <Container>
      <QuoteCTA
        whatsappNumber={whatsappNumber}
        whatsappHref={whatsappLink}
        serviceName={serviceName}
      />
    </Container>
  </section>
</main>
