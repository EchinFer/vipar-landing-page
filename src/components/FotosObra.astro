---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import Foto from "./Foto.astro";

interface Props {
	fotos: { src: ImageMetadata; alt: string }[];
}

const { fotos } = Astro.props;
const grandes = await Promise.all(fotos.map((foto) => getImage({ src: foto.src, width: foto.src.width, height: foto.src.height, format: "webp" })));
---

<section class="px-4 py-14 md:px-8 md:py-20" aria-label="Más fotos de la obra" data-fotos-obra>
	<p class="kicker text-muted">La obra</p>
	<h2 class="mt-3 text-3xl leading-[1.05] text-brand md:text-4xl">Más fotos</h2>
	<ul class="mt-8 grid gap-3 md:grid-cols-2 md:gap-4">
		{
			fotos.map((foto, indice) => (
				<li>
					<a
						href={grandes[indice].src}
						class="zoom block w-full cursor-zoom-in overflow-hidden focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand"
						data-abrir={indice}
						data-ancho={foto.src.width}
						data-alto={foto.src.height}
						aria-haspopup="dialog"
						aria-label={`Ver más grande. ${foto.alt}`}
					>
						<Foto src={foto.src} alt="" class="aspect-[4/3] w-full object-cover" sizes="(min-width: 768px) 50vw, 100vw" />
					</a>
				</li>
			))
		}
	</ul>
	<dialog class="visor" aria-label="Fotos de la obra">
		<div class="flex h-full min-h-0 w-full flex-col">
			<div class="flex items-center justify-between px-4 pt-[max(0.75rem,env(safe-area-inset-top))]">
				<p data-contador class="text-sm text-white/80" aria-live="polite"></p>
				<button type="button" data-cerrar class="grid size-11 place-items-center text-white" aria-label="Cerrar">
					<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75">
						<path d="M6 6l12 12M18 6L6 18"></path>
					</svg>
				</button>
			</div>
			<div class="relative flex min-h-0 flex-1 items-center justify-center px-3 md:px-16" data-escenario>
				<button type="button" data-anterior class="absolute left-2 grid size-11 place-items-center bg-white/15 text-white md:left-4" aria-label="Foto anterior" hidden={fotos.length < 2}>
					<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M15 5l-7 7 7 7"></path></svg>
				</button>
				<img data-ampliada alt="" draggable="false" class="max-h-full max-w-full object-contain" />
				<button type="button" data-siguiente class="absolute right-2 grid size-11 place-items-center bg-white/15 text-white md:right-4" aria-label="Foto siguiente" hidden={fotos.length < 2}>
					<svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.75"><path d="M9 5l7 7-7 7"></path></svg>
				</button>
			</div>
			<p data-pie class="px-4 pt-3 pb-[max(1rem,env(safe-area-inset-bottom))] text-center text-sm text-white/80"></p>
		</div>
	</dialog>
</section>

<style>
	dialog.visor {
		width: 100%;
		height: 100%;
		max-width: none;
		max-height: none;
		margin: 0;
		padding: 0;
		border: 0;
		background: transparent;
		color: #fff;
	}
	dialog.visor[open] {
		display: flex;
	}
	dialog.visor::backdrop {
		background: #002046;
	}
</style>

<script>
	document.querySelectorAll<HTMLElement>("[data-fotos-obra]").forEach((raiz) => {
		const dialogo = raiz.querySelector<HTMLDialogElement>("dialog.visor");
		const ampliada = raiz.querySelector<HTMLImageElement>("[data-ampliada]");
		const pie = raiz.querySelector<HTMLElement>("[data-pie]");
		const contador = raiz.querySelector<HTMLElement>("[data-contador]");
		const botones = [...raiz.querySelectorAll<HTMLAnchorElement>("[data-abrir]")];
		if (!dialogo || !ampliada || !pie || !contador || botones.length === 0) return;

		let actual = 0;
		let origenX = 0;

		const mostrar = (indice: number) => {
			actual = (indice + botones.length) % botones.length;
			const boton = botones[actual];
			const ancho = Number(boton.dataset.ancho) || 0;
			const alto = Number(boton.dataset.alto) || 0;
			ampliada.src = boton.href;
			ampliada.alt = boton.getAttribute("aria-label")?.replace(/^Ver más grande\.\s*/, "") ?? "";
			ampliada.style.maxWidth = `min(100%, ${ancho}px)`;
			ampliada.style.maxHeight = `min(100%, ${alto}px)`;
			pie.textContent = ampliada.alt;
			contador.textContent = `${actual + 1} de ${botones.length}`;
		};

		const abrir = (indice: number) => {
			mostrar(indice);
			if (!dialogo.open) dialogo.showModal();
		};

		raiz.addEventListener("click", (evento) => {
			const boton = (evento.target as HTMLElement).closest<HTMLAnchorElement>("[data-abrir]");
			if (!boton || !raiz.contains(boton)) return;
			evento.preventDefault();
			abrir(Number(boton.dataset.abrir) || 0);
		});

		dialogo.addEventListener("click", (evento) => {
			const objetivo = evento.target as HTMLElement;
			if (objetivo.closest("[data-cerrar]")) dialogo.close();
			else if (objetivo.closest("[data-anterior]")) mostrar(actual - 1);
			else if (objetivo.closest("[data-siguiente]")) mostrar(actual + 1);
			else if (!objetivo.closest("img, button")) dialogo.close();
		});

		dialogo.addEventListener("keydown", (evento) => {
			if (evento.key === "ArrowRight") {
				evento.preventDefault();
				mostrar(actual + 1);
			} else if (evento.key === "ArrowLeft") {
				evento.preventDefault();
				mostrar(actual - 1);
			}
		});

		dialogo.addEventListener("pointerdown", (evento) => {
			if ((evento.target as HTMLElement).closest("button")) return;
			origenX = evento.clientX;
		});
		dialogo.addEventListener("pointerup", (evento) => {
			if (botones.length < 2 || (evento.target as HTMLElement).closest("button")) return;
			const delta = evento.clientX - origenX;
			if (delta <= -48) mostrar(actual + 1);
			else if (delta >= 48) mostrar(actual - 1);
		});
	});
</script>
