---
import Foto from "./Foto.astro";
import { fotosDe } from "../lib/fotos";
import { tipos, type Obra, type TipoObra } from "../data/obras";

interface Props {
	obras: Obra[];
	activa: TipoObra | "todas";
}
const { obras, activa } = Astro.props;
---

<div class="flex gap-2 overflow-x-auto px-4 py-6 text-sm md:px-8">
	{
		tipos.map((tipo) => (
			<a href={tipo.href} class:list={["border px-4 py-2", tipo.id === activa ? "border-brand bg-brand text-white" : "border-aluminum/60 text-ink"]}>
				{tipo.label}
			</a>
		))
	}
</div>
<ul class="grid grid-cols-2 gap-2 px-4 pb-14 md:grid-cols-3 md:gap-3 md:px-8">
	{
		obras.flatMap((obra) => {
			const foto = fotosDe(obra.slug)[0];
			if (!foto) return [];
			const lugar = [obra.ciudad, obra.tipo].filter(Boolean).join(" · ");
			return (
				<li>
					<a href={`/obras/${obra.slug}/`} class="zoom group relative block aspect-[4/5] overflow-hidden bg-brand">
						<Foto src={foto} alt={obra.alts?.[0] ?? `${obra.titulo}${obra.ciudad ? `, ${obra.ciudad}` : ""}`} class="absolute inset-0 size-full object-cover" sizes="(min-width: 768px) 33vw, 50vw" widths={[480, 720, 1100, 1400, 1920]} />
						<div class="absolute inset-0 bg-gradient-to-t from-brand/85 via-transparent to-transparent"></div>
						<div class="absolute inset-x-0 bottom-0 p-3 text-white md:p-5">
							<p class="text-sm leading-tight font-bold md:text-xl">{obra.titulo}</p>
							<p class="text-xs text-white/80 md:text-sm">{lugar}</p>
						</div>
					</a>
				</li>
			);
		})
	}
</ul>
