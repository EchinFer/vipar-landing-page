---
interface Props { href?: string; variant?: "primary"|"secondary"|"ghost"; type?: "button"|"submit"|"reset"; class?: string }
const { href, variant = "primary", type = "button", class: className = "" } = Astro.props;
const variantClass = variant === "primary" ? "ds-btn-primary" : variant === "secondary" ? "ds-btn-secondary" : "ds-btn-ghost";
---
{href ? (
  <a href={href} class:list={["ds-btn", variantClass, className]}><slot /></a>
) : (
  <button type={type} class:list={["ds-btn", variantClass, className]}><slot /></button>
)}
