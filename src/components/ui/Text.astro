---
interface Props {
  as?: string;
  size?: "sm" | "md" | "lg";
  variant?: "body-lg" | "body-md" | "body-sm" | "label-md" | "label-sm";
  tone?: "default" | "muted" | "accent" | "inverse";
  class?: string;
}

const {
  as = "p",
  size = "md",
  variant = size === "lg" ? "body-lg" : size === "sm" ? "body-sm" : "body-md",
  tone = variant.startsWith("label") ? "default" : "muted",
  class: className = "",
} = Astro.props;

const Tag = as as any;
const variantClass =
  variant === "body-lg"
    ? "ds-text-body-lg"
    : variant === "body-sm"
      ? "ds-text-body-sm"
      : variant === "label-md"
        ? "ds-text-label-md"
        : variant === "label-sm"
          ? "ds-text-label-sm"
          : "ds-text-body-md";
const toneClass =
  tone === "accent"
    ? "ds-text-accent"
    : tone === "inverse"
      ? "ds-text-inverse"
      : tone === "default"
        ? "ds-text-default"
        : "ds-text-muted";
---
<Tag class:list={[variantClass, toneClass, className]}><slot /></Tag>
