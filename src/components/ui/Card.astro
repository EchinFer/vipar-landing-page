---
interface Props {
  as?: string;
  variant?: "default" | "media" | "soft" | "immersive" | "feature" | "gallery" | "catalog" | "info";
  class?: string;
}

const { as = "article", variant = "default", class: className = "", ...rest } = Astro.props;
const Tag = as as any;
---
<Tag {...rest} class:list={["ds-card", variant !== "default" && `ds-card--variant-${variant}`, className]}><slot /></Tag>
