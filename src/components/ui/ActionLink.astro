---
interface Props extends astroHTML.JSX.AnchorHTMLAttributes {
  href: string;
  tone?: "primary" | "secondary" | "neutral" | "inverse";
  size?: "sm" | "md";
  class?: string;
}

const {
  href,
  tone = "primary",
  size = "md",
  class: className = "",
  ...props
} = Astro.props;
---

<a
  href={href}
  {...props}
  class:list={["ds-action-link", `ds-action-link--${tone}`, `ds-action-link--${size}`, className]}
>
  <slot />
</a>
