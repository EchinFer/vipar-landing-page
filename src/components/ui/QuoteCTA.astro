---
import "@styles/ui/quote-cta.css";
import Button from "@components/ui/Button.astro";
import Heading from "@components/ui/Heading.astro";
import Text from "@components/ui/Text.astro";

interface Props {
  whatsappNumber: string;
  whatsappHref?: string;
  serviceName?: string;
  ctaLocation?: string;
  messageType?: string;
  titleText?: string;
  bodyText?: string;
  buttonLabel?: string;
  class?: string;
}

const {
  whatsappNumber,
  whatsappHref,
  serviceName,
  ctaLocation = "final_cta",
  messageType = "service_quote",
  titleText = "Quieres cotizar un trabajo similar?",
  bodyText = "Envia fotos, planos o referencias de tu proyecto para recibir un presupuesto detallado y asesoramiento tecnico especializado.",
  buttonLabel = "Solicitar presupuesto por WhatsApp",
  class: className = "",
} = Astro.props;
---

<section class:list={["ds-quote-cta", className]} data-consent-sensitive>
  <Heading level={2}>{titleText}</Heading>
  <Text>{bodyText}</Text>
  <Button
    href={whatsappHref ?? `https://wa.me/${whatsappNumber}`}
    target="_blank"
    rel="noopener noreferrer"
    variant="contained"
    tone="primary"
    size="lg"
    class="ds-quote-cta__button"
    data-track-event="whatsapp_click"
    data-cta-location={ctaLocation}
    data-service-name={serviceName}
    data-whatsapp-message-type={messageType}
  >
    {buttonLabel}
  </Button>
</section>
