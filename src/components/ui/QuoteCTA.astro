---
import "@styles/ui/quote-cta.css";
import Button from "@components/ui/Button.astro";
import Heading from "@components/ui/Heading.astro";
import Text from "@components/ui/Text.astro";

interface Props {
  whatsappNumber: string;
  whatsappHref?: string;
  serviceName?: string;
  ctaLocation?: string;
  messageType?: string;
  class?: string;
}

const {
  whatsappNumber,
  whatsappHref,
  serviceName,
  ctaLocation = "final_cta",
  messageType = "service_quote",
  class: className = "",
} = Astro.props;
---

<section class:list={["ds-quote-cta", className]}>
  <Heading level={2}>¿Querés cotizar un trabajo similar?</Heading>
  <Text>
    Enviá fotos, planos o referencias de tu proyecto para recibir un presupuesto detallado y
    asesoramiento técnico especializado.
  </Text>
  <Button
    href={whatsappHref ?? `https://wa.me/${whatsappNumber}`}
    target="_blank"
    rel="noopener noreferrer"
    variant="contained"
    tone="primary"
    size="lg"
    class="ds-quote-cta__button"
    data-track-event="whatsapp_service_click"
    data-cta-location={ctaLocation}
    data-service-name={serviceName}
    data-whatsapp-message-type={messageType}
  >
    Solicitar presupuesto por WhatsApp
  </Button>
</section>

<script define:vars={{ serviceName, ctaLocation }}>
  // Track WhatsApp clicks from quote CTA
  document.addEventListener("DOMContentLoaded", () => {
    const quoteCtaBtn = document.querySelector(
      '.ds-quote-cta__button[data-track-event="whatsapp_service_click"]'
    );
    if (quoteCtaBtn) {
      quoteCtaBtn.addEventListener("click", () => {
        if (typeof window !== "undefined" && typeof window.posthog === "object") {
          window.posthog.capture("whatsapp_click", {
            service_name: serviceName,
            source_page: window.location.pathname,
            cta_location: ctaLocation,
          });
        }
      });
    }
  });
</script>
