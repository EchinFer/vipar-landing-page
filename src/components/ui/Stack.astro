---
interface Props {
  as?: string;
  class?: string;
  gap?: "sm" | "md" | "lg";
}

const { as = "div", class: className = "", gap = "md" } = Astro.props;
const Tag = as as any;
const gapClass = gap === "sm" ? "ds-stack-sm" : gap === "lg" ? "ds-stack-lg" : "ds-stack-md";
---
<Tag class:list={[gapClass, className]}><slot /></Tag>
