---
import { getStaticObraBySlug } from "@lib/static-obras";

interface Props { slug: string; }
const obra = getStaticObraBySlug(Astro.props.slug);
if (!obra) throw new Error(`Obra inexistente: ${Astro.props.slug}`);
---
<figure class="ds-proof-photo">
  <a href={`/obras/${obra.slug}/`} aria-label={`Ver obra: ${obra.titulo}`}>
    <div class="ds-proof-photo__image">
      <img src={obra.imagen} alt={`${obra.systemLabel} — ${obra.titulo}, ${obra.ubicacion}`}
        width="1200" height="900" loading="lazy" decoding="async"
        class:list={[obra.imageRotation === 90 && "ds-photo-rotate-90"]} />
    </div>
  </a>
  <figcaption>{obra.systemLabel} · {obra.titulo} · {obra.ubicacion}</figcaption>
</figure>

<style>
  .ds-proof-photo { margin: 0 0 1rem; }
  .ds-proof-photo__image { position: relative; aspect-ratio: 16 / 10; overflow: hidden; border-radius: 8px; }
  img { width: 100%; height: 100%; object-fit: cover; }
  figcaption { padding-top: .5rem; font-size: .8rem; line-height: 1.5; }
  .ds-photo-rotate-90 { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%) rotate(90deg) scale(1.6); }
</style>
