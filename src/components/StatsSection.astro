<section class="py-5 bg-surface-container-high" aria-label="Experiencia Aplicada">
  <div class="max-w-7xl mx-auto px-4">
    <div class="bg-surface-container-lowest rounded-xl p-8 shadow-sm border" style="border-color:var(--color-outline-variant);">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-6 items-center">
        <div>
          <h3 class="text-2xl font-extrabold text-primary mb-2">Experiencia Aplicada</h3>
          <p class="text-secondary text-sm">Nuestras cifras respaldan el compromiso con la excelencia técnica.</p>
        </div>
        <div class="flex flex-col items-center justify-center p-4 bg-surface rounded-lg">
          <span class="text-4xl font-extrabold text-primary">98%</span>
          <span class="text-label-md text-secondary font-medium mt-2">Cumplimiento de plazos</span>
        </div>
        <div class="flex flex-col items-center justify-center p-4 bg-surface rounded-lg">
          <span class="text-4xl font-extrabold text-primary">0</span>
          <span class="text-label-md text-secondary font-medium mt-2">Accidentes laborales</span>
        </div>
        <div class="flex flex-col items-center justify-center p-4 bg-surface rounded-lg">
          <span class="text-4xl font-extrabold text-primary">+20</span>
          <span class="text-label-md text-secondary font-medium mt-2">Sectores atendidos</span>
        </div>
      </div>
    </div>
  </div>
</section>
