---
import Card from "@components/ui/Card.astro";
import Container from "@components/ui/Container.astro";
import Heading from "@components/ui/Heading.astro";
import Text from "@components/ui/Text.astro";
import UiIcon from "@components/icons/UiIcon.astro";
import type { CeilingDetailItem } from "@lib/static-servicio-cielo-raso";

interface Props {
  image: string;
  items: CeilingDetailItem[];
}

const { image, items } = Astro.props;
---

<section class="ceiling-service-section ceiling-service-details">
  <Container class="ceiling-service-details__grid">
    <div class="ceiling-service-details__media">
      <img
        src={image}
        alt="Detalle tecnico de materiales de cielo raso"
        width={1200}
        height={900}
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="ceiling-service-details__content">
      <Heading level={2} variant="lg">Ingeniería de detalle</Heading>
      <div class="ceiling-service-details__list">
        {items.map((item) => (
          <article class="ceiling-service-detail">
            <Card as="div" class="ceiling-service-detail__icon-wrap">
              <UiIcon name={item.icon} class="ceiling-service-detail__icon" />
            </Card>
            <div>
              <Heading level={3} variant="sm">{item.title}</Heading>
              <Text>{item.description}</Text>
            </div>
          </article>
        ))}
      </div>
    </div>
  </Container>
</section>
