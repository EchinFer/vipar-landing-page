---
import Container from "@components/ui/Container.astro";
import Heading from "@components/ui/Heading.astro";
import UiIcon from "@components/icons/UiIcon.astro";
import type { CeilingFaqItem } from "@lib/static-servicio-cielo-raso";

interface Props {
  items: CeilingFaqItem[];
}

const { items } = Astro.props;
---

<section class="ceiling-service-section ceiling-service-faq">
  <Container class="ceiling-service-faq__inner">
    <Heading level={2} variant="lg" class="ceiling-service-faq__title">
      Consultas frecuentes
    </Heading>
    <div class="ceiling-service-faq__list">
      {items.map((item, index) => (
        <details class="ceiling-service-faq__item" open={index === 0}>
          <summary>
            <span>{item.question}</span>
            <UiIcon name="chevron-down" />
          </summary>
          <div>{item.answer}</div>
        </details>
      ))}
    </div>
  </Container>
</section>
