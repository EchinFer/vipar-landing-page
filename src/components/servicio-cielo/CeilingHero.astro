---
import { Image } from "astro:assets";
import Button from "@components/ui/Button.astro";
import Container from "@components/ui/Container.astro";
import Heading from "@components/ui/Heading.astro";
import Text from "@components/ui/Text.astro";

interface Props {
  image: string;
  whatsappHref: string;
}

const { image, whatsappHref } = Astro.props;
---

<section class="ceiling-service-hero">
  <div class="ceiling-service-hero__media">
    <Image
      src={image}
      alt="Interior con cielo raso tecnico de alta gama"
      inferSize={true}
      widths={[768, 1280, 1600]}
      sizes="100vw"
      loading="eager"
      fetchpriority="high"
      decoding="async"
      format="webp"
      quality={72}
    />
    <div class="ceiling-service-hero__overlay"></div>
  </div>

  <Container class="ceiling-service-hero__content">
    <div class="ceiling-service-hero__copy">
      <Heading level={1} variant="display" tone="inverse">
        Cielo raso
      </Heading>
      <Text variant="body-lg" tone="inverse">
        Cielo raso para viviendas, comercios, oficinas y obras en Paraguay. Consultá opciones en
        PVC, Durlock, desmontable y otros sistemas según medidas, uso del espacio y condiciones de
        instalación.
      </Text>
      <div class="ceiling-service-hero__actions">
        <Button
          href={whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          variant="contained"
          tone="primary"
          size="lg"
          data-track-event="whatsapp_service_click"
          data-cta-location="cielo_raso_hero"
          data-service-name="Cielo raso"
          data-whatsapp-message-type="service_hero"
        >
          Cotizar por WhatsApp
        </Button>
        <Button href="#sistemas" variant="outlined" tone="inverse" size="lg">
          Ver tipos de cielo raso
        </Button>
      </div>
    </div>
  </Container>
</section>
