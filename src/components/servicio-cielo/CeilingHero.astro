---
import Button from "@components/ui/Button.astro";
import Container from "@components/ui/Container.astro";
import Heading from "@components/ui/Heading.astro";
import Text from "@components/ui/Text.astro";

interface Props {
  image: string;
  whatsappHref: string;
}

const { image, whatsappHref } = Astro.props;
---

<section class="ceiling-service-hero">
  <div class="ceiling-service-hero__media">
    <img
      src={image}
      alt="Interior con cielo raso tecnico de alta gama"
      width={1600}
      height={1200}
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
    <div class="ceiling-service-hero__overlay"></div>
  </div>

  <Container class="ceiling-service-hero__content">
    <div class="ceiling-service-hero__copy">
      <Heading level={1} variant="display" tone="inverse">
        Cielo raso en yeso, PVC, Durlock y desmontable
      </Heading>
      <Text variant="body-lg" tone="inverse">
        Cotizá cielo raso para viviendas, oficinas y locales en Paraguay. Te orientamos entre
        yeso, PVC, Durlock y sistemas desmontables según medidas, mantenimiento, uso del espacio y
        nivel de terminación buscado.
      </Text>
      <div class="ceiling-service-hero__actions">
        <Button
          href={whatsappHref}
          target="_blank"
          rel="noopener noreferrer"
          variant="contained"
          tone="primary"
          size="lg"
          data-track-event="whatsapp_click"
          data-cta-location="service_cta"
          data-service-name="Cielo raso"
          data-whatsapp-message-type="service_hero"
        >
          Cotizar por WhatsApp
        </Button>
        <Button href="#sistemas" variant="outlined" tone="inverse" size="lg">
          Ver tipos de cielo raso
        </Button>
      </div>
    </div>
  </Container>
</section>
